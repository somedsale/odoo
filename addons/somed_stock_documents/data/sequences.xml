<odoo>
  <record id="seq_pnk" model="ir.sequence">
    <field name="name">Phiếu nhập kho</field>
    <field name="code">stock.picking.pnk</field>
    <field name="prefix">PNK/%(year)s/%(month)s/</field>
    <field name="padding">4</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_pxk" model="ir.sequence">
    <field name="name">Phiếu xuất kho</field>
    <field name="code">stock.picking.pxk</field>
    <field name="prefix">PXK/%(year)s/%(month)s/</field>
    <field name="padding">4</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
