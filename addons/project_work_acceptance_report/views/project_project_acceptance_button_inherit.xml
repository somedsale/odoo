<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_project_project_form_work_custom_inherit_acceptance_button" model="ir.ui.view">
      <field name="name">project.project.form.work.custom.inherit.acceptance.button</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project_work_from_so.view_project_project_form_work_custom"/>
      <field name="arch" type="xml">

        <!-- Nếu form custom đã có button_box -->
        <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
          <button name="action_view_acceptance_reports"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-check-square-o"
                  groups="project.group_project_manager">
            <field name="acceptance_report_count" widget="statinfo" string="Nghiệm thu"/>
          </button>
        </xpath>
        <xpath expr="//group[@name='attachment_group']" position="after">
            <group string="Phân công báo cáo" >
                <field name="acceptance_user_id" string="Người báo cáo nghiệm thu" widget="many2one_avatar_user"/>
                <field name="claim_user_id" string="Người báo cáo thanh / quyết toán" widget="many2one_avatar_user"/>
                <field name="assigned_user_id" string="Người báo cáo sản lượng" widget="many2one_avatar_user"/>
            </group>

        </xpath>
      </field>
    </record>

  </data>
</odoo>