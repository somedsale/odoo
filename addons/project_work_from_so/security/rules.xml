<odoo>

  <!-- User chỉ thấy assignment của mình -->
  <record id="rule_assignment_user_own" model="ir.rule">
    <field name="name">Assignment: own</field>
    <field name="model_id" ref="model_project_work_assignment"/>
    <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    <field name="domain_force">[('user_id','=',user.id)]</field>
  </record>

  <!-- User thấy progress của các work_item mà mình được phân công -->
  <record id="rule_progress_user_assigned" model="ir.rule">
    <field name="name">Progress: assigned work items</field>
    <field name="model_id" ref="model_project_work_progress"/>
    <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    <field name="domain_force">[('work_item_id.assignment_ids.user_id','=',user.id)]</field>
  </record>

  <!-- PM: không cần rule (mặc định thấy hết). Nếu hệ thống bạn đang bị rule chặn PM thì thêm rule allow-all cho PM -->
  <record id="rule_progress_pm_all" model="ir.rule">
    <field name="name">Progress: PM all</field>
    <field name="model_id" ref="model_project_work_progress"/>
    <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

  <record id="rule_assignment_pm_all" model="ir.rule">
    <field name="name">Assignment: PM all</field>
    <field name="model_id" ref="model_project_work_assignment"/>
    <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

</odoo>
