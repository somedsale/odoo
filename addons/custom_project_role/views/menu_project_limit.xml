<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Ẩn menu Dự án gốc khỏi user thường -->
        <!-- <record id="project.menu_main_pm" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('project.group_project_manager')])]"/>
        </record> -->
        <record id="action_view_my_project" model="ir.actions.act_window">
            <field name="name">Dự án của tôi</field>
            <field name="res_model">project.project</field>
            <field name="view_mode">kanban,tree,form</field>
            <!-- Chỉ hiển thị dự án có nhiệm vụ gán cho user hiện tại -->
            <field name="domain">[('task_ids.user_ids', 'in', [uid])]</field>
        </record>
        <!-- Tạo menu Dự án riêng cho người dùng dự án -->
        <menuitem id="menu_main_pm_user" name="Công việc - Dự án" sequence="10" groups="project.group_project_user" action="project.action_view_my_task" />
        <menuitem id="menu_project_user_projects" name="Dự án của tôi" parent="menu_main_pm_user" sequence="5" action="custom_project_role.action_view_my_project" groups="project.group_project_user"/>
        <!-- Menu nhiệm vụ của tôi -->
        <menuitem id="menu_project_user_tasks" name="Nhiệm vụ của tôi" parent="menu_main_pm_user" sequence="10" action="project.action_view_my_task" groups="project.group_project_user"/>
        <!-- ACTION -->
        <!-- MENU Phiếu Đề Xuất -->
        <menuitem id="menu_proposal_sheet_root" name="Phiếu Đề Xuất" parent="menu_main_pm_user" sequence="20" groups="project.group_project_user"/>
        <menuitem id="menu_proposal_sheet" name="Quản Lý Phiếu Đề Xuất" parent="menu_proposal_sheet_root" action="proposal_sheet.action_proposal_sheet_user" sequence="10" groups="project.group_project_user"/>
        <menuitem id="menu_material_root_user" name="Vật tư" parent="menu_main_pm_user" sequence="30" groups="project.group_project_user" />
        <!-- Danh sách vật tư -->
        <menuitem id="menu_project_material_list_user" name="Danh sách vật tư" parent="menu_material_root_user" action="project_material.action_project_material" sequence="10" groups="project.group_project_user" />
        <!-- Danh mục vật tư -->
        <menuitem id="menu_material_category_user" name="Danh mục vật tư" parent="menu_material_root_user" action="project_material.action_material_category" sequence="20" groups="project.group_project_user" />
    </data>
</odoo>
