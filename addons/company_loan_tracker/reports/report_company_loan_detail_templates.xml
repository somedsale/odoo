<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paperformat (bỏ nếu đã có ở module khác) -->
    <record id="company_loan_detail_report_a4" model="report.paperformat">
        <field name="name">Company Loan Detail A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">20</field>
        <field name="dpi">110</field>
    </record>

    <!-- Layout -->
    <template id="report_company_loan_detail_layout">
        <t t-call="web.html_container">
            <div class="header" style="font-family:'Times New Roman'; font-size:11pt;">
                <table style="width:100%;">
                    <tr>
                        <td>
                            <img t-att-src="'/web/image/res.company/%s/logo' % res_company.id" style="max-height:50px;"/>
                        </td>
                        <td style="text-align:right;">
                            <div>
                                <t t-esc="res_company.name"/>
                            </div>
                            <div>Email: <t t-esc="user_id.email or ''"/>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <div class="article">
                <t t-raw="0"/>
            </div>
            <div class="footer" style="text-align:center;">
                <span class="page"/>
            </div>
        </t>
    </template>

    <!-- Report body -->
    <template id="report_company_loan_detail_view">
        <t t-call="company_loan_tracker.report_company_loan_detail_layout">
            <div class="page" style="font-family:'Times New Roman'; font-size:12pt; color:#000;">

                <!-- Tiêu đề -->
                <h1 style="text-align:center; text-transform:uppercase; margin-bottom:6px;">
                    <t t-esc="lender.name"/>
                </h1>
                <div style="text-align:center; margin-bottom:14px;">
                    <b>Báo cáo chi tiết khoản vay</b>
                    <br/>
                    <b>Khoảng thời gian:</b>
                    <t t-esc="date_from or '-'"/>
 →                    <t t-esc="date_to or '-'"/>
                </div>

                <style>
                    .tbl { width:100%; border-collapse: collapse; }
                    .tbl th, .tbl td { border:1px solid #000; padding:6px 8px; font-size:11pt; }
                    .bg { background:#E2EFDA; font-weight:bold; }
                    .right { text-align:right; white-space:nowrap; }
                    .center { text-align:center; }
                    .nowrap { white-space:nowrap; }
                </style>

                <table class="tbl">
                    <colgroup>
                        <col style="width:4%"/>
                        <!-- STT -->
                        <col style="width:12%"/>
                        <!-- Mã giao dịch -->
                        <col style="width:10%"/>
                        <!-- Số tiền vay -->
                        <col style="width:6%"/>
                        <!-- Lãi suất -->

                        <!-- Nhóm: Số tiền đã / dự kiến thanh toán -->
                        <col style="width:8%"/>
                        <!-- Loại -->
                        <col style="width:8%"/>
                        <!-- Ngày chi -->
                        <col style="width:8%"/>
                        <!-- Từ ngày -->
                        <col style="width:8%"/>
                        <!-- Đến ngày -->
                        <col style="width:6%"/>
                        <!-- Số ngày -->
                        <col style="width:9%"/>
                        <!-- Số tiền chi -->
                        <col style="width:9%"/>
                        <!-- Lãi phải trả -->

                        <!-- Nhóm: Số tiền còn nợ -->
                        <col style="width:8%"/>
                        <!-- Nợ gốc -->
                        <col style="width:10%"/>
                        <!-- Lãi còn nợ -->

                        <col style="width:6%"/>
                        <!-- Ngày bắt đầu -->
                        <col style="width:6%"/>
                        <!-- Ngày đáo hạn -->
                    </colgroup>

                    <thead>
                        <tr class="bg">
                            <th rowspan="2" class="center">STT</th>
                            <th rowspan="2" class="center">Mã giao dịch</th>
                            <th rowspan="2" class="center">Số tiền vay</th>
                            <th rowspan="2" class="center">Lãi suất</th>
                            <th colspan="7" class="center">Số tiền đã / dự kiến thanh toán</th>
                            <th colspan="2" class="center">Số tiền còn nợ</th>
                            <th rowspan="2" class="center">Bắt đầu</th>
                            <th rowspan="2" class="center">Đáo hạn</th>
                        </tr>
                        <tr class="bg">
                            <th class="center">Loại</th>
                            <th class="center">Ngày chi</th>
                            <th class="center">Từ ngày</th>
                            <th class="center">Đến ngày</th>
                            <th class="center">Số ngày</th>
                            <th class="center">Số tiền chi</th>
                            <th class="center">Lãi phải trả</th>
                            <th class="center">Nợ gốc</th>
                            <th class="center">Lãi còn nợ</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="stt" t-value="0"/>
                        <t t-foreach="rows" t-as="r">
                            <tr>
                                <!-- STT -->
                                <td class="center">
                                    <t t-set="stt" t-value="stt + 1"/>
                                    <t t-esc="stt"/>
                                </td>

                                <!-- Mã giao dịch -->
                                <td>
                                    <t t-esc="r['loan_name']"/>
                                </td>

                                <!-- Số tiền vay -->
                                <td class="right">
                                    <span t-esc="r['loan_amount']" t-options="{'widget':'monetary','display_currency': r['currency']}"/>
                                </td>

                                <!-- Lãi suất -->
                                <td class="center">
                                    <t t-esc="r['loan_interest_rate']"/>
%
                                </td>
                                <td class="center">
                                    <t t-esc="r['kind']=='principal' and 'Trả gốc' or (r['kind']=='interest' and 'Trả lãi' or 'Khác')"/>
                                </td>
                                <td class="center">
                                    <t t-esc="r['date'] or '-'"/>
                                </td>
                                <!-- Kỳ tính lãi -->
                                <td class="center">
                                    <t t-esc="r['date_from'] or '-'"/>
                                </td>
                                <td class="center">
                                    <t t-esc="r['date_to'] or '-'"/>
                                </td>
                                <td class="center">
                                    <t t-esc="r['interest_days'] or 0"/>
                                </td>

                                <!-- Số tiền chi -->
                                <td class="right">
                                    <span t-esc="r['total']" t-options="{'widget':'monetary','display_currency': r['currency']}"/>
                                </td>

                                <!-- Lãi phải trả -->
                                <td class="right">
                                    <span t-esc="r['interest_expected']" t-options="{'widget':'monetary','display_currency': r['currency']}"/>
                                </td>
                                <!-- Nợ gốc còn lại -->
                                <td class="right">
                                    <span t-esc="r['loan_balance']" t-options="{'widget':'monetary','display_currency': r['currency']}"/>
                                </td>

                                <!-- Lãi còn nợ -->
                                <td class="right">
                                    <span t-esc="r['loan_interest_outstanding']" t-options="{'widget':'monetary','display_currency': r['currency']}"/>
                                </td>

                                <!-- Ngày bắt đầu / Đáo hạn -->
                                <td class="center">
                                    <t t-esc="r['loan_start_date'] or '-'"/>
                                </td>
                                <td class="center">
                                    <t t-esc="r['loan_due_date'] or '-'"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <!-- ir.actions.report -->
    <record id="action_company_loan_detail_report" model="ir.actions.report">
        <field name="name">Báo cáo chi tiết khoản vay</field>
        <field name="model">company.loan</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">company_loan_tracker.report_company_loan_detail_view</field>
        <field name="report_file">company_loan_tracker.report_company_loan_detail_view</field>
        <field name="paperformat_id" ref="company_loan_detail_report_a4"/>
    </record>

</odoo>
