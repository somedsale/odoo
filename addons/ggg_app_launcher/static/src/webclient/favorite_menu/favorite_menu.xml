<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ggg_app_launcher.FavoriteMenu">
        <Dropdown position="'bottom-end'" beforeOpen.bind="onBeforeOpen" menuClass="'ggg-favorite-dropdown'">
            <t t-set-slot="toggler">
                <i class="fa fa-lg fa-star" role="img" aria-label="Favorites"/>
            </t>
            <div class="ggg-favorite-form p-3">
                <div class="fw-bold mb-2">Add to Favorites</div>
                <div class="mb-2">
                    <label class="form-label small text-muted mb-1">Name</label>
                    <input type="text" class="form-control form-control-sm" t-att-value="state.name" t-on-input="onNameInput" t-on-keydown="onKeydown" placeholder="Page name"/>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted mb-1">URL</label>
                    <input type="text" class="form-control form-control-sm text-muted" t-att-value="state.url" readonly="true"/>
                </div>
                <button class="btn btn-primary btn-sm w-100" t-on-click="onSave">
                    <i class="fa fa-star me-1"/>
Save
                </button>
            </div>
        </Dropdown>
    </t>

</templates>
