        ('community_id.member_ids.user_id','=',user.id)
      ]
    </field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="rule_comment_read" model="ir.rule">
    <field name="name">Comment read</field>
    <field name="model_id" ref="model_community_hub_comment"/>
    <field name="domain_force">
      ['|',
        ('community_id.is_public','=',True),
        ('community_id.member_ids.user_id','=',user.id)
      ]
    </field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="rule_reaction_read" model="ir.rule">
    <field name="name">Reaction read</field>
    <field name="model_id" ref="model_community_hub_reaction"/>
    <field name="domain_force">
      ['|',
        ('community_id.is_public','=',True),
        ('community_id.member_ids.user_id','=',user.id)
      ]
    </field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>

</odoo>
