<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- 🌟 Menu gốc riêng của module Somed -->
    <!-- <menuitem
      id="menu_somed_product_root"
      name="Cấu hình sản phẩm Somed"
      sequence="10"
    /> -->

    <!-- TREE VIEW -->
    <record id="view_product_attribute_set_tree" model="ir.ui.view">
      <field name="name">product.attribute.set.tree</field>
      <field name="model">product.attribute.set</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="attribute_ids"/>
          <field name="active"/>
        </tree>
      </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_product_attribute_set_form" model="ir.ui.view">
      <field name="name">product.attribute.set.form</field>
      <field name="model">product.attribute.set</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="active"/>
            </group>
            <group>
              <field name="attribute_ids" widget="many2many_tags"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACTION -->
    <record id="action_product_attribute_set" model="ir.actions.act_window">
      <field name="name">Bộ thuộc tính sản phẩm</field>
      <field name="res_model">product.attribute.set</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU CON: Bộ thuộc tính sản phẩm -->
    <!-- <menuitem
      id="menu_product_attribute_set"
      name="Bộ thuộc tính sản phẩm"
      parent="menu_somed_product_root"
      action="action_product_attribute_set"
      sequence="20"
    /> -->

  </data>
</odoo>
