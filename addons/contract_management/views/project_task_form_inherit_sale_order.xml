<!-- views/project_task_form_inherit_sale_order.xml -->
<odoo>
    <record id="view_task_form_inherit_sale_order" model="ir.ui.view">
        <field name="name">project.task.form.inherit.sale.order</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- 2 smart buttons trên header -->
            <xpath expr="//group/group/field[@name=&apos;project_id&apos;]" position="after">
                <!-- SO của Dự án để người dùng dễ nhìn bối cảnh -->
                <field name="project_sale_order_id" readonly="1" options="{'no_open': True}"/>

                <!-- Chỉ cho chọn line thuộc SO của Dự án -->
                <field name="sale_order_line_id" domain="[('order_id','=',project_sale_order_id)]" options="{'no_open': False,'no_create': True}" />
            </xpath>

        </field>
    </record>
    <odoo>
        <record id="view_order_line_tree_inherit_task" model="ir.ui.view">
            <field name="name">sale.order.line.tree.inherit.hide_delivery_invoice</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_tree"/>
            <field name="arch" type="xml">

                <!-- Ẩn số lượng giao hàng -->
                <xpath expr="//field[@name='qty_delivered']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <!-- Ẩn số lượng cần xuất hóa đơn -->
                <xpath expr="//field[@name='qty_to_invoice']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

                <!-- Ẩn số lượng đã xuất hóa đơn -->
                <xpath expr="//field[@name='qty_invoiced']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_id']" position="after">
                    <field name="product_id" string="Sản phẩm" readonly="1"/>
                </xpath>

            </field>
        </record>
    </odoo>
</odoo>
