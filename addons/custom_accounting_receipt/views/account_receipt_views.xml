<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_account_receipt_form" model="ir.ui.view">
            <field name="name">account.receipt.form</field>
            <field name="model">account.receipt</field>
            <field name="arch" type="xml">
                <form string="Phiếu Thu Kế Toán">
                    <header>
                        <button name="action_post" type="object" string="Ghi sổ" class="oe_highlight" invisible="state != 'draft'"/>
                        <!-- <button name="action_cancel" type="object" string="Hủy" invisible="state == 'cancel'"/> -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted,cancel"/>
                    </header>
                    <sheet>
                        <group col="2">
                            <group>
                                <field name="name"/>
                                <field name="date"/>
                                <field name="partner_type" widget="radio"/>
                                <field name="partner_id" invisible="partner_type !='customer'"/>
                                <field name ="employee_id" invisible="partner_type !='employee'"/>
                                <field name="amount" widget="monetary"/>
                                <field name="currency_id" invisible="1" optional="hide"/>
                                <field name="payment_method"/>
                                <field name="bank_id" invisible="payment_method != 'bank'"/>
                                <field name="note" string="Nội dung thu"/>
                            </group>
                            <group>
                                <field name="type_revenue"/>
                                <field name="project_id" invisible="type_revenue !='done_revenue' and type_revenue !='advance'"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_account_receipt_tree" model="ir.ui.view">
            <field name="name">account.receipt.tree</field>
            <field name="model">account.receipt</field>
            <field name="arch" type="xml">
                <tree string="Phiếu Thu Kế Toán">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="note" string="Nội dung thu"/>
                    <field name="partner_id"/>
                    <field name ="employee_id"/>
                    <field name="amount" widget="monetary" sum="1"/>
                    <field name="currency_id" invisible="1" optional="hide"/>
                    <field name="payment_method"/>
                    <field name="state" widget="badge" decoration-success="state =='posted'"/>
                </tree>
            </field>
        </record>
        <record id="view_account_receipt_search" model="ir.ui.view">
            <field name="name">account.receipt.search</field>
            <field name="model">account.receipt</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm phiếu thu">

                    <!-- Search fields -->
                    <field name="name" string="Số phiếu thu"/>
                    <field name="note" string="Nội dung thu"/>
                    <field name="project_id" string="Dự án"/>
                    <field name="partner_id" string="Khách hàng"/>
                    <field name="employee_id" string="Nhân viên"/>
                    <field name="date" string="Ngày thu"/>
                    <field name="bank_id" string="Ngân hàng"/>

                    <separator/>

                    <!-- State filters -->
                    <filter string="Nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Đã ghi sổ" name="posted" domain="[('state', '=', 'posted')]"/>
                    <filter string="Đã hủy" name="cancel" domain="[('state', '=', 'cancel')]"/>

                    <separator/>

                    <!-- Payment method -->
                    <filter string="Tiền mặt" name="cash" domain="[('payment_method', '=', 'cash')]"/>
                    <filter string="Chuyển khoản" name="bank" domain="[('payment_method', '=', 'bank')]"/>

                    <separator/>

                    <!-- Partner type -->
                    <filter string="Khách hàng" name="customer" domain="[('partner_type', '=', 'customer')]"/>
                    <filter string="Nhân viên" name="employee" domain="[('partner_type', '=', 'employee')]"/>

                    <separator/>

                    <!-- Revenue type -->
                    <filter string="Doanh thu đã thực hiện" name="done_revenue" domain="[('type_revenue', '=', 'done_revenue')]"/>
                    <filter string="Tạm ứng" name="advance" domain="[('type_revenue', '=', 'advance')]"/>
                    <filter string="Khoản vay" name="loan" domain="[('type_revenue', '=', 'loan')]"/>
                    <filter string="Giải chi" name="explain" domain="[('type_revenue', '=', 'explain')]"/>
                    <filter string="Thu khác" name="other" domain="[('type_revenue', '=', 'other')]"/>

                    <separator/>

                    <!-- Project filters -->
                    <filter string="Có dự án" name="has_project" domain="[('project_id', '!=', False)]"/>
                    <filter string="Không có dự án" name="no_project" domain="[('project_id', '=', False)]"/>

                    <separator/>

                    <!-- Time filters -->
                    <filter string="Hôm nay" name="today" domain="[('date', '=', context_today().strftime('%%Y-%%m-%%d'))]"/>

                    <filter string="Tháng này" name="this_month" domain="[
                        ('date', '&gt;=', context_today().strftime('%%Y-%%m-01')),
                        ('date', '&lt;=', context_today().strftime('%%Y-%%m-31'))
                    ]"/>

                    <separator/>

                    <!-- Group by -->
                    <group expand="0" string="Nhóm theo">
                        <filter string="Dự án" name="group_project" context="{'group_by': 'project_id'}"/>
                        <filter string="Khách hàng" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Loại đối tượng" name="group_partner_type" context="{'group_by': 'partner_type'}"/>
                        <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Loại doanh thu" name="group_type_revenue" context="{'group_by': 'type_revenue'}"/>
                        <filter string="Phương thức thanh toán" name="group_payment_method" context="{'group_by': 'payment_method'}"/>
                        <filter string="Ngân hàng" name="group_bank" context="{'group_by': 'bank_id'}"/>
                        <filter string="Ngày thu" name="group_date" context="{'group_by': 'date'}"/>
                        <filter string="Tháng thu" name="group_date_month" context="{'group_by': 'date:month'}"/>
                    </group>

                    <!-- Search panel -->
                    <searchpanel>
                        <field name="project_id" string="Dự án" enable_counters="1"/>
                        <field name="state" string="Trạng thái" select="multi" enable_counters="1"/>
                        <field name="partner_type" string="Loại đối tượng" select="multi" enable_counters="1"/>
                        <field name="type_revenue" string="Loại doanh thu" select="multi" enable_counters="1"/>
                        <field name="payment_method" string="Phương thức thanh toán" select="multi" enable_counters="1"/>
                        <field name="bank_id" string="Ngân hàng" select="multi" enable_counters="1"/>
                    </searchpanel>

                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_account_receipt" model="ir.actions.act_window">
            <field name="name">Phiếu Thu Kế Toán</field>
            <field name="res_model">account.receipt</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_account_receipt_search"/>
        </record>
        <!-- Menu -->
        <menuitem id="menu_account_receipt" name="Phiếu Thu" parent="custom_account_menu.menu_accounting_vouchers" action="action_account_receipt"/>
    </data>
</odoo>