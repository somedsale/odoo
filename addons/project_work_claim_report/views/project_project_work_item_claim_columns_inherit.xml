<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_project_project_form_work_custom_inherit_claim_cols" model="ir.ui.view">
      <field name="name">project.project.form.work.custom.inherit.claim.columns</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project_work_from_so.view_project_project_form_work_custom"/>
      <field name="arch" type="xml">

        <!-- ✅ Không dùng @string='Hạng mục công việc' -->
        <!-- Chèn cột quyết toán vào tree của field work_item_ids -->
        <xpath expr="//field[@name='work_item_ids']/tree/field[@name='progress_percent']"
               position="after">

          <field name="claim_qty_done" string="KL Q/T lũy kế" readonly="1"/>
          <field name="claim_qty_remaining" string="KL Q/T còn lại" readonly="1"/>
          <field name="claim_progress_percent" string="% Q/T" readonly="1"/>

          <field name="claim_value_done" string="GT Q/T lũy kế" readonly="1"/>
          <field name="claim_value_remaining" string="GT Q/T còn lại" readonly="1"/>

        </xpath>
      <xpath expr="//group/group/field[@name='progress_percent']" position="after">

        <field name="claim_value_done" readonly="1"/>
        <field name="claim_value_remaining" readonly="1"/>
      </xpath>
      </field>
    </record>

  </data>
</odoo>