<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ===== TREE VIEW MỚI ===== -->
    <record id="view_project_project_tree_custom" model="ir.ui.view">
        <field name="name">project.project.tree.custom</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <tree string="Dự án (Custom)" create="1" edit="1">
                <field name="partner_id"/>
                <field name="name" string="Tên dự án"/>
                <field name="num_contract" string="Số hợp đồng"/>
                <field name="sales_category_ids" widget="many2many_tags" options="{'color_field': 'color'}" string="Hạng mục"/>
                <field name="value_contract" sum="Tổng" string="Giá trị hợp đồng"/>
                <field name="signature_year" string="Năm ký hợp đồng"/>
                <field name="date_start"/>
                <field name="date"/>
                <field name="stage_id"/>
                <field name="currency_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ===== FORM VIEW MỚI ===== -->
    <record id="view_project_project_form_custom" model="ir.ui.view">
        <field name="name">project.project.form.custom</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
        <form string="Dự án (Custom)" create="1" edit="1">
            <sheet>

                <!-- Hidden fields để tránh lỗi validate domain/context -->
                <group invisible="1">
                    <field name="company_id"/>
                </group>

                <div class="oe_title">
                    <h1>
                        <field name="name" placeholder="Tên dự án..."/>
                    </h1>
                </div>

                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="user_id"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date"/>
                    </group>
                </group>

                <notebook>
                    <page string="Hợp đồng">
                        <group>
                            <group string="Thông tin hợp đồng">
                                <field name="contract_id" options="{'no_create': True}"/>
                                <field name="signature_date" readonly="1"/>
                                <field name="location" readonly="1"/>
                            </group>

                            <group string="Thông tin bán hàng">
                                <field name="sale_order_id" readonly="1"/>
                                <field name="value_contract" readonly="1"/>
                                <field name="sales_category_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </group>

                        <group string="Tài liệu">
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </group>
                    </page>
                </notebook>

            </sheet>
        </form>
        </field>
    </record>

    <!-- ===== ACTION RIÊNG: CHỈ MỞ VIEW CUSTOM ===== -->
<record id="action_project_project_custom" model="ir.actions.act_window">
    <field name="name">Dự án (Custom)</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">tree,form</field>

    <!-- Quan trọng: clear hết view_ids cũ trước khi add mới -->
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'sequence': 1, 'view_mode': 'tree', 'view_id': ref('view_project_project_tree_custom')}),
        (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('view_project_project_form_custom')})
    ]"/>
</record>


    <!-- ===== MENU RIÊNG (không đụng menu cũ) ===== -->
    <menuitem id="menu_project_project_custom"
              name="Dự án (Custom)"
              parent="project.menu_main_pm"
              action="action_project_project_custom"
              sequence="90"/>
</odoo>
