<templates xml:space="preserve">
    <t t-name="executive_dashboard.Template" owl="1">
        <div class="ed-dashboard o_action">

            <!-- ================= HEADER ================= -->
            <div class="ed-header">
                <div class="ed-header-main">
                    <h2>📊 Dashboard</h2>

                    <t t-if="state.filter_label">
                        <span class="ed-header-sub">
                            <i class="fa fa-filter"></i>
                            <t t-esc="state.filter_label"/>
                        </span>
                    </t>
                </div>
            </div>

            <!-- ================= BODY ================= -->
            <div class="ed-body">

                <!-- ============ KPI CARDS ============ -->
                <div class="ed-kpis" t-if="state.data">

                    <!-- Báo giá -->
                    <div class="ed-kpi-card ed-kpi-card--split" t-on-click="openQuotations">
                        <div class="ed-kpi-left">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-file-text-o"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>BÁO GIÁ</p>
                                <h3>
                                    <t t-esc="state.data.kpis.quotation.count.toLocaleString('vi-VN')"/>
                                </h3>
                            </div>
                        </div>
                        <div class="ed-kpi-right">
                            <span class="ed-kpi-amount">
                                <t t-esc="state.data.kpis.quotation.total_amount.toLocaleString('vi-VN')"/>
 ₫
                            </span>
                        </div>
                    </div>

                    <!-- Đơn hàng -->
                    <div class="ed-kpi-card ed-kpi-card--split" t-on-click="openOrders">
                        <div class="ed-kpi-left">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-shopping-cart"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>ĐƠN HÀNG</p>
                                <h3>
                                    <t t-esc="state.data.kpis.order.count.toLocaleString('vi-VN')"/>
                                </h3>
                            </div>
                        </div>
                        <div class="ed-kpi-right">
                            <span class="ed-kpi-amount">
                                <t t-esc="state.data.kpis.order.total_amount.toLocaleString('vi-VN')"/>
 ₫
                            </span>
                        </div>
                    </div>

                    <!-- Tiền thu -->
                    <div class="ed-kpi-card ed-kpi-card--split" t-on-click="openCashIn">
                        <div class="ed-kpi-left">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-sign-in"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>TIỀN THU</p>
                                <h3>
                                    <t t-esc="state.data.kpis.cash_in.toLocaleString('vi-VN')"/>
 ₫
                                </h3>
                            </div>
                        </div>
                    </div>

                    <!-- Tiền chi -->
                    <div class="ed-kpi-card ed-kpi-card--split" t-on-click="openCashOut">
                        <div class="ed-kpi-left">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-sign-out"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>TIỀN CHI</p>
                                <h3>
                                    <t t-esc="state.data.kpis.cash_out.toLocaleString('vi-VN')"/>
 ₫
                                </h3>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ============ CHART GRID #1 ============ -->
                <div class="ed-content-grid">
                    <!-- Doughnut: Top sản phẩm -->
                    <div class="ed-list">
                        <h4>📊 Top sản phẩm: Báo giá + Đơn hàng</h4>

                        <div style="height: 320px; position: relative;">
                            <canvas t-ref="productChart" style="cursor: pointer;"></canvas>

                            <t t-if="!state.data">
                                <div class="ed-empty">Chưa có dữ liệu hiển thị</div>
                            </t>
                        </div>
                    </div>

                    <!-- Bar: Top khách hàng -->
                    <div class="ed-list" t-if="state.data">
                        <h4>👥 Top 5 khách hàng tiêu biểu</h4>
                        <div style="height: 300px;">
                            <canvas t-ref="customerChart" style="cursor: pointer;"></canvas>

                            <t t-if="!state.data">
                                <div class="ed-empty">Chưa có dữ liệu hiển thị</div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- ============ CHART GRID #2 ============ -->
                <div class="ed-content-grid">
                    <!-- Chi phí dự án -->
                    <div class="ed-list">
                        <h4>📊 Chi phí dự án</h4>

                        <div style="height: 300px;">
                            <canvas t-ref="projectExpenseChart" style="cursor: pointer;"></canvas>

                            <t t-if="!state.data">
                                <div class="ed-empty">Chưa có dữ liệu hiển thị</div>
                            </t>
                        </div>
                    </div>

                    <!-- Hóa đơn vào / ra -->
                    <div class="ed-list" t-if="state.data">
                        <h4>💳 Hóa đơn vào / ra</h4>
                        <div style="height: 260px;">
                            <canvas t-ref="invoiceChart" style="cursor: pointer;"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================= FILTER OVERLAY ================= -->
            <div t-attf-class="ed-filter-overlay #{state.showFilters ? 'show' : ''}"></div>

            <!-- ================= FILTER PANEL ================= -->
            <div t-ref="filterPanel" t-attf-class="ed-filter-panel #{state.showFilters ? 'show' : ''}">

                <div class="ed-filter-header">
                    <h4>Bộ lọc</h4>
                    <button class="close-btn" t-on-click="toggleFilters">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <div class="ed-filter-body">
                    <input type="date" t-model="state.filters.date_from" t-on-change="onChangeDate"/>
                    <input type="date" t-model="state.filters.date_to" t-on-change="onChangeDate"/>

                    <select t-model="state.filters.year" t-on-change="onChangeYear">
                        <option value="">---</option>
                        <t t-foreach="years" t-as="y" t-key="y">
                            <option t-att-value="y">
                                <t t-esc="y"/>
                            </option>
                        </t>
                    </select>

                    <select t-model="state.filters.quarter" t-on-change="onChangeQuarter">
                        <option value="">---</option>
                        <option value="Q1">Q1</option>
                        <option value="Q2">Q2</option>
                        <option value="Q3">Q3</option>
                        <option value="Q4">Q4</option>
                    </select>

                    <div class="ed-filter-actions">
                        <button class="btn btn-primary" t-on-click="applyFilters">Áp dụng</button>
                        <button class="btn btn-secondary" t-on-click="resetFilters">Đặt lại</button>
                    </div>
                </div>
            </div>

            <!-- ================= FILTER FAB BUTTON ================= -->
            <button t-attf-class="ed-filter-fab #{state.showFilters ? 'active' : ''}" t-on-click="toggleFilters">
                <i t-attf-class="fa #{state.showFilters ? 'fa-times' : 'fa-filter'}"></i>
            </button>

        </div>
    </t>
</templates>
