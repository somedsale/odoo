<odoo>
    <record id="view_future_project_kanban" model="ir.ui.view">
        <field name="name">future.project.kanban</field>
        <field name="model">future.project</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                class="o_kanban_small_column">

                <field name="name"/>
                <field name="customer_id"/>
                <field name="expected_value"/>
                <field name="currency_id"/>
                <field name="expected_bid_date"/>
                <field name="assigned_user_id"/>
                <field name="priority"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_header">
                                <strong>
                                    <field name="name"/>
                                </strong>
                            </div>

                            <div class="o_kanban_content">
                                <div t-if="record.customer_id.raw_value">
                                    <i class="fa fa-building-o me-1"/>
                                    <field name="customer_id"/>
                                </div>

                                <div class="mt-1">
                                    <i class="fa fa-money me-1"/>
                                    <field name="expected_value"/>
                                </div>

                                <div t-if="record.expected_bid_date.raw_value" class="mt-1 text-muted">
                                    <i class="fa fa-calendar me-1"/>
                                    <field name="expected_bid_date"/>
                                </div>
                            </div>

                            <div class="o_kanban_footer mt-2">
                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                <field name="priority" widget="priority"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
