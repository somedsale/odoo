<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_bank_balance_wizard_form" model="ir.ui.view">
        <field name="name">bank.balance.wizard.form</field>
        <field name="model">bank.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Tồn ngân hàng theo ngày">
                <group>
                    <field name="company_id"/>
                    <field name="date"/>
                </group>

                <notebook>
                    <page string="Danh sách ngân hàng">
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom" delete="false">
                                <field name="bank_id" options="{'no_create': true}"/>
                                <field name="need_manual_opening" optional="hide"/>

                                <!-- modifier expression -->
                                <field name="opening_manual" string="Tồn đầu nhập" readonly="not need_manual_opening"/>

                                <field name="opening_balance" sum="Tổng tồn đầu"/>
                                <field name="receipt_amount" sum="Tổng PS thu"/>
                                <field name="payment_amount" sum="Tổng PS chi"/>
                                <field name="closing_balance" sum="Tổng tồn cuối"/>
                            </tree>
                        </field>
                    </page>
                </notebook>

                <footer>
                    <button name="action_generate_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_balance_wizard" model="ir.actions.act_window">
        <field name="name">Tồn ngân hàng theo ngày</field>
        <field name="res_model">bank.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- GIỮ MENU Y CHANG -->
    <menuitem id="menu_bank_balance_wizard" name="Tồn ngân hàng theo ngày" parent="expense_proposal.menu_expense_proposal_root" action="action_bank_balance_wizard" sequence="110"/>

</odoo>
