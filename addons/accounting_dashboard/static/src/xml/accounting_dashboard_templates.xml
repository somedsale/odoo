<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ad.AccountingDashboard" owl="1">
        <div class="ad-dashboard o_action">

            <!-- ========== HEADER ========== -->
            <div class="ad-header">
                <div class="ad-header__title">
                    <h2>KẾ TOÁN</h2>
                </div>

                <div class="ad-header__filters">
                    <input type="date" t-model="state.filters.date_from" title="Từ ngày"/>
                    <span class="ad-date-sep">→</span>
                    <input type="date" t-model="state.filters.date_to" title="Đến ngày"/>
                    <button class="ad-btn" t-on-click="applyFilter">
                        <i class="fa fa-filter me-1"></i> Áp dụng
                    </button>
                </div>

                <div class="ad-header__period">
                    <span t-esc="periodLabel"/>
                </div>
            </div>

            <!-- ========== CONTENT ========== -->
            <div class="ad-content o_content">
                <div class="ad-grid-layout">

                    <!-- ==== KPI ROW ==== -->
                    <div class="ad-card kpi ad-click" t-on-click="openReceipts">
                        <div class="ad-kpi-icon bg-green">
                            <i class="fa fa-arrow-down"></i>
                        </div>
                        <div>
                            <div class="ad-kpi-label">Tiền thu</div>
                            <div class="ad-kpi-value" t-esc="state.kpis.cash_in"/>
                        </div>
                    </div>

                    <div class="ad-card kpi ad-click" t-on-click="openPayments">
                        <div class="ad-kpi-icon bg-red">
                            <i class="fa fa-arrow-up"></i>
                        </div>
                        <div>
                            <div class="ad-kpi-label">Tiền chi</div>
                            <div class="ad-kpi-value" t-esc="state.kpis.cash_out"/>
                        </div>
                    </div>

                    <div class="ad-card kpi">
                        <div class="ad-kpi-icon bg-blue">
                            <i class="fa fa-chart-line"></i>
                        </div>
                        <div>
                            <div class="ad-kpi-label">Chênh lệch</div>
                            <div class="ad-kpi-value" t-esc="state.kpis.net_cash"/>
                        </div>
                    </div>

                    <div class="ad-card kpi ad-click" t-on-click="openAdvances">
                        <div class="ad-kpi-icon bg-yellow">
                            <i class="fa fa-wallet"></i>
                        </div>
                        <div>
                            <div class="ad-kpi-label">Tạm ứng cần thu</div>
                            <div class="ad-kpi-value" t-esc="state.kpis.advance_remain_total"/>
                        </div>
                    </div>

                    <!-- ==== ROW 2: BIỂU ĐỒ ==== -->
                    <div class="ad-block span-1">
                        <div class="ad-block__head">
                            <h3>Nhân viên chưa thu tạm ứng</h3>
                        </div>
                        <div class="ad-chart-wrap small">
                            <canvas t-ref="remainChart"/>
                        </div>
                    </div>

                    <div class="ad-block span-2">
                        <div class="ad-block__head">
                            <h3>Dòng tiền theo ngày</h3>
                        </div>
                        <div class="ad-chart-wrap small">
                            <canvas t-ref="dailyFlowChart"/>
                        </div>
                    </div>
                    <div class="ad-block span-1">
                        <!-- Phiếu đề xuất -->
                        <div class="ad-card kpi ad-click" t-on-click="openProposals">
                            <div class="ad-kpi-icon bg-amber">
                                <i class="fa-solid fa-clipboard-list"></i>
                            </div>
                            <div>
                                <div class="ad-kpi-label">Đề xuất cần xử lý</div>
                                <div class="ad-kpi-value" t-esc="state.proposal_pending_count"/>
                            </div>
                        </div>

                        <!-- Giải chi kế toán -->
                        <div class="ad-card kpi ad-click" t-on-click="openPaymentProposals">
                            <div class="ad-kpi-icon bg-blue">
                                <i class="fa fa-money-bill"></i>
                            </div>
                            <div>
                                <div class="ad-kpi-label">Giải chi cần xử lý</div>
                                <div class="ad-kpi-value" t-esc="state.payment_proposals_pending_count"/>
                            </div>
                        </div>
                        <div class="ad-card kpi ad-click" t-on-click="openPaymentProposals">
                            <div class="ad-kpi-icon bg-blue">
                                <i class="fa fa-money-bill"></i>
                            </div>
                            <div>
                                <div class="ad-kpi-label">Giải chi cần xử lý</div>
                                <div class="ad-kpi-value" t-esc="state.payment_proposals_pending_count"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
