<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa form đơn bán hàng để thêm field service_name -->
    <record id="view_order_form_service_line" model="ir.ui.view">
        <field name="name">sale.order.form.service.line</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Thêm cột Dịch vụ vào tree của order_line -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="service_name" optional="show"/>
            </xpath>

            <!-- Thêm field Dịch vụ vào form line (popup chỉnh dòng) -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                <field name="service_name"/>
            </xpath>

        </field>
    </record>
</odoo>
