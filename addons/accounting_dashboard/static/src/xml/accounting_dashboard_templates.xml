<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="ad.AccountingDashboard" owl="1">
        <div class="ad-page">
            <div class="ad-container">

                <!-- Filters -->
                <div class="ad-filterbar">
                    <div class="ad-filter-item">
                        <label>Từ ngày</label>
                        <input type="date" class="ad-date" t-model="state.filters.date_from"/>
                    </div>
                    <div class="ad-filter-item">
                        <label>Đến ngày</label>
                        <input type="date" class="ad-date" t-model="state.filters.date_to"/>
                    </div>
                    <button class="ad-chip primary" t-on-click="applyFilter">Áp dụng</button>
                    <div class="ad-period">(                        <t t-esc="periodLabel"/>
)</div>
                </div>

                <!-- KPI row -->
                <div class="ad-grid ad-grid-kpi">
                    <t t-foreach="state.kpis" t-as="k" t-key="k.title">
                        <div class="ad-card">
                            <div class="ad-kpi-top">
                                <div class="ad-kpi-title" t-esc="k.title"/>
                                <div class="ad-kpi-right">
                                    <span class="ad-spark">spark</span>
                                </div>
                            </div>
                            <div class="ad-kpi-value" t-esc="k.value"/>
                            <div class="ad-kpi-sub" t-esc="k.sub"/>
                        </div>
                    </t>
                </div>

                <!-- Charts + Sidebar -->
                <div class="ad-grid ad-grid-main">
                    <!-- Left -->
                    <div class="ad-left">
                        <div class="ad-grid ad-charts-2wide">
                            <div class="ad-block">
                                <div class="ad-block__head">
                                    <div class="ad-block__title">Dòng tiền 13 tuần</div>
                                </div>
                                <div class="ad-chart">
                                    <canvas t-ref="salesTrend"/>
                                </div>
                            </div>
                            <div class="ad-block">
                                <div class="ad-block__head">
                                    <div class="ad-block__title">KQKD theo tháng</div>
                                </div>
                                <div class="ad-chart">
                                    <canvas t-ref="kqkdMonthly"/>
                                </div>
                            </div>
                        </div>

                        <!-- 3 tables -->
                        <div class="ad-grid ad-tables">
                            <!-- AR -->
                            <div class="ad-block">
                                <div class="ad-block__head">
                                    <div class="ad-block__title">AR sắp đến hạn/quá hạn (Top 10)</div>
                                </div>
                                <div class="ad-tablewrap">
                                    <table class="ad-table">
                                        <thead>
                                            <tr>
                                                <th>Khách hàng</th>
                                                <th>Số HĐ</th>
                                                <th>Đến hạn</th>
                                                <th class="right">Còn lại</th>
                                                <th class="right">Tuổi nợ</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.tables.ar" t-as="row" t-key="row.number">
                                                <tr>
                                                    <td>
                                                        <t t-esc="row.partner"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="row.number"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="row.due"/>
                                                    </td>
                                                    <td class="right">
                                                        <t t-esc="row.remain"/>
                                                    </td>
                                                    <td class="right">
                                                        <t t-esc="row.age"/>
                                                    </td>
                                                    <td class="right">
                                                        <button class="ad-btn" t-on-click="openARSoon">Nhắc thu</button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- AP -->
                            <div class="ad-block">
                                <div class="ad-block__head">
                                    <div class="ad-block__title">AP sắp đến hạn/quá hạn (Top 10)</div>
                                </div>
                                <div class="ad-tablewrap">
                                    <table class="ad-table">
                                        <thead>
                                            <tr>
                                                <th>Nhà cung cấp</th>
                                                <th>Số HĐ</th>
                                                <th>Đến hạn</th>
                                                <th class="right">Còn lại</th>
                                                <th class="right">Tuổi nợ</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.tables.ap" t-as="row" t-key="row.number">
                                                <tr>
                                                    <td>
                                                        <t t-esc="row.vendor"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="row.number"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="row.due"/>
                                                    </td>
                                                    <td class="right">
                                                        <t t-esc="row.remain"/>
                                                    </td>
                                                    <td class="right">
                                                        <t t-esc="row.age"/>
                                                    </td>
                                                    <td class="right">
                                                        <button class="ad-btn" t-on-click="openAPSoon">Đề nghị chi</button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Lịch thu/chi -->
                            <div class="ad-block">
                                <div class="ad-block__head">
                                    <div class="ad-block__title">Lịch thu/chi 14 ngày</div>
                                </div>
                                <div class="ad-tablewrap">
                                    <table class="ad-table">
                                        <thead>
                                            <tr>
                                                <th>Ngày</th>
                                                <th>Chứng từ</th>
                                                <th>Đối tượng</th>
                                                <th class="right">Số tiền</th>
                                                <th class="right">Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="state.tables.schedule" t-as="row" t-key="row.doc">
                                                <tr>
                                                    <td>
                                                        <t t-esc="row.day"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="row.doc"/>
                                                    </td>
                                                    <td>
                                                        <t t-esc="row.partner"/>
                                                    </td>
                                                    <td class="right">
                                                        <t t-esc="row.amount"/>
                                                    </td>
                                                    <td class="right">
                                                        <span class="ad-badge warning">
                                                            <t t-esc="row.state"/>
                                                        </span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right sidebar -->
                    <aside class="ad-right">
                        <t t-foreach="state.sideCards" t-as="sc" t-key="sc.title">
                            <div class="ad-block">
                                <div class="ad-block__head">
                                    <div class="ad-block__title" t-esc="sc.title"/>
                                    <div class="ad-dot-menu">• • •</div>
                                </div>
                                <div class="ad-mini">
                                    <ul class="ad-list">
                                        <t t-foreach="sc.items" t-as="it" t-key="it[0]">
                                            <li>
                                                <span t-esc="it[0]"/>
                                                <b t-esc="it[1]"/>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </t>

                        <div class="ad-block">
                            <div class="ad-block__head">
                                <div class="ad-block__title">Cảnh báo</div>
                            </div>
                            <ul class="ad-alarms">
                                <li>Tiền mặt dưới ngưỡng</li>
                                <li>AR/AP &gt; 60 ngày</li>
                                <li>VAT nộp trong 7 ngày</li>
                                <li>Tồn chậm luân chuyển</li>
                            </ul>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </t>
</templates>
