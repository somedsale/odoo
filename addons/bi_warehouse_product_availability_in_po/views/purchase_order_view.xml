<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="inherit_view_purchase_order_form" model="ir.ui.view">
        <field name="name">inherit.purchase.order.form.available.qty.btn</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- chèn SAU field cuối cùng trong tree order_line -->
            <xpath expr="//field[@name='order_line']/tree/field[last()]" position="after">
                <button name="%(action_product_available_quantity_wizard)d" type="action" icon="fa-cubes" class="btn-link" help="Xem tồn khả dụng"/>
            </xpath>
        </field>
    </record>
</odoo>
