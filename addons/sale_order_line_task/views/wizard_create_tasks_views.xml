<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form -->
    <record id="view_wizard_create_tasks_form" model="ir.ui.view">
        <field name="name">wizard.create.tasks.form</field>
        <field name="model">wizard.create.tasks.from.sale</field>
        <field name="arch" type="xml">
            <form string="Create Tasks from Sale Order Lines">
                <sheet>
                    <group>
                        <!-- <field name="used_line_ids" invisible="1" /> -->
                        <field name="sale_order_id"/>
                        <field name="sale_order_line_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <!-- <field name="sale_order_line_ids" widget="many2many_checkboxes" domain="[('order_id', '=', sale_order_id), ('id', 'not in', used_line_ids)]"/> -->
                    <footer>
                        <button name="action_create_tasks" type="object" string="Tạo" class="btn-primary"/>
                        <button string="Hủy" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
