<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu cha -->

    <!-- Tree view Hợp đồng -->
    <record id="view_customer_contract_tree" model="ir.ui.view">
        <field name="name">customer.contract.tree</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="contract_number"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="amount_total" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_invoiced" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_due" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" string="Tiền tệ" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form view Hợp đồng -->
    <record id="view_customer_contract_form" model="ir.ui.view">
        <field name="name">customer.contract.form</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="contract_number"/>
                        <field name="date"/>
                        <field name="project_id"/>
                        <field name="partner_id"/>
                        <field name="amount_total"/>
                        <field name="warranty_amount"/>
                        <field name="warranty_time"/>
                    </group>

                    <notebook>
                        <page string="Hóa đơn">
                            <field name="invoice_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="invoice_number"/>
                                    <field name="project_id"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                    <field name="amount_total" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" string="Tiền tệ" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_customer_contract_search" model="ir.ui.view">
        <field name="name">customer.contract.search</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <search string="Tìm hợp đồng">
                <!-- Các trường tìm kiếm cơ bản -->
                <field name="date"/>
                <field name="partner_id"/>
                <field name="project_id"/>

                <!-- Bộ lọc nhanh -->
                <filter string="Hôm nay" name="today" domain="[('date','=', context_today())]"/>
                <filter string="Ngày ký" name="date_filter" date="date"/>
                <filter string="Ngày tạo" name="create_date_filter" date="create_date"/>
                <separator/>
                <!-- Search Panel -->
                <searchpanel>
                    <field name="partner_id" string="Khách hàng" icon="fa-user" enable_counters="1"/>
                    <field name="project_id" string="Dự án" icon="fa-folder" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action mở hợp đồng -->
    <record id="action_customer_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng</field>
        <field name="res_model">customer.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_customer_contract_search"/>
    </record>
    <record id="action_customer_only" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('customer_rank','>',0), ('parent_id','=',False)]</field>
    </record>
    <menuitem id="menu_customer_debt_root" name="Công nợ khách hàng" parent="custom_account_menu.menu_accounting_custom_root" sequence="10"/>

    <!-- Menu hợp đồng -->
    <menuitem id="menu_customer_contract" name="Hợp đồng" parent="menu_customer_debt_root" action="action_customer_contract" sequence="20"/>
    <menuitem id="menu_customer_partner" name="Khách hàng" parent="menu_customer_debt_root" action="action_customer_only" sequence="100"/>

</odoo>
