<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Đảm bảo có button box -->
    <record id="project_task_form_add_button_box" model="ir.ui.view">
      <field name="name">project.task.form.add.button.box</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2"/>
      <field name="arch" type="xml">
        <xpath expr="//form/sheet" position="inside">
          <div class="oe_button_box" name="button_box"/>
        </xpath>
      </field>
    </record>

    <!-- Smart button: Đơn mua hàng -->
    <record id="project_task_form_inherit_po_button" model="ir.ui.view">
      <field name="name">project.task.form.inherit.po.button</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2"/>
      <field name="arch" type="xml">
        <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
          <button name="action_view_task_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" groups="purchase.group_purchase_user,project.group_project_user" invisible="purchase_order_count == 0">
            <field name="purchase_order_count" widget="statinfo" string="Đơn mua hàng"/>
          </button>
        </xpath>
      </field>
    </record>
    <!-- Thêm 2 checkbox vào form Task -->
    <record id="view_task_form_add_optional_stages" model="ir.ui.view">
      <field name="name">project.task.form.add.optional.stages</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2"/>
      <field name="priority" eval="10010"/>
      <field name="arch" type="xml">
        <!-- Chèn vào group đầu tiên trong sheet (tuỳ bố cục của bạn) -->
        <xpath expr="//form/sheet/group" position="inside">
          <group string="Luồng tuỳ chọn">
            <field name="add_stage_production"/>
            <field name="add_stage_installation"/>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
