    <!-- ======================= LISTS ======================= -->
    <t t-name="ManageActivity">
        <!-- PLANNED -->
        <div id="tab-planned" class="tab-panel table_activity table_planned_activity">
            <div class="table_title">Công việc đang đợi duyệt</div>

            <t t-if="!planned_activity || planned_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-check-circle"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="planned_activity &amp;&amp; planned_activity.length">
                <div class="table-responsive">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:20%">Tên</th>
                                <th style="width:35%">Dự án</th>
                                <th style="width:15%">Ghi chú</th>
                                <th style="width:15%">Ngày hoàn thành</th>
                                <th style="width:15%"> Xem chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="planned_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.display_name"/>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.project_id">
                                        <t t-esc="line.origin.project_id[1]"/>
                                    </t>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.note">
                                        <t t-esc="line.origin.note"/>
                                    </t>
                                    <t t-if="line.origin &amp;&amp; line.origin.take_note">
                                        <t t-esc="line.origin.take_note"/>
                                    </t>
                                </td>
                                <td>
                                    <button t-att-value="line.id" t-on-click="click_origin" class="btn-pill click-origin-view">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- TODAY -->
        <div id="tab-today" class="tab-panel table_activity table_today_activity">
            <div class="table_title">Công việc hôm nay</div>

            <t t-if="!today_activity || today_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-calendar-o"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="today_activity &amp;&amp; today_activity.length">
                <div class="table-responsive">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:20%">Tên</th>
                                <th style="width:35%">Dự án</th>
                                <th style="width:15%">Ghi chú</th>
                                <th style="width:15%">Ngày hoàn thành</th>
                                <th style="width:15%"> Xem chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="today_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.display_name"/>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.project_id">
                                        <t t-esc="line.origin.project_id[1]"/>
                                    </t>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.note">
                                        <t t-esc="line.origin.note"/>
                                    </t>
                                    <t t-if="line.origin &amp;&amp; line.origin.take_note">
                                        <t t-esc="line.origin.take_note"/>
                                    </t>
                                </td>
                                <td>
                                    <button t-att-value="line.id" t-on-click="click_origin" class="btn-pill click-origin-view">Xem</button>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- OVERDUE -->
        <div id="tab-overdue" class="tab-panel table_activity table_main_view">
            <div class="table_title">Công việc quá hạn</div>

            <t t-if="!overdue_activity || overdue_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-exclamation-circle"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="overdue_activity &amp;&amp; overdue_activity.length">
                <div class="table-responsive">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:20%">Tên</th>
                                <th style="width:35%">Dự án</th>
                                <th style="width:15%">Ghi chú</th>
                                <th style="width:15%">Ngày hoàn thành</th>
                                <th style="width:15%"> Xem chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="overdue_activity" t-as="line" t-key="line.id">

                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.display_name"/>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.project_id">
                                        <t t-esc="line.origin.project_id[1]"/>
                                    </t>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.note">
                                        <t t-esc="line.origin.note"/>
                                    </t>
                                    <t t-if="line.origin &amp;&amp; line.origin.take_note">
                                        <t t-esc="line.origin.take_note"/>
                                    </t>
                                </td>
                                <td>
                                    <button t-att-value="line.id" t-on-click="click_origin" class="btn-pill click-origin-view">Xem</button>
                                </td>

                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- DONE -->
        <div id="tab-done" class="tab-panel table_activity table_main_view">
            <div class="table_title">Công việc hoàn thành</div>

            <t t-if="!done_activity || done_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-flag-checkered"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="done_activity &amp;&amp; done_activity.length">
                <div class="table-responsive-somed">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:20%">Tên</th>
                                <th style="width:35%">Dự án</th>
                                <th style="width:15%">Ghi chú</th>
                                <th style="width:15%">Ngày hoàn thành</th>
                                <th style="width:15%"> Xem chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="done_activity" t-as="line" t-key="line.id">

                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.display_name"/>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.project_id">
                                        <t t-esc="line.origin.project_id[1]"/>
                                    </t>
                                </td>

                                <td>
                                    <t t-if="line.origin &amp;&amp; line.origin.note">
                                        <t t-esc="line.origin.note"/>
                                    </t>
                                    <t t-if="line.origin &amp;&amp; line.origin.take_note">
                                        <t t-esc="line.origin.take_note"/>
                                    </t>
                                </td>



                                <td>
                                    <t t-esc="line.date_done ? (new Date(line.date_done)).toLocaleDateString('vi-VN') : ''"/>
                                </td>

                                <td>
                                    <button t-att-value="line.id" t-on-click="click_origin" class="btn-pill click-origin-view">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>
    </t>


</templates>
