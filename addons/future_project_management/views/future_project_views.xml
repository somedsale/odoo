<odoo>
    <record id="view_future_project_tree" model="ir.ui.view">
        <field name="name">future.project.tree</field>
        <field name="model">future.project</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="stage_id"/>
                <field name="expected_bid_date"/>
                <field name="expected_value"/>
                <field name="assigned_user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_future_project_form" model="ir.ui.view">
        <field name="name">future.project.form</field>
        <field name="model">future.project</field>
        <field name="arch" type="xml">
            <form string="Future Project">
                <sheet>

                    <!-- HEADER -->
                    <header>
                        <field name="stage_id" widget="statusbar" options="{'clickable': 1}" />
                    </header>

                    <!-- TITLE -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên dự án dự kiến"/>
                        </h1>
                    </div>


                    <!-- MAIN CONTENT -->
                    <group string="Thông tin dự án" col="2" class="mt16">

                        <!-- LEFT -->
                        <group>
                            <field name="code"/>
                            <field name="address"/>
                            <field name="location"/>
                            <field name="customer_id"/>
                            <field name="priority"/>
                        </group>

                        <!-- RIGHT -->
                        <group>
                            <field name="expected_value" widget="monetary"/>
                            <field name="probability" widget="percentage" readonly="1"/>
                            <field name="expected_bid_date"/>
                            <field name="expected_start_date"/>
                            <field name="expected_end_date"/>
                        </group>

                    </group>

                    <!-- NOTEBOOK -->
                    <notebook class="mt16">

                        <page string="Thông tin liên hệ">
                            <group col="2">
                                <field name="contact_person"/>
                                <field name="contact_phone"/>
                                <field name="contact_email"/>
                            </group>
                        </page>

                        <page string="Ghi chú">
                            <field name="description" placeholder="Ghi chú, nguồn thông tin, đối thủ, tình trạng tiếp cận…" />
                        </page>

                    </notebook>

                </sheet>

                <!-- CHATTER -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

</odoo>
