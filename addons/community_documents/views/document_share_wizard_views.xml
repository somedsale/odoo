<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_document_share_wizard_form" model="ir.ui.view">
    <field name="name">document.share.wizard.form</field>
    <field name="model">document.share.wizard</field>
    <field name="arch" type="xml">
      <form string="Share">
        <sheet>
          <group>
            <field name="share_type" readonly="1"/>
            <field name="folder_id" invisible="share_type != 'folder'" readonly="1"/>
            <field name="document_id" invisible="share_type != 'document'" readonly="1"/>

            <field name="allow_download"/>
            <field name="expiration_date"/>
          </group>

          <group string="Link">
            <field name="share_url" readonly="1" placeholder="Click Generate to get link"/>
          </group>
        </sheet>
        <footer>
          <button string="Generate" type="object" name="action_generate" class="btn-primary"/>
          <button string="Close" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_document_share_wizard" model="ir.actions.act_window">
    <field name="name">Share</field>
    <field name="res_model">document.share.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_document_share_wizard_form"/>
    <field name="target">new</field>
  </record>
</odoo>
