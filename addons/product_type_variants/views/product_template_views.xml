<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_product_template_form_inherit_somed_product_type" model="ir.ui.view">
      <field name="name">product.template.form.inherit.somed.product.type</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_only_form_view"/>
      <field name="arch" type="xml">

        <!-- Chèn sau mã nội bộ (default_code) -->
        <xpath expr="//field[@name='default_code']" position="after">
          <field name="product_type_id" options="{'no_create_edit': False}"/>
          <field name="attribute_set_id" options="{'no_create_edit': False}"/>
        </xpath>

      </field>
    </record>

  </data>
</odoo>
