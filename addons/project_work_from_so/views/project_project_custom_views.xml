<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===== TREE PROJECT (CUSTOM) ===== -->
    <record id="view_project_project_tree_work_custom" model="ir.ui.view">
        <field name="name">project.project.tree.work.custom</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <tree string="Dự án" create="1" edit="1">
                <field name="partner_id"/>
                <field name="name" string="Tên dự án"/>
                <field name="num_contract" string="Số hợp đồng"/>
                <field name="sales_category_ids" widget="many2many_tags" options="{'color_field': 'color'}" string="Hạng mục"/>
                <field name="value_contract_tax" sum="Tổng" string="Giá trị hợp đồng"/>
                <field name="signature_year" string="Năm ký hợp đồng"/>
                <field name="date_start"/>
                <field name="date"/>
                <field name="stage_id"/>
                <field name="currency_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ===== FORM PROJECT (CUSTOM) ===== -->
    <record id="view_project_project_form_work_custom" model="ir.ui.view">
        <field name="name">project.project.form.work.custom</field>
        <field name="model">project.project</field>
        <!-- ✅ thêm -->
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form string="Dự án" create="1" edit="1">
                <sheet>

                    <!-- tránh lỗi validate domain partner_id theo company_id -->
                    <group invisible="1">
                        <field name="company_id"/>
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks_custom" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count_custom" widget="statinfo" string="Nhiệm vụ"/>
                        </button>
                        <button name="action_view_work_items" type="object" class="oe_stat_button" icon="fa-list-ul">
                            <field name="work_item_count" widget="statinfo" string="Hạng mục công việc"/>
                        </button>
                        <button name="action_view_cost_estimates" type="object" class="oe_stat_button" icon="fa-calculator">
                            <field name="cost_estimate_count" widget="statinfo" string="Dự toán chi phí"/>
                        </button>
                        <button name="action_view_project_expense_custom" type="object" class="oe_stat_button" icon="fa-usd">
                            <field name="project_expense_custom_count" widget="statinfo" string="Chi phí dự án"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tên dự án..."/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"/>
                            <!-- <field name="user_id"/> -->
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date"/>
                        </group>

                        <group string="Thông tin hợp đồng">
                            <field name="contract_id" options="{'no_create': True}"/>
                            <field name="signature_date" readonly="1"/>
                            <field name="location"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="value_contract_tax" readonly="1"/>
                            <field name="sales_category_ids" widget="many2many_tags" readonly="1"/>
                            <field name="description"/>
                        </group>
                        <group string="Tiến độ dự án">
                            <field name="stage_id"/>
                            <field name="value_contract_tax" readonly="1"/>
                            <field name="value_completed" readonly="1"/>
                            <field name="value_remaining" readonly="1"/>
                            <field name="progress_percent" readonly="1"/>
                        </group>

                        <group string="Tài liệu" name="attachment_group">
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <!-- <page string="Hạng mục công việc">
                            <div class="mb-2">
                                <button name="action_sync_work_items_from_so" type="object" string="Lấy hạng mục từ Đơn bán" class="btn btn-primary"/>
                            </div>

