<odoo>
    <record id="view_account_payment_request_form_inherit_loan" model="ir.ui.view">
        <field name="name">account.payment.request.form.inherit.loan</field>
        <field name="model">account.payment.request</field>
        <field name="inherit_id" ref="custom_account_payment_request.view_account_payment_request_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='receive_person']" position="after">
                <field name="is_office_loan_allowed" readonly="1" invisible="1"/>
                <field name="loan_id" domain="[('lender_id', '=', receive_person)]" options="{'no_create': True}" invisible="not (cost_classification == 'loan_interest' or is_office_loan_allowed)"/>
                <field name="loan_payment_kind" widget="selection" readonly="state != 'draft'" invisible="not (cost_classification == 'loan_interest' or is_office_loan_allowed)"/>
                <field name="date_from" readonly="state != 'draft'" invisible="not (loan_payment_kind == 'interest' and (cost_classification == 'loan_interest' or is_office_loan_allowed))"/>
                <field name="date_to" readonly="state != 'draft'" invisible="not (loan_payment_kind == 'interest' and (cost_classification == 'loan_interest' or is_office_loan_allowed))"/>
                <field name="interest_days" readonly="1" invisible="not (loan_payment_kind == 'interest' and (cost_classification == 'loan_interest' or is_office_loan_allowed))"/>
                <field name="interest_expected" readonly="state != 'draft'" invisible="not (loan_payment_kind == 'interest' and (cost_classification == 'loan_interest' or is_office_loan_allowed))"/>
                <field name="interest_shortfall" readonly="1" invisible="not (loan_payment_kind == 'interest' and (cost_classification == 'loan_interest' or is_office_loan_allowed))"/>
            </xpath>
        </field>
    </record>
</odoo>
