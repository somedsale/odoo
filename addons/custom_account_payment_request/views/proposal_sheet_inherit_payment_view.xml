<odoo>
    <record id="view_proposal_sheet_form_inherit_payment" model="ir.ui.view">
        <field name="name">proposal.sheet.form.inherit.payment</field>
        <field name="model">proposal.sheet</field>
        <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_form"/>
        <field name="arch" type="xml">
            <!-- Chèn sau thẻ notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Phiếu Chi" groups="account.group_account_user,account.group_account_manager" context="{'default_proposal_sheet_id': active_id}">
                    <field name="payment_ids" context="{'default_total': amount_total, 'default_currency_id': currency_id, 'default_proposal_sheet_id': active_id}">
                        <tree>
                            <field name="name" />
                            <field name="create_date" string="Ngày tạo chi"/>
                            <field name="date_payment" string="Ngày chi"/>
                            <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="note"/>
                            <field name="state" string="Trạng thái" widget="badge" decoration-muted="state == 'draft'" decoration-primary="state == 'confirmed'" decoration-success="state == 'done'"/>
                        </tree>

                    </field>
                </page>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name=&apos;amount_total_taxes&apos;]" position="after">
                <field name="payment_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>
    <record id="view_proposal_sheet_tree_inherit_payment" model="ir.ui.view">
        <field name="name">proposal.sheet.tree.inherit.payment</field>
        <field name="model">proposal.sheet</field>
        <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name=&apos;amount_total_taxes&apos;]" position="after">
                <field name="payment_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="1"/>
            </xpath>
        </field>
    </record>
</odoo>
