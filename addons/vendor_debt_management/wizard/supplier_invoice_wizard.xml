<odoo>
    <record id="view_supplier_invoice_report_wizard" model="ir.ui.view">
        <field name="name">supplier.invoice.wizard.form</field>
        <field name="model">supplier.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo Hóa đơn NCC">
                <group>
                    <field name="filter_type"/>
                </group>
                <group>                    <!-- Theo ngày -->
                    <field name="date_from" options="{'warn_future': true}" invisible="filter_type != 'day'"/>
                    <field name="date_to" options="{'warn_future': true}" invisible="filter_type != 'day'"/>
                    <!-- Theo tháng -->
                    <field name="month" invisible="filter_type != 'month'"/>
                    <!-- Theo quý -->
                    <field name="year" widget="yearpicker" placeholder="Chọn năm..." invisible="filter_type != 'quarter'"/>
                    <field name="quarter" invisible="filter_type != 'quarter'"/>
                    <!-- Theo năm -->
                    <field name="year" widget="yearpicker" placeholder="Chọn năm..." invisible="filter_type != 'year'"/>
                </group>
                <footer>
                    <button name="action_print_report" string="In báo cáo" type="object" class="btn-primary"/>
                    <button name="action_view_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_supplier_invoice_report_wizard" model="ir.actions.act_window">
        <field name="name">Báo cáo Hóa đơn NCC</field>
        <field name="res_model">supplier.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu mở wizard -->
    <menuitem id="menu_supplier_invoice_report_wizard" name="Báo cáo Hóa đơn NCC" parent="menu_supplier_invoice_root" action="action_supplier_invoice_report_wizard" sequence="5"/>
</odoo>
