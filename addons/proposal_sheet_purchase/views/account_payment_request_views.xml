<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_request_form_inherit_purchase_button" model="ir.ui.view">
        <field name="name">account.payment.request.form.inherit.purchase.button</field>
        <field name="model">account.payment.request</field>
        <field name="inherit_id" ref="custom_account_payment_request.view_account_payment_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="purchase_order_count" invisible="1"/>
                <field name="purchase_id" invisible="1"/>
            </xpath>

            <xpath expr="//sheet/div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box"/>
            </xpath>

            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_view_purchase_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="purchase_order_count == 0">
                    <field name="purchase_order_count" widget="statinfo" string="Đơn hàng"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
