<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_multi_mrp_order_tree" model="ir.ui.view">
        <field name="name">multi.mrp.order.tree</field>
        <field name="model">multi.mrp.order</field>
        <field name="arch" type="xml">
            <tree string="Lệnh sản xuất nhiều thành phẩm">
                <field name="name"/>
                <field name="date"/>
                <field name="origin"/>
                <!-- <field name="sale_id"/> -->
                <field name="contract_id"/>
                <field name="production_count"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-primary="state == 'confirmed'" decoration-success="state == 'done'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_multi_mrp_order_form" model="ir.ui.view">
        <field name="name">multi.mrp.order.form</field>
        <field name="model">multi.mrp.order</field>
        <field name="arch" type="xml">
            <form string="Lệnh sản xuất nhiều thành phẩm">
                <header>

                    <!-- Trạng thái -->
                    <button name="action_confirm" type="object" string="Xác nhận" class="btn-primary" invisible="state != 'draft'"/>

                    <button name="action_done" type="object" string="Hoàn tất" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_generate_additional_raw_picking" type="object" string="Tạo bổ sung PXK" class="btn-secondary" invisible="state not in ['confirmed', 'done']"/>

                    <button name="action_generate_additional_finished_picking" type="object" string="Tạo bổ sung PNK" class="btn-secondary" invisible="state not in ['confirmed', 'done']"/>
                    <button name="action_cancel" type="object" string="Hủy" class="btn-secondary" invisible="state not in ['draft', 'confirmed']"/>

                    <button name="action_reset_to_draft" type="object" string="Chuyển về nháp" class="btn-secondary" invisible="state != 'cancel'"/>
                    <!-- Sản xuất tất cả MO (chỉ đổi state, không động tới kho) -->
                    <!-- <button name="action_produce_all" type="object" string="Sản xuất tất cả" class="btn-primary" invisible="state != 'confirmed'"/> -->
                    <button name="action_load_finished_from_sale" type="object" string="Lấy thành phẩm từ đơn bán" class="btn-secondary" invisible="not contract_id or state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancel"/>
                    <field name="raw_picking_count" invisible="1"/>
                    <field name="finished_picking_count" invisible="1"/>
                </header>

                <sheet>
                    <field name="sale_id" invisible="1"/>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions" type="object" class="oe_stat_button" invisible="production_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Lệnh sản xuất</span>
                                <span class="o_stat_value">
                                    <field name="production_count"/>
                                </span>
                            </div>
                        </button>

                        <button name="action_view_all_raw_pickings" type="object" class="oe_stat_button" invisible="raw_picking_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Tất cả PXK NVL</span>
                                <span class="o_stat_value">
                                    <field name="raw_picking_count"/>
                                </span>
                            </div>
                        </button>

                        <button name="action_view_all_finished_pickings" type="object" class="oe_stat_button" invisible="finished_picking_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Tất cả PNK TP</span>
                                <span class="o_stat_value">
                                    <field name="finished_picking_count"/>
                                </span>
                            </div>
                        </button>
                    </div>

                    <!-- Các field dùng trong invisible -->
                    <field name="production_count" invisible="1"/>
                    <field name="picking_raw_id" invisible="1"/>
                    <field name="picking_finished_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Số lệnh"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <!-- <field name="origin"/> -->
                            <!-- <field name="sale_id" options="{'no_create_edit': True}"/> -->
                            <field name="contract_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Thiết lập kho">
                        <field name="picking_type_out_id"/>
                        <field name="picking_type_in_id"/>
                        <field name="location_src_id"/>
                        <!-- <field name="location_production_id"/> -->
                        <field name="location_dest_id"/>
                    </group>

                    <notebook>
                        <page string="Thành phẩm">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sale_id" column_invisible="1"/>
                                    <field name="allowed_product_ids" column_invisible="1"/>
                                    <field name="product_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="sale_line_id"/>
                                    <!-- field dùng trong domain của bom_id -->
                                    <field name="product_tmpl_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1"/>

                                    <field name="bom_id" context="{
                                            'default_product_tmpl_id': product_tmpl_id,
                                            'default_product_id': product_id,
                                            'default_company_id': company_id,
                                            'default_product_qty': product_qty,
                                            'default_type': 'normal'
                                        }"/>
                                    <!-- <field name="sale_line_id"/> -->
                                    <!-- <field name="mrp_production_id" readonly="1"/> -->
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_multi_mrp_order" model="ir.actions.act_window">
        <field name="name">Lệnh sản xuất nhiều thành phẩm</field>
        <field name="res_model">multi.mrp.order</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo lệnh sản xuất tổng để gom nhiều thành phẩm, sinh ra nhiều
                Manufacturing Orders (mrp.production) và phiếu xuất/nhập kho tương ứng.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_multi_mrp_order_root" name="Lệnh sản xuất" parent="custom_account_menu.menu_accounting_stock" action="action_multi_mrp_order" sequence="20"/>
</odoo>
