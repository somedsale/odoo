<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_future_project_report_wizard" model="ir.ui.view">
        <field name="name">future.project.report.wizard.form</field>
        <field name="model">future.project.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo dự án tiềm năng">
                <group>
                    <field name="period_type"/>
                    <field name="year"/>
                    <field name="month" invisible="period_type != 'month'"/>
                    <field name="quarter" invisible="period_type != 'quarter'"/>
                </group>

                <footer>
                    <button string="Xem HTML"
                            type="object"
                            name="action_view_html"
                            class="btn-secondary"/>
                    <button string="In PDF"
                            type="object"
                            name="action_print_pdf"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
