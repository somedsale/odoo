<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form xem dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_form_view" model="ir.ui.view">
        <field name="name">move.lines.in.form</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <form string="Dòng chứng từ kho" edit="0" create="0" duplicate="0" delete="0">
                <sheet>
                    <field name="move_line_image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <h2>
                                <field name="picking_id"/>
                            </h2>
                            <br/>
                            <field name="create_date" string="Ngày tạo"/>
                            <field name="scheduled_date" string="Ngày đã lên lịch"/>
                            <field name="date_done" string="Ngày hoàn tất"/>
                            <field name="origin" string="Chứng từ gốc"/>
                            <field name="picking_type_id" string="Loại hoạt động"/>
                            <field name="code" string="Mã hoạt động"/>
                            <field name="date_deadline" decoration-danger="has_deadline_issue == True" string="Hạn chót" invisible="has_deadline_issue == False"/>
                        </group>
                        <group class="mt-5">
                            <field name="product_id" string="Sản phẩm"/>
                            <field name="quantity" string="Nhu cầu"/>
                            <field name="reserved_available" string="Đã giữ chỗ"/>

                            <field name="location_id" string="Vị trí nguồn"/>
                            <field name="location_dest_id" string="Vị trí đích"/>
                            <field name="state" string="Trạng thái" decoration-success="state == 'assigned' or state == 'done'  or state == 'confirmed'" decoration-info="state == 'draft'" decoration-warning="state == 'waiting' or state == 'partially_available'" widget="badge" optional="show"/>
                            <field name="has_deadline_issue" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_tree_view" model="ir.ui.view">
        <field name="name">move.lines.in.tree</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <tree string="Dòng chứng từ kho" create="false" edit="true" delete="false">
                <field name="picking_id" string="Phiếu dịch chuyển"/>
                <field name="product_id" string="Sản phẩm"/>
                <field name="move_line_image" widget="image" class="m-0" optional="show" options="{'zoom': true}"/>
                <field name="scheduled_date" string="Ngày đã lên lịch"/>
                <field name="date_done" string="Ngày hoàn tất" optional="show"/>
                <field name="origin" string="Chứng từ gốc" optional="hide"/>
                <field name="picking_type_id" string="Loại hoạt động"/>
                <field name="date_deadline" decoration-danger="has_deadline_issue == True" string="Hạn chót" optional="hide" invisible="has_deadline_issue == False"/>
                <field name="quantity" string="Nhu cầu ban đầu"/>
                <field name="reserved_available" string="Đã giữ chỗ" optional="show"/>
                <field name="location_id" string="Vị trí nguồn"/>
                <field name="location_dest_id" string="Vị trí đích" optional="show"/>
                <field name="state" string="Trạng thái" widget="badge" optional="show" decoration-danger="state=='cancel'" decoration-info="state== 'assigned'" decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state not in ('draft','cancel','done','assigned')"/>
                <field name="has_deadline_issue" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Kanban dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_kanban_view" model="ir.ui.view">
        <field name="name">move.lines.in.kanbn</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="id"/>
                <field name="picking_type_id"/>
                <field name="move_line_image" class="oe_avatar"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click ">
                            <div class="o_kanban_image me-1">
                                <field name="move_line_image" widget="image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="picking_id"/>
                                        </strong>
                                    </div>
                                </div>
                                <div name="product_lst_price" class="mt-1">
                                    Ngày đã lên lịch:
                                    <field name="scheduled_date"/>
                                </div>
                                Ngày hoàn tất:
                                <field name="date_done"/>
                                <div>
                                    Nhu cầu ban đầu:
                                    <field name="quantity"/>
                                </div>
                                <div>
                                    Trạng thái:
                                    <field name="state" widget="badge" optional="show" class="float-end" decoration-danger="state=='cancel'" decoration-info="state== 'assigned'" decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state not in ('draft','cancel','done','assigned')"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_view_pivot" model="ir.ui.view">
        <field name="name">move.lines.in.pivot</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích tổng hợp" sample="1">
                <field name="state" type="row" string="Trạng thái"/>
                <field name="picking_id" type="row" string="Phiếu dịch chuyển"/>
                <field name="product_id" type="row" string="Sản phẩm"/>
                <field name="quantity" type="measure" string="Nhu cầu ban đầu"/>
            </pivot>
        </field>
    </record>

    <!-- Biểu đồ dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_view_graph_view" model="ir.ui.view">
        <field name="name">move.lines.in.graph.view</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <graph string="Phân tích biểu đồ chứng từ kho" sample="1">
                <field name="product_id" class="font-weight-bold" string="Sản phẩm"/>
                <field name="quantity" string="Nhu cầu ban đầu"/>
            </graph>
        </field>
    </record>

    <!-- Lịch dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_calender_view" model="ir.ui.view">
        <field name="name">move.lines.in.calendar</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <calendar string="Chứng từ kho" mode="month" date_start="create_date" color="product_id" hide_time="true" event_limit="5">
                <field name="product_id" string="Sản phẩm"/>
                <field name="picking_id" string="Phiếu dịch chuyển"/>
                <field name="scheduled_date" string="Ngày đã lên lịch"/>
            </calendar>
        </field>
    </record>

    <!-- Search dòng chứng từ kho (nhập) -->
    <record id="view_stock_move_line_in_search_filter" model="ir.ui.view">
        <field name="name">stock.move.line.in.search</field>
        <field name="model">stock.move.line</field>
        <field name="arch" type="xml">
            <search string="Tìm dòng chứng từ kho">
                <field name="picking_id" string="Phiếu dịch chuyển"/>
                <field name="product_id" string="Sản phẩm"/>
                <field name="product_category_name" string="Danh mục"/>
                <field name="location_id" string="Vị trí" filter_domain="['|',('location_id', 'ilike', self),('location_dest_id', 'ilike', self)]" groups="stock.group_stock_multi_locations"/>
                <field name="reference" string="Tham chiếu"/>
                <field name="lot_id" string="Lô/Số sê-ri" groups="stock.group_production_lot"/>
                <field name="package_id" string="Kiện nguồn" groups="stock.group_tracking_lot"/>
                <field name="result_package_id" string="Kiện đích" groups="stock.group_tracking_lot"/>
                <field name="owner_id" string="Chủ sở hữu" groups="stock.group_tracking_owner"/>
                <separator/>

                <filter string="Cần làm" name="todo" domain="[('state', 'not in', ['done', 'draft', 'cancel'])]"/>
                <filter string="Sẵn sàng" name="ready" domain="[('state', '=', 'assigned')]"/>
                <filter string="Hoàn tất" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="date" string="Ngày" date="date" default_period="this_month"/>
                <filter string="30 ngày gần nhất" name="filter_last_30_days" domain="[('date','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="3 tháng gần nhất" name="filter_last_3_months" domain="[('date','&gt;=', (context_today() - relativedelta(months=3)).strftime('%Y-%m-%d'))]"/>
                <filter string="12 tháng gần nhất" name="filter_last_12_months" domain="[('date','&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Sản phẩm" name="groupby_product_id" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Danh mục" name="by_category" domain="[]" context="{'group_by': 'product_category_name'}"/>
                    <filter string="Phiếu dịch chuyển" name="by_picking" domain="[]" context="{'group_by': 'picking_id'}"/>
                    <filter name="origin" string="Chứng từ gốc" domain="[]" context="{'group_by': 'origin'}"/>
                    <filter name="picking_type_id" string="Loại hoạt động" domain="[]" context="{'group_by': 'picking_type_id'}"/>
                    <filter string="Vị trí nguồn" name="by_location" domain="[]" context="{'group_by': 'location_id'}"/>
                    <filter string="Vị trí đích" name="by_dest_location" domain="[]" context="{'group_by': 'location_dest_id'}"/>
                    <filter string="Trạng thái" name="by_state" domain="[]" context="{'group_by': 'state'}"/>
                    <separator/>
                    <filter string="Ngày tạo" name="by_date" domain="[]" context="{'group_by': 'date'}"/>
                    <filter string="Ngày đã lên lịch" name="by_schedule_date" domain="[]" context="{'group_by': 'scheduled_date'}"/>
                    <separator/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action dòng chứng từ kho (nhập) -->
    <record id="stock_move_in_views_action" model="ir.actions.act_window">
        <field name="name">Dòng chứng từ nhập kho</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="domain">[
            ('picking_id.picking_type_id.code', '=', 'incoming')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                            (0, 0, {'view_mode': 'tree', 'view_id': ref('stock_move_in_tree_view')}),
                            (0, 0, {'view_mode': 'kanban', 'view_id': ref('stock_move_in_kanban_view')}),
                            (0, 0, {'view_mode': 'pivot', 'view_id': ref('stock_move_in_view_pivot')}),
                            (0, 0, {'view_mode': 'graph', 'view_id': ref('stock_move_in_view_graph_view')}),
                            (0, 0, {'view_mode': 'calendar', 'view_id': ref('stock_move_in_calender_view')})
                            ]"/>
        <field name="search_view_id" ref="view_stock_move_line_in_search_filter"/>
    </record>

