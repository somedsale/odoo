<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Rule cho phép user thường chỉ thấy employee record của chính họ -->
        <record id="rule_employee_self" model="ir.rule">
            <field name="name">Employee: Self Access</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
        <record id="rule_res_users_self_signature" model="ir.rule">
            <field name="name">User: Self Signature</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('id', '=', user.id)]</field>
        </record>
        <record id="access_res_users_self" model="ir.model.access">
            <field name="name">res.users.self.access</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>