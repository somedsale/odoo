<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Đăng ký report -->
    <!-- <report id="report_pending_approval_action" model="report.pending.approval" string="Khoản chi chưa được duyệt" report_type="qweb-html" name="expense_proposal.report_pending_approval" file="expense_proposal.report_pending_approval" print_report_name="'Các khoản chi chưa duyệt Report'" /> -->

    <record id="custom_sale_report_a4_portrait" model="report.paperformat">
        <field name="name">Custom Sale Report A4 Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>        <!-- Điều chỉnh từ 40mm xuống 30mm -->
        <field name="margin_bottom">30</field>        <!-- Tăng từ 23mm lên 30mm -->
        <field name="margin_left">10</field>        <!-- Tăng từ 7mm lên 10mm -->
        <field name="margin_right">10</field>        <!-- Tăng từ 7mm lên 10mm -->
        <field name="header_spacing">25</field>        <!-- Giảm từ 35mm xuống 25mm -->
        <field name="dpi">90</field>
    </record>
    <!-- Template QWeb -->
    <template id="report_pending_approval_layout">
        <t t-call="web.html_container">
            <t t-set="o" t-value="o or list"/>
            <div class="header" style="display: flex; justify-content: space-between; font-family: Times New Roman;">
                <table style="width:100%; border-collapse: collapse; border: 1px solid #fff;">
                    <tr>
                        <!-- Cột logo bên trái -->
                        <td style="text-align: left; vertical-align: middle; border-collapse: collapse; border: 1px solid #fff; width: 50%;">
                            <img t-att-src="'/web/image/res.company/%s/logo' % res_company.id" alt="Company Logo" style="max-width: 160px;"/>
                        </td>

                        <!-- Cột thông tin công ty bên phải -->
                        <td style="text-align: right; vertical-align: middle; border-collapse: collapse; border: 1px solid #fff; font-size: 11px; text-transform: capitalize; width: 50%;">
                            <span t-esc="res_company.name" style="text-transform: uppercase;"/>
                            <br/>
                MST: <span t-esc="res_company.partner_id.vat"/>
                        <br/>
                Địa chỉ: <span t-esc="res_company.partner_id.street"/>
                    <br/>
                SĐT: <span t-esc="res_company.phone_accounting"/>
                <br/>
                Email: <span style="text-transform: lowercase;" t-esc="res_company.account_email"/>
            </td>
        </tr>
    </table>


</div>
<div class="article" style="font-family: Times New Roman; font-size: 11pt; line-height: 1.5;">
    <t t-raw="0"/>
    <!-- Nội dung chính của báo cáo -->
</div>
<div class="footer" style="text-align: center; padding: 5mm; font-size: 10pt;">
    <p>
        <span class="page"/>
    </p>
</div>
</t>
</template><!-- Template for Sale Contract Report -->
<template id="report_pending_approval">
<t t-call="expense_proposal.report_pending_approval_layout">
<style>
                .page {
                    font-family: "Times New Roman";
                    font-size: 12pt;
                    color: #333;
                }
                .styled-table {
                    border-collapse: collapse;
                    margin: 0 auto;
                    font-size: 12pt;
                    min-width: 100%;
                    border: 1px solid #000;
                    vertical-align: middle;
                }
                .styled-table thead tr {
                    background-color: #C6E0B4;
                    font-weight: bold;
                    color: #000;
                    text-align: center;
                }
                .table-item{
                    text-transform: uppercase;
                    background-color: #E2EFDA;
                    font-weight: bold;
                    color: #FF0000;
                }
                .styled-table th,
                .styled-table td {
                    padding: 8px 12px;
                    border: 1px solid #000;
                }
                                                                <!-- .styled-table tbody tr:nth-of-type(even) {
                    background-color: #f3f6fb;
                } -->
                .styled-table tbody tr:hover {
                    background-color: #D9EAD3;
                }
                .text-center { text-align: center; }
                .text-right { text-align: right; }
</style>
<div class="page">



    <h2 style="text-align:center; margin-bottom: 20px; font-size: 24pt; text-transform: uppercase;">DỰ KIẾN THANH TOÁN</h2>
    <!-- <div style="text-align: center; margin-bottom: 20px; text-transform: capitalize;">
        Ngày: <t t-esc="today.strftime('%d/%m/%Y')"/>
    </div> -->
    <table class="styled-table">
        <thead>
            <tr>
                <th class="text-center" style="width: 5%;">STT</th>
                <th class="text-center" style="width: 20%;">Đối tượng/ NCC</th>
                <th class="text-center" style="width: 27%;">Nội dung</th>
                <th class="text-center" style="width: 13%;">Tổng giá trị</th>
                <th class="text-center" style="width: 25%;">Dự án</th>
                <th class="text-center" style="width: 10%;">Ghi chú</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="lists" t-as="grp">

                <!-- NHÓM: EMPLOYEE -->
                <t t-if="grp.get('total_employee', 0) > 0">
                    <tr class="table-item">
                        <td colspan="3" class="text-center">KHOẢN VAY NỘI BỘ NHÂN VIÊN</td>
                        <td class="text-right">
                            <t t-esc="grp.get('total_employee')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <t t-foreach="grp.get('line_employee', [])" t-as="line">
                        <tr>
                            <td class="text-center" t-esc="line['stt']"/>
                            <td t-esc="line['object']"/>
                            <td t-esc="line['name']"/>
                            <td class="text-right">
                                <t t-esc="line['amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td t-esc="line['project']"/>
                            <td t-esc="line['note']"/>
                        </tr>
                    </t>
                </t>

                <!-- NHÓM: OFFICE -->
                <t t-if="grp.get('total_office', 0) > 0">
                    <tr class="table-item">
                        <td colspan="3" class="text-center">CHI PHÍ TẠI CÔNG TY</td>
                        <td class="text-right">
                            <t t-esc="grp.get('total_office')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <t t-foreach="grp.get('line_office', [])" t-as="line">
                        <tr>
                            <td class="text-center" t-esc="line['stt']"/>
                            <td t-esc="line['object']"/>
                            <td t-esc="line['name']"/>
                            <td class="text-right">
                                <t t-esc="line['amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td t-esc="line['project']"/>
                            <td t-esc="line['note']"/>
                        </tr>
                    </t>
                </t>

                <!-- NHÓM: PROJECT -->
                <t t-if="grp.get('total_project', 0) > 0">
                    <tr class="table-item">
                        <td colspan="3" class="text-center">CHI PHÍ CÁC CÔNG TRÌNH</td>
                        <td class="text-right">
                            <t t-esc="grp.get('total_project')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <t t-foreach="grp.get('line_project', [])" t-as="line">
                        <tr>
                            <td class="text-center" t-esc="line['stt']"/>
                            <td t-esc="line['object']"/>
                            <td t-esc="line['name']"/>
                            <td class="text-right">
                                <t t-esc="line['amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td t-esc="line['project']"/>
                            <td t-esc="line['note']"/>
                        </tr>
                    </t>
                </t>

                <!-- NHÓM: ESTIMATED COST -->
                <t t-if="grp.get('total_estimated', 0) > 0">
                    <tr class="table-item">
                        <td colspan="3" class="text-center">CHI PHÍ DỰ TOÁN</td>
                        <td class="text-right">
                            <t t-esc="grp.get('total_estimated')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <t t-foreach="grp.get('line_estimated', [])" t-as="line">
                        <tr>
                            <td class="text-center" t-esc="line['stt']"/>
                            <td t-esc="line['object']"/>
                            <td t-esc="line['name']"/>
                            <td class="text-right">
                                <t t-esc="line['amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td t-esc="line['project']"/>
                            <td t-esc="line['note']"/>
                        </tr>
                    </t>
                </t>

                <!-- NHÓM: FIXED COST -->
                <t t-if="grp.get('total_fixed', 0) > 0">
                    <tr class="table-item">
                        <td colspan="3" class="text-center">CHI PHÍ CỐ ĐỊNH</td>
                        <td class="text-right">
                            <t t-esc="grp.get('total_fixed')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <t t-foreach="grp.get('line_fixed', [])" t-as="line">
                        <tr>
                            <td class="text-center" t-esc="line['stt']"/>
                            <td t-esc="line['object']"/>
                            <td t-esc="line['name']"/>
                            <td class="text-right">
                                <t t-esc="line['amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td t-esc="line['project']"/>
                            <td t-esc="line['note']"/>
                        </tr>
                    </t>
                </t>

                <!-- NHÓM: IRREGULAR EXPENSES -->
                <t t-if="grp.get('total_irregular', 0) > 0">
                    <tr class="table-item">
                        <td colspan="3" class="text-center">CHI PHÍ KHÔNG THƯỜNG XUYÊN</td>
                        <td class="text-right">
                            <t t-esc="grp.get('total_irregular')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    <t t-foreach="grp.get('line_irregular', [])" t-as="line">
                        <tr>
                            <td class="text-center" t-esc="line['stt']"/>
                            <td t-esc="line['object']"/>
                            <td t-esc="line['name']"/>
                            <td class="text-right">
                                <t t-esc="line['amount']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                            </td>
                            <td t-esc="line['project']"/>
                            <td t-esc="line['note']"/>
                        </tr>
                    </t>
                </t>

            </t>

            <!-- TỔNG CỘNG -->
            <tr>
                <td colspan="3" style="text-align:center;font-weight:bold;">TỔNG CỘNG</td>
                <td class="text-right" style="font-weight:bold;">
                    <t t-esc="total" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                </td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>
</t>
</template>
<!-- Hai action URL: HTML & PDF -->
<record id="action_report_pending_approval_html_url" model="ir.actions.act_url">
<field name="name">Các khoản chi chưa duyệt (HTML)</field>
<field name="type">ir.actions.act_url</field>
<!-- docids = 0 (bị bỏ qua), AbstractModel sẽ lấy search([]) -->
<field name="url">/report/html/expense_proposal.report_pending_approval/0</field>
<field name="target">new</field>
</record>

<record id="action_report_pending_approval_pdf_url" model="ir.actions.act_url">
<field name="name">Các khoản chi chưa duyệt (PDF)</field>
<field name="type">ir.actions.act_url</field>
<field name="url">/report/pdf/expense_proposal.report_pending_approval/0</field>
<field name="target">new</field>
</record>
<record id="action_report_pending_approval" model="ir.actions.report">
<field name="name">Các khoản chi chưa duyệt Report</field>
<field name="model">expense.proposal</field>
<field name="report_type">qweb-html</field>
<field name="report_name">expense_proposal.report_pending_approval</field>
<field name="report_file">expense_proposal.report_pending_approval</field>
<field name="print_report_name">'Các khoản chi chưa duyệt Report'</field>
</record>
<record id="action_report_pending_approval_pdf" model="ir.actions.report">
<field name="name">Các khoản chi chưa duyệt Report (PDF)</field>
<field name="model">expense.proposal</field>
<field name="report_type">qweb-pdf</field>
<field name="report_name">expense_proposal.report_pending_approval</field>
<field name="report_file">expense_proposal.report_pending_approval</field>
<field name="print_report_name">'Các khoản chi chưa duyệt Report'</field>
<field name="paperformat_id" ref="custom_sale_report_a4_portrait"/>
</record>
<!-- Menu -->
<menuitem id="menu_expense_proposal_root" name="Đề xuất chi" parent="custom_account_menu.menu_accounting_reporting" sequence="1"/>
<menuitem id="menu_report_pending_approval_root" name="Các khoản chưa duyệt" parent="menu_expense_proposal_root" action="expense_proposal.action_report_pending_approval"/>

</odoo>
