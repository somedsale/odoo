<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_simple_custom" model="ir.ui.view">
        <field name="name">res.users.form.simple.custom</field>
        <field name="model">res.users</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Cài đặt cá nhân" create="false" delete="false">
                <sheet>
                    <div class="oe_title" style="margin-bottom:16px;">
                        <h1>
                            <field name="name" readonly="0"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tùy chọn">
                            <!-- <field name="notification_type"/> -->
                            <!-- <field name="odoobot_state"/> -->
                            <field name="email"/>
                            <field name="signature" widget="html"/>
                        </group>
                        <group string="Ngôn ngữ - Múi giờ">
                            <field name="lang"/>
                            <field name="tz"/>
                        </group>
                    </group>
                    <group string="Bảo mật tài khoản">
                        <field name="login" readonly="1"/>
                        <field name="password" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_user_settings_my" model="ir.actions.act_window">
        <field name="name">Cài đặt cá nhân</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hide_user_menus.view_users_form_simple_custom"/>
        <field name="target">new</field>
        <field name="context">
            {
                'from_my_profile': True,
                'form_view_ref': 'hide_user_menus.view_users_form_simple_custom',
                'uid': uid,
                'active_id': uid,
                'active_ids': [uid]
            }
        </field>
    </record>
</odoo>
