<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_my_assignment_acceptance_report_search" model="ir.ui.view">
      <field name="name">project.work.assignment.my.acceptance.report.search</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <search string="Tìm báo cáo nghiệm thu">
          <field name="project_id"/>
          <field name="work_item_name"/>
          <field name="product_id"/>
          <field name="acceptance_user_id"/>
          <field name="user_id"/>

          <filter string="Đang hoạt động" name="active_true" domain="[('active','=',True)]"/>
          <filter string="Đã gán người nghiệm thu" name="has_acceptance_user" domain="[('acceptance_user_id','!=',False)]"/>
          <filter string="Người nghiệm thu là tôi" name="my_acceptance_user" domain="[('acceptance_user_id','=',uid)]"/>

          <group expand="0" string="Nhóm theo">
            <filter string="Dự án" name="group_project" context="{'group_by':'project_id'}"/>
            <filter string="Danh mục" name="group_section" context="{'group_by':'section_name'}"/>
            <filter string="Người nghiệm thu" name="group_acceptance_user" context="{'group_by':'acceptance_user_id'}"/>
          </group>

          <!-- searchpanel chỉ để project_id -->
          <searchpanel>
            <field name="project_id" string="Dự án" enable_counters="1"/>
          </searchpanel>
        </search>
      </field>
    </record>

    <record id="view_my_assignment_acceptance_report_tree" model="ir.ui.view">
      <field name="name">project.work.assignment.my.acceptance.report.tree</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <tree string="Báo cáo nghiệm thu lũy kế theo kỳ" create="0" delete="0" default_order="project_id, id">
          <field name="project_id"/>
          <field name="work_item_name"/>
          <field name="product_id"/>

          <field name="acceptance_user_id" string="Người báo cáo nghiệm thu" widget="many2one_avatar_user" optional="hide"/>
          <field name="date_start"/>
          <field name="current_period_no"/>
          <field name="uom_id"/>
          <field name="qty_settlement" string="KL HĐ/TT"/>
          <field name="prev_acceptance_qty_cum" string="Lũy kế kỳ trước"/>
          <field name="current_acceptance_qty_period" string="KL nghiệm thu kỳ này"/>
          <field name="current_acceptance_qty_cum" string="Lũy kế nghiệm thu"/>
          <field name="current_acceptance_qty_remaining" string="KL nghiệm thu còn lại"/>
          <field name="acceptance_value_prev_period" string="GT kỳ trước"/>
          <field name="acceptance_value_current_period" string="GT kỳ này"/>
          <field name="acceptance_value_cum" string="GT lũy kế"/>
          <field name="current_acceptance_value_remaining" string="GT còn lại"/>
          <field name="acceptance_process_percent" widget="progressbar" string="% Nghiệm thu"/>
        </tree>
      </field>
    </record>

    <record id="view_my_assignment_acceptance_report_form" model="ir.ui.view">
      <field name="name">project.work.assignment.my.acceptance.report.form</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <form string="Báo cáo nghiệm thu lũy kế theo kỳ" create="0" delete="0" edit="1">

          <sheet>
            <group>
              <group>
                <field name="project_id" readonly="1"/>
                <field name="work_item_name" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="executor_user_id" string="Người thi công" widget="many2one_avatar_user" readonly="1"/>
                <field name="acceptance_user_id" readonly="1" string="Người nghiệm thu"/>
                <field name="attachment_ids" readonly="1" widget="many2many_binary"/>
              </group>
              <group>
                <field name="date_start" readonly="1"/>
                <field name="current_period_no" readonly="1"/>
                <field name="uom_id" readonly="1"/>
                <field name="qty_settlement" readonly="1" string="KL Hợp đồng/ Thực tế"/>
                <field name="qty_done" readonly="1" string="Sản lượng đã thực hiện"/>

                <field name="current_acceptance_qty_cum" readonly="1" string="KL đã nghiệm thu"/>
                <field name="current_acceptance_qty_remaining" readonly="1" string="KL nghiệm thu còn lại"/>
                <field name="price_unit" readonly="1"/>
                <field name="value_completed" readonly="1" string="Giá trị sản lượng đã thực hiện"/>

                <field name="progress_percent" readonly="1" widget="progressbar" string="% Sản lượng"/>
                <field name="acceptance_process_percent" readonly="1" widget="progressbar" string="% Nghiệm thu"/>
              </group>
            </group>

            <notebook>
              <page string="Nhập kỳ hiện tại (Nghiệm thu)">
                <group>
                  <group>
                    <field name="current_period_start" readonly="1"/>
                    <field name="current_period_end" readonly="1"/>
                  </group>
                  <group>
                    <field name="prev_acceptance_qty_cum" readonly="1"/>
                    <field name="current_acceptance_qty_cum" readonly="1" string="Lũy kế nghiệm thu đến hiện tại"/>
                  </group>
                </group>

                <group>
                  <group>
                    <field name="current_acceptance_qty_period" readonly="not current_period_start" placeholder="Nhập khối lượng nghiệm thu trong kỳ..."/>
                  </group>
                  <group>
                    <field name="current_acceptance_note" readonly="not current_period_start" placeholder="Ghi chú nghiệm thu..."/>
                  </group>
                </group>

                <group>
                  <group>
                    <field name="acceptance_value_current_period" readonly="1"/>
                  </group>
                  <group>
                    <field name="acceptance_value_cum" readonly="1"/>
                  </group>
                </group>

                <div class="text-muted" style="margin-top:8px;">
                  Bạn chỉ nhập <b>khối lượng nghiệm thu trong kỳ</b>. Hệ thống tự cộng thành <b>lũy kế</b> và lưu vào lịch sử.
                  Không được vượt <b>lũy kế sản lượng báo cáo</b> cùng kỳ.
                </div>
              </page>

              <page string="Lịch sử nghiệm thu">
                <field name="acceptance_progress_ids" nolabel="1">
                  <tree create="0" delete="0" edit="0">
                    <field name="period_no"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="qty_period" sum="Tổng KL kỳ"/>
                    <field name="qty_cum"/>
                    <field name="uom_id" readonly="1"/>
                    <field name="value_period" sum="Tổng GT kỳ"/>
                    <field name="value_cum"/>
                    <field name="note"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_my_assignment_acceptance_report" model="ir.actions.act_window">
      <field name="name">Báo cáo nghiệm thu của tôi</field>
      <field name="res_model">project.work.assignment</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="project_work_acceptance_report.view_my_assignment_acceptance_report_search"/>
      <field name="domain">[('acceptance_user_id','=',uid), ('active','=',True)]</field>
      <field name="view_ids" eval="[
        (5,0,0),
        (0,0, {'sequence':1, 'view_mode':'tree', 'view_id': ref('project_work_acceptance_report.view_my_assignment_acceptance_report_tree')}),
        (0,0, {'sequence':2, 'view_mode':'form', 'view_id': ref('project_work_acceptance_report.view_my_assignment_acceptance_report_form')})
      ]"/>
    </record>

    <record id="action_manager_assignment_acceptance_report" model="ir.actions.act_window">
      <field name="name">Quản lý báo cáo nghiệm thu</field>
      <field name="res_model">project.work.assignment</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="project_work_acceptance_report.view_my_assignment_acceptance_report_search"/>
      <field name="domain">[('active','=',True)]</field>
      <field name="view_ids" eval="[
        (5,0,0),
        (0,0, {'sequence':1, 'view_mode':'tree', 'view_id': ref('project_work_acceptance_report.view_my_assignment_acceptance_report_tree')}),
        (0,0, {'sequence':2, 'view_mode':'form', 'view_id': ref('project_work_acceptance_report.view_my_assignment_acceptance_report_form')})
      ]"/>
    </record>

    <menuitem id="menu_my_assignment_acceptance_report" name="Báo cáo nghiệm thu của tôi" parent="project_work_acceptance_report.menu_project_work_acceptance_root" action="action_my_assignment_acceptance_report" sequence="1"/>

    <menuitem id="menu_manager_assignment_acceptance_report" name="Quản lý báo cáo nghiệm thu" parent="project_work_acceptance_report.menu_project_work_acceptance_root" action="action_manager_assignment_acceptance_report" sequence="3" groups="project.group_project_manager"/>

  </data>
</odoo>