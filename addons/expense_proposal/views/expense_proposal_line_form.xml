<odoo>
    <record id="view_expense_proposal_line_form" model="ir.ui.view">
        <field name="name">expense.proposal.line.form</field>
        <field name="model">expense.proposal.line</field>
        <field name="arch" type="xml">
            <form string="Nhóm chi phí">
                <sheet>
                    <group colspan="2">
                        <field name="object" widget="many2one_avatar"/>
                        <field name="content"/>
                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="date"/>
                        <field name="cost_classification"/>
                        <field name="expense_category_id"/>
                        <field name="project_id" invisible="(cost_classification != 'project') and (cost_classification != 'estimated_cost')"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>