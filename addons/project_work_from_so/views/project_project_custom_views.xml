                                    <field name="uom_id"/>
                                    <field name="qty_plan"/>
                                    <field name="qty_arise"/>
                                    <field name="qty_settlement"/>
                                    <field name="qty_done" readonly="1"/>
                                    <field name="qty_remaining" readonly="1"/>
                                    <field name="progress_percent" readonly="1"/>
                                </tree>

                                <form string="Hạng mục công việc">
                                    <sheet>

                                        <field name="project_id" invisible="1"/>

                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="product_id"/>
                                                <field name="uom_id"/>
                                                <field name="so_line_id" readonly="1"/>
                                                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                                            </group>
                                            <group>
                                                <field name="qty_plan" readonly="1"/>
                                                <field name="qty_done" readonly="1"/>
                                                <field name="qty_remaining" readonly="1"/>
                                                <field name="progress_percent" readonly="1"/>
                                            </group>
                                        </group>

                                        <notebook>
                                            <page string="Phân công">
                                                <field name="assignment_ids" context="{'default_project_id': project_id, 'default_work_item_id': id}">
