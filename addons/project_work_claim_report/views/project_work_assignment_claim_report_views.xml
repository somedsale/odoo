<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- SEARCH (dùng chung) -->
    <record id="view_my_assignment_claim_report_search" model="ir.ui.view">
      <field name="name">project.work.assignment.my.claim.report.search</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <search string="Tìm báo cáo thanh / quyết toán">
          <field name="project_id"/>
          <field name="work_item_name" string="Hạng mục"/>
          <field name="product_id"/>
          <field name="claim_user_id"/>
          <field name="user_id"/>

          <separator/>

          <filter string="Đang hoạt động" name="active_true" domain="[('active','=',True)]"/>
          <filter string="Đã gán người báo cáo T/QT" name="has_claim_user" domain="[('claim_user_id','!=',False)]"/>

          <group expand="0" string="Nhóm theo">
            <filter string="Dự án" name="group_project" context="{'group_by':'project_id'}"/>
            <filter string="Sản phẩm" name="group_product" context="{'group_by':'product_id'}"/>
            <filter string="Người báo cáo T/QT" name="group_claim_user" context="{'group_by':'claim_user_id'}"/>
            <filter string="Người thi công" name="group_exec_user" context="{'group_by':'user_id'}"/>
          </group>

          <searchpanel>
            <field name="project_id" string="Dự án" enable_counters="1"/>
          </searchpanel>
        </search>
      </field>
    </record>

    <!-- TREE -->
    <record id="view_my_assignment_claim_report_tree" model="ir.ui.view">
      <field name="name">project.work.assignment.my.claim.report.tree</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <tree string="Báo cáo thanh / quyết toán lũy kế theo kỳ" create="0" delete="0"
              default_order="project_id, id">
          <field name="project_id"/>
          <field name="work_item_name"/>
          <field name="product_id"/>
          <field name="date_start"/>
          <field name="current_period_no"/>
          <field name="user_id" string="Người thi công" optional="hide"/>
          <field name="claim_user_id" string="Người báo cáo T/QT" optional="hide"/>
          <field name="uom_id"/>
          <field name="qty_settlement"/>
          <field name="current_acceptance_qty_cum" string="KL đã nghiệm thu"/>
          <field name="prev_claim_qty_cum" string="KL T/QT kỳ trước"/>
          <field name="current_claim_qty_period" string="KL T/QT kỳ này"/>
          <field name="current_claim_qty_remaining" string="KL T/QT còn lại"/>
          <field name="current_claim_qty_cum" string="Lũy kế T/QT"/>
          <field name="prev_claim_value_cum" string="GT T/QT kỳ trước"/>
          <field name="claim_value_current_period" string="GT T/QT kỳ này"/>
          <field name="claim_value_current_remaining" string="GT T/QT còn lại"/>
          <field name="claim_value_cum" string="GT lũy kế T/QT"/>
          <field name="claim_process_percent" widget="progressbar" string="% Thanh/QT"/>

        </tree>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_my_assignment_claim_report_form" model="ir.ui.view">
      <field name="name">project.work.assignment.my.claim.report.form</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <form string="Báo cáo thanh / quyết toán lũy kế theo kỳ" create="0" delete="0" edit="1">
          <header>
            <button name="action_repair_claim_cumulative"
                    type="object"
                    string="Sửa dữ liệu lũy kế T/QT"
                    class="btn-secondary"
                    groups="project.group_project_manager"/>
          </header>

          <sheet>
            <group>
              <group>
                <field name="project_id" readonly="1"/>
                <field name="work_item_name" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="user_id" readonly="1" string="Người thi công"/>
                <field name="claim_user_id" readonly="1" string="Người báo cáo T/QT"/>
                <field name="attachment_ids" readonly="1" widget="many2many_binary"/>
              </group>
              <group>
                <field name="uom_id" readonly="1"/>
                <field name="qty_settlement" readonly="1"/>
                  <field name="current_acceptance_qty_cum" readonly="1" string="KL đã nghiệm thu"/>
                  <field name="current_claim_qty_remaining" readonly="1" string="KL T/QT còn lại"/>
                <field name="date_start" readonly="1"/>
                <field name="current_period_no" readonly="1"/>
                <field name="progress_percent" readonly="1" widget="progressbar" string="% Sản lượng"/>
                <field name="acceptance_process_percent" readonly="1" widget="progressbar" string="% Nghiệm thu"/>
                <field name="claim_process_percent" readonly="1" widget="progressbar" string="% Thanh/QT"/>
                <field name="value_completed" readonly="1"/>
                <field name="price_unit" readonly="1"/>
              </group>
            </group>

            <notebook>
              <page string="Nhập kỳ hiện tại (Thanh/QT)">
                <group>
                  <group>
                    <field name="current_period_start" readonly="1"/>
                    <field name="current_period_end" readonly="1"/>
                  </group>
                  <group>
                    <field name="prev_claim_qty_cum" readonly="1"/>
                    <field name="current_claim_qty_cum" readonly="1" string="Lũy kế thanh/QT đến hiện tại"/>
                  </group>
                </group>

                <group>
                  <group>
                    <field name="current_claim_qty_period"
                           readonly="not current_period_start"
                           placeholder="Nhập khối lượng thanh/quyết toán trong kỳ..."/>
                  </group>
                  <group>
                    <field name="current_claim_note"
                           readonly="not current_period_start"
                           placeholder="Ghi chú thanh/quyết toán..."/>
                  </group>
                </group>

                <group>
                  <group>
                    <field name="claim_value_current_period" readonly="1"/>
                  </group>
                  <group>
                    <field name="claim_value_cum" readonly="1"/>
                  </group>
                </group>

                <div class="text-muted" style="margin-top:8px;">
                  Bạn chỉ nhập <b>khối lượng thanh/quyết toán trong kỳ</b>. Hệ thống tự cộng thành <b>lũy kế</b>
                  và lưu vào lịch sử. Không được vượt <b>lũy kế sản lượng báo cáo</b> cùng kỳ.
                </div>
              </page>

              <page string="Lịch sử thanh/quyết toán">
                <field name="claim_progress_ids" nolabel="1">
                  <tree create="0" delete="0" edit="0">
                    <field name="period_no"/>
                    <field name="period_start"/>
                    <field name="period_end"/>
                    <field name="qty_period" sum="Tổng KL kỳ"/>
                    <field name="qty_cum"/>
                    <field name="uom_id" readonly="1"/>
                    <field name="value_period" sum="Tổng GT kỳ"/>
                    <field name="value_cum"/>
                    <field name="note"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACTION: Của tôi -->
    <record id="action_my_assignment_claim_report" model="ir.actions.act_window">
      <field name="name">Báo cáo thanh / quyết toán của tôi</field>
      <field name="res_model">project.work.assignment</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_my_assignment_claim_report_search"/>
      <!-- ✅ lọc theo người báo cáo quyết toán -->
      <field name="domain">[('claim_user_id','=',uid), ('active','=',True)]</field>
      <field name="view_ids" eval="[
        (5,0,0),
        (0,0, {'sequence': 1, 'view_mode':'tree', 'view_id': ref('view_my_assignment_claim_report_tree')}),
        (0,0, {'sequence': 2, 'view_mode':'form', 'view_id': ref('view_my_assignment_claim_report_form')})
      ]"/>
    </record>

    <!-- ACTION: Quản lý (manager xem tất cả) -->
    <record id="action_manager_assignment_claim_report" model="ir.actions.act_window">
      <field name="name">Quản lý báo cáo thanh / quyết toán</field>
      <field name="res_model">project.work.assignment</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_my_assignment_claim_report_search"/>
      <field name="domain">[('active','=',True)]</field>
      <field name="view_ids" eval="[
        (5,0,0),
        (0,0, {'sequence': 1, 'view_mode':'tree', 'view_id': ref('view_my_assignment_claim_report_tree')}),
        (0,0, {'sequence': 2, 'view_mode':'form', 'view_id': ref('view_my_assignment_claim_report_form')})
      ]"/>
    </record>

    <!-- MENUS -->
    <menuitem id="menu_my_assignment_claim_report"
              name="Báo cáo T/QT của tôi"
              parent="project_work_claim_report.menu_project_work_claim_root"
              action="action_my_assignment_claim_report"
              sequence="2"/>

    <menuitem id="menu_manager_assignment_claim_report"
              name="Quản lý báo cáo T/QT"
              parent="project_work_claim_report.menu_project_work_claim_root"
              action="action_manager_assignment_claim_report"
              sequence="3"
              groups="project.group_project_manager"/>

  </data>
</odoo>