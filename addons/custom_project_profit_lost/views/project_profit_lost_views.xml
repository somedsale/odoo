<odoo>
    <record id="view_project_profit_lost_tree" model="ir.ui.view">
        <field name="name">project.profit.lost.tree</field>
        <field name="model">project.profit.lost</field>
        <field name="arch" type="xml">
            <tree create="false" string="Phân tích lãi lỗ công trình" decoration-info="is_highlighted" decoration-bf="is_highlighted">
                <header>
                    <button name="load_all_projects" type="object" string="Đồng bộ dữ liệu" class="oe_highlight"/>
                    <button name="action_highlight" type="object" string="Highlight"/>
                </header>
                <field name="project_id"/>
                <field name="num_contract" options="{'header_group': 'Thông tin'}"/>
                <field name="contract_value" sum="1" options="{'header_group': 'Hợp đồng'}"/>
                <field name="settlement_value" sum="1" options="{'header_group': 'Hợp đồng'}"/>
                <field name="invoice_amount" sum="1" options="{'header_group': 'Doanh thu'}"/>
                <field name="revenue" sum="1" options="{'header_group': 'Doanh thu'}"/>
                <field name="material_cost" sum="1" options="{'header_group': 'Chi phí'}"/>
                <field name="labor_cost" sum="1" options="{'header_group': 'Chi phí'}"/>
                <field name="other_cost" sum="1" options="{'header_group': 'Chi phí'}"/>
                <field name="expense" sum="1" options="{'header_group': 'Chi phí'}"/>
                <field name="profit" sum="1" options="{'header_group': 'Kết quả'}"/>
                <field name="currency_id" optional="hide"/>
                <field name="is_highlighted" column_invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_project_profit_lost_form" model="ir.ui.view">
        <field name="name">project.profit.lost.form</field>
        <field name="model">project.profit.lost</field>
        <field name="arch" type="xml">
            <form create="false" string="Phân tích lãi lỗ công trình">
                <sheet>
                    <group col="3">
                        <group string="Thông tin">
                            <field name="project_id" readonly="1"/>
                            <field name="num_contract" readonly="1"/>
                            <field name="contract_value" readonly="1"/>
                            <field name="settlement_value" />
                            <field name="invoice_amount" />
                            <field name ="currency_id" invisible="1"/>
                        </group>
                        <group string="Chi phí">
                            <field name="material_cost" readonly="1"/>
                            <field name="labor_cost" readonly="1"/>
                            <field name="other_cost" readonly="1"/>
                        </group>
                        <group string="Kết quả">
                            <field name="revenue" readonly="1"/>
                            <field name="receivable_amount" readonly="1"/>
                            <field name="expense" readonly="1"/>
                            <field name="profit" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết chi">
                            <field name="detail_ids" readonly="1">
                                <tree >
                                    <field name="date"/>
                                    <field name="material_amount" options="{'header_group': 'Chi phí'}" sum="1"/>
                                    <field name="labor_amount" options="{'header_group': 'Chi phí'}" sum="1"/>
                                    <field name="other_amount" options="{'header_group': 'Chi phí'}" sum="1"/>
                                    <field name ="total_amount" options="{'header_group': 'Chi phí'}" sum="1"/>
                                    <field name="description" readonly="0"/>
                                    <field name="currency_id" nolabel="1" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hóa đơn">
                            <field name="invoice_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="invoice_number"/>
                                    <field name="project_id"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="account_tax_id" optional="show"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="amount_total" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="currency_id" string="Tiền tệ" optional="hide"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="invoice_number"/>
                                                <field name="project_id"/>
                                                <field name="partner_id"/>
                                                <field name="date"/>
                                            </group>
                                            <group>
                                                <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                                <field name="account_tax_id" />
                                                <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                                <field name="currency_id" string="Tiền tệ" />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Quyết toán">
                            <field name="settlement_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="settlement_number"/>
                                    <field name="date"/>
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="tax_id"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_settlement" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name ="currency_id" invisible="1"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="settlement_number"/>
                                            <field name="date"/>
                                            <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            <field name="tax_id"/>
                                            <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            <field name="amount_settlement" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                            <field name ="currency_id" invisible="1"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_project_profit_lost_pivot" model="ir.ui.view">
        <field name="name">project.profit.lost.pivot</field>
        <field name="model">project.profit.lost</field>
        <field name="arch" type="xml">
            <pivot string="Phân tích lãi lỗ công trình">
                <field name="project_id" type="row"/>
                <field name="profit" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="expense" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_open_project_profit_lost" model="ir.actions.server">
        <field name="name">Mở phân tích lãi lỗ</field>
        <field name="model_id" ref="model_project_profit_lost"/>
        <!-- <field name="state">code</field> -->
        <!-- <field name="code">action = model.action_open_profit_lost()</field> -->
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Nhấn vào đây để tạo mới một bản ghi phân tích lãi lỗ công trình.
            </p>
        </field>
    </record>
    <record id="action_sync_profit_lost" model="ir.actions.server">
        <field name="name">Đồng bộ dữ liệu</field>
        <field name="model_id" ref="model_project_profit_lost"/>
        <field name="binding_model_id" ref="model_project_profit_lost"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">model.load_all_projects()</field>
    </record>
    <menuitem id="menu_project_profit_lost_root" name="Lãi lỗ công trình" parent="custom_account_menu.menu_accounting_project"/>
    <menuitem id="menu_project_profit_lost" name="Phân tích lãi lỗ công trình" parent="menu_project_profit_lost_root" action="action_open_project_profit_lost"/>
</odoo>
