<odoo>
    <record id="view_future_project_kanban" model="ir.ui.view">
    <field name="name">future.project.kanban</field>
    <field name="model">future.project</field>
    <field name="arch" type="xml">

        <kanban
            default_group_by="stage_id"
            disable_drag_drop="context.get('disable_drag_drop')"
            class="o_kanban_small_column">

            <!-- FIELDS -->
            <field name="name"/>
            <field name="customer_id"/>
            <field name="location_id"/>
            <field name="expected_value"/>
            <field name="currency_id"/>
            <field name="expected_bid_date"/>
            <field name="assigned_user_id"/>
            <field name="priority"/>
            <field name="probability"/>

            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_card oe_kanban_global_click p-3">

                        <!-- HEADER: NAME + STATUS -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="o_text_overflow fs-6">
                                <field name="name"/>
                            </strong>

                            <div class="d-flex align-items-center gap-2">
                                <field name="priority" widget="priority"/>
                                <span class="badge bg-light text-dark">
                                    <t t-esc="record.probability.raw_value * 100"/>%
                                </span>
                            </div>
                        </div>

                        <!-- BODY -->
                        <div class="o_kanban_content">

                            <!-- CUSTOMER -->
                            <div t-if="record.customer_id.raw_value" class="text-muted mb-1">
                                <i class="fa fa-building-o me-1"/>
                                <field name="customer_id"/>
                            </div>

                            <!-- LOCATION -->
                            <div t-if="record.location_id.raw_value" class="mb-1">
                                <i class="fa fa-map-marker me-1"/>
                                <field name="location_id"/>
                            </div>

                            <!-- VALUE -->
                            <div class="fw-bold my-2">
                                <i class="fa fa-money me-1"/>
                                <field name="expected_value"/>
                            </div>

                        </div>

                        <hr class="my-2"/>

                        <!-- FOOTER: USER + DATE -->
                        <div class="d-flex justify-content-between align-items-center">

                            <field
                                name="assigned_user_id"
                                widget="many2one_avatar_user"/>

                            <div t-if="record.expected_bid_date.raw_value"
                                 class="text-muted small">
                                <i class="fa fa-calendar me-1"/>
                                <field name="expected_bid_date"/>
                            </div>

                        </div>

                    </div>
                </t>
            </templates>

        </kanban>
    </field>
</record>

</odoo>
