<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_purchase_advance_payment_wizard_form" model="ir.ui.view">
      <field name="name">purchase.advance.payment.wizard.form</field>
      <field name="model">purchase.advance.payment.wizard</field>
      <field name="arch" type="xml">
        <form string="Tạo phiếu chi tạm ứng" create="false" edit="false">
          <group>
            <field name="purchase_id" readonly="1"/>
            <field name="leftover" readonly="1"/>
            <field name="amount"/>
            <field name="payment_type"/>
            <field name="journal_id" optional="hide"/>
            <field name="currency_id" invisible="1"/>
            <field name="note" placeholder="Ghi chú (tuỳ chọn)"/>
          </group>
          <footer>
            <button string="Tạo phiếu chi" type="object" name="action_confirm" class="btn-primary"/>
            <button string="Hủy" special="cancel" class="btn-secondary"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>
