<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 🌟 Kế thừa form view Phiếu Thu để thêm liên kết với Khoản vay -->
        <record id="view_account_receipt_form_inherit_loan" model="ir.ui.view">
            <field name="name">account.receipt.form.inherit.loan</field>
            <field name="model">account.receipt</field>
            <field name="inherit_id" ref="custom_accounting_receipt.view_account_receipt_form"/>
            <field name="arch" type="xml">

                <!-- 📌 Chèn sau field total -->
                <xpath expr="//field[@name='amount']" position="after">
                    <field name="loan_id" domain="[('lender_id', '=', partner_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
                <xpath expr="//field[@name='payment_proposal_id']" position="attributes">
                    <attribute name="invisible">loan_id</attribute>
                </xpath>
                <xpath expr="//field[@name='is_advance_refund']" position="attributes">
                    <attribute name="invisible">loan_id</attribute>
                </xpath>
                <xpath expr="//field[@name='contract_id']" position="attributes">
                    <attribute name="invisible">loan_id</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_id']" position="attributes">
                    <attribute name="invisible">loan_id</attribute>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
