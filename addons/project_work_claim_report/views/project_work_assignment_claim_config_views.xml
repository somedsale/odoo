<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- SEARCH -->
    <record id="view_project_work_assignment_claim_config_search" model="ir.ui.view">
      <field name="name">project.work.assignment.claim.config.search</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <search string="Phân công báo cáo quyết toán">
          <field name="project_id"/>
          <field name="work_item_name"/>
          <field name="user_id"/>

          <separator/>

          <filter string="Chưa gán người báo cáo T/QT"
                  name="no_claim_user"
                  domain="[('claim_user_id','=',False)]"/>

          <filter string="Đang hoạt động"
                  name="active_true"
                  domain="[('active','=',True)]"/>

          <group expand="0" string="Nhóm theo">
            <filter string="Dự án" name="group_project" context="{'group_by':'project_id'}"/>
            <filter string="Người thi công" name="group_exec_user" context="{'group_by':'user_id'}"/>
          </group>

          <searchpanel>
            <field name="project_id" string="Dự án" enable_counters="1"/>
          </searchpanel>
        </search>
      </field>
    </record>

    <!-- TREE -->
    <record id="view_project_work_assignment_claim_config_tree" model="ir.ui.view">
      <field name="name">project.work.assignment.claim.config.tree</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <tree string="Phân công báo cáo quyết toán" editable="bottom" create="0" delete="0"
              default_order="project_id, id">
          <field name="project_id"/>
          <field name="work_item_name"/>
          <field name="product_id"/>
          <field name="qty_plan"/>
          <field name="uom_id"/>
          <field name="executor_user_ids" string="Người phụ trách"/>
          <field name="claim_user_id" string="Người báo cáo T/QT"/>
          <field name="date_start"/>
          <field name="active"/>
        </tree>
      </field>
    </record>

    <!-- FORM -->
    <record id="view_project_work_assignment_claim_config_form" model="ir.ui.view">
      <field name="name">project.work.assignment.claim.config.form</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <form string="Phân công báo cáo quyết toán" create="0" delete="0">
          <sheet>
            <group>
              <group>
                <field name="project_id" readonly="1"/>
                <field name="work_item_name" readonly="1"/>
                <field name="product_id" readonly="1"/>
                <field name="uom_id" readonly="1"/>
                <field name="qty_plan" readonly="1"/>
              </group>
              <group>
                <field name="executor_user_ids" string="Người phụ trách" readonly="1"/>
                <field name="claim_user_id" string="Người báo cáo T/QT"/>
                <field name="date_start"/>
                <field name="active"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACTION -->
    <record id="action_project_work_assignment_claim_config" model="ir.actions.act_window">
      <field name="name">Phân công báo cáo quyết toán</field>
      <field name="res_model">project.work.assignment</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="view_project_work_assignment_claim_config_search"/>
      <field name="view_ids" eval="[
        (5,0,0),
        (0,0, {'sequence':1, 'view_mode':'tree', 'view_id': ref('view_project_work_assignment_claim_config_tree')}),
        (0,0, {'sequence':2, 'view_mode':'form', 'view_id': ref('view_project_work_assignment_claim_config_form')})
      ]"/>
      <field name="domain">[('active','=',True)]</field>
    </record>

    <!-- MENU (Manager) -->
    <menuitem id="menu_project_work_claim_root"
              name="Báo cáo thanh / quyết toán"
              parent="project.menu_main_pm"
              sequence="15"/>

    <!-- <menuitem id="menu_project_work_assignment_claim_config"
              name="Phân công báo cáo T/QT"
              parent="menu_project_work_claim_root"
              action="action_project_work_assignment_claim_config"
              sequence="1"
              groups="project.group_project_manager"/> -->

  </data>
</odoo>