<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- PNK XLSX -->
  <record id="action_report_stock_picking_pnk_xlsx" model="ir.actions.report">
    <field name="name">Phiếu Nhập Kho (XLSX)</field>
    <field name="model">stock.picking</field>
    <field name="report_type">xlsx</field>
    <field name="report_name">somed_stock_documents.report_stock_picking_pnk_xlsx</field>
    <field name="report_file">somed_stock_documents.report_stock_picking_pnk_xlsx</field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'%s' % (object.name or '')</field>
  </record>

  <!-- PXK XLSX -->
  <record id="action_report_stock_picking_pxk_xlsx" model="ir.actions.report">
    <field name="name">Phiếu Xuất Kho (XLSX)</field>
    <field name="model">stock.picking</field>
    <field name="report_type">xlsx</field>
    <field name="report_name">somed_stock_documents.report_stock_picking_pxk_xlsx</field>
    <field name="report_file">somed_stock_documents.report_stock_picking_pxk_xlsx</field>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">'%s' % (object.name or '')</field>
  </record>
</odoo>
