<odoo>

    <!-- ================= KANBAN ================= -->
<record id="view_future_project_location_kanban" model="ir.ui.view">
    <field name="name">future.project.location.kanban</field>
    <field name="model">future.project.location</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_small_column">

            <field name="name"/>
            <field name="description"/>
            <field name="project_count"/>
            <field name="won_project_count"/>

            <templates>
                <t t-name="kanban-box">

                    <div class="oe_kanban_card p-3">

                        <!-- HEADER -->
                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <!-- 🔥 CLICK = VÀO DỰ ÁN -->
                            <a type="action"
                               name="%(action_future_project_by_location)d"
                               class="text-decoration-none text-dark flex-grow-1">

                                <div class="d-flex align-items-center">
                                    <i class="fa fa-map-marker text-primary me-2"/>
                                    <strong class="fs-5 o_text_overflow">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </a>

                            <!-- ⚙️ CÀI ĐẶT KHU VỰC -->
                            <a type="open"
                               class="btn btn-sm btn-link p-0 text-muted"
                               title="Cài đặt khu vực">
                                <i class="fa fa-cog"/>
                            </a>

                        </div>

                        <!-- DESCRIPTION (CLICK ĐƯỢC) -->
                        <a type="action"
                           name="%(action_future_project_by_location)d"
                           class="text-decoration-none text-muted">
                            <div t-if="record.description.raw_value"
                                 class="small mb-3">
                                <field name="description"/>
                            </div>
                        </a>

                        <!-- KPI (CLICK ĐƯỢC) -->
                        <a type="action"
                           name="%(action_future_project_by_location)d"
                           class="text-decoration-none text-dark">

                            <div class="row text-center my-3">
                                <div class="col-6">
                                    <div class="fs-4 fw-bold">
                                        <t t-esc="record.project_count.raw_value"/>
                                    </div>
                                    <div class="text-muted small">
                                        Tổng dự án
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="fs-4 fw-bold text-success">
                                        <t t-esc="record.won_project_count.raw_value"/>
                                    </div>
                                    <div class="text-muted small">
                                        Trúng thầu
                                    </div>
                                </div>
                            </div>

                        </a>

                        <hr/>

                        <!-- FOOTER -->
                        <a type="action"
                           name="%(action_future_project_by_location)d"
                           class="text-decoration-none text-primary small">
                            Nhấn để xem dự án →
                        </a>

                    </div>

                </t>
            </templates>
        </kanban>
    </field>
</record>


    <!-- ================= TREE ================= -->
    <record id="view_future_project_location_tree" model="ir.ui.view">
        <field name="name">future.project.location.tree</field>
        <field name="model">future.project.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="project_count"/>
                <field name="won_project_count"/>
            </tree>
        </field>
    </record>

    <!-- ================= FORM ================= -->
    <record id="view_future_project_location_form" model="ir.ui.view">
        <field name="name">future.project.location.form</field>
        <field name="model">future.project.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>

                    <group string="Thống kê">
                        <field name="project_count" readonly="1"/>
                        <field name="won_project_count" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Dự án">
                            <field name="project_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="expected_bid_date"/>
                                    <field name="expected_value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
