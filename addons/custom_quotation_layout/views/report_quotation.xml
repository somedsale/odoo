<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Kế thừa template báo giá mặc định -->
    <template id="custom_sale_order_report" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@class='page']" position="replace">
            <!-- Tùy chỉnh layout mới -->
            <div style="font-family: 'Times New Roman', Times, serif; color:#000 !important;">
                <div style="font-weight: bold; text-align:center; visibility: hidden">BẢNG BÁO GIÁ</div>

                <div style="display: flex; align-items: center;">
                    <!-- Cột trái để cân giữa -->
                    <div style="flex: 1; text-align: center;">
                        <h2 style="font-weight: bold; font-size: 20px; margin: 0; line-height: 1;">
                            BẢNG BÁO GIÁ
                        </h2>
                    </div>

                    <!-- Mã báo giá bên phải -->
                    <div style="flex: 1; text-align: right; position: relative;">
                        <div t-esc="doc.name"
                             style="color:#27B1FC; font-size: 16px; font-weight: bold; position: relative; top: -4px;"/>
                    </div>

                    <div style="flex: 1; text-align: left; position: relative; font-weight: bold; top: -4px;">
                        <t t-if="doc.x_project_name">
                            <span>
                                Dự án:
                                <span t-esc="doc.x_project_name" style="font-weight: normal;"/>
                            </span>
                        </t>
                    </div>
                </div>

                <!-- đọc dữ liệu nhân viên -->
                <t t-set="emp" t-value="env['hr.employee'].search([('user_id', '=', doc.user_id.id)], limit=1)"/>

                <table style="color:#000; width: 100%; font-size:14px; line-height: 1.8; border-color: transparent; border-style: none; outline: none; border-collapse: collapse;">
                    <tr style="border: none; color:#000 !important;">
                        <td style="width: 50%; padding-right: 10px; border: none;">
                            <strong>Khách hàng:</strong>
                            <span t-field="doc.partner_id.name"/>
                        </td>
                        <td style="width: 50%; padding-left: 10px; border: none;">
                            <strong>Nhân viên kinh doanh:</strong>
                            <span t-esc="(doc.user_id.name if doc.user_id and doc.write_uid and doc.user_id.id == doc.write_uid.id else (doc.write_uid.name if doc.write_uid else ''))"/>
                        </td>
                    </tr>

                    <tr style="border: none; color:#000 !important;">
                        <td style="padding-right: 10px; border: none;">
                            <strong>Địa chỉ:</strong>
                            <span t-if="doc.partner_id.contact_address"
                                  t-esc="doc.partner_id.contact_address.replace(doc.partner_id.name or '', '').strip()"/>
                        </td>
                        <td style="padding-left: 10px; border: none;">
                            <strong>Địa chỉ:</strong>
                            <span t-if="doc.user_id.address_id.contact_address"
                                  t-esc="doc.user_id.address_id.contact_address.replace(doc.user_id.address_id.complete_name or '', '').strip()"/>
                        </td>
                    </tr>

                    <tr style="border: none; color:#000 !important;">
                        <t t-if="doc.partner_contact_id">
                            <td style="padding-right: 10px; border: none;">
                                <strong>Người liên hệ:</strong>
                                <span t-field="doc.partner_contact_id.name"/>
                                -
                                <span t-field="doc.partner_contact_id.phone"/>
                            </td>
                        </t>
                        <t t-else="">
                            <td style="padding-right: 10px; border: none;">
                                <strong>Điện thoại:</strong>
                                <t t-if="doc.partner_contact_id and doc.partner_contact_id.phone">
                                    <t t-out="doc.partner_contact_id.phone"/>
                                </t>
                                <t t-else="">
                                    <t t-out="doc.partner_id.phone"/>
                                </t>
                            </td>
                        </t>

                        <td style="padding-left: 10px; border: none;">
                            <strong>Điện thoại:</strong>
                            <span t-esc="(doc.user_id.mobile_phone if doc.user_id and doc.write_uid and doc.user_id.id == doc.write_uid.id else (doc.write_uid.mobile_phone if doc.write_uid else ''))"/>
                        </td>
                    </tr>

                    <tr style="border: none; color:#000 !important;">
                        <td style="padding-right: 10px; border: none;">
                            <strong>Email:</strong>
                            <t t-if="doc.partner_contact_id and doc.partner_contact_id.email">
                                <t t-out="doc.partner_contact_id.email"/>
                            </t>
                            <t t-else="">
                                <t t-out="doc.partner_id.email"/>
                            </t>
                        </td>
                        <td style="padding-left: 10px; border: none;">
                            <strong>Email:</strong>
                            <span t-esc="(doc.user_id.email if doc.user_id and doc.write_uid and doc.user_id.id == doc.write_uid.id else (doc.write_uid.email if doc.write_uid else ''))"/>
                        </td>
                    </tr>
                </table>

                <div style="font-size:14px; line-height: 1.8; margin-top:10px">
                    <p>
                        Lời đầu tiên Công ty TNHH giải pháp kỹ thuật Y tế Miền Nam xin gửi Quý khách
                        hàng lời chúc sức khỏe và lời chào trân trọng nhất!
                    </p>
                    <p>
                        Công ty TNHH giải pháp kỹ thuật Y tế Miền Nam xin gửi Quý khách hàng bảng báo giá
                        sản phẩm, vật tư theo yêu cầu từ Quý khách hàng, cụ thể như sau:
                    </p>
                </div>

                <div style="page-break-inside: auto;">
                    <style>
                        .so_quote_table {
                            width: 100%;
                            border-collapse: collapse;
                            table-layout: fixed;
                            font-family: 'Times New Roman', Times, serif !important;
                            color: #000000 !important;
                            font-size: 13px;
                            border: 1.5px solid #000 !important;
                        }

                        .so_quote_table th,
                        .so_quote_table td,
                        .so_quote_table span,
                        .so_quote_table div,
                        .so_quote_table p,
                        .so_quote_table strong,
                        .so_quote_table b,
                        .so_quote_table i,
                        .so_quote_table t {
                            color: #000000 !important;
                        }

                        .so_quote_table th,
                        .so_quote_table td {
                            border: 1px solid #000000 !important;
                            padding: 6px 6px;
                            vertical-align: top;
                            word-break: break-word !important;
                            overflow-wrap: anywhere !important;
                            white-space: normal !important;
                            line-height: 1.35 !important;
                        }

                        .so_quote_table th {
                            text-align: center !important;
                            font-weight: bold;
                            vertical-align: middle !important;
                            background: #e9eef5 !important;
                            padding: 8px 6px !important;
                            color: #000000 !important;
                        }

                        .so_quote_table tr {
                            page-break-inside: avoid !important;
                            break-inside: avoid-page !important;
                        }

                        .so_main_row td {
                            vertical-align: middle !important;
                            background: #ffffff !important;
                            color: #000000 !important;
                        }

                        .so_main_row td:first-child,
                        .so_main_row td:nth-child(2) {
                            font-weight: bold !important;
                            color: #000000 !important;
                        }

                        .so_center {
                            text-align: center !important;
                            vertical-align: middle !important;
                            color: #000000 !important;
                        }

                        .so_num {
                            text-align: right !important;
                            white-space: nowrap !important;
                            vertical-align: middle !important;
                            font-variant-numeric: tabular-nums;
                            color: #000000 !important;
                        }

                        .so_product_name {
                            line-height: 1.3 !important;
                            padding-left: 8px;
                            font-weight: bold !important;
                            color: #000000 !important;
                        }

                        .so_spec_line {
                            line-height: 1.2 !important;
                            font-style: italic;
                            padding-left: 8px;
                            color: #000000 !important;
                        }

                        .so_note_row td {
                            background: #fcfcfc !important;
                            font-style: italic;
                            color: #000000 !important;
                            border: 1px solid #000000 !important;
                            vertical-align: top !important;
                        }

                        .so_note_text {
                            padding-left: 8px;
                            color: #000000 !important;
                            line-height: 1.25 !important;
                            white-space: normal !important;
                            word-break: break-word !important;
                        }

                        .so_spec_row td {
                            border-left: 1px solid #000000 !important;
                            border-right: 1px solid #000000 !important;
                            border-top: 1px dashed #888888 !important;
                            border-bottom: 1px dashed #888888 !important;
                            vertical-align: top !important;
                            background: #fcfcfc !important;
                            color: #000000 !important;
                        }

                        .so_product_follow {
                            border-left: 1px solid #000000 !important;
                            border-right: 1px solid #000000 !important;
                            border-top: 1px dashed #888888 !important;
                            border-bottom: 1px dashed #888888 !important;
                            color: #000000 !important;
                        }

                        .so_empty_follow {
                            border-left: 1px solid #000000 !important;
                            border-right: 1px solid #000000 !important;
                            border-top: 1px dashed #888888 !important;
                            border-bottom: 1px dashed #888888 !important;
                            color: #000000 !important;
                        }

                        .so_section_row td {
                            background-color: #dfe7f2 !important;
                            color: #000000 !important;
                            font-weight: bold;
                            padding-top: 7px !important;
                            padding-bottom: 7px !important;
                            vertical-align: middle !important;
                        }

                        .so_summary_row td {
                            background-color: #f3f0e7 !important;
                            color: #000000 !important;
                            font-weight: bold;
                            padding-top: 7px !important;
                            padding-bottom: 7px !important;
                            vertical-align: middle !important;
                        }

                        .so_keep_block {
                            page-break-inside: avoid !important;
                            break-inside: avoid-page !important;
                        }

                        .so_quote_table img {
                            display: block;
                            margin: 0 auto;
                            max-width: 60px;
                            max-height: 60px;
                            object-fit: contain;
                        }

                        .o_somed_report_bg_wrap {
                            position: relative;
                            min-height: 100%;
                        }

                        .o_somed_report_bg_layer {
                            position: absolute;
                            inset: 0;
                            background-repeat: no-repeat;
                            background-position: center top;
                            background-size: cover;
                            opacity: 1;
                            z-index: 0;
                        }

                        .o_somed_report_content {
                            position: relative;
                            z-index: 1;
                        }
                    </style>

                    <table class="so_quote_table">
                        <thead>
                            <tr>
                                <th style="width:4%;">STT</th>
                                <th style="width:25%;">Sản phẩm</th>

                                <t t-if="doc.is_show_image">
                                    <th style="width:8%;">Ảnh</th>
                                </t>

                                <t t-if="doc.is_show_ma_sp">
                                    <th style="width:8%;">Mã SP</th>
                                </t>

                                <th style="width:7%;">Xuất xứ</th>
                                <th style="width:5%;">Đơn vị</th>
                                <th style="width:7%;">Khối lượng</th>

                                <t t-if="doc.is_show_chi_phi_nhan_cong">
                                    <th style="width:9%;">Chi phí nhân công</th>
                                </t>

                                <th style="width:9%;">Đơn giá</th>
                                <th style="width:10%;">Thành tiền</th>
                                <th style="width:7%;">Ghi chú</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="stt" t-value="0"/>
                            <t t-set="sttLM" t-value="0"/>

                            <t t-foreach="doc.order_line" t-as="line">
                                <t t-set="total_cols"
                                   t-value="9
                                            + (1 if doc.is_show_image else 0)
                                            + (1 if doc.is_show_ma_sp else 0)
                                            + (1 if doc.is_show_chi_phi_nhan_cong else 0)"/>

                                <!-- Dòng section -->
                                <t t-if="line.display_type == 'line_section'">
                                    <t t-set="sttLM" t-value="sttLM + 1"/>
                                    <t t-set="stt" t-value="0"/>

                                    <tr class="so_section_row so_keep_block">
                                        <td class="so_center">
                                            <span t-esc="doc.int_to_roman(sttLM)"/>
                                        </td>
                                        <td t-att-colspan="total_cols - 1"
                                            style="text-align:left; vertical-align:middle; font-weight:bold;">
                                            <span t-field="line.name"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Dòng note -->
                                <t t-elif="line.display_type == 'line_note'">
                                    <tr class="so_note_row">
                                        <td class="so_center"></td>
                                        <td t-att-colspan="total_cols - 1" style="text-align:left; vertical-align:top;">
                                            <div class="so_note_text">
                                                <span t-field="line.name"/>
                                            </div>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Dòng sản phẩm thật -->
                                <t t-else="">
                                    <t t-set="stt" t-value="stt + 1"/>
                                    <t t-set="product_name" t-value="line.product_display_name or line.product_id.name"/>
                                    <t t-set="spec_text" t-value="(line.name or '').strip() if (line.name or '').strip() != (product_name or '').strip() else ''"/>
                                    <t t-set="spec_lines" t-value="[s.strip() for s in spec_text.split('\n') if s and s.strip()]"/>

                                    <!-- Dòng tên sản phẩm -->
                                    <tr class="so_main_row">
                                        <td class="so_center">
                                            <span t-esc="stt"/>
                                        </td>

                                        <td>
                                            <div class="so_product_name" style="vertical-align:middle !important;">
                                                <span t-esc="product_name"/>
                                            </div>
                                        </td>

                                        <t t-if="doc.is_show_image">
                                            <td class="so_center" style="vertical-align:middle !important;">
                                                <t t-if="line.product_id.image_1920">
                                                    <img t-att-src="'data:image/png;base64,%s' % (line.product_id.image_1920.decode() if isinstance(line.product_id.image_1920, bytes) else line.product_id.image_1920)"
                                                         style="width:60px; height:auto; object-fit:contain;"/>
                                                </t>
                                                <t t-else="">
                                                    <span></span>
                                                </t>
                                            </td>
                                        </t>

                                        <t t-if="doc.is_show_ma_sp">
                                            <td class="so_center" style="vertical-align:middle !important;">
                                                <span t-field="line.product_id.default_code" t-field-options='{"widget": "char"}'/>
                                            </td>
                                        </t>

                                        <td class="so_center" style="vertical-align:middle !important;">
                                            <span t-field="line.x_xuatxu"/>
                                        </td>

                                        <td class="so_center" style="vertical-align:middle !important;">
                                            <span t-field="line.product_uom"/>
                                        </td>

                                        <td class="so_center" style="vertical-align:middle !important;">
                                            <span t-field="line.product_uom_qty"/>
                                        </td>

                                        <t t-if="doc.is_show_chi_phi_nhan_cong">
                                            <td class="so_num" style="vertical-align:middle !important;">
                                                <span t-field="line.x_chi_phi_nhan_cong"
                                                      t-field-options='{"widget": "monetary", "currency_field": "currency_id"}'/>
                                            </td>
                                        </t>

                                        <td class="so_num" style="vertical-align:middle !important;">
                                            <span t-field="line.formatted_price"/>
                                        </td>

                                        <td class="so_num" style="vertical-align:middle !important;">
                                            <span t-field="line.price_subtotal"/>
                                        </td>

                                        <td>
                                            <span t-field="line.x_note"/>
                                        </td>
                                    </tr>

                                    <!-- Các dòng diễn giải / thông số -->
                                    <t t-if="spec_lines">
                                        <t t-foreach="spec_lines" t-as="spec_line">
                                            <tr class="so_spec_row">
                                                <td class="so_empty_follow"></td>

                                                <td class="so_product_follow">
                                                    <div class="so_spec_line">
                                                        <span t-esc="spec_line"/>
                                                    </div>
                                                </td>

                                                <t t-if="doc.is_show_image">
                                                    <td class="so_empty_follow"></td>
                                                </t>

                                                <t t-if="doc.is_show_ma_sp">
                                                    <td class="so_empty_follow"></td>
                                                </t>

                                                <td class="so_empty_follow"></td>
                                                <td class="so_empty_follow"></td>
                                                <td class="so_empty_follow"></td>

                                                <t t-if="doc.is_show_chi_phi_nhan_cong">
                                                    <td class="so_empty_follow"></td>
                                                </t>

                                                <td class="so_empty_follow"></td>
                                                <td class="so_empty_follow"></td>
                                                <td class="so_empty_follow"></td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </t>

                            <t t-set="tax_details" t-value="{}"/>
                            <t t-foreach="doc.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <t t-foreach="line.tax_id" t-as="tax">
                                        <t t-set="base" t-value="tax_details.get(tax.name, {'base': 0.0, 'amount': 0.0})"/>
                                        <t t-set="tax_details"
                                           t-value="dict(tax_details, **{tax.name: {'base': base['base'] + line.price_subtotal, 'amount': base['amount'] + (line.price_subtotal * tax.amount / 100)}})"/>
                                    </t>
                                </t>
                            </t>

                            <t t-set="col_base" t-value="6"/>
                            <t t-set="col_base" t-value="col_base + 1 if doc.is_show_ma_sp else col_base"/>
                            <t t-set="col_base" t-value="col_base + 1 if doc.is_show_chi_phi_nhan_cong else col_base"/>
                            <t t-set="col_base" t-value="col_base + 1 if doc.is_show_image else col_base"/>

                            <tr class="so_summary_row so_keep_block">
                                <td t-att-colspan="col_base" style="white-space:nowrap; text-align:left; vertical-align:middle;">
                                    Tổng chưa VAT
                                </td>
                                <td style="white-space:nowrap; text-align:right;">
                                    <span t-field="doc.amount_untaxed"/>
                                </td>
                                <td></td>
                            </tr>

                            <t t-foreach="tax_details.items()" t-as="item">
                                <tr class="so_summary_row so_keep_block">
                                    <td t-att-colspan="col_base" style="white-space:nowrap; text-align:left; vertical-align:middle;">
                                        <t t-esc="'VAT %s' % item[0]"/>
                                    </td>
                                    <td style="white-space:nowrap; text-align:right;">
                                        <t t-esc="'%s đ' % '{:,.0f}'.format(item[1]['amount']).replace(',', '.')"/>
                                    </td>
                                    <td></td>
                                </tr>
                            </t>

                            <tr class="so_summary_row so_keep_block">
                                <td t-att-colspan="col_base" style="white-space:nowrap; text-align:left; vertical-align:middle;">
                                    Tổng
                                </td>
                                <td style="white-space:nowrap; text-align:right;">
                                    <span t-field="doc.amount_total"/>
                                </td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="page-break-inside: avoid;">
                    <div style="text-align: center; font-weight: bold; margin-top: 10px;">
                        Số tiền bằng chữ:
                        <span>
                            <t t-esc="doc.amount_to_text_vi(doc.amount_total)"/>
                        </span>
                    </div>
                </div>

                <div style="font-size:14px;">
                    <p><strong>Điều kiện thương mại:</strong></p>

                    <t t-set="line_num" t-value="1"/>

                    <t t-if="doc.is_including_testing">
                        <p>
                            <t t-out="line_num"/>. Báo giá đã bao gồm chi phí kiểm định
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>

                    <p>
                        <t t-out="line_num"/>. Báo giá đã bao gồm Thuế VAT
                    </p>
                    <t t-set="line_num" t-value="line_num + 1"/>

                    <t t-if="doc.is_including_installation and doc.is_including_transport">
                        <p>
                            <t t-out="line_num"/>. Báo giá đã bao gồm lắp đặt và vận chuyển
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>
                    <t t-elif="doc.is_including_installation">
                        <p>
                            <t t-out="line_num"/>. Báo giá đã bao gồm lắp đặt
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>
                    <t t-elif="doc.is_including_transport">
                        <p>
                            <t t-out="line_num"/>. Báo giá đã bao gồm vận chuyển
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>
                    <t t-elif="not doc.is_including_installation and not doc.is_including_transport">
                        <p>
                            <t t-out="line_num"/>. Báo giá chưa bao gồm lắp đặt và vận chuyển
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>

                    <t t-if="doc.x_estimated_delivery_time_id">
                        <p>
                            <t t-out="line_num"/>. Thời gian giao hàng:
                            <t t-out="doc.x_estimated_delivery_time_id.name"/>
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>

                    <t t-if="doc.x_warranty_duration_id">
                        <p>
                            <t t-out="line_num"/>. Thời gian bảo hành:
                            <t t-out="doc.x_warranty_duration_id.name"/>
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>

                    <p style="margin-bottom: -25px;">
                        <t t-out="line_num"/>. Điều khoản thanh toán:
                    </p>
                    <div style="white-space: pre-line; margin-top: 0; line-height: 2.2; margin-left: 15px;">
                        <t t-out="doc.x_custom_payment_terms"/>
                    </div>
                    <t t-set="line_num" t-value="line_num + 1"/>

                    <p>
                        <t t-out="line_num"/>. Phương thức thanh toán:
                        <t t-out="doc.x_payment_method_id.name"/>
                    </p>

                    <t t-set="bank" t-value="doc.company_bank_id or (doc.company_id.partner_id.bank_ids and doc.company_id.partner_id.bank_ids[0])"/>
                    <t t-if="bank">
                        <div style="margin-left:15px;">
                            <p>
                                <span>Chủ tài khoản:</span>
                                <t t-esc="bank.acc_holder_name or bank.partner_id.name or ''"/>
                            </p>
                            <p>
                                <span>Số tài khoản:</span>
                                <t t-esc="bank.acc_number or ''"/>
                            </p>
                            <p>
                                <span>Tại Ngân hàng:</span>
                                <t t-esc="bank.bank_id.name or ''"/>
                            </p>
                        </div>
                    </t>

                    <t t-set="line_num" t-value="line_num + 1"/>

                    <t t-if="doc.x_delivery_location">
                        <p>
                            <t t-out="line_num"/>. Địa điểm giao hàng:
                            <t t-out="doc.x_delivery_location"/>
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>

                    <t t-if="doc.validity_date and doc.date_order">
                        <p>
                            <t t-out="line_num"/>. Bảng báo giá có hiệu lực trong vòng
                            <t t-out="doc.x_quote_valid_until"/> ngày,
                            sau đó có thể được thay đổi mà không thông báo trước.
                        </p>
                        <t t-set="line_num" t-value="line_num + 1"/>
                    </t>
                </div>

                <div style="page-break-inside: avoid;">
                    <div class="row">
                        <div class="col-6" style="text-align:center; line-height:1.8">
                            <div><i>Xác nhận của khách hàng</i></div>
                            <div><i>(Ký tên, đóng dấu)</i></div>
                        </div>

                        <div class="col-6" style="text-align:center; line-height:1.8">
                            <div>
                                <i><t t-esc="doc.formatted_date"/></i>
                            </div>
                            <div>
                                <b><i>CÔNG TY TNHH GIẢI PHÁP KỸ THUẬT Y TẾ MIỀN NAM</i></b>
                            </div>
                            <div>
                                <b><i>PHÒNG KINH DOANH</i></b>
                            </div>
                            <div style="height:65px"></div>
                            <span t-esc="(doc.user_id.name if doc.user_id and doc.write_uid and doc.user_id.id == doc.write_uid.id else (doc.write_uid.name if doc.write_uid else ''))"/>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>