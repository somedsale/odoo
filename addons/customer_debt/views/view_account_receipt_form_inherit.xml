<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_account_receipt_form_inherit" model="ir.ui.view">
            <field name="name">account.receipt.form.inherit</field>
            <field name="model">account.receipt</field>
            <field name="inherit_id" ref="custom_accounting_receipt.view_account_receipt_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='project_id']" position="after">
                    <field name="contract_id"/>
                    <field name="invoice_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>