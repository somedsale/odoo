<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_proposal_tree" model="ir.ui.view">
        <field name="name">expense.proposal.tree</field>
        <field name="model">expense.proposal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="proposer_id" widget="many2one_avatar"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="general_note" string="Mục đích" placeholder="Nhập ghi chú hoặc mục đích"/>
                <field name="currency_id" optional="hide"/>
                <field name="state" string="Trạng thái" widget="badge" decoration-muted="state == 'draft'" decoration-primary="state == 'submitted'" decoration-success="state == 'approved'" decoration-warning="state == 'posted'" decoration-info="state == 'completed'" decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_expense_proposal_form" model="ir.ui.view">
        <field name="name">expense.proposal.form</field>
        <field name="model">expense.proposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Xác nhận" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="custom_director_role.group_director"/>
                    <button name="action_open_reject_wizard" string="Từ chối" type="object" invisible="state != 'submitted'" groups="custom_director_role.group_director"/>
                    <button name="action_post" string="Tạo phiếu chi" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_done" string="Hoàn tất" type="object" class="oe_highlight" invisible="state != 'posted'"/>
                    <button name="action_draft" string="Trở về nháp" type="object" invisible="state != 'rejected'" confirm="Bạn muốn chuyển trạng thái thành nháp ?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted,completed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="proposer_id" widget="many2one_avatar"/>
                        <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="general_note" string="Mục đích" placeholder="Nhập ghi chú hoặc mục đích"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <field name="expense_proposal_lines">
                        <tree>
                            <field name="sequence" widget="handle"/>
                            <field name="content" width="20%"/>
                            <field name="date" width="20%"/>
                            <field name ="object" width="20%" widget="many2one_avatar"/>
                            <field name="cost_classification" width="20%"/>
                            <field name="amount" width="20%" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="expense_category_id" width="20%"/>
                            <button name="action_view_payment_request" type="object" string="Xem Phiếu Chi" icon="fa-money" invisible="'payment_request_id', '=', False"/>
                            <field name ="currency_id" optional="hide"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_expense_proposal" model="ir.actions.act_window">
        <field name="name">Đề xuất chi phí</field>
        <field name="res_model">expense.proposal</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="action_view_payment_requests" model="ir.actions.act_window">
        <field name="name">Phiếu Chi</field>
        <field name="res_model">account.payment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('expense_proposal_id', '=', active_id)]</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_expense_proposal" name="Đề xuất chi phí" action="action_expense_proposal" parent="custom_account_menu.menu_accounting_vouchers" sequence="10"/>
</odoo>