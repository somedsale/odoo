<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menu cha -->

    <!-- Tree view Hợp đồng -->
    <record id="view_customer_contract_tree" model="ir.ui.view">
        <field name="name">customer.contract.tree</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <tree default_order="date desc">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="date"/>
                <field name ="ref_code"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="contact" />

                <field name="contract_type" optional="hide"/>
                <field name="settlement_value" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_total" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_invoiced" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_receipt" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_due" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" string="Tiền tệ" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Form view Hợp đồng -->
    <record id="view_customer_contract_form" model="ir.ui.view">
        <field name="name">customer.contract.form</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng">
                <sheet>
                    <group col="2">
                        <group>
                            <field name="name"/>
                            <field name="contract_id" widget="many2one"/>
                            <field name="date"/>
                            <field name="project_id" require="1" options="{'no_create':True}"/>
                            <field name="partner_id" require="1"/>
                            <field name="contact" />
                            <field name="management_id" invisible="1" force_save="1"/>
                            <field name ="ref_code"/>
                            <field name="settlement_value" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>

                        <group>
                            <field name="tax_id" widget="many2many_tags" domain="[('type_tax_use','in',('sale','none')), ('company_id','in', allowed_company_ids)]"/>
                            <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="warranty_amount"/>
                            <field name="warranty_time"/>
                            <field name="contract_type" />
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <field name="currency_id" string="Tiền tệ" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Hóa đơn">
                            <field name="invoice_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="invoice_number"/>
                                    <!-- <field name="project_id"/>
                                    <field name="partner_id"/> -->
                                    <field name="date"/>
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="account_tax_id" optional="show"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="amount_total" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="currency_id" string="Tiền tệ" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Phiếu thu">
                            <field name="receipt_ids" context="{'default_contract_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="note" string="Nội dung thu"/>
                                    <field name="partner_id"/>
                                    <field name="project_id"/>
                                    <!-- <field name="partner_id"/>
                                    <field name="project_id"/> -->
                                    <field name="amount" sum="Tổng tiền" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="payment_method"/>
                                    <field name="state"/>
                                    <field name="currency_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hồ sơ quyết toán">
                            <field name="settlement_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="settlement_number"/>
                                    <!-- <field name="project_id"/>
                                    <field name="partner_id"/> -->
                                    <field name="date"/>
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="tax_id" optional="show"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show"/>
                                    <field name="amount_settlement" sum="Tổng quyết toán" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" string="Tiền tệ" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_customer_contract_search" model="ir.ui.view">
        <field name="name">customer.contract.search</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <search string="Tìm hợp đồng">
                <!-- Các trường tìm kiếm cơ bản -->
                <field name="date"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="contract_number"/>
                <field name ="ref_code"/>
                <field name="contract_type"/>
                <field name="name"/>

                <!-- Bộ lọc nhanh -->
                <filter string="Hôm nay" name="today" domain="[('date','=', context_today())]"/>
                <filter string="Ngày ký" name="date_filter" date="date"/>
                <filter string="Ngày tạo" name="create_date_filter" date="create_date"/>
                <separator/>
                <!-- Search Panel -->
                <searchpanel>
                    <field name="partner_id" string="Khách hàng" icon="fa-user" enable_counters="1"/>
                    <field name="project_id" string="Dự án" icon="fa-folder" enable_counters="1"/>
                    <field name="contract_type" string="Loại" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Action mở hợp đồng -->
    <record id="action_customer_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng</field>
        <field name="res_model">customer.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_customer_contract_search"/>
    </record>
    <record id="action_customer_only" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('customer_rank','>',0), ('parent_id','=',False)]</field>
    </record>
    <menuitem id="menu_customer_debt_root" name="Công nợ khách hàng" parent="custom_account_menu.menu_accounting_custom_root" sequence="10"/>

    <!-- Menu hợp đồng -->
    <menuitem id="menu_customer_contract" name="Danh sách hợp đồng bán" parent="menu_customer_debt_root" action="action_customer_contract" sequence="20"/>
    <menuitem id="menu_customer_partner" name="Danh sách khách hàng" parent="menu_customer_debt_root" action="action_customer_only" sequence="100"/>

</odoo>
