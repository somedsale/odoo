<templates xml:space="preserve">
    <t t-name="executive_dashboard.Template" owl="1">
        <div class="ed-dashboard o_action">
            <!-- HEADER -->
            <div class="ed-header">
                <h2>📊 Dashboard Giám đốc</h2>
            </div>

            <!-- BODY (scrollable) -->
            <div class="ed-body">
                <t t-if="state.data">
                    <div class="ed-kpis">
                        <!-- KPI cards -->
                        <div class="ed-kpi-card">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-file-invoice"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>BÁO GIÁ</p>
                                <h3>
                                    <t t-esc="state.data.kpis.quotations.toLocaleString('vi-VN')"/>
                                </h3>
                            </div>
                        </div>
                        <div class="ed-kpi-card">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-shopping-cart"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>ĐƠN HÀNG</p>
                                <h3>
                                    <t t-esc="state.data.kpis.orders.toLocaleString('vi-VN')"/>
                                </h3>
                            </div>
                        </div>
                        <div class="ed-kpi-card">
                            <div class="ed-kpi-icon">
                                <i class="fa fa-percentage"></i>
                            </div>
                            <div class="ed-kpi-info">
                                <p>TỶ LỆ CHUYỂN ĐỔI</p>
                                <h3>
                                    <t t-esc="state.data.kpis.conversion_rate + ' %'"/>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <!-- 2 CỘT: Top sản phẩm + Khách hàng -->
                    <div class="ed-content-grid">
                        <div class="ed-list">
                            <h4>📊 Top sản phẩm: Báo giá vs Đơn hàng</h4>
                            <div style="height: 320px;">
                                <canvas t-ref="productChart"></canvas>
                            </div>
                        </div>

                        <div class="ed-list">
                            <h4>👥 Top 3 khách hàng tiêu biểu</h4>
                            <ul class="ed-top-customer-list">
                                <t t-set="stt" t-value="0"/>
                                <t t-foreach="state.data.top_customers" t-as="c" t-key="c.name" t-foreach-index="i">
                                    <t t-set="stt" t-value="stt + 1"/>
                                    <li>
                                        <div class="ed-top-left">
                                            <span class="rank">
                                                <t t-esc="stt"/>
                                            </span>
                                            <div class="name">
                                                <t t-esc="c.name"/>
                                                <small>
                                                    <t t-esc="c.order_count"/>
 đơn</small>
                                            </div>
                                        </div>
                                        <div class="ed-top-right">
                                            <span class="value">
                                                <t t-esc="c.total_value.toLocaleString('vi-VN')"/>
 ₫
                                            </span>
                                        </div>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </t>

                <t t-if="!state.data">
                    <div class="ed-empty">Chưa có dữ liệu hiển thị</div>
                </t>
            </div>            <!-- /.ed-body -->

            <!-- ===== Overlay & Filter ===== -->
            <div t-attf-class="ed-filter-overlay #{state.showFilters ? 'show' : ''}"></div>

            <div t-ref="filterPanel" t-attf-class="ed-filter-panel #{state.showFilters ? 'show' : ''}">
                <div class="ed-filter-header">
                    <h4>Bộ lọc</h4>
                    <button class="close-btn" t-on-click="toggleFilters">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="ed-filter-body">
                    <input type="date" t-model="state.filters.date_from" t-on-change="onChangeDate"/>
                    <input type="date" t-model="state.filters.date_to" t-on-change="onChangeDate"/>
                    <select t-model="state.filters.year" t-on-change="onChangeYear">
                        <option value="">---</option>
                        <t t-foreach="years" t-as="y" t-key="y">
                            <option t-att-value="y">
                                <t t-esc="y"/>
                            </option>
                        </t>
                    </select>
                    <select t-model="state.filters.quarter" t-on-change="onChangeQuarter">
                        <option value="">---</option>
                        <option value="Q1">Q1</option>
                        <option value="Q2">Q2</option>
                        <option value="Q3">Q3</option>
                        <option value="Q4">Q4</option>
                    </select>
                    <div class="ed-filter-actions">
                        <button class="btn btn-primary" t-on-click="applyFilters">Áp dụng</button>
                        <button class="btn btn-secondary" t-on-click="resetFilters">Đặt lại</button>
                    </div>
                </div>

            </div>

            <!-- FLOAT BUTTON -->
            <button t-attf-class="ed-filter-fab #{state.showFilters ? 'active' : ''}" t-on-click="toggleFilters">
                <i t-attf-class="fa #{state.showFilters ? 'fa-times' : 'fa-filter'}"></i>
            </button>
        </div>
    </t>
</templates>
