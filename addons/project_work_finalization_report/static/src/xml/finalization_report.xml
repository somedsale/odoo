<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="project_work_finalization_report.FinalizationReport">
        <div class="o_my_finalization_report pb-4 px-3">
            <div class="o_report_sticky_header mb-3 pt-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-outline-secondary" t-on-click="backToProjectList">
                            <i class="fa fa-arrow-left me-1"/>Quay lại
                        </button>
                        <button class="btn btn-outline-secondary" t-on-click="reload">
                            <i class="fa fa-refresh me-1"/>Tải lại
                        </button>
                        <button class="btn btn-primary"
                                t-if="!isReadonlyPeriod and !state.project.is_completed"
                                t-on-click="saveAll"
                                t-att-disabled="state.saving">
                            <t t-if="state.saving"><i class="fa fa-spinner fa-spin me-1"/>Đang lưu...</t>
                            <t t-else=""><i class="fa fa-save me-1"/>Lưu tất cả</t>
                        </button>
                    </div>

                    <div class="text-end ms-auto">
                        <h2 class="mb-1 o_page_title">
                            <t t-if="state.project.manager_mode">Báo cáo thanh/quyết toán quản lý</t>
                            <t t-else="">Báo cáo thanh/quyết toán của tôi</t>
                        </h2>
                    </div>
                </div>
            </div>

            <div t-if="state.loading" class="o_loading_box text-center py-5">
                <i class="fa fa-spinner fa-spin me-2"/>Đang tải dữ liệu...
            </div>

            <t t-else="">
                <div class="row g-3 mb-3">
<div class="col-12 col-xxl-7">
    <div class="card o_project_info h-100">
        <div class="card-body p-3 p-lg-4">
            <div class="o_project_info_head mb-3">
                <div class="o_project_info_label">Dự án</div>
                <div class="o_project_info_title" t-esc="state.project.name || ''"/>
            </div>

            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <div class="o_info_box">
                        <div class="o_info_label">Khách hàng</div>
                        <div class="o_info_value" t-esc="state.project.partner_name || ''"/>
                    </div>
                </div>


                <div class="col-12 col-md-6">
                    <div class="o_info_box">
                        <div class="o_info_label">Số hợp đồng</div>
                        <div class="o_info_value" t-esc="state.project.num_contract || ''"/>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="o_info_box">
                        <div class="o_info_label">Người phụ trách thanh/quyết toán</div>
                        <div class="o_info_value" t-esc="state.project.finalization_user_name || ''"/>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="o_info_box">
                        <div class="o_info_label">Ngày bắt đầu</div>
                        <div class="o_info_value" t-esc="state.project.date_start || ''"/>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="o_info_box">
                        <div class="o_info_label">Ngày kết thúc</div>
                        <div class="o_info_value" t-esc="state.project.date_end || state.project.date || ''"/>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="o_info_box">
                        <div class="o_info_label">Trạng thái</div>
                        <div class="o_info_value">
                            <span class="badge bg-success" t-if="state.project.is_completed">Đã hoàn thành</span>
                            <span class="badge bg-warning text-dark" t-elif="state.project.stage_name">
                                <t t-esc="state.project.stage_name"/>
                            </span>
                            <span class="badge bg-secondary" t-else="">Đang thực hiện</span>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="o_info_box">
                        <div class="o_info_label">Địa điểm</div>
                        <div class="o_info_value" t-esc="state.project.location|| ''"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

                    <div class="col-12 col-xxl-5">
                        <div class="card o_summary_card h-100">
                            <div class="card-body p-3 p-lg-4">
                                <div class="o_section_title mb-3">Tổng quan giá trị thanh/quyết toán</div>
                                <div class="row g-3">
                                    <div class="col-12 col-sm-6">
                                        <div class="o_metric_box">
                                            <div class="o_metric_label">Giá trị hợp đồng</div>
                                            <div class="o_metric_value" t-esc="formatMoney(state.project.value_contract_tax)"/>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="o_metric_box">
                                            <div class="o_metric_label">Giá trị đã thanh/quyết toán</div>
                                            <div class="o_metric_value" t-esc="formatMoney(state.project.value_finalized)"/>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="o_metric_box">
                                            <div class="o_metric_label">Giá trị còn lại</div>
                                            <div class="o_metric_value" t-esc="formatMoney(state.project.value_finalization_remaining)"/>
                                        </div>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <div class="o_metric_box o_metric_box_highlight">
                                            <div class="o_metric_label">% thanh/quyết toán</div>
                                            <div class="o_metric_value">
                                                <t t-esc="Math.round(state.project.finalization_percent || 0)"/>%
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12" t-if="state.project.manager_mode">
                        <div class="card o_filter_card">
                            <div class="card-body p-3">
                                <div class="row g-3 align-items-end">
                                    <div class="col-12 col-md-5 col-xl-4">
                                        <label class="form-label mb-1">Người báo cáo thanh/quyết toán</label>
                                        <select class="form-select" t-on-change="onProjectAssignUserChange">
                                            <option value="" t-att-selected="!state.projectAssignUserId">Chọn người báo cáo</option>
                                            <t t-foreach="state.assignableUsers" t-as="user" t-key="user.id">
                                                <option t-att-value="user.id" t-att-selected="user.id == state.projectAssignUserId">
                                                    <t t-esc="user.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-7 col-xl-8">
                                        <button class="btn btn-primary"
                                                t-on-click="assignProjectUser"
                                                t-att-disabled="!state.projectAssignUserId">
                                            Áp dụng cho toàn bộ hạng mục
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card o_filter_card">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                        <label class="fw-semibold mb-0">Chọn kỳ thanh/quyết toán:</label>
                                        <select class="form-select form-select-sm" style="width: 220px;" t-on-change="onPeriodChange">
                                            <t t-foreach="state.availablePeriods" t-as="periodNo" t-key="periodNo">
                                                <option t-att-value="periodNo" t-att-selected="periodNo == state.selectedPeriod">
                                                    Kỳ <t t-esc="periodNo"/>
                                                </option>
                                            </t>
                                        </select>
                                                                                <span class="text-muted small"
                                              t-if="selectedRows.length and selectedRows[0].period_start and selectedRows[0].period_end">
                                            (
                                            <t t-esc="formatDate(selectedRows[0].period_start)"/>
                                            -
                                            <t t-esc="formatDate(selectedRows[0].period_end)"/>
                                            )
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="o_table_wrap">
                    <div class="table-responsive">
<table class="table table-bordered table-sm align-middle o_report_table">
    <thead>
        <tr>
            <th colspan="3">Thông tin</th>
            <th colspan="2">Khối lượng</th>
            <th colspan="3">Thanh/Quyết toán</th>
            <th rowspan="2" style="min-width: 120px;">Đơn giá</th>
            <th colspan="5">Giá trị</th>
        </tr>
        <tr>
            <th style="min-width: 220px;">Hạng mục</th>
            <th style="min-width: 260px;">Mô tả</th>
            <th style="min-width: 90px;">ĐVT</th>
            <th style="min-width: 145px;">Khối lượng theo HĐ/TT</th>
            <th style="min-width: 135px;">Khối lượng phát sinh</th>
            <th style="min-width: 150px;">QT đến hết kỳ trước</th>
            <th style="min-width: 130px;">QT kỳ này</th>
            <th style="min-width: 150px;">QT đến hết kỳ này</th>
            <th style="min-width: 155px;">Tổng giá trị theo HĐ/TT</th>
            <th style="min-width: 160px;">GT đến hết kỳ trước</th>
            <th style="min-width: 145px;">GT kỳ này</th>
            <th style="min-width: 160px;">GT đến hết kỳ này</th>
            <th style="min-width: 150px;">GT còn lại</th>
        </tr>
    </thead>

    <tbody>
        <t t-foreach="groupedSelectedRows" t-as="group" t-key="group.section_name">
            <tr class="o_group_row">
                <td colspan="14" class="fw-bold">
                    <t t-esc="group.section_name"/>
                </td>
            </tr>

            <t t-foreach="group.rows" t-as="row" t-key="`${row.assignment_id}_${row.period_no}`">
                <tr t-att-class="row._dirty ? 'table-warning' : ''">
                    <td>
                        <div class="fw-semibold" t-esc="row.work_item_name || ''"/>
                    </td>

                    <td t-esc="row.description || ''"/>
                    <td class="text-center" t-esc="row.uom_name || ''"/>

                    <td class="text-end" t-esc="formatQty(row.contract_qty)"/>
                    <td class="text-end" t-esc="formatQty(row.qty_arise)"/>
                    <td class="text-end" t-esc="formatQty(row.prev_qty_cum)"/>

                    <td>
                        <t t-if="!isReadonlyPeriod and row.is_editable">
                            <input type="number"
                            min="0"
                                   step="any"
                                   class="form-control form-control-sm text-end"
                                   t-att-value="row.current_qty_week || 0"
                                   t-on-input="(ev) => this.onQtyInput(row, ev)"/>
                        </t>
                        <t t-else="">
                            <div class="text-end" t-esc="formatQty(row.current_qty_week)"/>
                        </t>
                    </td>

                    <td class="text-end" t-esc="formatQty(row.current_qty_cum)"/>
                    <td class="text-end" t-esc="formatMoney(row.price_unit_tax)"/>
                    <td class="text-end" t-esc="formatMoney(row.contract_value_tax)"/>
                    <td class="text-end" t-esc="formatMoney(row.prev_value_tax)"/>
                    <td class="text-end" t-esc="formatMoney(row.current_value_tax)"/>
                    <td class="text-end" t-esc="formatMoney(row.current_value_cum_tax)"/>
                    <td class="text-end" t-esc="formatMoney(row.value_remaining_tax)"/>
                </tr>
            </t>
        </t>

        <tr t-if="!groupedSelectedRows.length">
            <td colspan="14" class="text-center text-muted py-4">
                Không có dữ liệu để hiển thị.
            </td>
        </tr>
    </tbody>
</table>
                    </div>
                </div>
            </t>
            <div class="col-12 mt-3" t-if="!state.loading and state.projectId">
    <div class="card o_embedded_project_form_card">
        <div class="card-header">
            <h5 class="mb-0">Trao đổi dự án</h5>
        </div>
        <div class="card-body p-0">
            <View
                t-if="embeddedProjectFormProps"
                t-key="state.embeddedFormKey"
                t-props="embeddedProjectFormProps"
            />
        </div>
    </div>
</div>
        </div>
    </t>
</templates>