<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action report HTML -->
    <record id="customer_contract_by_partner_report_action_html" model="ir.actions.report">
        <field name="name">Báo cáo HĐ theo Khách hàng (HTML)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">customer_debt.customer_contract_by_partner_report</field>
        <field name="report_file">customer_debt.customer_contract_by_partner_report</field>
        <field name="print_report_name">'Bao cao hop dong - ' + (object.name or 'Khach hang')</field>
        <field name="paperformat_id" ref="customer_debt.custom_sale_report_a4_portrait"/>
    </record>

    <!-- Template QWeb: dùng layout của báo cáo tổng hợp -->
    <template id="customer_contract_by_partner_report">
        <t t-call="customer_debt.report_customer_summary_layout">
            <div class="page">
                <style>
                    .page { font-family: "Times New Roman"; font-size: 12pt; color: #000; }
                    .styled-table { border-collapse: collapse; margin: 0 auto; font-size: 12pt; width: 100%; border: 1px solid #000; table-layout: fixed; }
                    .styled-table thead tr { background-color: #C6E0B4; font-weight: bold; color: #000; text-align: center; }
                    .table-item { text-transform: uppercase; background-color: #E2EFDA; font-weight: bold; color: #000; }
                    .styled-table th, .styled-table td { font-size: 10pt; padding: 8px 12px; border: 1px solid #000; vertical-align: middle; overflow: hidden; word-wrap: break-word; overflow-wrap: anywhere; }
                    .styled-table tbody tr:hover { background-color: #D9EAD3; }
                    .text-center { text-align: center; }
                    .text-right { text-align: right; }
                    .num { white-space: nowrap; }
                </style>

                <h2 style="text-align:center; margin-bottom: 20px; font-size: 24px; text-transform: uppercase;">
                    Báo cáo hợp đồng theo khách hàng
                </h2>

                <div style="margin: 4px 0 10px;">
                    <strong>Khách hàng:</strong>
                    <t t-esc="partners_data and partners_data[0]['partner'].display_name or ''"/>
                </div>

                <table class="styled-table">
                    <!-- 13 cột -->
                    <colgroup>
                        <col style="width:4%"/>   <!-- 1: STT -->
                        <col style="width:16%"/>  <!-- 2: Hợp đồng (Dự án) -->
                        <col style="width:10%"/>  <!-- 3: Giá trị HĐ -->
                        <col style="width:12%"/>  <!-- 4: HSQT: Số/Ngày -->
                        <col style="width:10%"/>  <!-- 5: HSQT: Số tiền -->
                        <col style="width:8%"/>   <!-- 6: HĐ: Ngày -->
                        <col style="width:10%"/>  <!-- 7: HĐ: Số -->
                        <col style="width:10%"/>  <!-- 8: HĐ: Số tiền -->
                        <col style="width:8%"/>   <!-- 9: Thu: Ngày nhận -->
                        <col style="width:10%"/>  <!-- 10: Thu: Số tiền -->
                        <col style="width:10%"/>  <!-- 11: Còn nợ sau dòng -->
                        <col style="width:10%"/>  <!-- 12: Bảo hành -->
                        <col style="width:10%"/>  <!-- 13: Thời gian BH -->
                    </colgroup>

                    <thead>
                        <tr>
                            <th rowspan="2" class="num">STT</th>
                            <th rowspan="2">Hợp đồng (Dự án)</th>
                            <th rowspan="2">Giá trị Hợp đồng</th>
                            <th colspan="2">Hồ sơ quyết toán</th>
                            <th colspan="3">Hóa đơn</th>
                            <th colspan="2">Đã thu</th>
                            <th rowspan="2">Số tiền còn nợ</th>
                            <th rowspan="2">Giá trị bảo hành</th>
                            <th rowspan="2">Thời gian bảo hành</th>
                        </tr>
                        <tr>
                            <th>Số HS/ ngày</th>
                            <th>Số tiền</th>
                            <th>Ngày</th>
                            <th>Số</th>
                            <th>Số tiền</th>
                            <th>Ngày nhận</th>
                            <th>Số tiền</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="partners_data" t-as="blk">
                            <t t-set="stt" t-value="0"/>

                            <!-- Vòng nhóm Loại hợp đồng -->
                            <t t-foreach="blk['groups']" t-as="g">

                                <!-- Header nhóm: hiển thị tổng theo cột -->
                                <tr class="table-item" style="background-color:#E2EFDA;">
                                    <td class="text-center"></td>
                                    <td><t t-esc="g['label']"/></td>

                                    <td class="text-right">
                                        <t t-if="g['totals']['amount_total']">
                                            <span t-esc="g['totals']['amount_total']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>

                                    <td class="text-center"></td>
                                    <td class="text-right">
                                        <t t-if="g['totals']['amount_final']">
                                            <span t-esc="g['totals']['amount_final']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>

                                    <td class="text-center"></td>
                                    <td class="text-center"></td>
                                    <td class="text-right">
                                        <t t-if="g['totals']['amount_invoiced']">
                                            <span t-esc="g['totals']['amount_invoiced']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>

                                    <td class="text-center"></td>
                                    <td class="text-right">
                                        <t t-if="g['totals']['amount_paid']">
                                            <span t-esc="g['totals']['amount_paid']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>

                                    <td class="text-right">
                                        <t t-if="g['totals']['amount_due']">
                                            <span t-esc="g['totals']['amount_due']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <t t-if="g['totals']['warranty_amount']">
                                            <span t-esc="g['totals']['warranty_amount']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>
                                    <td class="text-center"></td>
                                </tr>

                                <!-- Hợp đồng: Invoice -> Receipts (dòng chi tiết) -->
                                <t t-foreach="g['items']" t-as="ct">
                                    <t t-set="stt" t-value="stt + 1"/>
                                    <t t-set="row_idx" t-value="0"/>
                                    <t t-set="rows" t-value="ct['rows'] if ct.get('rows') else [ {} ]"/>

                                    <t t-foreach="rows" t-as="row">
                                        <t t-set="row_idx" t-value="row_idx + 1"/>
                                        <tr>
                                            <!-- 1. STT: chỉ dòng đầu của từng HĐ -->
                                            <td class="text-center">
                                                <t t-if="row_idx == 1"><t t-esc="stt"/></t>
                                            </td>

                                            <!-- 2. Hợp đồng (Dự án): chỉ dòng đầu của HĐ -->
                                            <td>
                                                <t t-if="row_idx == 1">
                                                    <t t-if="ct['project']"><t t-esc="ct['project'].display_name"/> – </t>
                                                    <t t-esc="ct['name']"/>
                                                </t>
                                            </td>

                                            <!-- 3. Giá trị HĐ: chỉ dòng đầu của HĐ -->
                                            <td class="text-right">
                                                <t t-if="row_idx == 1 and ct['amount_total']">
                                                    <span t-esc="ct['amount_total']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                                </t>
                                            </td>

                                            <!-- 4. HSQT: Số/Ngày: in 1 lần ở hóa đơn đầu tiên của HĐ -->
                                            <td class="text-center">
                                                <t t-if="row.get('print_contract_columns')">
                                                    <t t-esc="ct['sett_numbers'] or '-'"/> <t t-esc="ct['sett_dates'] or '-'"/>
                                                </t>
                                            </td>

                                            <!-- 5. HSQT: Số tiền -->
                                            <td class="text-right">
                                                <t t-if="row.get('print_contract_columns') and ct['amount_final']">
                                                    <span t-esc="ct['amount_final']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                                </t>
                                            </td>

                                            <!-- 6-8. Hóa đơn: Ngày / Số / Số tiền (chỉ trên dòng đầu của mỗi hóa đơn) -->
                                            <td class="text-center"><t t-esc="row.get('invoice_date') or ''"/></td>
                                            <td class="text-center"><t t-esc="row.get('invoice_number') or ''"/></td>
                                            <td class="text-right">
                                                <t t-if="row.get('invoice_amount')">
                                                    <span t-esc="row.get('invoice_amount')" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                                </t>
                                            </td>

                                            <!-- 9-10. Đã thu: Ngày nhận / Số tiền -->
                                            <td class="text-center"><t t-esc="row.get('receipt_date') or ''"/></td>
                                            <td class="text-right">
                                                <t t-if="row.get('receipt_amount')">
                                                    <span t-esc="row.get('receipt_amount')" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                                </t>
                                            </td>

                                            <!-- 11. Còn nợ (sau dòng hiện tại) -->
                                            <td class="text-right">
                                                <t t-if="row.get('residual_after') is not None">
                                                    <span t-esc="row.get('residual_after')" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                                </t>
                                            </td>

                                            <!-- 12. Bảo hành: chỉ dòng đầu của HĐ -->
                                            <td class="text-right">
                                                <t t-if="row_idx == 1 and ct['warranty_amount']">
                                                    <span t-esc="ct['warranty_amount']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                                </t>
                                            </td>

                                            <!-- 13. Thời gian BH: chỉ dòng đầu của HĐ -->
                                            <td class="text-center">
                                                <t t-if="row_idx == 1 and ct.get('warranty_period')"><t t-esc="ct['warranty_period']"/></t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <!-- Subtotal: Tổng Còn nợ của NHÓM -->
                                <tr style="background:#FCE4D6; font-weight:bold;">
                                    <td></td>
                                    <td class="text-right">Tổng còn nợ nhóm:</td>
                                    <td class="text-right"></td>
                                    <td class="text-center"></td>
                                    <td class="text-right"></td>
                                    <td class="text-center"></td>
                                    <td class="text-center"></td>
                                    <td class="text-right"></td>
                                    <td class="text-center"></td>
                                    <td class="text-right"></td>
                                    <td class="text-right">
                                        <t t-if="g['totals']['amount_due']">
                                            <span t-esc="g['totals']['amount_due']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                        </t>
                                    </td>
                                    <td class="text-right"></td>
                                    <td class="text-center"></td>
                                </tr>

                            </t>

                            <!-- Tổng toàn bộ cho KH -->
                            <tr style="background:#DDEBF7; font-weight:bold;">
                                <td></td>
                                <td class="text-right">Tổng toàn bộ:</td>
                                <td class="text-right">
                                    <t t-if="blk['grand_totals']['amount_total']">
                                        <span t-esc="blk['grand_totals']['amount_total']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td class="text-center"></td>
                                <td class="text-right">
                                    <t t-if="blk['grand_totals']['amount_final']">
                                        <span t-esc="blk['grand_totals']['amount_final']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td class="text-center"></td>
                                <td class="text-center"></td>
                                <td class="text-right">
                                    <t t-if="blk['grand_totals']['amount_invoiced']">
                                        <span t-esc="blk['grand_totals']['amount_invoiced']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td class="text-center"></td>
                                <td class="text-right">
                                    <t t-if="blk['grand_totals']['amount_paid']">
                                        <span t-esc="blk['grand_totals']['amount_paid']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td class="text-right">
                                    <t t-if="blk['grand_totals']['amount_due']">
                                        <span t-esc="blk['grand_totals']['amount_due']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td class="text-right"></td>
                                <td class="text-center"></td>
                            </tr>

                            <!-- Dòng nhấn mạnh: TỔNG CỘNG CÒN NỢ -->
                            <tr style="background:#BDD7EE; font-weight:bold;">
                                <td colspan="10" class="text-right">TỔNG CỘNG CÒN NỢ:</td>
                                <td class="text-right">
                                    <t t-if="blk['grand_totals']['amount_due']">
                                        <span t-esc="blk['grand_totals']['amount_due']" t-options="{'widget':'monetary','display_currency':res_company.currency_id}"/>
                                    </t>
                                </td>
                                <td></td>
                                <td></td>
                            </tr>

                        </t>
                    </tbody>
                </table>

                <!-- Chữ ký -->
                <div style="page-break-inside: avoid; style: font-weight: bold">
                    <div class="row">
                        <div class="col-6" style="text-align:center;line-height:1.8">
                            <div>
                                TP Hồ Chí Minh ngày <span t-esc="datetime.datetime.today().day"/>
                                tháng <span t-esc="datetime.datetime.today().month"/>
                                năm <span t-esc="datetime.datetime.today().year"/>
                            </div>
                            <div><span>Người lập biểu</span></div>
                            <div style="height:65px">
                                <t t-if="user_id.digital_signature">
                                    <img t-att-src="'data:image/png;base64,' + (user_id.digital_signature.decode() if isinstance(user_id.digital_signature, bytes) else user_id.digital_signature)" style="max-height:65px; max-width:150px;"/>
                                </t>
                            </div>
                            <div><span t-field="user_id.name"/></div>
                        </div>

                        <div class="col-6" style="text-align:center;line-height:1.8">
                            <div>
                                TP Hồ Chí Minh ngày <span t-esc="datetime.datetime.today().day"/>
                                tháng <span t-esc="datetime.datetime.today().month"/>
                                năm <span t-esc="datetime.datetime.today().year"/>
                            </div>
                            <div> Giám Đốc </div>
                            <div style="height:65px">
                                <t t-set="director_group" t-value="env.ref('custom_director_role.group_director')"/>
                                <t t-set="director" t-value="env['res.users'].search([('groups_id', 'in', director_group.id)], limit=1)"/>
                                <t t-if="director and director.digital_signature">
                                    <img t-att-src="'data:image/png;base64,' + (director.digital_signature.decode() if isinstance(director.digital_signature, bytes) else director.digital_signature)" style="max-height:65px; max-width:150px;"/>
                                </t>
                            </div>
                            <div><span> Đỗ Minh Toàn </span></div>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>

</odoo>
