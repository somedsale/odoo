<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ad.AccountingDashboard" owl="1">
        <div class="ad-dashboard o_action">
            <!-- ===== HEADER ===== -->
            <div class="ad-header">
                <div class="ad-header__left">
                    <h2 class="ad-title">💼 KẾ TOÁN</h2>
                    <p class="ad-subtitle">Tổng quan dòng tiền và công nợ</p>
                </div>
                <div class="ad-header__filters">
                    <label>
                        <span>Kiểu lọc:</span>
                        <select class="ad-select" t-att-value="state.filters.period_type" t-on-change="onPeriodTypeChange">
                            <option value="custom">Tùy chọn</option>
                            <option value="month">Theo tháng</option>
                            <option value="quarter">Theo quý</option>
                            <option value="year">Theo năm</option>
                        </select>
                    </label>

                    <t t-if="state.filters.period_type === 'month' or state.filters.period_type === 'quarter' or state.filters.period_type === 'year'">
                        <label>
                            <span>Năm:</span>
                            <select class="ad-select" t-att-value="state.filters.year" t-on-change="onYearChange">
                                <t t-foreach="yearOptions" t-as="year" t-key="year">
                                    <option t-att-value="year">
                                        <t t-esc="year"/>
                                    </option>
                                </t>
                            </select>
                        </label>
                    </t>

                    <t t-if="state.filters.period_type === 'month'">
                        <label>
                            <span>Tháng:</span>
                            <select class="ad-select" t-att-value="state.filters.month" t-on-change="onMonthChange">
                                <t t-foreach="monthOptions" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value">
                                        <t t-esc="m.label"/>
                                    </option>
                                </t>
                            </select>
                        </label>
                    </t>

                    <t t-if="state.filters.period_type === 'quarter'">
                        <label>
                            <span>Quý:</span>
                            <select class="ad-select" t-att-value="state.filters.quarter" t-on-change="onQuarterChange">
                                <t t-foreach="quarterOptions" t-as="q" t-key="q.value">
                                    <option t-att-value="q.value">
                                        <t t-esc="q.label"/>
                                    </option>
                                </t>
                            </select>
                        </label>
                    </t>

                    <t t-if="state.filters.period_type === 'custom'">
                        <label>
                            <span>Từ:</span>
                            <input type="date" t-att-value="state.filters.date_from" t-on-change="onDateFromChange"/>
                        </label>
                        <label>
                            <span>Đến:</span>
                            <input type="date" t-att-value="state.filters.date_to" t-on-change="onDateToChange"/>
                        </label>
                    </t>

                    <button class="ad-btn" t-on-click="applyFilter">
                        <i class="fa fa-filter me-1"></i>
                        <span class="btn-filter-text">Áp dụng</span>
                    </button>
                </div>
            </div>

            <!-- ===== CONTENT ===== -->
            <div class="ad-content o_content">

                <!-- KPI SECTION -->
                <div class="ad-kpi-grid">
                    <div class="ad-card kpi" t-on-click="openReceipts">
                        <div class="ad-icon bg-green">
                            <i class="fa fa-arrow-down"></i>
                        </div>
                        <div class="ad-info">
                            <span class="ad-label">Tiền thu</span>
                            <span class="ad-value" t-esc="state.kpis.cash_in" />
                        </div>
                    </div>
                    <div class="ad-card kpi" t-on-click="openPayments">
                        <div class="ad-icon bg-red">
                            <i class="fa fa-arrow-up"></i>
                        </div>
                        <div class="ad-info">
                            <span class="ad-label">Tiền chi</span>
                            <span class="ad-value" t-esc="state.kpis.cash_out" />
                        </div>
                    </div>
                    <div class="ad-card kpi">
                        <div class="ad-icon bg-blue">
                            <i class="fa fa-bar-chart"></i>
                        </div>
                        <div class="ad-info">
                            <span class="ad-label">Chênh lệch</span>
                            <span class="ad-value" t-esc="state.kpis.net_cash" />
                        </div>
                    </div>
                    <div class="ad-card kpi" t-on-click="openAdvances">
                        <div class="ad-icon bg-yellow">
                            <i class="fa fa-handshake-o"></i>
                        </div>
                        <div class="ad-info">
                            <span class="ad-label">Tạm ứng cần thu</span>
                            <span class="ad-value" t-esc="state.kpis.advance_remain_total" />
                        </div>
                    </div>
                </div>

                <!-- ===== CHART ROW ===== -->
                <div class="ad-grid chart-row">
                    <!-- Left mini cards -->
                    <div class="ad-block">
                        <div class="ad-mini-grid">
                            <div class="ad-card mini" t-on-click="openProposals">
                                <div class="ad-icon bg-amber">
                                    <i class="fa fa-tasks"></i>
                                </div>
                                <div class="ad-info">
                                    <span class="ad-label">Đề xuất cần xử lý</span>
                                    <span class="ad-value" t-esc="state.proposal_pending_count" />
                                </div>
                            </div>
                            <div class="ad-card mini" t-on-click="openPaymentProposals">
                                <div class="ad-icon bg-indigo">
                                    <i class="fa fa-clipboard"></i>
                                </div>
                                <div class="ad-info">
                                    <span class="ad-label">Giải chi cần xử lý</span>
                                    <span class="ad-value" t-esc="state.payment_proposals_pending_count" />
                                </div>
                            </div>
                            <div class="ad-card mini" t-on-click="openCustomerInvoices">
                                <div class="ad-icon bg-purple">
                                    <i class="fa fa-file"></i>
                                </div>
                                <div class="ad-info">
                                    <span class="ad-label">HĐ đầu ra</span>
                                    <span class="ad-value" t-esc="state.kpis.total_customer_invoice" />
                                </div>
                            </div>
                            <div class="ad-card mini" t-on-click="openSupplierInvoices">
                                <div class="ad-icon bg-cyan">
                                    <i class="fa fa-line-chart"></i>
                                </div>
                                <div class="ad-info">
                                    <span class="ad-label">HĐ đầu vào</span>
                                    <span class="ad-value" t-esc="state.kpis.total_supplier_invoice" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Middle chart -->
                    <div class="ad-block">
                        <div class="ad-block__head">
                            <h3>Dòng tiền theo khoảng ngày</h3>
                        </div>
                        <canvas t-ref="dailyFlowChart" class="ad-chart medium" />
                    </div>

                    <!-- Right chart -->
                    <div class="ad-block">
                        <div class="ad-block__head">
                            <h3>Nhân viên chưa thu tạm ứng</h3>
                        </div>
                        <canvas t-ref="remainChart" class="ad-chart small" />
                    </div>
                </div>

                <!-- ===== TABLES ===== -->
                <div class="ad-grid">
                    <div class="ad-block">
                        <div class="ad-block__head">
                            <h3>Hóa đơn đầu vào (Nhà cung cấp)</h3>
                        </div>
                        <div class="ad-table-wrapper">
                            <table class="ad-table">
                                <thead>
                                    <tr>
                                        <th>Mã HĐ</th>
                                        <th>Nhà cung cấp</th>
                                        <th>Ngày HĐ</th>
                                        <th class="right">Tổng tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.supplier_invoices.length">
                                        <tr>
                                            <td colspan="4" class="empty">Không có hóa đơn</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.supplier_invoices" t-as="inv" t-key="inv.id">
                                        <tr t-on-click="() => this.openDetailSupplierInvoice(inv.id)" class="wt-row--click">
                                            <td>
                                                <t t-esc="inv.invoice_number" />
                                            </td>
                                            <td>
                                                <t t-esc="inv.partner_id &amp;&amp; inv.partner_id[1]" />
                                            </td>
                                            <td>
                                                <t t-esc="fmtDate(inv.date)" />
                                            </td>
                                            <td class="right">
                                                <t t-esc="fmtVND(inv.amount)" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="ad-block">
                        <div class="ad-block__head">
                            <h3>Hóa đơn đầu ra (Khách hàng)</h3>
                        </div>
                        <div class="ad-table-wrapper">
                            <table class="ad-table">
                                <thead>
                                    <tr>
                                        <th>Mã HĐ</th>
                                        <th>Khách hàng</th>
                                        <th>Ngày</th>
                                        <th class="right">Tổng tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.customer_invoices.length">
                                        <tr>
                                            <td colspan="4" class="empty">Không có hóa đơn</td>
                                        </tr>
                                    </t>
                                    <t t-foreach="state.customer_invoices" t-as="inv" t-key="inv.id">
                                        <tr t-on-click="() => this.openDetailCustomerInvoice(inv.id)" class="wt-row--click">
                                            <td>
                                                <t t-esc="inv.invoice_number" />
                                            </td>
                                            <td>
                                                <t t-esc="inv.partner_id &amp;&amp; inv.partner_id[1]" />
                                            </td>
                                            <td>
                                                <t t-esc="fmtDate(inv.date)" />
                                            </td>
                                            <td class="right">
                                                <t t-esc="fmtVND(inv.amount_total)" />
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
