<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <record id="view_document_create_folder_wizard_form" model="ir.ui.view">
    <field name="name">document.create.folder.wizard.form</field>
    <field name="model">document.create.folder.wizard</field>
    <field name="arch" type="xml">
<form string="Create Folder">
  <sheet>
<group>
  <field name="name"/>
  <field name="parent_id"/>
  <field name="access_level"/>
</group>

<group string="USERS" col="2" invisible="access_level != 'shared'">
  <field name="writable_user_ids" widget="many2many_tags" domain="[('share','=',False)]"/>
  <field name="readable_user_ids" widget="many2many_tags" domain="[('share','=',False)]"/>
  <field name="own_document_only_user_ids" widget="many2many_tags" domain="[('share','=',False)]"/>
</group>


  </sheet>

  <footer>
    <button string="Create" type="object" name="action_create_folder" class="btn-primary"/>
    <button string="Cancel" special="cancel" class="btn-secondary"/>
  </footer>
</form>

    </field>
  </record>

  <record id="action_document_create_folder_wizard" model="ir.actions.act_window">
    <field name="name">Create Folder</field>
    <field name="res_model">document.create.folder.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_document_create_folder_wizard_form"/>
    <field name="target">new</field>
  </record>

</odoo>
