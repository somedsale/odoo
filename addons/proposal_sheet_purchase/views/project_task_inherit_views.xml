<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Đảm bảo có button box -->
    <record id="project_task_form_add_button_box" model="ir.ui.view">
      <field name="name">project.task.form.add.button.box</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2"/>
      <field name="arch" type="xml">
        <xpath expr="//form/sheet" position="inside">
          <div class="oe_button_box" name="button_box"/>
        </xpath>
      </field>
    </record>

    <!-- Smart button: Đơn mua hàng -->
    <record id="project_task_form_inherit_po_button" model="ir.ui.view">
      <field name="name">project.task.form.inherit.po.button</field>
      <field name="model">project.task</field>
      <field name="inherit_id" ref="project.view_task_form2"/>
      <field name="arch" type="xml">
        <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
          <button name="action_view_task_purchase_orders"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-shopping-cart"
                  invisible="purchase_order_count == 0">
            <field name="purchase_order_count" string="Đơn mua hàng" widget="statinfo"/>
          </button>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
