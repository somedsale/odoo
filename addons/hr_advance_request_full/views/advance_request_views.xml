<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_somed_advance_request_tree" model="ir.ui.view">
        <field name="name">somed.advance.request.tree</field>
        <field name="model">somed.advance.request</field>
        <field name="arch" type="xml">
            <tree string="Phiếu tạm ứng" decoration-success="state == 'approved'" decoration-warning="state in ('manager_waiting','accountant_waiting','director_waiting')" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="request_date"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="reason"/>
                <field name="amount"/>
                <field name="payment_request_id" optional="show"/>
                <field name="payment_request_state" optional="hide"/>
                <field name="payment_request_status_expense" optional="show" widget="badge"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_somed_advance_request_form" model="ir.ui.view">
        <field name="name">somed.advance.request.form</field>
        <field name="model">somed.advance.request</field>
        <field name="arch" type="xml">
            <form string="Phiếu tạm ứng">
                <header>
                    <button name="action_submit" string="Trình duyệt" type="object" class="btn-primary" invisible="not can_submit"/>
                    <button name="action_manager_approve" string="Trưởng bộ phận duyệt" type="object" class="btn-primary" invisible="not can_manager_approve"/>
                    <button name="action_accountant_approve" string="Kế toán tổng hợp duyệt" type="object" class="btn-primary" invisible="not can_accountant_approve"/>
                    <button name="action_director_approve" string="Giám đốc duyệt" type="object" class="btn-primary" invisible="not can_director_approve"/>
                    <button name="action_open_reject_wizard" string="Từ chối" type="object" class="btn-secondary" invisible="not can_reject"/>
                    <button name="action_cancel" string="Hủy phiếu" type="object" invisible="not can_cancel"/>
                    <button name="action_reset_to_draft" string="Đưa về nháp" type="object" invisible="not can_reset"/>
                    <button name="action_create_payment_request" string="Tạo phiếu chi" type="object" class="btn-primary" invisible="not can_create_payment_request"/>
                    <button name="action_view_payment_request" string="Xem phiếu chi" type="object" invisible="not payment_request_id"/>
                    <button name="action_print_pdf" string="In PDF" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,manager_waiting,accountant_waiting,director_waiting,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="TỪ CHỐI" bg_color="text-bg-danger" invisible="state != 'rejected' and payment_request_state != 'cancelled'"/>
                    <widget name="web_ribbon" title="ĐÃ CHI" bg_color="text-bg-success" invisible="state == 'rejected' or payment_request_state == 'cancelled' or not payment_request_id or payment_request_status_expense != 'paid'"/>
                    <widget name="web_ribbon" title="CHƯA CHI" bg_color="text-bg-warning" invisible="state == 'rejected' or payment_request_state == 'cancelled' or not payment_request_id or payment_request_status_expense == 'paid'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_request" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_request_id">
                            <field name="payment_request_count" widget="statinfo" string="Phiếu chi"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin người tạm ứng">
                            <field name="request_date" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="department_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="manager_user_id" invisible="1"/>
                            <field name="user_id" invisible="1"/>
                        </group>
                        <group string="Thông tin tạm ứng">
                            <field name="reason" readonly="state != 'draft'" placeholder="Nhập lý do tạm ứng..."/>
                            <field name="advance_document" readonly="state != 'draft'" placeholder="Ví dụ: Đề nghị mua vật tư, công tác phí..."/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="amount_text" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Thông tin duyệt">
                            <group>
                                <group string="Trưởng bộ phận">
                                    <field name="manager_approved_by" readonly="1"/>
                                    <field name="manager_approved_date" readonly="1"/>
                                </group>
                                <group string="Kế toán tổng hợp">
                                    <field name="accountant_approved_by" readonly="1"/>
                                    <field name="accountant_approved_date" readonly="1"/>
                                </group>
                                <group string="Giám đốc">
                                    <field name="director_approved_by" readonly="1"/>
                                    <field name="director_approved_date" readonly="1"/>
                                </group>
                                <group string="Từ chối" invisible="state != 'rejected'">
                                    <field name="reject_reason" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Phiếu chi">
                            <group>
                                <field name="payment_request_id" readonly="1"/>
                                <field name="payment_request_state" readonly="1"/>
                                <field name="payment_request_status_expense" readonly="1"/>
                                <field name="payment_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="can_submit" invisible="1"/>
                    <field name="can_manager_approve" invisible="1"/>
                    <field name="can_accountant_approve" invisible="1"/>
                    <field name="can_director_approve" invisible="1"/>
                    <field name="can_reject" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <field name="can_reset" invisible="1"/>
                    <field name="can_create_payment_request" invisible="1"/>
                    <field name="payment_request_id" invisible="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_somed_advance_request_search" model="ir.ui.view">
        <field name="name">somed.advance.request.search</field>
        <field name="model">somed.advance.request</field>
        <field name="arch" type="xml">
            <search string="Tìm phiếu tạm ứng">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="reason"/>
                <filter string="Phiếu của tôi" name="my_requests" domain="[('user_id','=',uid)]"/>
                <filter string="Chờ duyệt" name="waiting" domain="[('state','in',('manager_waiting','accountant_waiting','director_waiting'))]"/>
                <filter string="Đã duyệt" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Từ chối" name="rejected" domain="[('state','=','rejected')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Trạng thái" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Nhân viên" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Đơn vị" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="Tháng" name="group_month" context="{'group_by':'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_somed_advance_request" model="ir.actions.act_window">
        <field name="name">Phiếu tạm ứng</field>
        <field name="res_model">somed.advance.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tạo phiếu đề nghị tạm ứng đầu tiên</p>
        </field>
    </record>

    <menuitem id="menu_somed_advance_root"
              name="Tạm ứng"
              sequence="35"
              action="action_somed_advance_request"
              groups="base.group_user"
              web_icon="hr_advance_request_full,static/description/icon.png"/>
    <menuitem id="menu_somed_advance_request" name="Phiếu tạm ứng" parent="menu_somed_advance_root" action="action_somed_advance_request" sequence="10" groups="base.group_user"/>
</odoo>
