<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract Form View (giữ nguyên phần bạn đang dùng) -->
    <record id="view_contract_management_form" model="ir.ui.view">
        <field name="name">contract.management.form</field>
        <field name="model">contract.management</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_cancel" type="object" string="Hủy hợp đồng" class="btn-danger" invisible="stage in ('completed','canceled') or context.get('from_project_menu')"/>
                    <button name="action_to_executing" type="object" string="Bắt đầu thực hiện" class="btn-primary" invisible="stage != 'negotiating' or context.get('from_project_menu')"/>
                    <!-- <button name="action_to_completed" type="object" string="Hoàn thành" class="btn-success" invisible="stage != 'executing'"/> -->
                    <field name="stage" widget="statusbar" decoration-info="stage == 'negotiating'" decoration-primary="stage == 'executing'" decoration-success="stage == 'completed'" statusbar_visible="negotiating,executing,completed,canceled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="name"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" options="{'no_create': True}" readonly="1"/>
                            <field name="num_contract"/>
                            <field name="partner_id" options="{'no_create': True}" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tax_id" widget="many2many_tags" domain="[('type_tax_use','in',('sale','none')), ('company_id','in', allowed_company_ids)]"/>
                            <field name="amount_untaxed" />
                            <field name="contract_value"/>
                            <field name="warranty_time"/>
                        </group>
                        <group>
                            <field name="location" string="Địa điểm thực hiện"/>
                            <field name="sales_category_ids" widget="many2many_tags" options="{'color_field': 'color'}" string="Hạng mục bán hàng"/>
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                            <field name="signature_date" string ="Ngày ký hợp đồng"/>
                            <!-- Hai ngày mới thêm để người dùng nhập -->
                            <!-- <field name="date_execution"/>
                            <field name="date_completion"/> -->
                            <field name="description" placeholder="Thêm mô tả cho hợp đồng"/>
                            <field name="attachment_ids" widget="many2many_binary" string="Đính kèm tài liệu"/>
                        </group>
                    </group>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Contract Tree View: thêm 2 cột ngày + sửa badge bỏ 'preparing' -->
    <record id="view_contract_management_tree" model="ir.ui.view">
        <field name="name">contract.management.tree</field>
        <field name="model">contract.management</field>
        <field name="arch" type="xml">
            <tree string="Contracts">
                <field name="name"/>
                <field name="num_contract"/>
                <field name="contract_value" sum="Tổng" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="location"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="signature_date"/>
                <field name="currency_id" optional="hide"/>
                <field name="stage" widget="badge" decoration-info="stage == 'negotiating'" decoration-primary="stage == 'executing'" decoration-success="stage == 'completed'"/>
            </tree>
        </field>
    </record>

    <!-- 🔍 Contract Search View: bộ lọc theo trạng thái + ngày (Tháng/Quý/Năm/Tuần) -->
    <record id="view_contract_management_search" model="ir.ui.view">
        <field name="name">contract.management.search</field>
        <field name="model">contract.management</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Hợp đồng">
                <field name="name"/>
                <field name="num_contract"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <field name="project_id"/>
                <field name="stage"/>

                <!--  Bộ lọc trạng thái nhanh  -->
                <filter string="Đang thương thảo" name="stg_negotiating" domain="[('stage','=','negotiating')]"/>
                <filter string="Đang thực hiện" name="stg_executing" domain="[('stage','=','executing')]"/>
                <filter string="Hoàn thành" name="stg_completed" domain="[('stage','=','completed')]"/>
                <filter string="Đã hủy" name="stg_canceled" domain="[('stage','=','canceled')]"/>

                <!--  Bộ lọc theo ngày: Odoo sẽ hiện menu (Hôm nay, Tuần này, Tháng này, Quý này, Năm nay, Tùy chọn...)  -->
                <!-- Ngày thực hiện -->
                <filter string="Ngày thực hiện" name="date_exec_filter" date="date_execution"/>
                <!-- Ngày hoàn thành -->
                <filter string="Ngày hoàn thành" name="date_comp_filter" date="date_completion"/>

                <!--  Nhóm theo (Group By)  -->
                <group expand="0" string="Nhóm theo">
                    <!-- Group by Stage -->
                    <filter string="Trạng thái" name="grp_stage" context="{'group_by':'stage'}"/>

                    <!-- Group by đối tác / đơn bán -->
                    <filter string="Khách hàng" name="grp_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Đơn bán" name="grp_sale_order" context="{'group_by':'sale_order_id'}"/>
                    <filter string="Dự án" name="grp_project" context="{'group_by':'project_id'}"/>

                    <!-- Group by Ngày thực hiện -->
                    <filter string="Thực hiện - Năm" name="grp_exec_year" context="{'group_by':'date_execution:year'}"/>
                    <filter string="Thực hiện - Quý" name="grp_exec_quarter" context="{'group_by':'date_execution:quarter'}"/>
                    <filter string="Thực hiện - Tháng" name="grp_exec_month" context="{'group_by':'date_execution:month'}"/>
                    <filter string="Thực hiện - Tuần" name="grp_exec_week" context="{'group_by':'date_execution:week'}"/>

                    <!-- Group by Ngày hoàn thành -->
                    <filter string="Hoàn thành - Năm" name="grp_comp_year" context="{'group_by':'date_completion:year'}"/>
                    <filter string="Hoàn thành - Quý" name="grp_comp_quarter" context="{'group_by':'date_completion:quarter'}"/>
                    <filter string="Hoàn thành - Tháng" name="grp_comp_month" context="{'group_by':'date_completion:month'}"/>
                    <filter string="Hoàn thành - Tuần" name="grp_comp_week" context="{'group_by':'date_completion:week'}"/>
                </group>

                <!-- (Tùy chọn) Search Panel cho Stage/Partner -->
                <searchpanel>
                    <field name="stage"/>
                    <field name="partner_id" icon="fa-user"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ir_actions_server_backfill_customer_contracts" model="ir.actions.server">
        <field name="name">Đồng bộ Customer Contract</field>
        <field name="model_id" ref="model_contract_management"/>
        <field name="binding_model_id" ref="model_contract_management"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_backfill_customer_contracts()</field>
    </record>

    <!-- Action for Contract Menu: gắn search view -->
    <record id="action_contract_management" model="ir.actions.act_window">
        <field name="name">Hợp đồng</field>
        <field name="res_model">contract.management</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_contract_management_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Click to create a new contract.</p>
        </field>
    </record>
    <record id="action_project_contract_readonly" model="ir.actions.act_window">
        <field name="name">Hợp đồng dự án</field>
        <field name="res_model">contract.management</field>
        <field name="view_mode">tree,form</field>
        <field name="context">
        {
            'from_project_menu': True,
            'create': False,
            'edit': False,
            'delete': False,
            'form_view_initial_mode': 'readonly'
        }
        </field>
    </record>
    <!-- Menu -->
    <menuitem id="menu_contract_management_root" name="Hợp đồng" sequence="10" parent="sale.sale_menu_root"/>
    <menuitem id="menu_contract_management" name="Hợp đồng" action="action_contract_management" parent="menu_contract_management_root" sequence="10"/>
    <menuitem id="menu_project_contract_readonly" name="Hợp đồng" parent="project.menu_main_pm" action="action_project_contract_readonly" sequence="60"/>
    <menuitem id="menu_project_contract_readonly_user" name="Hợp đồng" parent="custom_project_role.menu_main_pm_user" action="action_project_contract_readonly" sequence="60"/>
</odoo>
