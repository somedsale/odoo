<odoo>
    <!-- ===================== FORM VIEW ===================== -->
    <record id="view_account_payment_proposal_form" model="ir.ui.view">
        <field name="name">account.payment.proposal.form</field>
        <field name="model">account.payment.proposal</field>
        <field name="arch" type="xml">
            <form string="Giấy đề nghị giải chi" create="true" edit="true">
                <header>
                    <field name="can_edit_invoice" invisible="1"/>
                    <field name="can_submit" invisible="1"/>
                    <field name="can_approve_manager" invisible="1"/>
                    <field name="can_approve_accountant" invisible="1"/>
                    <field name="can_approve_director" invisible="1"/>
                    <field name="can_paid" invisible="1"/>
                    <field name="can_reset_draft" invisible="1"/>
                    <field name="can_reject" invisible="1"/>
                    <field name="can_withdraw_submit" invisible="1"/>
                    <button name="action_submit" type="object" string="Gửi duyệt" class="btn-primary" invisible="not can_submit"/>
                    <button name="action_approve_manager" type="object" string="Trưởng phòng duyệt" class="btn-success" invisible="not can_approve_manager"/>
                    <button name="action_approve_accountant" type="object" string="Kế toán duyệt" class="btn-success" invisible="not can_approve_accountant"/>
                    <button name="action_approve_director" type="object" string="Giám đốc duyệt" class="btn-success" invisible="not can_approve_director"/>
                    <button name="action_paid" type="object" string="Kế toán chi tiền" class="btn-secondary" invisible="not can_paid"/>
                    <button name="action_withdraw_submit" type="object" string="Hủy gửi" class="btn-secondary" invisible="not can_withdraw_submit" confirm="Bạn chắc chắn muốn hủy gửi để chỉnh sửa không?"/>
                    <button name ="action_done" type="object" string="Hoàn tất chi" class="btn-success" invisible="not can_paid" confirm="Bạn chắc chắn muốn hoàn tất không?"/>
                    <button name ="action_reset_draft" type="object" string="Trở về nháp" class="btn-secondary" invisible="not can_reset_draft" confirm="Bạn chắc chắn chuyển thành nhap?"/>
                    <button name="action_reject" type="object" string="Từ chối" class="btn-danger" invisible="not can_reject"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,dept_approved,account_approved,director_approved,paid,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="base.group_system,account.group_account_manager,custom_director_role.group_director">

                        <!-- 🔹 Phiếu thu -->
                        <button class="oe_stat_button" name="action_view_receipts" type="object" icon="fa-sign-in">
                            <div class="o_stat_info text-center" style="display:flex; flex-direction:column; align-items:center; line-height:1.2;">
                                <span class="o_stat_value" style="font-weight:600;">
                                    <field name="receipt_total" widget="monetary" nolabel="1"/>
                                </span>
                                <span class="o_stat_text" style="font-size:13px; color:#555;">
                                    <field name="receipt_count" nolabel="1"/>
 Phiếu thu
                                </span>
                            </div>
                        </button>

                        <!-- 🔹 Phiếu chi -->
                        <button class="oe_stat_button" name="action_view_payments" type="object" icon="fa-sign-out">
                            <div class="o_stat_info text-center" style="display:flex; flex-direction:column; align-items:center; line-height:1.2;">
                                <span class="o_stat_value" style="font-weight:600;">
                                    <field name="payment_total" widget="monetary" nolabel="1"/>
                                </span>
                                <span class="o_stat_text" style="font-size:13px; color:#555;">
                                    <field name="payment_count" nolabel="1"/>
 Phiếu chi
                                </span>
                            </div>
                        </button>

                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1" string="Số phiếu đề nghị"/>
                            <field name="project_id" string="Dự án" options="{'no_create': True,'no_open':True}" readonly="state !='draft'"/>
                            <field name="date_request" readonly="state !='draft'"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True,'no_open':True}" readonly="1"/>
                            <field name="department_id" options="{'no_create': True,'no_open':True}" readonly="state !='draft'"/>
                            <field name ="manager_id" widget="many2one_avatar_user" options="{'no_create': True,'no_open':True}" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>

                        <group>
                            <field name="amount_advance" help="Nhập số tiền tạm ứng (nếu có)." readonly="state !='draft'"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="amount_refund" readonly="1"/>
                            <field name="amount_remain" readonly="1"/>
                            <field name="amount_in_words" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Nội dung đề nghị" colspan="2"/>
                    <field name="note" placeholder="Nội dung chi tiết mục đích thanh toán" readonly="state !='draft'"/>

                    <separator string="Chi tiết chứng từ" colspan="2"/>
                    <!-- Draft: cho nhập/sửa/thêm dòng -->
                    <field name="line_ids" invisible="state != 'draft'">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" string="" width="30"/>
                            <field name="date_from" width="90"/>
                            <field name="date_to" width="90"/>
                            <field name="content" string="Nội dung" width="250"/>
                            <field name="uom_id" string="DVT" options="{'no_create':False}"/>
                            <field name="quantity" string="Số lượng"/>
                            <field name="unit_price" string="Đơn giá" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount" string="Thành tiền" width="130" options="{'currency_field': 'currency_id'}" sum="1" readonly="1"/>
                            <field name="project_id" string="Dự án" width="200" optional="hide"/>
                            <field name="attachment_ids" widget="many2many_binary" width="160"/>
                            <field name="invoice_id" string="Hóa đơn" width="200" column_invisible="1"/>
                            <field name="note" string="Ghi chú" width="120"/>
                            <field name="currency_id" optional="hide"/>
                        </tree>

                        <form string="Chi tiết dòng">
                            <group>
                                <group>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="uom_id" string="DVT" options="{'no_create':False}"/>
                                    <field name="quantity" string="Số lượng"/>
                                    <field name="project_id" string="Dự án"/>
                                </group>
                                <group>
                                    <field name="unit_price" string="Đơn giá" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount" string="Thành tiền" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>

                            <group>
                                <field name="content" string="Nội dung"/>
                                <field name="note" string="Ghi chú"/>
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </group>
                        </form>
                    </field>

                    <!-- Không phải draft: không cho thêm dòng, chỉ cho kế toán chọn hóa đơn -->
                    <field name="line_ids" invisible="state == 'draft'">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle" string="" width="30" readonly="1"/>
                            <field name="date_from" width="90" readonly="1"/>
                            <field name="date_to" width="90" readonly="1"/>
                            <field name="content" string="Nội dung" width="250" readonly="1"/>
                            <field name="uom_id" string="DVT" readonly="1"/>
                            <field name="quantity" string="Số lượng" readonly="1"/>
                            <field name="unit_price" string="Đơn giá" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="amount" string="Thành tiền" width="130" options="{'currency_field': 'currency_id'}" sum="1" readonly="1"/>
                            <field name="project_id" string="Dự án" width="200" optional="hide" readonly="1"/>
                            <field name="attachment_ids" widget="many2many_binary" width="160" readonly="1"/>
                            <field name="invoice_id" string="Hóa đơn" width="200" options="{'no_create': True, 'no_open': True}" placeholder="Kế toán chọn" readonly="not parent.can_edit_invoice" domain="[('project_id', '=', parent.project_id)]"/>
                            <field name="note" string="Ghi chú" width="120" readonly="1"/>
                            <field name="currency_id" optional="hide" readonly="1"/>
                        </tree>
                    </field>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                        <field name="activity_ids" widget="mail_activity"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================== TREE VIEW ===================== -->
    <record id="view_account_payment_proposal_tree" model="ir.ui.view">
        <field name="name">account.payment.proposal.tree</field>
        <field name="model">account.payment.proposal</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='paid'" decoration-bf="1" decoration-warning="state=='submitted'" decoration-info="state=='approved'">
                <field name="name" string="Số phiếu đề nghị"/>
                <field name="date_request"/>
                <field name="project_id" string="Dự án"/>
                <field name="user_id" readonly="1" widget="many2one_avatar_user"/>
                <field name="note" string="Nội dung"/>
                <field name="amount_advance" sum="1"/>
                <field name="total_amount" sum="1"/>
                <field name="amount_refund" sum="1"/>
                <field name="amount_remain" sum="1"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-warning="state == 'submitted'" decoration-info="state == 'dept_approved'" decoration-primary="state == 'account_approved'" decoration-it="state == 'director_approved'" decoration-success="state == 'paid'" decoration-danger="state == 'rejected'"/>
                <field name="currency_id" optional="hide"/>
            </tree>
        </field>
    </record>
    <record id="view_account_payment_proposal_search" model="ir.ui.view">
        <field name="name">account.payment.proposal.search</field>
        <field name="model">account.payment.proposal</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Giải chi">
                <!-- 🔎 Trường tìm kiếm chính -->
                <field name="name" string="Số phiếu"/>
                <field name="user_id" string="Người tạo"/>
                <field name="department_id" string="Phòng ban"/>
                <field name="state" string="Trạng thái"/>
                <field name="date_request" string="Ngày đề nghị"/>

                <!-- 🔸 Bộ lọc nhanh -->
                <filter name="filter_my" string="Của tôi" domain="[('user_id','=',uid)]" icon="fa-user"/>
                <filter name="filter_draft" string="Nháp" domain="[('state','=','draft')]" icon="fa-pencil"/>
                <filter name="filter_submitted" string="Chờ duyệt" domain="[('state','in',['submitted','dept_approved','account_approved','director_approved'])]" icon="fa-hourglass-half"/>
                <filter name="filter_paid" string="Đã chi" domain="[('state','=','paid')]" icon="fa-check-circle"/>
                <filter name="filter_rejected" string="Từ chối" domain="[('state','=','rejected')]" icon="fa-times-circle"/>

                <!-- 🔽 Bộ nhóm (Group By) -->
                <group expand="0" string="Nhóm theo">
                    <filter name="group_department" string="Phòng ban" context="{'group_by':'department_id'}"/>
                    <filter name="group_user" string="Người tạo" context="{'group_by':'user_id'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by':'state'}"/>
                    <filter name="group_date" string="Ngày đề nghị" context="{'group_by':'date_request'}"/>
                </group>

                <!-- 🔹 Search Panel (bên trái) -->
                <searchpanel>
                    <field name="department_id" string="Phòng ban"/>
                    <field name="state" string="Trạng thái"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ===================== ACTION ===================== -->
    <record id="action_account_payment_proposal" model="ir.actions.act_window">
        <field name="name">Giấy đề nghị giải chi</field>
        <field name="res_model">account.payment.proposal</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_account_payment_proposal_search"/>
        <field name="help" type="html">
            <p>
                Tạo mới một <b>Giấy đề nghị giải chi</b> để hoàn tạm ứng hoặc đề nghị thanh toán chi phí công tác.
            </p>
        </field>
    </record>

    <!-- ===================== MENU ===================== -->
    <menuitem id="menu_account_payment_proposal_root" web_icon="customer_account_payment_proposal,static/description/icon.png" name="Đề nghị giải chi" sequence="90"/>

    <menuitem id="menu_account_payment_proposal" name="Giấy đề nghị chi" parent="menu_account_payment_proposal_root" action="action_account_payment_proposal"/>
    <menuitem id="menu_account_payment_proposal" name="Giấy đề nghị chi" parent="project_work_from_so.menu_internal_project" action="action_account_payment_proposal"/>
    <menuitem id="menu_account_payment_proposal_for_accounting" name="Quyết toán tạm ứng" parent="custom_account_menu.menu_accounting_vouchers" action="action_account_payment_proposal"/>
</odoo>
