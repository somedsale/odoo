<odoo>
    <record id="view_account_payment_request_tree" model="ir.ui.view">
        <field name="name">account.payment.request.tree</field>
        <field name="model">account.payment.request</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button name="action_sync_old_payment_requests" string="Đồng bộ phiếu chi cũ" type="object" class="btn-warning" display="always" groups="base.group_system"/>
                </header>
                <field name="currency_id" optional="hide"/>
                <field name="name" string="Mã phiếu chi"/>
                <field name="project_id" string="Dự án"/>
                <field name="proposal_sheet_names"/>
                <field name="note" string="Nội dung chi"/>
                <field name="proposal_count" string="Số PĐX"/>
                <field name="create_date" string="Ngày tạo"/>
                <field name="date_payment" string="Ngày chi"/>
                <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                <field name="state" string="Trạng thái" widget="badge" decoration-muted="state == 'draft'" decoration-primary="state == 'confirmed'" decoration-success="state == 'done'"/>
                <field name="status_expense" widget="badge" string="Trạng thái chi tiền" decoration-danger="status_expense == 'not yet'" decoration-success="status_expense == 'paid'"/>
            </tree>
        </field>
    </record>

    <record id="view_account_payment_request_form" model="ir.ui.view">
        <field name="name">account.payment.request.form</field>
        <field name="model">account.payment.request</field>
        <field name="arch" type="xml">
            <form string="Phiếu chi">
                <field name="status_expense" invisible="1"/>
                <header>


                    <button name="action_confirm" string="Xác nhận" type="object" class="btn-primary" invisible="state != 'draft'" />

                    <button name="action_payment_request" string="Ghi nhận thanh toán" type="object" class="btn-success" invisible="state != 'confirmed'" />

                    <button name="action_cancel" string="Hủy" type="object" class="btn-danger" invisible="state == 'cancelled'" />

                    <button name="action_reset_to_draft" string="Đặt lại thành nháp" type="object" class="btn-secondary" invisible="state != 'cancelled'" />

                    <field name="state" widget="statusbar" statusbar_visible="confirmed,done"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Đã thanh toán" bg_color="bg-success" invisible="status_expense != 'paid'"/>
                    <widget name="web_ribbon" title="Chưa thanh toán" bg_color="bg-danger" invisible="status_expense != 'not yet' or state == 'draft'"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="proposal_sheet_id" invisible="1"/>
                            <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="manual_total"/>
                            <field name="payment_person" widget="many2one_avatar_user" readonly="1"/>
                            <field name="create_date" string="Ngày tạo" readonly="1"/>
                            <field name="receive_person" readonly="state != 'draft'"/>
                            <field name="bankids" invisible="payment_type != 'bank'" readonly="state != 'draft'"/>
                            <field name="note" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>

                        <group>
                            <field name="cost_classification" widget="select" readonly="state != 'draft'"/>
                            <field name="expense_category_id" context="{'default_classification': cost_classification}"/>
                            <field name="project_id" invisible="cost_classification != 'project'" readonly="state != 'draft'"/>
                            <!-- <field name="date" invisible="proposal_person_id == False" readonly="1"/> -->
                            <field name="date_payment" string="Ngày chi" invisible="status_expense == 'not yet'"/>
                            <!-- <field name="proposal_person_id" widget="many2one_avatar_user" invisible="proposal_person_id == False" readonly="1"/> -->
                            <field name="expense_type" widget="select" invisible="cost_classification != 'project'" readonly="state != 'draft'"/>
                            <field name="payment_type" widget="select" readonly="state != 'draft'"/>
                            <field name="bank_id" string="Ngân hàng" invisible="payment_type != 'bank'" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Phiếu đề xuất">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="proposal_sheet_id" domain="[('project_id', '=', parent.project_id)]"/>
                                    <!-- <field name="project_id" readonly="1"/> -->
                                    <field name="requested_by" readonly="1"/>
                                    <field name="proposal_date" readonly="1"/>
                                    <field name="interpretation"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="note"/>    
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_account_payment_request" model="ir.actions.act_window">
        <field name="name">Phiếu Chi</field>
        <field name="res_model">account.payment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>
    <record id="action_account_payment_request_without_searchpanel" model="ir.actions.act_window">
        <field name="name">Phiếu Chi</field>
        <field name="res_model">account.payment.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_accounting_payment_request" name="Phiếu Chi" parent="custom_account_menu.menu_accounting_vouchers" action="action_account_payment_request"/>

</odoo>