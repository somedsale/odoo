<odoo>
    <record id="action_report_account_receipt_xlsx" model="ir.actions.report">
        <field name="name">Xuất Excel Phiếu Thu</field>
        <field name="model">account.receipt</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">account_receipt_xlsx_report.account_receipt_xlsx</field>
        <field name="binding_model_id" ref="custom_accounting_receipt.model_account_receipt"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'PhieuThu_' + (object.name or 'NoName') + '_' + time.strftime('%Y%m%d')</field>
    </record>
</odoo>
