<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- OWL client actions -->
    <record id="action_bid_project_list_owl" model="ir.actions.client">
        <field name="name">Danh sách dự án dự thầu</field>
        <field name="tag">bid_estimation_project_list_action</field>
    </record>

    <record id="action_bid_import_owl" model="ir.actions.client">
        <field name="name">Import Excel dự thầu</field>
        <field name="tag">bid_estimation_import_action</field>
    </record>

    <record id="action_bid_project_view_owl" model="ir.actions.client">
        <field name="name">Xem dự án OWL</field>
        <field name="tag">bid_estimation_project_view_action</field>
    </record>

    <!-- Gắn vào menu Bán hàng -->
    <menuitem id="menu_bid_sale_root"
              name="Dự toán dự thầu"
              parent="sale.sale_menu_root"
              sequence="85"/>

    <menuitem id="menu_bid_sale_project_list"
              name="Danh sách dự án"
              parent="menu_bid_sale_root"
              action="action_bid_project_list_owl"
              sequence="1"/>

    <menuitem id="menu_bid_sale_import"
              name="Import Excel"
              parent="menu_bid_sale_root"
              action="action_bid_import_owl"
              sequence="2"/>

    <!-- Gắn vào menu Dự án -->
    <menuitem id="menu_bid_project_root_in_project"
              name="Dự toán dự thầu"
              parent="project.menu_main_pm"
              groups="project.group_project_manager"
              sequence="85"/>

    <menuitem id="menu_bid_project_project_list"
              name="Danh sách dự án"
              parent="menu_bid_project_root_in_project"
              action="action_bid_project_list_owl"
              sequence="1"/>

    <menuitem id="menu_bid_project_import"
              name="Import Excel"
              parent="menu_bid_project_root_in_project"
              action="action_bid_import_owl"
              sequence="2"/>
</odoo>
