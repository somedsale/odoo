<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_document_add_link_wizard_form" model="ir.ui.view">
        <field name="name">document.add.link.wizard.form</field>
        <field name="model">document.add.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Add a Link">
                <sheet>
                    <group>
                        <field name="name" placeholder=""/>
                        <field name="url" placeholder="https://"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Add A Link" type="object" name="action_add_link" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_document_add_link_wizard" model="ir.actions.act_window">
        <field name="name">Add a Link</field>
        <field name="res_model">document.add.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_document_add_link_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
