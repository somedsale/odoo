<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- TREE VIEW -->
    <record id="view_product_type_tree" model="ir.ui.view">
      <field name="name">product.type.tree</field>
      <field name="model">product.type</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="code"/>
          <field name="attribute_set_id"/>
          <field name="active"/>
        </tree>
      </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_product_type_form" model="ir.ui.view">
      <field name="name">product.type.form</field>
      <field name="model">product.type</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="code"/>
            </group>
            <group>
              <field name="attribute_set_id"/>
              <field name="active"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- ACTION -->
    <record id="action_product_type" model="ir.actions.act_window">
      <field name="name">Loại sản phẩm</field>
      <field name="res_model">product.type</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU CON: Loại sản phẩm -->
    <menuitem
      id="menu_product_type"
      name="Loại sản phẩm"
      parent="menu_somed_product_root"
      action="action_product_type"
      sequence="30"
    />

  </data>
</odoo>
