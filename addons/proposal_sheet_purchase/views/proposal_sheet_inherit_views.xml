<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="proposal_sheet_form_inherit_po_buttons" model="ir.ui.view">
      <field name="name">proposal.sheet.form.inherit.po.buttons</field>
      <field name="model">proposal.sheet</field>
      <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_form"/>
      <field name="arch" type="xml">

        <!-- Thêm 2 nút hành động vào HEADER -->
        <xpath expr="//form/header" position="inside">
          <button name="action_create_purchase_orders"
                  type="object"
                  class="btn-primary"
                  string="Tạo Đơn Mua"
                  invisible="(type != 'material') or (state != 'waiting_accounting_paid')" groups="account.group_account_manager"/>
        </xpath>

        <!-- Bổ sung button box nếu form chưa có -->
        <xpath expr="//form/sheet" position="inside">
          <div class="oe_button_box" name="button_box"/>
        </xpath>

        <!-- Smart button mở DS PO: đặt trong oe_button_box -->
        <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
          <button name="action_view_purchase_orders"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-shopping-cart"
                  invisible="purchase_order_count == 0"
                  groups="purchase.group_purchase_user,project.group_project_user">
            <field name="purchase_order_count" widget="statinfo" string="Đơn mua hàng"/>
          </button>
        </xpath>

      </field>
    </record>

  </data>
</odoo>
