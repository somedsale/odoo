<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_acceptance_assign_multi_wizard_form" model="ir.ui.view">
        <field name="name">project.acceptance.assign.multi.wizard.form</field>
        <field name="model">project.acceptance.assign.multi.wizard</field>
        <field name="arch" type="xml">
            <form string="Phân công báo cáo nghiệm thu">
                <group>
                    <field name="user_id"/>
                    <field name="project_count" readonly="1"/>
                    <field name="project_ids" widget="many2many_tags" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm_assign"
                            string="Xác nhận phân công"
                            type="object"
                            class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_acceptance_assign_multi_wizard" model="ir.actions.act_window">
        <field name="name">Phân công báo cáo nghiệm thu</field>
        <field name="res_model">project.acceptance.assign.multi.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>