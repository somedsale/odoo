<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_expense_dashboard_tree" model="ir.ui.view">
        <field name="name">project.expense.dashboard.tree</field>
        <field name="model">project.expense.dashboard</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="project_id"/>
                <field name="total_estimate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_actual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name ="currency_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_project_expense_dashboard_form" model="ir.ui.view">
        <field name="name">project.expense.dashboard.form</field>
        <field name="model">project.expense.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_requests" type="object" class="oe_stat_button" icon="fa-book">
                            <span class="o_stat_value">
                                <field string ="Phiếu đã chi" name="payment_request_count" widget="statinfo"/>
                            </span>
                        </button>
                        <button name="action_view_payment_pending_requests" type="object" class="oe_stat_button" icon="fa-book">
                            <span class="o_stat_value">
                                <field string ="Phiếu chưa chi" name="payment_request_pending_count" widget="statinfo"/>
                            </span>
                        </button>
                    </div>
                    <group col="2">
                        <group string="Thông tin">
                            <field name="project_id" readonly="1"/>
                            <field name="cost_estimate_id" readonly ="1"/>
                            <field name ="currency_id" invisible ="1"/>
                            <field name="total_actual_with_item" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_actual_without_item" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="Chi phí">
                            <field name="total_estimate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_actual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="progress" widget="progressbar" string="% Chi trả" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Dự toán và thực tế theo hạng mục">
                            <field name="cost_estimate_line_ids">
                                <tree create="false" edit="false" delete="false">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name ="currency_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chi tiết chi không có hạng mục">
                            <field name="payment_requests_without_item_ids">
                                <tree create="false" edit="false" delete="false">
                                    <field name="name"/>
                                    <field name="total" sum="Tổng"/>
                                    <field name="date_payment"/>
                                    <field name="state" string="Trạng thái" widget="badge" decoration-success="state=='done'" decoration-bf="state=='done'"/>
                                    <field name="item_note_alt" string="Mục đích"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chi tiết dự toán chi phí gián tiếp">
                            <field name="additional_expense_line_ids" context="{'default_cost_estimate_id': active_id}">
                                <tree editable="bottom">
                                    <field name="expense_id" string ="Tên chi phí"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" string="Đơn vị"/>
                                    <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price_subtotal" sum="Tổng 1" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="tax_id"/>
                                    <field name="price_tax" sum="Tổng 2" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price_total" sum="Tổng 3" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" string="Tiền tệ" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_project_expense_dashboard_kanban" model="ir.ui.view">
        <field name="name">project.expense.dashboard.kanban</field>
        <field name="model">project.expense.dashboard</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="project_id"/>
                <field name="total_estimate"/>
                <field name="total_actual"/>
                <field name="progress"/>
                <field name="currency_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <!-- Header -->
                            <div class="o_kanban_header d-flex align-items-center justify-content-between mb-2">
                                <strong class="o_kanban_record_title ">
                                    <i class="fa fa-folder-open me-1" style="color: #ffc107;"></i>
                                    <field name="project_id"/>
                                </strong>
                            </div>

                            <!-- Body -->
                            <div class="o_kanban_body">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small">
                                        <i class="fa fa-calculator me-1 text-primary"></i>Dự toán</span>
                                    <span class="fw-bold text-dark">
                                        <field name="total_estimate" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="small">
                                        <i class="fa fa-money me-1 text-success"></i>Thực tế</span>
                                    <span class="fw-bold text-dark">
                                        <field name="total_actual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                            </div>

                            <!-- Footer -->
                            <div class="o_kanban_footer mt-3 w-100">
                                <!-- lấy giá trị -->
                                <t t-set="percent" t-value="record.progress.raw_value"/>

                                <!-- chọn màu theo percent -->
                                <t t-set="color">
                                    <t t-if="percent &lt; 30">#dc3545</t>                                    <!-- đỏ -->
                                    <t t-elif="percent &lt; 80">#fd7e14</t>                                    <!-- cam -->
                                    <t t-else="">#28a745</t>                                    <!-- xanh -->
                                </t>

                                <!-- Progress bar custom -->
                                <div class="oe_kanban_progressbar" style="margin-top: 8px; width: 100%;">
                                    <!-- lấy và làm tròn giá trị -->
                                    <t t-set="percent" t-value="Math.round(record.progress.raw_value)"/>

                                    <!-- chọn màu theo percent -->
                                    <t t-set="color">
                                        <t t-if="percent &lt; 30">#dc3545</t>                                        <!-- đỏ -->
                                        <t t-elif="percent &lt; 80">#fd7e14</t>                                        <!-- cam -->
                                        <t t-else="">#28a745</t>                                        <!-- xanh -->
                                    </t>

                                    <!-- track -->
                                    <div style="width: 90%; height: 20px; background-color: #e0e0e0; border-radius: 5px; overflow: hidden; position: relative;margin: 0 auto;">
                                        <!-- thanh tiến độ -->
                                        <div t-attf-style="
            --final-width: {{percent}}%;
            height:100%;
            background-color: {{color}};
            animation: grow 1s ease-out forwards;">
                                            <!-- text nằm trong thanh -->
                                            <span style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
                     font-size: 11px; color: #fff; font-weight: bold;">
                                                <t t-esc="percent"/>
%
                                            </span>
                                        </div>
                                    </div>
                                    <style>
                                            @keyframes grow {
                                                from { width: 0%; }
                                                to { width: var(--final-width,100%); }
                                            }
                                    </style>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_project_expense_dashboard" model="ir.actions.act_window">
        <field name="name">Quản lí chi phí dự án</field>
        <field name="res_model">project.expense.dashboard</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Nhấn để tạo mới một báo cáo chi phí dự án.
            </p>
        </field>
    </record>
    <menuitem id="menu_project_expense_dashboard" name="Quản lí dự án" parent="custom_account_menu.menu_accounting_project" action="action_project_expense_dashboard" sequence="10"/>
</odoo>