<odoo>
    <record id="view_product_bundle_form" model="ir.ui.view">
        <field name="name">product.bundle.form</field>
        <field name="model">product.bundle</field>
        <field name="arch" type="xml">
            <form string="Gói sản phẩm">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                    </group>

                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="show_on_sale"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_bundle_tree" model="ir.ui.view">
        <field name="name">product.bundle.tree</field>
        <field name="model">product.bundle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
            </tree>
        </field>
    </record>

    <record id="action_product_bundle" model="ir.actions.act_window">
        <field name="name">Gói sản phẩm</field>
        <field name="res_model">product.bundle</field>
        <field name="view_mode">tree,form</field>
    </record>

<menuitem id="menu_product_bundle_root"
          name="Gói sản phẩm"
          parent="sale.product_menu_catalog"
          action="action_product_bundle"/>


</odoo>
