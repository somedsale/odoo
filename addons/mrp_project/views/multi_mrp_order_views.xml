<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_multi_mrp_order_tree" model="ir.ui.view">
        <field name="name">multi.mrp.order.tree</field>
        <field name="model">multi.mrp.order</field>
        <field name="arch" type="xml">
            <tree string="Lệnh sản xuất nhiều thành phẩm">
                <field name="name"/>
                <field name="date"/>
                <field name="origin"/>
                <field name="sale_id"/>
                <field name="project_id"/>
                <field name="production_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_multi_mrp_order_form" model="ir.ui.view">
        <field name="name">multi.mrp.order.form</field>
        <field name="model">multi.mrp.order</field>
        <field name="arch" type="xml">
            <form string="Lệnh sản xuất nhiều thành phẩm">
                <header>
                    <!-- Tạo MO con -->
                    <button name="action_generate_mo"
                            type="object"
                            string="Tạo lệnh sản xuất"
                            class="btn-primary"
                            invisible="state in ['done', 'cancel']"/>

                    <!-- Tạo PXK & PNK -->
                    <button name="action_generate_pickings"
                            type="object"
                            string="Tạo PXK/PNK"
                            class="btn-secondary"
                            invisible="state in ['done', 'cancel']"/>

                    <!-- Trạng thái -->
                    <button name="action_confirm"
                            type="object"
                            string="Xác nhận"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_done"
                            type="object"
                            string="Hoàn tất"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>

                    <button name="action_cancel"
                            type="object"
                            string="Hủy"
                            class="btn-secondary"
                            invisible="state not in ['draft', 'confirmed']"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Chuyển về nháp"
                            class="btn-secondary"
                            invisible="state != 'cancel'"/>
                <!-- Sản xuất tất cả MO (chỉ đổi state, không động tới kho) -->
                <button name="action_produce_all"
                        type="object"
                        string="Sản xuất tất cả"
                        class="btn-primary"
                        invisible="state != 'confirmed'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,done,cancel"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_productions"
                                type="object"
                                class="oe_stat_button"
                                invisible="production_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Lệnh sản xuất</span>
                                <span class="o_stat_value">
                                    <field name="production_count"/>
                                </span>
                            </div>
                        </button>

                        <button name="action_view_raw_picking"
                                type="object"
                                class="oe_stat_button"
                                invisible="not picking_raw_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Phiếu xuất NVL</span>
                            </div>
                        </button>

                        <button name="action_view_finished_picking"
                                type="object"
                                class="oe_stat_button"
                                invisible="not picking_finished_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Phiếu nhập TP</span>
                            </div>
                        </button>
                    </div>

                    <!-- Các field dùng trong invisible -->
                    <field name="production_count" invisible="1"/>
                    <field name="picking_raw_id" invisible="1"/>
                    <field name="picking_finished_id" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Số lệnh"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="origin"/>
                            <field name="sale_id" options="{'no_create_edit': True}"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group string="Thiết lập kho">
                        <field name="picking_type_out_id"/>
                        <field name="picking_type_in_id"/>
                        <field name="location_src_id"/>
                        <field name="location_production_id"/>
                        <field name="location_dest_id"/>
                    </group>

                    <notebook>
                        <page string="Thành phẩm">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="product_qty"/>

                                    <!-- field dùng trong domain của bom_id -->
                                    <field name="product_tmpl_id" invisible="1"/>
                                    <field name="company_id" invisible="1"/>

                                    <field name="bom_id"/>
                                    <field name="sale_line_id"/>
                                    <field name="mrp_production_id" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Ghi chú">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_multi_mrp_order" model="ir.actions.act_window">
        <field name="name">Lệnh sản xuất nhiều thành phẩm</field>
        <field name="res_model">multi.mrp.order</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo lệnh sản xuất tổng để gom nhiều thành phẩm, sinh ra nhiều
                Manufacturing Orders (mrp.production) và phiếu xuất/nhập kho tương ứng.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_multi_mrp_order_root"
              name="Lệnh sản xuất nhiều thành phẩm"
              parent="mrp.menu_mrp_manufacturing"
              action="action_multi_mrp_order"
              sequence="20"/>
</odoo>
