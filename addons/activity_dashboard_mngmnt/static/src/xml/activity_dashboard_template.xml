            <!-- ===== Layout: Tabs dọc + Nội dung ===== -->
            <div class="layout-two-cols">
                <!-- Radios (ẩn) -->
                <input type="radio" name="activityTabs" id="tabbtn-planned" class="tab-radio" checked="checked"/>
                <input type="radio" name="activityTabs" id="tabbtn-today" class="tab-radio"/>
                <input type="radio" name="activityTabs" id="tabbtn-overdue" class="tab-radio"/>
                <input type="radio" name="activityTabs" id="tabbtn-done" class="tab-radio"/>

                <!-- Sidebar -->
                <aside class="side-tabs" role="tablist" aria-label="Bộ lọc trạng thái công việc">
                    <label for="tabbtn-planned" class="tab-pill">
        Đang đợi duyệt
                        <span class="tab-badge">
                            <t t-esc="len_planned"/>
                        </span>
                    </label>
