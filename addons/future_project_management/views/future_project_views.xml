<odoo>
    <record id="view_future_project_tree" model="ir.ui.view">
        <field name="name">future.project.tree</field>
        <field name="model">future.project</field>
        <field name="arch" type="xml">
            <tree default_group_by="stage_id">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="stage_id"/>
                <field name="expected_bid_date"/>
                <field name="expected_value"/>
            </tree>
        </field>
    </record>

    <record id="view_future_project_form" model="ir.ui.view">
        <field name="name">future.project.form</field>
        <field name="model">future.project</field>
        <field name="arch" type="xml">
            <form string="Future Project">
                <sheet>

                    <!-- HEADER -->
<header>

    <!-- STATUS BAR -->
    <field name="stage_id"
           widget="statusbar"
           options="{'fold_field': 'fold'}"/>

    <!-- PIPELINE BUTTONS -->
    <field name="show_btn_researching" invisible="1"/>
    <field name="show_btn_contacting" invisible="1"/>
    <field name="show_btn_proposal" invisible="1"/>
    <field name="show_btn_bidding" invisible="1"/>
    <field name="show_btn_won" invisible="1"/>
    <field name="show_btn_lost" invisible="1"/>
    
    <button name="action_stage_researching"
            type="object"
            string="Đang tìm hiểu"
            class="btn-secondary"
            invisible="not show_btn_researching"/>

    <button name="action_stage_contacting"
            type="object"
            string="Đã tiếp cận"
            class="btn-secondary"
            invisible="not show_btn_contacting"/>

    <button name="action_stage_proposal"
            type="object"
            string="Chuẩn bị hồ sơ"
            class="btn-secondary"
            invisible="not show_btn_proposal"/>

    <button name="action_stage_bidding"
            type="object"
            string="Đang / Sắp đấu thầu"
            class="btn-warning"
            invisible="not show_btn_bidding"/>

    <button name="action_stage_won"
            type="object"
            string="Trúng thầu"
            class="btn-primary"
            invisible="not show_btn_won"/>

    <button name="action_stage_lost"
            type="object"
            string="Không khả thi"
            class="btn-danger"
            invisible="not show_btn_lost"/>

</header>


                    <!-- TITLE -->
                    <div class="oe_title">
                        <h1>
                            <label for="name" class="oe_form_label oe_form_required" string="Tên dự án"/>
                            <field name="name" placeholder="Tên dự án dự kiến"/>
                        </h1>
                    </div>


                    <!-- MAIN CONTENT -->
                    <group string="Thông tin dự án" col="2" class="mt16">

                        <!-- LEFT -->
                        <group>
                            <field name="code"/>
                            <field name="address"/>
                            <field name="location_id"/>
                            <field name="customer_id"/>
                            <field name="priority"/>
                        </group>

                        <!-- RIGHT -->
                        <group>
                            <field name="expected_value" widget="monetary"/>
                            <field name="probability" widget="percentage" readonly="1"/>
                            <field name="expected_bid_date"/>
                            <field name="expected_start_date"/>
                            <field name="expected_end_date"/>
                        </group>

                    </group>

                    <!-- NOTEBOOK -->
                    <group class="mt16" string="Thống tin liên quan">
                            <group col="2">
                                <field name="contact_person"/>
                                <field name="contact_phone"/>
                                <field name="contact_email"/>
                            </group>

                        <group string="Ghi chú &amp; Tài liệu" class="mt16">
                            <field name="description" string="Ghi chú" placeholder="Ghi chú, nguồn thông tin, đối thủ, tình trạng tiếp cận…" />
                            <field name="attachment_ids" widget="many2many_binary" string="Tài liệu đính kèm" />
                        </group>

                    </group>
                </sheet>

                <!-- CHATTER -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

</odoo>
