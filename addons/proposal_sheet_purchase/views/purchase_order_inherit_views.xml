<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Inject fields hỗ trợ modifiers -->
    <record id="purchase_order_form_inherit_support_fields" model="ir.ui.view">
      <field name="name">purchase.order.form.inherit.support.fields</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
          <field name="shipping_status" invisible="1"/>
          <field name="payment_status" invisible="1"/>
          <field name="has_full_request" invisible="1"/>
          <field name="is_fully_requested" invisible="1"/>
          <field name="amount_requested" invisible="1"/>
          <field name="payment_request_count" invisible="1"/>
        </xpath>
      </field>
    </record>

    <!-- Liên kết Proposal/Project/Task + auto-pay + smart button + header button + khối thanh toán -->
    <record id="purchase_order_form_inherit_ps_links_payment" model="ir.ui.view">
      <field name="name">purchase.order.form.inherit.ps.links.payment</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">

        <!-- Liên kết -->
        <xpath expr="//sheet/group" position="inside">
          <field name="proposal_sheet_id" options="{'no_create_edit': True}"/>
          <field name="project_id" readonly="1"/>
          <field name="task_id" readonly="1"/>
        </xpath>

        <!-- Auto-pay khi xác nhận -->
        <xpath expr="//sheet/notebook" position="before">
          <group string="Thanh toán khi xác nhận">
            <field name="auto_payment_on_confirm"/>
            <field name="payment_on_confirm_type" invisible="not auto_payment_on_confirm"/>
            <field name="advance_amount_type" invisible="(not auto_payment_on_confirm) or (payment_on_confirm_type != 'advance')"/>
            <field name="advance_percent" invisible="(not auto_payment_on_confirm) or (payment_on_confirm_type != 'advance') or (advance_amount_type != 'percent')"/>
            <field name="advance_amount" invisible="(not auto_payment_on_confirm) or (payment_on_confirm_type != 'advance') or (advance_amount_type != 'fixed')"/>
          </group>
        </xpath>

        <!-- Smart button Phiếu chi -->
        <xpath expr="//sheet" position="inside">
          <div class="oe_button_box" name="button_box"/>
        </xpath>
        <xpath expr="//sheet/div[@name='button_box']" position="inside">
          <button name="action_view_payment_requests" type="object" class="oe_stat_button" icon="fa-money" invisible="payment_request_count == 0">
            <field name="payment_request_count" widget="statinfo" string="Phiếu chi"/>
          </button>
        </xpath>

        <!-- Nút header: Đang giao + tạo phiếu chi -->
        <xpath expr="//header" position="inside">
          <!-- Đang giao: cần PO đã xác nhận, đang 'Chưa giao' và đã có tạm ứng/thanh toán -->
          <button name="action_mark_shipping_in_progress" type="object" string="Đang giao" class="btn-secondary" invisible="(state not in ['purchase','done']) or (shipping_status != 'not_shipped') or ((payment_status == 'no') and (amount_requested &lt;= 0))"/>
          <!-- Nút 'Nhận hàng' -> chuyển sang ĐÃ GIAO -->
          <button name="action_mark_shipping_done" type="object" string="Nhận hàng" class="btn-primary" invisible="(state not in ['purchase','done']) or (shipping_status != 'in_progress')"/>
          <!-- Tạo tạm ứng -->
          <button name="action_open_advance_wizard" type="object" string="Tạo phiếu chi tạm ứng" class="btn-secondary" invisible="(state not in ['purchase']) or has_full_request or is_fully_requested"/>

          <!-- Thanh toán toàn bộ -->
          <button name="action_create_payment_request_full" type="object" string="Tạo phiếu chi toàn bộ" class="btn-secondary" invisible="(state not in ['purchase']) or has_full_request or is_fully_requested or (amount_requested > 0)"/>

          <!-- Chi còn lại -->
          <button name="action_create_payment_request_remaining" type="object" string="Chi còn lại" class="btn-secondary" invisible="(state not in ['purchase']) or has_full_request or is_fully_requested or (amount_requested == 0)"/>
        </xpath>

        <!-- Khối thanh toán -->
        <xpath expr="//sheet/group" position="after">
          <group string="Thanh toán đơn hàng">
            <field name="amount_total" readonly="1"/>
            <field name="amount_paid" readonly="1"/>
            <field name="amount_to_pay" readonly="1"/>
            <field name="payment_progress" readonly="1"/>
            <field name="payment_status" readonly="1"/>
            <field name="is_paid" readonly="1"/>
            <separator string="Khóa tạo phiếu chi" colspan="2"/>
            <field name="amount_requested" readonly="1"/>
            <field name="has_full_request" readonly="1"/>
            <field name="is_fully_requested" readonly="1"/>
          </group>
        </xpath>

        <!-- Cột dòng -->
        <xpath expr="//field[@name='order_line']/tree" position="inside">
          <field name="qty_remaining" string="Còn lại" optional="show"/>
          <field name="goods_status" string="Trạng thái hàng" optional="show"/>
        </xpath>

      </field>
    </record>

    <!-- Ribbons -->
    <record id="purchase_order_form_inherit_ribbons" model="ir.ui.view">
      <field name="name">purchase.order.form.inherit.ribbons</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="inside">
          <!-- Thanh toán -->
          <widget name="web_ribbon" title="Đã thanh toán" bg_color="bg-success" invisible="payment_status != 'paid'"/>
          <widget name="web_ribbon" title="Chưa thanh toán" bg_color="bg-danger" invisible="payment_status == 'paid' or state == 'draft'"/>

          <!-- Hàng hóa -->
          <widget name="web_ribbon" title="Chưa giao" bg_color="bg-secondary" invisible="shipping_status != 'not_shipped'"/>
          <widget name="web_ribbon" title="Đang giao" bg_color="bg-warning" invisible="shipping_status != 'in_progress'"/>
          <widget name="web_ribbon" title="Đã giao" bg_color="bg-success" invisible="shipping_status != 'done'"/>
        </xpath>
      </field>
    </record>

    <!-- Ẩn toàn bộ nút Send by Email -->
    <record id="purchase_order_form_hide_send_email" model="ir.ui.view">
      <field name="name">purchase.order.form.hide.send.email</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="priority" eval="300"/>
      <field name="arch" type="xml">
        <xpath expr="//form/header/button[@name='action_rfq_send']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
