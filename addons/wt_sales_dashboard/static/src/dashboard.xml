<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wt_sales_dashboard.SalesDashboard" owl="1">
        <div class="wt-dashboard o_action_wt_sales_dashboard_dashboard">
            <!-- Thanh tiêu đề -->
            <div class="o_control_panel wt-cp">
                <!-- <div class="o_cp_left wt-cp-left">
                    <div class="o_cp_title wt-cp-title">
                        <h1 class="wt-title o_breadcrumb">Bảng điều khiển Bán hàng</h1>
                    </div>
                </div> -->
                <div class="wt-filters">
                    <div class="wt-filter-item">
                        <label>Kiểu lọc</label>
                        <select class="wt-select" t-att-value="state.filters.period_type" t-on-change="onPeriodTypeChange">
                            <option value="custom">Tùy chọn</option>
                            <option value="month">Theo tháng</option>
                            <option value="quarter">Theo quý</option>
                            <option value="year">Theo năm</option>
                        </select>
                    </div>

                    <t t-if="state.filters.period_type === 'month' or state.filters.period_type === 'quarter' or state.filters.period_type === 'year'">
                        <div class="wt-filter-item">
                            <label>Năm</label>
                            <select class="wt-select" t-att-value="state.filters.year" t-on-change="onYearChange">
                                <t t-foreach="yearOptions" t-as="year" t-key="year">
                                    <option t-att-value="year">
                                        <t t-esc="year"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </t>

                    <t t-if="state.filters.period_type === 'month'">
                        <div class="wt-filter-item">
                            <label>Tháng</label>
                            <select class="wt-select" t-att-value="state.filters.month" t-on-change="onMonthChange">
                                <t t-foreach="monthOptions" t-as="m" t-key="m.value">
                                    <option t-att-value="m.value">
                                        <t t-esc="m.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </t>

                    <t t-if="state.filters.period_type === 'quarter'">
                        <div class="wt-filter-item">
                            <label>Quý</label>
                            <select class="wt-select" t-att-value="state.filters.quarter" t-on-change="onQuarterChange">
                                <t t-foreach="quarterOptions" t-as="q" t-key="q.value">
                                    <option t-att-value="q.value">
                                        <t t-esc="q.label"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </t>

                    <t t-if="state.filters.period_type === 'custom'">
                        <div class="wt-filter-item">
                            <label>Từ ngày</label>
                            <input type="date" class="wt-date" t-att-value="state.filters.date_from" t-on-change="onDateFromChange"/>
                        </div>

                        <div class="wt-filter-item">
                            <label>Đến ngày</label>
                            <input type="date" class="wt-date" t-att-value="state.filters.date_to" t-on-change="onDateToChange"/>
                        </div>
                    </t>

                    <button class="wt-btn wt-btn--primary" t-on-click="applyFilter">Áp dụng</button>
                </div>
            </div>

            <!-- Nội dung -->
            <div class="wt-content o_content">
                <!-- Thẻ KPI -->


                <div class="wt-kpi-grid">
                    <div class="wt-card wt-card--click wt-card--has-badge" t-on-click="() => this.openTotalQuotations()">

                        <!-- Badge -->
                        <span class="wt-kpi-badge">
                            <t t-esc="state.kpis.quotation_count || 0"/>
 báo giá
                        </span>

                        <h2 class="wt-card-sub">
        Báo giá
                            <span class="wt-kpi-period">
            (                                <t t-esc="this.periodLabel"/>
)
                            </span>
                        </h2>

                        <p class="wt-card-val">
                            <t t-esc="state.kpis.total_quotations.toLocaleString(
            'vi-VN',{style:'currency',currency:'VND'}
        )"/>
                        </p>
                    </div>
                    <div class="wt-card wt-card--click wt-card--has-badge" t-on-click="() => this.openTotalSales()">

                        <!-- Badge -->
                        <span class="wt-kpi-badge wt-kpi-badge--success">
                            <t t-esc="state.kpis.order_count || 0"/>
 đơn
                        </span>

                        <h2 class="wt-card-sub">
        Doanh thu
                            <span class="wt-kpi-period">
            (                                <t t-esc="this.periodLabel"/>
)
                            </span>
                        </h2>

                        <p class="wt-card-val">
                            <t t-esc="state.kpis.total_sales.toLocaleString(
            'vi-VN',{style:'currency',currency:'VND'}
        )"/>
                        </p>
                    </div>
                    <div class="wt-card wt-card--click">
                        <h2 class="wt-card-sub">
    Tỉ lệ chuyển đổi
                        </h2>
                        <p class="wt-card-val">
                            <t t-esc="state.kpis.close_rate_value"/>
%
                        </p>
                    </div>

                    <div class="wt-card wt-card--click" t-on-click="() => this.openCategories()">
                        <h2 class="wt-card-sub">
    Số lượng hạng mục bán hàng
                        </h2>
                        <p class="wt-card-val">
                            <t t-esc="(state.kpis.category_count || 0).toLocaleString('vi-VN')"/>
                        </p>
                    </div>
                </div>

                <!-- Biểu đồ -->
                <div class="wt-charts-grid">
                    <div class="wt-card">
                        <h3 class="wt-card-title">Xu hướng doanh thu</h3>
                        <div class="wt-chart-box">
                            <canvas t-ref="salesTrendChart"/>
                        </div>
                    </div>

                    <div class="wt-card">
                        <h3 class="wt-card-title">Top 5 sản phẩm bán chạy</h3>
                        <div class="wt-chart-box">
                            <canvas t-ref="topProductsChart"/>
                        </div>
                    </div>
                    <div class="wt-card">
                        <h3 class="wt-card-title">Hạng mục bán hàng (số đơn)</h3>
                        <div class="wt-chart-box">
                            <canvas t-ref="categoryChart"/>
                        </div>
                    </div>
                </div>

                <!-- Bảng đơn bán gần đây -->
                <div class="wt-card wt-table-wrap">
                    <h3 class="wt-card-title">Đơn bán gần đây</h3>
                    <div class="wt-table-scroll">
                        <table class="wt-table">
                            <thead>
                                <tr>
                                    <th>Số đơn</th>
                                    <th>Khách hàng</th>
                                    <th>Ngày</th>
                                    <th>Hạng mục</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.recent_orders" t-as="order" t-key="order.id">
                                    <tr class="wt-row--click" t-on-click="() => this.openSaleOrder(order.id)">
                                        <td class="wt-link">
                                            <t t-esc="order.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="order.partner"/>
                                        </td>
                                        <td>
                                            <t t-esc="order.date"/>
                                        </td>
                                        <td>
                                            <div class="wt-tags">
                                                <t t-set="cats" t-value="order.categories or []"/>
                                                <!-- Hiển thị tối đa 3 badge: dùng slice(0,3) -->
                                                <t t-foreach="cats.slice(0, 3)" t-as="cat" t-key="cat.id">
                                                    <span t-att-class="'wt-tag wt-tag--c' + (cat.color || 0)">
                                                        <t t-esc="cat.name"/>
                                                    </span>
                                                </t>
                                                <!-- Nếu còn dư, hiện +N -->
                                                <t t-if="cats.length &gt; 3">
                                                    <span class="wt-tag wt-tag--more">+                                                        <t t-esc="cats.length - 3"/>
                                                    </span>
                                                </t>
                                            </div>
                                        </td>
                                        <td>
                                            <t t-esc="order.total.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' })"/>
                                        </td>
                                        <td>
                                            <span class="wt-badge" t-att-class="{
                                                    'wt-badge--success': order.state === 'Sales Order' || order.state === 'Đã xác nhận',
                                                    'wt-badge--info': order.state === 'Quotation' || order.state === 'Báo giá',
                                                    'wt-badge--warning': order.state === 'To Invoice' || order.state === 'Chờ xuất hóa đơn'
                                                  }">
                                                <t t-esc="order.state"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
