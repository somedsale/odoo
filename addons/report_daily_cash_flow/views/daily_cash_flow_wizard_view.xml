<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_daily_cash_flow_report_wizard_form" model="ir.ui.view">
        <field name="name">daily.cash.flow.wizard.form</field>
        <field name="model">daily.cash.flow.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Sale Report">
                <group>
                    <field name="period_type" required="1" string="Chọn kỳ báo cáo" widget="radio" options="{'horizontal': true}"/>
                </group>

                <group invisible="period_type != 'custom'">
                    <field name="date_from" widget="date" string="Từ ngày"/>
                    <field name="date_to" widget="date" string="Đến ngày"/>
                </group>

                <group invisible="period_type != 'month'">
                    <field name="month"/>
                    <field name="year" widget="year"/>
                </group>

                <group invisible="period_type != 'quarter'">
                    <field name="quarter"/>
                    <field name="year" widget="year"/>
                </group>

                <group invisible="period_type != 'year'">
                    <field name="year" widget="year"/>
                </group>

                <group>
                    <field name="period_label" readonly="1"/>
                </group>

                <group string="Tồn đầu kỳ (nhập lần đầu)">
                    <field name="opening_bank" placeholder="0" help="Nhập tay nếu là ngày đầu tiên."/>
                    <field name="opening_cash" placeholder="0" help="Nhập tay nếu là ngày đầu tiên."/>
                </group>
                <footer>
                    <button name="action_generate_report" string="Xem báo cáo" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_daily_cash_flow_report_wizard" model="ir.actions.act_window">
        <field name="name">Tạo báo cáo</field>
        <field name="res_model">daily.cash.flow.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cash_flow_report_daily" name="Báo cáo thu chi" parent="expense_proposal.menu_expense_proposal_root" action="action_daily_cash_flow_report_wizard" sequence="100"/>
</odoo>