<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sắp xếp lại tree stock.vpicktree -->
    <record id="view_stock_picking_tree_inherit_default_order" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.default.order</field>
        <field name="model">stock.picking</field>
        <!-- Kế thừa đúng cái tree gốc -->
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <!-- Chỉnh thuộc tính của thẻ <tree> -->
            <xpath expr="//tree" position="attributes">
                <!-- Thay field theo ý bạn: scheduled_date, date, name, id,... -->
                <attribute name="default_order">scheduled_date desc, id desc</attribute>
            </xpath>
        </field>
    </record>
</odoo>
