<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action báo cáo HTML chi tiết công nợ NCC -->
    <record id="action_report_supplier_summary_html" model="ir.actions.report">
        <field name="name">Chi tiết công nợ NCC</field>
        <!-- DÙNG MODEL MỚI -->
        <field name="model">supplier.invoice.payment.summary</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vendor_debt_management.report_sup_summary_html</field>
        <field name="report_file">vendor_debt_management.report_sup_summary_html</field>
        <field name="print_report_name">'Chi tiết công nợ NCC'</field>
        <field name="paperformat_id" ref="custom_sale_report_a4_portrait"/>
    </record>

    <!-- Khổ giấy ngang A4 -->
    <record id="custom_sale_report_a4_portrait" model="report.paperformat">
        <field name="name">Custom Sale Report A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_spacing">25</field>
        <field name="dpi">120</field>
    </record>

    <!-- Template HTML QWeb -->
    <template id="report_sup_summary_html">
        <!-- Layout header/footer chung bạn đã định nghĩa -->
        <t t-call="vendor_debt_management.report_supplier_summary_layout">
            <style>
              .page { font-family: "Times New Roman"; font-size: 12pt; color: #000; }

              .styled-table {
                border-collapse: collapse;
                margin: 0 auto;
                font-size: 12pt;
                width: 100%;
                border: 1px solid #000;
                table-layout: fixed;
              }

              .styled-table thead tr {
                background-color: #C6E0B4;
                font-weight: bold;
                color: #000;
                text-align: center;
              }

              .table-item{
                text-transform: uppercase;
                background-color: #E2EFDA;
                font-weight: bold;
                color: #000;
              }

              .styled-table th, .styled-table td {
                font-size: 10pt;
                padding: 8px 12px;
                border: 1px solid #000;
                vertical-align: middle;
                overflow: hidden;
                word-wrap: break-word;
                overflow-wrap: anywhere;
              }

              .styled-table tbody tr:hover { background-color: #D9EAD3; }

              .text-center { text-align: center; }
              .text-right  { text-align: right; }

              .num { white-space: nowrap; }
            </style>

            <div class="page">
                <t t-if="docs">
                    <!-- 1 NCC + 1 currency => lấy record đầu để in header -->
                    <t t-set="doc_first" t-value="docs[0]"/>

                    <!-- Tiêu đề: tên NCC -->
                    <h2 style="text-align:center; margin-bottom: 20px; font-size: 24px; text-transform: uppercase;">
                        <span t-esc="partner_name or (doc_first.partner_id.name or '')"/>
                    </h2>

                    <!-- Công nợ cũ -->
                    <div>
                        <h6>
                            Công nợ cũ:
                            <span t-esc="format_amount(doc_first.old_debt or 0.0, doc_first.currency_id)"/>
                        </h6>
                    </div>

                    <table class="styled-table">
                        <colgroup>
                            <col style="width:3%"/>
                            <!-- 1. STT -->
                            <col style="width:12%"/>
                            <!-- 2. Dự án -->
                            <col style="width:8%"/>
                            <!-- 3. Diễn giải -->
                            <col style="width:5%"/>
                            <!-- 4. HĐ Số/Ngày -->
                            <col style="width:7%"/>
                            <!-- 5. HĐ Số tiền -->
                            <col style="width:4%"/>
                            <!-- 6. HSQT Số HS/ngày -->
                            <col style="width:7%"/>
                            <!-- 7. HSQT Số tiền -->
                            <col style="width:7%"/>
                            <!-- 8. Hóa đơn Ngày -->
                            <col style="width:5%"/>
                            <!-- 9. Hóa đơn Số -->
                            <col style="width:7%"/>
                            <!-- 10. Hóa đơn Số tiền -->
                            <col style="width:6%"/>
                            <!-- 11. Đã trả Ngày -->
                            <col style="width:7%"/>
                            <!-- 12. Đã trả Số tiền -->
                            <col style="width:7%"/>
                            <!-- 13. Còn nợ -->
                            <col style="width:6%"/>
                            <!-- 14. Ghi chú -->
                            <col style="width:7%"/>
                            <!-- 15. Hạn T/T -->
                        </colgroup>

                        <thead>
                            <tr>
                                <th rowspan="2" class="num">STT</th>
                                <th rowspan="2">Dự án</th>
                                <th rowspan="2">Diễn giải</th>
                                <th colspan="2">Hợp đồng</th>
                                <th colspan="2">Hồ sơ quyết toán</th>
                                <th colspan="3">Hóa đơn</th>
                                <th colspan="2">Đã trả</th>
                                <th rowspan="2">Số tiền còn nợ</th>
                                <th rowspan="2">Ghi chú</th>
                                <th rowspan="2">Hạn T/T</th>
                            </tr>
                            <tr>
                                <th>Số/ Ngày</th>
                                <th>Số tiền</th>
                                <th>Số HS/ ngày</th>
                                <th>Số tiền</th>
                                <th>Ngày</th>
                                <th>Số</th>
                                <th>Số tiền</th>
                                <th>Ngày trả</th>
                                <th>Số tiền</th>
                            </tr>
                        </thead>

                        <tbody>
                            <!-- ===== DÒNG TỔNG CỘNG ĐẦU BẢNG ===== -->
                            <t t-if="docs">
                                <t t-set="doc" t-value="docs[0]"/>
                                <!-- Tổng còn nợ = HĐ - Đã trả + Công nợ cũ -->
                                <t t-set="residual_total" t-value="(doc.total_invoice_amount or 0.0)
                    - (doc.total_payment_amount or 0.0)
                    + (doc.old_debt or 0.0)"/>

                                <tr class="table-item">
                                    <!-- 1. STT -->
                                    <td class="text-center"></td>

                                    <!-- 2-4. Gộp thành ô 'TỔNG CỘNG' -->
                                    <td colspan="3" class="text-center">
                TỔNG CỘNG
                                    </td>

                                    <!-- 5. HĐ Số tiền -->
                                    <td class="text-right num">
                                        <t t-if="doc.total_contract_amount">
                                            <span t-esc="format_amount(
                        doc.total_contract_amount,
                        doc.currency_id
                    )"/>
                                        </t>
                                    </td>

                                    <!-- 6. HSQT Số HS/ngày (không cộng) -->
                                    <td class="text-center"></td>

                                    <!-- 7. HSQT Số tiền -->
                                    <td class="text-right num">
                                        <t t-if="doc.total_settlements_amount">
                                            <span t-esc="format_amount(
                        doc.total_settlements_amount,
                        doc.currency_id
                    )"/>
                                        </t>
                                    </td>

                                    <!-- 8. Hóa đơn Ngày (không cộng) -->
                                    <td class="text-center"></td>

                                    <!-- 9. Hóa đơn Số (không cộng) -->
                                    <td class="text-center"></td>

                                    <!-- 10. Hóa đơn Số tiền -->
                                    <td class="text-right num">
                                        <t t-if="doc.total_invoice_amount">
                                            <span t-esc="format_amount(
                        doc.total_invoice_amount,
                        doc.currency_id
                    )"/>
                                        </t>
                                    </td>

                                    <!-- 11. Đã trả Ngày (không cộng) -->
                                    <td class="text-center"></td>

                                    <!-- 12. Đã trả Số tiền -->
                                    <td class="text-right num">
                                        <t t-if="doc.total_payment_amount">
                                            <span t-esc="format_amount(
                        doc.total_payment_amount,
                        doc.currency_id
                    )"/>
                                        </t>
                                    </td>

                                    <!-- 13. Số tiền còn nợ -->
                                    <td class="text-right num">
                                        <span t-esc="format_amount(
                    residual_total,
                    doc.currency_id
                )"/>
                                    </td>

                                    <!-- 14. Ghi chú -->
                                    <td class="text-center"></td>

                                    <!-- 15. Hạn T/T -->
                                    <td class="text-center"></td>
                                </tr>
                            </t>

                            <!-- Biến đếm STT -->
                            <t t-set="stt" t-value="0"/>


                            <!-- docs: recordset supplier.invoice.payment.summary (thường là 1 record NCC/currency) -->
                            <t t-foreach="docs" t-as="doc">

                                <!-- ================== PHẦN 1: THEO HỢP ĐỒNG ================== -->
                                <t t-set="contracts" t-value="doc.contract_ids.sorted(key=lambda c: (c.project_id.id or 0, c.id))"/>

                                <t t-foreach="contracts" t-as="line">
                                    <!-- Lấy rows: hóa đơn + phiếu chi của HĐ -->
                                    <t t-set="rows" t-value="line.get_report_rows()"/>
                                    <t t-if="not rows">
                                        <t t-set="rows" t-value="[{}]"/>
                                    </t>

                                    <!-- Biến đếm dòng trong từng HĐ để gộp ô -->
                                    <t t-set="row_idx" t-value="0"/>

                                    <t t-foreach="rows" t-as="row">
                                        <t t-set="row_idx" t-value="row_idx + 1"/>
                                        <t t-set="stt" t-value="stt + 1"/>
                                        <t t-set="inv" t-value="row.get('invoice')"/>
                                        <t t-set="pay" t-value="row.get('payment')"/>

                                        <tr>
                                            <!-- 1. STT -->
                                            <td class="text-center">
                                                <span t-esc="stt"/>
                                            </td>

                                            <!-- 2. Dự án -->
                                            <td class="text-center" style="vertical-align:middle;">
                                                <t t-if="row_idx == 1">
                                                    <span t-esc="line.project_id.name or ''"/>
                                                </t>
                                            </td>

                                            <!-- 3. Diễn giải (HĐ) -->
                                            <td class="text-center" style="vertical-align:middle;">
                                                <t t-if="row_idx == 1">
                                                    <span t-esc="line.interpretation or ''"/>
                                                </t>
                                            </td>

                                            <!-- 4. HĐ Số / Ngày -->
                                            <td class="text-center" style="vertical-align:middle;">
                                                <t t-if="row_idx == 1">
                                                    <t t-if="line.name">
                                                        <span t-esc="line.name"/>
                                                    </t>
                                                    <t t-if="line.contract_date">
                                                        <br/>
                                                        <span t-esc="line.contract_date.strftime('%d/%m/%Y')"/>
                                                    </t>
                                                </t>
                                            </td>

                                            <!-- 5. HĐ Số tiền -->
                                            <td class="text-right num" style="vertical-align:middle;">
                                                <t t-if="row_idx == 1 and line.amount">
                                                    <span t-esc="format_amount(
                                                        line.amount,
                                                        line.currency_id or doc.currency_id
                                                    )"/>
                                                </t>
                                            </td>

                                            <!-- 6. HSQT Số HS / ngày -->
                                            <td class="text-left" style="vertical-align:middle;">
                                                <t t-if="row_idx == 1 and line.settlement_ids">
                                                    <t t-foreach="line.settlement_ids" t-as="stl">
                                                        <div>
                                                            <span t-esc="stl.name or ''"/>
                                                            <t t-if="stl.date">
                                                                –                                                                <span t-esc="stl.date.strftime('%d/%m/%Y')"/>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </t>
                                            </td>

                                            <!-- 7. HSQT Số tiền -->
                                            <td class="text-right num" style="vertical-align:middle;">
                                                <t t-if="row_idx == 1 and line.settlement_ids">
                                                    <t t-foreach="line.settlement_ids" t-as="stl">
                                                        <div>
                                                            <span t-esc="format_amount(
                                                                stl.amount or 0.0,
                                                                stl.currency_id or line.currency_id or doc.currency_id
                                                            )"/>
                                                        </div>
                                                    </t>
                                                </t>
                                            </td>

                                            <!-- 8. Hóa đơn Ngày -->
                                            <td class="text-center">
                                                <t t-if="inv and inv.date">
                                                    <span t-esc="inv.date.strftime('%d/%m/%Y')"/>
                                                </t>
                                            </td>

                                            <!-- 9. Hóa đơn Số -->
                                            <td class="text-center">
                                                <t t-if="inv">
                                                    <span t-esc="inv.invoice_number or ''"/>
                                                </t>
                                            </td>

                                            <!-- 10. Hóa đơn Số tiền -->
                                            <td class="text-right num">
                                                <t t-if="inv and inv.amount">
                                                    <span t-esc="format_amount(
                                                        inv.amount,
                                                        inv.currency_id or doc.currency_id
                                                    )"/>
                                                </t>
                                            </td>

                                            <!-- 11. Ngày trả -->
                                            <td class="text-center">
                                                <t t-if="pay and pay.date_payment">
                                                    <span t-esc="pay.date_payment.strftime('%d/%m/%Y')"/>
                                                </t>
                                            </td>

                                            <!-- 12. Số tiền trả -->
                                            <td class="text-right num">
                                                <t t-if="pay and pay.total">
                                                    <span t-esc="format_amount(
                                                        pay.total,
                                                        pay.currency_id or doc.currency_id
                                                    )"/>
                                                </t>
                                            </td>

                                            <!-- 13. Còn nợ (running_balance) -->
                                            <td class="text-right num">
                                                <t t-if="row.get('running_balance') is not None">
                                                    <span t-esc="format_amount(
                                                        row.get('running_balance'),
                                                        (inv and inv.currency_id) or (line.currency_id or doc.currency_id)
                                                    )"/>
                                                </t>
                                            </td>

                                            <!-- 14. Ghi chú (hiện đang để trống, có thể map thêm sau) -->
                                            <td></td>

                                            <!-- 15. Hạn T/T (due_date của invoice) -->
                                            <td class="text-center">
                                                <t t-if="inv and inv.due_date">
                                                    <span t-esc="inv.due_date.strftime('%d/%m/%Y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <!-- =========== PHẦN 2: Hóa đơn CÓ dự án nhưng KHÔNG HỢP ĐỒNG =========== -->
                                <t t-set="proj_invoices" t-value="doc.invoice_ids.filtered(lambda i: not i.contract_id and i.project_id)"/>
                                <t t-set="proj_invoices" t-value="proj_invoices.sorted(key=lambda i: ((i.project_id.id or 0), (i.date or i.create_date or i.id)))"/>

                                <t t-set="last_proj_id" t-value="False"/>

                                <t t-foreach="proj_invoices" t-as="inv">
                                    <t t-set="stt" t-value="stt + 1"/>
                                    <t t-set="proj" t-value="inv.project_id"/>

                                    <!-- Phiếu chi của hóa đơn này (trong tập payment_request_ids của doc) -->
                                    <t t-set="pay_lines" t-value="doc.payment_request_ids.filtered(lambda p: p.invoice_id.id == inv.id)"/>
                                    <t t-set="paid_amount" t-value="sum(pay_lines.mapped('total')) if pay_lines else 0.0"/>
                                    <t t-set="balance" t-value="(inv.amount or 0.0) - (paid_amount or 0.0)"/>

                                    <tr>
                                        <!-- 1. STT -->
                                        <td class="text-center">
                                            <span t-esc="stt"/>
                                        </td>

                                        <!-- 2. Dự án: chỉ in khi đổi dự án -->
                                        <td class="text-center" style="vertical-align:middle;">
                                            <t t-if="not last_proj_id or last_proj_id != proj.id">
                                                <span t-esc="proj.name or ''"/>
                                                <t t-set="last_proj_id" t-value="proj.id"/>
                                            </t>
                                        </td>

                                        <!-- 3. Diễn giải -->
                                        <td></td>

                                        <!-- 4. HĐ Số/Ngày -->
                                        <td></td>

                                        <!-- 5. HĐ Số tiền -->
                                        <td></td>

                                        <!-- 6. HSQT Số HS/Ngày -->
                                        <td></td>

                                        <!-- 7. HSQT Số tiền -->
                                        <td></td>

                                        <!-- 8. Hóa đơn Ngày -->
                                        <td class="text-center">
                                            <t t-if="inv.date">
                                                <span t-esc="inv.date.strftime('%d/%m/%Y')"/>
                                            </t>
                                        </td>

                                        <!-- 9. Hóa đơn Số -->
                                        <td class="text-center">
                                            <span t-esc="inv.invoice_number or ''"/>
                                        </td>

                                        <!-- 10. Hóa đơn Số tiền -->
                                        <td class="text-right num">
                                            <t t-if="inv.amount">
                                                <span t-esc="format_amount(
                                                    inv.amount,
                                                    inv.currency_id or doc.currency_id
                                                )"/>
                                            </t>
                                        </td>

                                        <!-- 11. Ngày trả -->
                                        <td class="text-center"></td>

                                        <!-- 12. Số tiền trả -->
                                        <td class="text-right num">
                                            <t t-if="paid_amount">
                                                <span t-esc="format_amount(
                                                    paid_amount,
                                                    inv.currency_id or doc.currency_id
                                                )"/>
                                            </t>
                                        </td>

                                        <!-- 13. Còn nợ -->
                                        <td class="text-right num">
                                            <t t-if="balance">
                                                <span t-esc="format_amount(
                                                    balance,
                                                    inv.currency_id or doc.currency_id
                                                )"/>
                                            </t>
                                        </td>

                                        <!-- 14. Ghi chú -->
                                        <td></td>

                                        <!-- 15. Hạn T/T -->
                                        <td class="text-center">
                                            <t t-if="inv.due_date">
                                                <span t-esc="inv.due_date.strftime('%d/%m/%Y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>

                                <!-- =========== PHẦN 3: Hóa đơn KHÔNG có dự án & KHÔNG có hợp đồng =========== -->
                                <t t-set="orphan_invoices" t-value="doc.invoice_ids.filtered(lambda i: not i.project_id and not i.contract_id)"/>

                                <t t-foreach="orphan_invoices" t-as="inv">
                                    <t t-set="stt" t-value="stt + 1"/>

                                    <!-- Phiếu chi của hóa đơn này -->
                                    <t t-set="pay_lines" t-value="doc.payment_request_ids.filtered(lambda p: p.invoice_id.id == inv.id)"/>
                                    <t t-set="paid_amount" t-value="sum(pay_lines.mapped('total')) if pay_lines else 0.0"/>
                                    <t t-set="balance" t-value="(inv.amount or 0.0) - (paid_amount or 0.0)"/>

                                    <tr>
                                        <!-- 1. STT -->
                                        <td class="text-center">
                                            <span t-esc="stt"/>
                                        </td>

                                        <!-- 2. Dự án: không thuộc dự án -->
                                        <td class="text-center" style="vertical-align:middle;">
                                            Không có dự án
                                        </td>

                                        <!-- 3. Diễn giải -->
                                        <td></td>

                                        <!-- 4. HĐ Số/Ngày -->
                                        <td></td>

                                        <!-- 5. HĐ Số tiền -->
                                        <td></td>

                                        <!-- 6. HSQT Số HS/Ngày -->
                                        <td></td>

                                        <!-- 7. HSQT Số tiền -->
                                        <td></td>

                                        <!-- 8. Hóa đơn Ngày -->
                                        <td class="text-center">
                                            <t t-if="inv.date">
                                                <span t-esc="inv.date.strftime('%d/%m/%Y')"/>
                                            </t>
                                        </td>

                                        <!-- 9. Hóa đơn Số -->
                                        <td class="text-center">
                                            <span t-esc="inv.invoice_number or ''"/>
                                        </td>

                                        <!-- 10. Hóa đơn Số tiền -->
                                        <td class="text-right num">
                                            <t t-if="inv.amount">
                                                <span t-esc="format_amount(
                                                    inv.amount,
                                                    inv.currency_id or doc.currency_id
                                                )"/>
                                            </t>
                                        </td>

                                        <!-- 11. Ngày trả -->
                                        <td class="text-center"></td>

                                        <!-- 12. Số tiền trả -->
                                        <td class="text-right num">
                                            <t t-if="paid_amount">
                                                <span t-esc="format_amount(
                                                    paid_amount,
                                                    inv.currency_id or doc.currency_id
                                                )"/>
                                            </t>
                                        </td>

                                        <!-- 13. Còn nợ -->
                                        <td class="text-right num">
                                            <t t-if="balance">
                                                <span t-esc="format_amount(
                                                    balance,
                                                    inv.currency_id or doc.currency_id
                                                )"/>
                                            </t>
                                        </td>

                                        <!-- 14. Ghi chú -->
                                        <td></td>

                                        <!-- 15. Hạn T/T -->
                                        <td class="text-center">
                                            <t t-if="inv.due_date">
                                                <span t-esc="inv.due_date.strftime('%d/%m/%Y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>

                            </t>                            <!-- end foreach docs -->
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <p>Không có dữ liệu công nợ.</p>
                </t>

                <!-- Chữ ký -->
                <div style="page-break-inside: avoid; font-weight: bold">
                    <div class="row">
                        <div class="col-6" style="text-align:center;line-height:1.8">
                            <div>
                                TP Hồ Chí Minh ngày &#160;&#160;
                                tháng &#160;&#160;
                                năm <span t-esc="datetime.datetime.today().year"/>
                            </div>
                            <div>
                                <span>Người lập biểu</span>
                            </div>
                            <div style="height:65px">
                                <t t-if="user_id.digital_signature">
                                    <img t-att-src="'data:image/png;base64,' + (user_id.digital_signature.decode() if isinstance(user_id.digital_signature, bytes) else user_id.digital_signature)" style="max-height:65px; max-width:150px;"/>
                                </t>
                            </div>
                            <div>
                                <span t-field="user_id.name"/>
                            </div>
                        </div>

                        <div class="col-6" style="text-align:center;line-height:1.8">
                            <div>
                                TP Hồ Chí Minh ngày &#160;&#160;
                                tháng &#160;&#160;
                                năm <span t-esc="datetime.datetime.today().year"/>
                            </div>
                            <div>Giám Đốc</div>
                            <div style="height:65px">
                                <t t-set="director_group" t-value="env.ref('custom_director_role.group_director')"/>
                                <t t-set="director" t-value="env['res.users'].search([('groups_id', 'in', director_group.id)], limit=1)"/>
                                <t t-if="director and director.digital_signature">
                                    <img t-att-src="'data:image/png;base64,' + (director.digital_signature.decode() if isinstance(director.digital_signature, bytes) else director.digital_signature)" style="max-height:65px; max-width:150px;"/>
                                </t>
                            </div>
                            <div>
                                <span> Đỗ Minh Toàn </span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </t>
    </template>
</odoo>
