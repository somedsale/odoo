<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_project_project_form_work_custom_inherit_customer_invoice_btn" model="ir.ui.view">
      <field name="name">project.project.form.work.custom.inherit.customer.invoice.button</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project_work_from_so.view_project_project_form_work_custom"/>
      <field name="arch" type="xml">

        <!-- Nếu form custom của bạn đã có button_box -->
        <xpath expr="//form/sheet/div[@name='button_box']" position="inside">
          <button name="action_view_customer_invoices"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-file-text-o">
            <field name="customer_invoice_count" widget="statinfo" string="Báo cáo giải ngân"/>
          </button>
        </xpath>

      </field>
    </record>

  </data>
</odoo>