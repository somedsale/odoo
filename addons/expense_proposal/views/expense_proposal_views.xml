<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_expense_proposal_tree" model="ir.ui.view">
        <field name="name">expense.proposal.tree</field>
        <field name="model">expense.proposal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="proposer_id"/>
                <field name="amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_expense_proposal_form" model="ir.ui.view">
        <field name="name">expense.proposal.form</field>
        <field name="model">expense.proposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Xác nhận" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Duyệt" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Từ chối" type="object" invisible="state != 'submitted'"/>
                    <button name="action_post" string="Tạo phiếu chi" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_draft" string="Trở về nháp" type="object" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="proposer_id"/>
                        <field name="amount"/>
                    </group>
                        <field name="expense_proposal_lines">
                            <tree>
                                <field name="content" width="20%"/>
                                <field name="date" width="20%"/>
                                <field name="cost_classification" width="20%"/>
                                <field name="amount" width="20%"/>
                                <field name="expense_category_id" width="20%"/>
                                 <button name="action_view_payment_request" type="object" string="Xem Phiếu Chi"
                                        icon="fa-money" invisible="'payment_request_id', '=', False"/>
                            </tree>
                        </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_expense_proposal" model="ir.actions.act_window">
        <field name="name">Đề xuất chi phí</field>
        <field name="res_model">expense.proposal</field>
        <field name="view_mode">tree,form</field>
    </record>
<record id="action_view_payment_requests" model="ir.actions.act_window">
    <field name="name">Phiếu Chi</field>
    <field name="res_model">account.payment.request</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('expense_proposal_id', '=', active_id)]</field>
    <field name="target">current</field>
</record>
    <menuitem id="menu_expense_proposal" name="Đề xuất chi phí" action="action_expense_proposal" parent="custom_account_menu.menu_accounting_vouchers" sequence="10"/>
</odoo>