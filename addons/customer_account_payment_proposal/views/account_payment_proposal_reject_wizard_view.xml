<odoo>
    <record id="view_account_payment_proposal_reject_wizard" model="ir.ui.view">
        <field name="name">account.payment.proposal.reject.wizard.form</field>
        <field name="model">account.payment.proposal.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Lý do từ chối">
                <group>
                    <field name="reason" placeholder="Nhập lý do từ chối..." />
                </group>
                <footer>
                    <button string="Xác nhận từ chối" name="action_confirm_reject" type="object" class="btn-danger"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
