<odoo>
    <!-- Inherit cho “Đơn hàng” -->
    <record id="view_purchase_order_tree_inherit_po" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.po</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='partner_id']" position="after">
                <field name="project_id" optional="show"/>
                <field name="proposal_sheet_id" optional="show"/>
                <field name="supplier_contract_id" optional="show"/>
                <field name="payment_status" widget="badge" optional="show"/>
                <field name="shipping_status" widget="badge" optional="show" decoration-danger="shipping_status == 'not_shipped'" decoration-warning="shipping_status == 'in_process'" decoration-success="shipping_status == 'done'"/>
            </xpath>
            <xpath expr="//tree/field[@name='state']" position="attributes">
                <attributes>
                    <attribute name="invisible">1</attribute>
                </attributes>
            </xpath>
        </field>
    </record>

    <!-- Inherit cho “Yêu cầu báo giá” (RFQ) -->
    <record id="view_purchase_order_tree_inherit_rfq" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.rfq</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='partner_id']" position="after">
                <field name="project_id" optional="show"/>
            </xpath>
            <xpath expr="//tree/field[@name='state']" position="after">
                <field name="note"  optional="show"/>
                <field name="shipping_status" widget="badge" optional="show" decoration-danger="shipping_status == 'not_shipped'" decoration-warning="shipping_status == 'in_process'" decoration-success="shipping_status == 'done'"/>
            </xpath>
                        <xpath expr="//tree/field[@name='state']" position="attributes">
                <attributes>
                    <attribute name="column_invisible">1</attribute>
                </attributes>
            </xpath>
            <xpath expr="//tree/field[@name='activity_ids']" position="attributes">
                <attributes>
                    <attribute name="column_invisible">1</attribute>
                </attributes>
            </xpath>
        </field>
    </record>
</odoo>
