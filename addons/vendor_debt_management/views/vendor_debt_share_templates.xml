<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="vendor_debt_share_page" name="Vendor Debt Share Page">
        <t t-call="web.html_container">
            <t t-set="data" t-value="report_data or {}"/>
            <t t-set="summary_data" t-value="data.get('summary', {})"/>
            <t t-set="projects" t-value="data.get('projects', [])"/>
            <t t-set="currency_symbol" t-value="summary_data.get('currency_symbol', '')"/>

            <style>
                .container {
                    max-width: 100% !important;
                }

                body {
                    background: #eef3f8 !important;
                    font-family: "Inter", "Segoe UI", Arial, sans-serif;
                }

                .vendor-share-page,
                .vendor-share-page * {
                    box-sizing: border-box;
                }

                .vendor-share-page .container,
                .vendor-share-page .container-fluid {
                    max-width: 100% !important;
                }

                .vendor-share-shell {
                    width: 100%;
                    max-width: 100%;
                    padding: 20px;
                }

                .vendor-share-hero {
                    background:
                        radial-gradient(circle at top right, rgba(255,255,255,0.20), transparent 28%),
                        linear-gradient(135deg, #0f4c81 0%, #2563eb 55%, #3b82f6 100%);
                    color: #ffffff;
                    border-radius: 24px;
                    padding: 30px 34px;
                    position: relative;
                    overflow: hidden;
                }

                .vendor-share-hero:after {
                    content: "";
                    position: absolute;
                    right: -40px;
                    top: -40px;
                    width: 180px;
                    height: 180px;
                    border-radius: 50%;
                    background: rgba(255,255,255,0.08);
                }

                .vendor-share-tag {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    padding: 8px 14px;
                    border-radius: 999px;
                    background: rgba(255,255,255,0.16);
                    border: 1px solid rgba(255,255,255,0.20);
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 0.04em;
                    text-transform: uppercase;
                }

                .vendor-share-title {
                    margin: 14px 0 8px;
                    font-size: 34px;
                    line-height: 1.15;
                    font-weight: 800;
                }

                .vendor-share-subtitle {
                    margin: 0;
                    font-size: 16px;
                    line-height: 1.6;
                    color: rgba(255,255,255,0.95);
                }

                .vendor-share-meta {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 12px;
                    justify-content: flex-end;
                }

                .vendor-share-meta-box {
                    min-width: 180px;
                    background: rgba(255,255,255,0.12);
                    border: 1px solid rgba(255,255,255,0.18);
                    border-radius: 18px;
                    padding: 14px 16px;
                    backdrop-filter: blur(4px);
                }

                .vendor-share-meta-label {
                    font-size: 12px;
                    opacity: 0.85;
                    margin-bottom: 6px;
                    text-transform: uppercase;
                    letter-spacing: 0.04em;
                }

                .vendor-share-meta-value {
                    font-size: 15px;
                    font-weight: 700;
                    line-height: 1.4;
                }

                .vendor-share-section {
                    margin-top: 18px;
                }

                .vendor-share-grid {
                    display: grid;
                    grid-template-columns: repeat(6, minmax(0, 1fr));
                    gap: 16px;
                }

                .vendor-kpi {
                    background: #ffffff;
                    border: 1px solid #e8edf3;
                    border-radius: 20px;
                    padding: 18px 18px 16px;
                    min-height: 116px;
                    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.04);
                }

                .vendor-kpi-label {
                    font-size: 13px;
                    color: #64748b;
                    margin-bottom: 12px;
                    line-height: 1.4;
                }

                .vendor-kpi-value {
                    font-size: 24px;
                    font-weight: 800;
                    color: #0f172a;
                    line-height: 1.2;
                }

                .vendor-kpi-highlight {
                    background: linear-gradient(180deg, #fff8eb 0%, #fff3d6 100%);
                    border: 1px solid #f5c66b;
                }

                .vendor-kpi-highlight .vendor-kpi-label {
                    color: #9a6700;
                }

                .vendor-kpi-highlight .vendor-kpi-value {
                    color: #b45309;
                    font-size: 28px;
                }

                .vendor-note-grid {
                    display: grid;
                    grid-template-columns: 1.2fr 1fr 1fr;
                    gap: 16px;
                    margin-top: 16px;
                }

                .vendor-note-box {
                    background: #ffffff;
                    border: 1px solid #e8edf3;
                    border-radius: 20px;
                    padding: 18px 20px;
                    min-height: 102px;
                }

                .vendor-note-title {
                    font-size: 13px;
                    color: #64748b;
                    margin-bottom: 10px;
                }

                .vendor-note-content {
                    font-size: 15px;
                    color: #0f172a;
                    font-weight: 600;
                    line-height: 1.55;
                }

                .vendor-table-card {
                    background: #ffffff;
                    border: 1px solid #e5eaf1;
                    border-radius: 24px;
                    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
                    overflow: hidden;
                }

                .vendor-table-head {
                    padding: 24px 26px 18px;
                    border-bottom: 1px solid #edf2f7;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 16px;
                    flex-wrap: wrap;
                }

                .vendor-table-title {
                    margin: 0;
                    font-size: 24px;
                    font-weight: 800;
                    color: #0f172a;
                }

                .vendor-table-desc {
                    margin-top: 6px;
                    font-size: 14px;
                    color: #64748b;
                }

                .vendor-table-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 4px;
                    padding: 9px 14px;
                    border-radius: 999px;
                    background: #eff6ff;
                    color: #1d4ed8;
                    border: 1px solid #bfdbfe;
                    font-size: 13px;
                    font-weight: 700;
                }

                .vendor-table-wrap {
                    width: 100%;
                    overflow: auto;
                    padding: 0 0 6px;
                }

                .vendor-table {
                    width: 100%;
                    min-width: 1500px;
                    border-collapse: separate !important;
                    border-spacing: 0;
                    margin: 0;
                    background: #ffffff;
                }

                .vendor-table thead th {
                    background: #f8fafc;
                    color: #0f172a;
                    font-size: 12px;
                    font-weight: 800;
                    text-align: center;
                    vertical-align: middle;
                    padding: 12px 10px;
                    border-right: 1px solid #e5e7eb;
                    border-bottom: 1px solid #dbe3ec;
                    white-space: nowrap;
                }

                .vendor-table thead tr:first-child th {
                    background: #edf4fb;
                }

                .vendor-table tbody td {
                    padding: 11px 10px;
                    border-right: 1px solid #edf2f7;
                    border-bottom: 1px solid #edf2f7;
                    font-size: 13px;
                    color: #0f172a;
                    vertical-align: middle;
                    background: #ffffff;
                }

                .vendor-table tbody tr:hover td {
                    background: #fafcff;
                }

                .vendor-project-row td {
                    background: #f0f9f4 !important;
                    font-weight: 700;
                    color: #166534;
                    border-bottom: 1px solid #d6eadc;
                }

                .vendor-contract-row td {
                    background: #f8fafc !important;
                    font-weight: 600;
                }

                .vendor-row-invoice td {
                    background: #ffffff;
                }

                .vendor-row-payment td {
                    background: #fcfcfd;
                }

                .vendor-row-payment-orphan td {
                    background: #fffaf0;
                }

                .vendor-muted {
                    color: #64748b;
                    font-size: 12px;
                }

                .vendor-total-label {
                    color: #64748b;
                    font-size: 12px;
                    font-weight: 700;
                    white-space: nowrap;
                }

                .vendor-line-payment-marker {
                    color: #64748b;
                    margin-right: 6px;
                }

                .vendor-payment-name {
                    font-weight: 600;
                    color: #0f172a;
                }

                .vendor-payment-note {
                    color: #64748b;
                    font-size: 12px;
                    line-height: 1.45;
                }

                .vendor-empty {
                    padding: 40px 20px;
                    text-align: center;
                    color: #64748b;
                    font-size: 14px;
                }

                .vendor-footer-note {
                    padding: 16px 26px 24px;
                    font-size: 12px;
                    color: #64748b;
                }

                .text-end {
                    text-align: right;
                }

                .text-center {
                    text-align: center;
                }

                @media (max-width: 1400px) {
                    .vendor-share-grid {
                        grid-template-columns: repeat(3, minmax(0, 1fr));
                    }
                }

                @media (max-width: 992px) {
                    .vendor-share-shell {
                        padding: 12px;
                    }

                    .vendor-share-hero {
                        padding: 22px 20px;
                    }

                    .vendor-share-title {
                        font-size: 28px;
                    }

                    .vendor-share-meta {
                        justify-content: flex-start;
                    }

                    .vendor-share-grid {
                        grid-template-columns: repeat(2, minmax(0, 1fr));
                    }

                    .vendor-note-grid {
                        grid-template-columns: 1fr;
                    }

                    .vendor-table-head {
                        padding: 18px 18px 14px;
                    }
                }

                @media (max-width: 576px) {
                    .vendor-share-grid {
                        grid-template-columns: 1fr;
                    }

                    .vendor-share-title {
                        font-size: 24px;
                    }

                    .vendor-kpi-value {
                        font-size: 22px;
                    }
                }
            </style>

            <div class="vendor-share-page" style="width:100%; max-width:100%;">
                <div class="vendor-share-shell">

                    <div class="vendor-share-hero mb-4">
                        <div class="row g-4 align-items-start">
                            <div class="col-lg-8">
                                <div class="vendor-share-tag">Supplier Debt Reconciliation</div>

                                <div class="vendor-share-title">Đối chiếu công nợ nhà cung cấp</div>

                                <p class="vendor-share-subtitle">
                                    Nhà cung cấp:
                                    <strong t-esc="summary_data.get('partner_name') or (summary.partner_id.name if summary and summary.partner_id else '')"/>
                                </p>

                                <p class="vendor-share-subtitle" style="margin-top:10px; max-width:900px;">
                                    Đây là báo cáo chia sẻ để hai bên đối chiếu các khoản công nợ, hợp đồng, hóa đơn, thanh toán và số dư còn nợ tại thời điểm hiện tại.
                                </p>
                            </div>

                            <div class="col-lg-4">
                                <div class="vendor-share-meta">
                                    <div class="vendor-share-meta-box">
                                        <div class="vendor-share-meta-label">Trạng thái</div>
                                        <div class="vendor-share-meta-value">Liên kết chia sẻ đang hoạt động</div>
                                    </div>

                                    <div class="vendor-share-meta-box">
                                        <div class="vendor-share-meta-label">Hạn chia sẻ</div>
                                        <div class="vendor-share-meta-value">
                                            <t t-if="summary and summary.share_expired_at">
                                                <span t-esc="summary.share_expired_at"/>
                                            </t>
                                            <t t-else="">Không giới hạn</t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="vendor-share-section">
                        <div class="vendor-share-grid">
                            <div class="vendor-kpi">
                                <div class="vendor-kpi-label">Công nợ cũ</div>
                                <div class="vendor-kpi-value">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('old_debt', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>

                            <div class="vendor-kpi">
                                <div class="vendor-kpi-label">Tổng hợp đồng</div>
                                <div class="vendor-kpi-value">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('total_contract_amount', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>

                            <div class="vendor-kpi">
                                <div class="vendor-kpi-label">Tổng hồ sơ quyết toán</div>
                                <div class="vendor-kpi-value">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('total_settlements_amount', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>

                            <div class="vendor-kpi">
                                <div class="vendor-kpi-label">Tổng hóa đơn</div>
                                <div class="vendor-kpi-value">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('total_invoice_amount', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>

                            <div class="vendor-kpi">
                                <div class="vendor-kpi-label">Tổng đã trả</div>
                                <div class="vendor-kpi-value">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('total_payment_amount', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>

                            <div class="vendor-kpi vendor-kpi-highlight">
                                <div class="vendor-kpi-label">Còn nợ</div>
                                <div class="vendor-kpi-value">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('residual_amount', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>
                        </div>

                        <div class="vendor-note-grid">
                            <div class="vendor-note-box">
                                <div class="vendor-note-title">Chi chưa hóa đơn</div>
                                <div class="vendor-note-content">
                                    <span t-esc="'{:,.0f}'.format(summary_data.get('advance_amount', 0.0) or 0.0).replace(',', '.')"/>
                                    <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                </div>
                            </div>

                            <div class="vendor-note-box">
                                <div class="vendor-note-title">Thông tin hạn thanh toán</div>
                                <div class="vendor-note-content">
                                    <span t-esc="summary_data.get('due_days') or 'Không có thông tin hạn thanh toán'"/>
                                </div>
                            </div>

                            <div class="vendor-note-box">
                                <div class="vendor-note-title">Ghi chú</div>
                                <div class="vendor-note-content" style="font-weight:500;">
                                    <t t-if="summary_data.get('note')">
                                        <span t-esc="summary_data.get('note')"/>
                                    </t>
                                    <t t-else="">
                                        Vui lòng đối chiếu số liệu và phản hồi lại nếu có chênh lệch giữa hai bên.
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="vendor-table-card mt-4">
                        <div class="vendor-table-head">
                            <div>
                                <h3 class="vendor-table-title">Chi tiết đối chiếu</h3>
                                <div class="vendor-table-desc">
                                    Dữ liệu được nhóm theo dự án, hợp đồng, hóa đơn và các khoản thanh toán liên quan.
                                </div>
                            </div>

                            <div class="vendor-table-badge">
                                <span t-esc="len(projects) if projects else 0"/>
                                <span>dự án</span>
                            </div>
                        </div>

                        <div class="vendor-table-wrap">
                            <table class="vendor-table table table-bordered table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="min-width:60px;">STT</th>
                                        <th rowspan="2" style="min-width:260px;">Diễn giải</th>
                                        <th colspan="2">Hợp đồng</th>
                                        <th colspan="2">Hồ sơ quyết toán</th>
                                        <th colspan="3">Hóa đơn</th>
                                        <th colspan="2">Đã trả</th>
                                        <th rowspan="2" style="min-width:140px;">Số tiền còn nợ</th>
                                        <th rowspan="2" style="min-width:160px;">Ghi chú</th>
                                        <th rowspan="2" style="min-width:120px;">Hạn T/T</th>
                                    </tr>

                                    <tr>
                                        <th>Số/Ngày</th>
                                        <th>Số tiền</th>
                                        <th>Số HS/ngày</th>
                                        <th>Số tiền</th>
                                        <th>Ngày</th>
                                        <th>Số</th>
                                        <th>Số tiền</th>
                                        <th>Ngày trả</th>
                                        <th>Số tiền</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-set="display_stt" t-value="1"/>

                                    <t t-foreach="projects" t-as="project" t-key="project.get('id')">
                                        <!-- DỰ ÁN -->
                                        <tr class="vendor-project-row">
                                            <td colspan="14">
                                                <span t-esc="project.get('project_name')"/>
                                            </td>
                                        </tr>

                                        <t t-foreach="project.get('contracts', [])" t-as="contract" t-key="contract.get('id')">
                                            <!-- HỢP ĐỒNG -->
                                            <tr class="vendor-contract-row">
                                                <td class="text-center"></td>

                                                <td colspan="2">
                                                    <div class="vendor-contract-text" style="padding-left: 24px;">
                                                        <t t-if="contract.get('contract_name') and contract.get('contract_name') != 'Không có hợp đồng'">
                                                            <span t-esc="contract.get('contract_name')"/>
                                                            <t t-if="contract.get('contract_date')">
                                                                <span> / </span>
                                                                <span t-esc="contract.get('contract_date')"/>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <span>Không có hợp đồng</span>
                                                        </t>
                                                    </div>
                                                </td>

                                                <td class="text-end">
                                                    <strong>
                                                        <t t-if="contract.get('contract_amount')">
                                                            <span t-esc="'{:,.0f}'.format(contract.get('contract_amount') or 0.0).replace(',', '.')"/>
                                                            <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                        </t>
                                                    </strong>
                                                </td>

                                                <td></td>

                                                <td class="text-end"></td>

                                                <td></td>

                                                <td class="text-center">
                                                    <span class="vendor-total-label">Tổng HĐ</span>
                                                </td>

                                                <td class="text-end">
                                                    <strong>
                                                        <t t-if="contract.get('invoice_total')">
                                                            <span t-esc="'{:,.0f}'.format(contract.get('invoice_total') or 0.0).replace(',', '.')"/>
                                                            <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                        </t>
                                                    </strong>
                                                </td>

                                                <td class="text-center">
                                                    <span class="vendor-total-label">Tổng trả</span>
                                                </td>

                                                <td class="text-end">
                                                    <strong>
                                                        <t t-if="contract.get('payment_total')">
                                                            <span t-esc="'{:,.0f}'.format(contract.get('payment_total') or 0.0).replace(',', '.')"/>
                                                            <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                        </t>
                                                    </strong>
                                                </td>

                                                <td class="text-end">
                                                    <strong>
                                                        <t t-if="contract.get('residual_total')">
                                                            <span t-esc="'{:,.0f}'.format(contract.get('residual_total') or 0.0).replace(',', '.')"/>
                                                            <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                        </t>
                                                    </strong>
                                                </td>

                                                <td></td>

                                                <td></td>
                                            </tr>

                                            <!-- HÓA ĐƠN + PHIẾU CHI -->
                                            <t t-foreach="contract.get('rows', [])" t-as="row" t-key="row.get('id')">

                                                <!-- DÒNG HÓA ĐƠN -->
                                                <t t-if="row.get('show_invoice')">
                                                    <tr class="vendor-row-invoice">
                                                        <td class="text-center">
                                                            <span t-esc="display_stt"/>
                                                            <t t-set="display_stt" t-value="display_stt + 1"/>
                                                        </td>

                                                        <td colspan="2">
                                                            <div class="vendor-line-invoice-text" style="padding-left: 48px;">
                                                                <t t-if="row.get('invoice_note')">
                                                                    <span t-esc="row.get('invoice_note')"/>
                                                                </t>
                                                                <t t-elif="row.get('invoice_name')">
                                                                    <span t-esc="row.get('invoice_name')"/>
                                                                </t>
                                                            </div>
                                                        </td>

                                                        <td class="text-end"></td>
                                                        <td></td>
                                                        <td class="text-end"></td>

                                                        <td class="text-center">
                                                            <span t-esc="row.get('invoice_date') or ''"/>
                                                        </td>

                                                        <td>
                                                            <span t-esc="row.get('invoice_name') or ''"/>
                                                        </td>

                                                        <td class="text-end">
                                                            <t t-if="row.get('invoice_amount') not in (False, None, '')">
                                                                <span t-esc="'{:,.0f}'.format(row.get('invoice_amount') or 0.0).replace(',', '.')"/>
                                                                <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                            </t>
                                                        </td>

                                                        <td></td>
                                                        <td></td>

                                                        <td class="text-end">
                                                            <t t-if="row.get('residual_display') not in (False, None, '')">
                                                                <span t-esc="'{:,.0f}'.format(row.get('residual_display') or 0.0).replace(',', '.')"/>
                                                                <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                            </t>
                                                        </td>

                                                        <td></td>

                                                        <td class="text-center">
                                                            <span t-esc="row.get('invoice_due_date') or ''"/>
                                                        </td>
                                                    </tr>
                                                </t>

                                                <!-- DÒNG PHIẾU CHI -->
                                                <t t-if="row.get('payment_id') or row.get('payment_date') or row.get('payment_amount')">
                                                    <tr t-att-class="row.get('note') and 'vendor-row-payment vendor-row-payment-orphan' or 'vendor-row-payment'">
                                                        <td class="text-center"></td>

                                                        <td colspan="2">
                                                            <div class="vendor-line-payment-text" style="padding-left: 72px;">
                                                                <span class="vendor-line-payment-marker">↳</span>

                                                                <t t-if="row.get('payment_name')">
                                                                    <span class="vendor-payment-name" t-esc="row.get('payment_name')"/>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="vendor-muted">Phiếu chi</span>
                                                                </t>
                                                            </div>
                                                        </td>

                                                        <td class="text-end"></td>
                                                        <td></td>
                                                        <td class="text-end"></td>
                                                        <td></td>
                                                        <td></td>
                                                        <td></td>

                                                        <td class="text-center">
                                                            <span t-esc="row.get('payment_date') or ''"/>
                                                        </td>

                                                        <td class="text-end">
                                                            <t t-if="row.get('payment_amount') not in (False, None, '')">
                                                                <span t-esc="'{:,.0f}'.format(row.get('payment_amount') or 0.0).replace(',', '.')"/>
                                                                <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                            </t>
                                                        </td>

                                                        <td class="text-end">
                                                            <t t-if="not row.get('show_invoice') and row.get('residual_display') not in (False, None, '')">
                                                                <span t-esc="'{:,.0f}'.format(row.get('residual_display') or 0.0).replace(',', '.')"/>
                                                                <span t-if="currency_symbol" t-esc="' ' + currency_symbol"/>
                                                            </t>
                                                        </td>

                                                        <!-- Ghi chú: chỉ hiện payment_note, không hiện row.note / Không có hóa đơn -->
                                                        <td>
                                                            <t t-if="row.get('payment_note')">
                                                                <span class="vendor-payment-note" t-esc="row.get('payment_note')"/>
                                                            </t>
                                                        </td>

                                                        <td></td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </t>

                                    <t t-if="not projects">
                                        <tr>
                                            <td colspan="14" class="vendor-empty">
                                                Không có dữ liệu để hiển thị.
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="vendor-footer-note">
                            Lưu ý: Đây là báo cáo chia sẻ dùng cho mục đích đối chiếu công nợ giữa các bên tại thời điểm truy cập liên kết.
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>
</odoo>