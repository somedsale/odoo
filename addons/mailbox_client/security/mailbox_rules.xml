<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Mailbox User: chỉ thấy account của mình -->
        <record id="mailbox_account_rule_user_own" model="ir.rule">
            <field name="name">Mailbox Account - own only</field>
            <field name="model_id" ref="model_mailbox_account"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Mailbox User: chỉ thấy folder thuộc account của mình -->
        <record id="mailbox_folder_rule_user_own" model="ir.rule">
            <field name="name">Mailbox Folder - own only</field>
            <field name="model_id" ref="model_mailbox_folder"/>
            <field name="domain_force">[('account_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Mailbox User: chỉ thấy mail thuộc account của mình -->
        <record id="mailbox_message_rule_user_own" model="ir.rule">
            <field name="name">Mailbox Message - own only</field>
            <field name="model_id" ref="model_mailbox_message"/>
            <field name="domain_force">[('account_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Manager: thấy tất cả -->
        <record id="mailbox_account_rule_manager_all" model="ir.rule">
            <field name="name">Mailbox Account - manager all</field>
            <field name="model_id" ref="model_mailbox_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mailbox_client.group_mailbox_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="mailbox_folder_rule_manager_all" model="ir.rule">
            <field name="name">Mailbox Folder - manager all</field>
            <field name="model_id" ref="model_mailbox_folder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mailbox_client.group_mailbox_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="mailbox_message_rule_manager_all" model="ir.rule">
            <field name="name">Mailbox Message - manager all</field>
            <field name="model_id" ref="model_mailbox_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('mailbox_client.group_mailbox_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>