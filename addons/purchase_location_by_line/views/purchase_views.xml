<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.location.actual.stock</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']//field[@name='date_planned']" position="after">
                <field name="state" column_invisible="1"/>

                <field name="location_dest_id"
                       string="Tên kho"
                       readonly="state in ('purchase', 'done', 'cancel')"/>

                <field name="actual_stock_qty"
                       string="Tồn thực tế"
                       readonly="1"/>
            </xpath>

        </field>
    </record>


    <record id="purchase_order_line_form2" model="ir.ui.view">
        <field name="name">purchase.order.line.form.inherit.location.actual.stock</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_form2"/>
        <field name="arch" type="xml">

            <field name="date_planned" position="after">
                <field name="state" invisible="1"/>

                <field name="location_dest_id"
                       string="Tên kho"
                       readonly="state in ('purchase', 'done', 'cancel')"/>

                <field name="actual_stock_qty"
                       string="Tồn thực tế"
                       readonly="1"/>
            </field>

        </field>
    </record>


    <record id="purchase_order_line_tree" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.inherit.location.actual.stock</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
        <field name="arch" type="xml">

            <field name="date_planned" position="after">
                <field name="location_dest_id"
                       string="Tên kho"
                       required="1"/>

                <field name="actual_stock_qty"
                       string="Tồn thực tế"
                       readonly="1"/>
            </field>

        </field>
    </record>

</odoo>