<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="project_work_from_so.ProjectWorkProjectFormOwl" owl="1">
    <div class="o_pwf_project_form_owl d-flex flex-column h-100">

      <!-- Loading -->
      <t t-if="state.loading">
        <div class="d-flex align-items-center justify-content-center flex-grow-1">
          <div class="text-muted p-4">
            <i class="fa fa-spinner fa-spin me-2"/> Đang tải form dự án...
          </div>
        </div>
      </t>

      <t t-else="">
        <!-- Toolbar -->
        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <button t-if="props.onBack"
                    class="btn btn-sm btn-outline-secondary"
                    t-on-click="props.onBack">
              <i class="fa fa-arrow-left me-1"/> Quay lại
            </button>

            <span class="badge rounded-pill text-bg-light border">
              Project ID: <t t-esc="props.projectId"/>
            </span>
          </div>

          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" t-on-click="openStandardForm">
              <i class="fa fa-external-link me-1"/> Mở form chuẩn
            </button>
            <button class="btn btn-sm btn-primary"
                    t-on-click="saveForm"
                    t-att-disabled="state.saving ? true : undefined">
              <i class="fa fa-save me-1"/>
              <t t-if="state.saving">Đang lưu...</t>
              <t t-else="">Lưu</t>
            </button>
          </div>
        </div>

        <!-- Main Card -->
        <div class="card flex-grow-1 d-flex flex-column shadow-sm" style="min-height:0;">
          <div class="card-body overflow-auto">

            <!-- Smart buttons -->
            <div class="p-2 rounded border bg-light-subtle mb-3">
              <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-outline-primary" t-on-click="openTasksAction">
                  <i class="fa fa-tasks me-1"/> Nhiệm vụ
                  <span class="badge bg-primary-subtle text-primary-emphasis ms-1">
                    <t t-esc="state.stats.task_count_custom"/>
                  </span>
                </button>

                <button class="btn btn-sm btn-outline-primary" t-on-click="openWorkItemsAction">
                  <i class="fa fa-list-ul me-1"/> Sản lượng / Hạng mục công việc
                  <span class="badge bg-primary-subtle text-primary-emphasis ms-1">
                    <t t-esc="state.stats.work_item_count"/>
                  </span>
                </button>

                <button class="btn btn-sm btn-outline-secondary" t-on-click="openCostEstimatesAction">
                  <i class="fa fa-calculator me-1"/> Dự toán chi phí
                  <span class="badge bg-secondary-subtle text-secondary-emphasis ms-1">
                    <t t-esc="state.stats.cost_estimate_count"/>
                  </span>
                </button>

                <button class="btn btn-sm btn-outline-success" t-on-click="openExpenseDashboardAction">
                  <i class="fa fa-usd me-1"/> Chi phí dự án
                  <span class="badge bg-success-subtle text-success-emphasis ms-1">
                    <t t-esc="state.stats.project_expense_custom_count"/>
                  </span>
                </button>

                <button class="btn btn-sm btn-outline-warning" t-on-click="openAcceptanceReportsAction">
                  <i class="fa fa-check-square-o me-1"/> Nghiệm thu
                  <span class="badge bg-warning-subtle text-warning-emphasis ms-1">
                    <t t-esc="state.stats.acceptance_report_count"/>
                  </span>
                </button>
                <button class="btn btn-sm btn-outline-info" t-on-click="openClaimReportsAction">
                  <i class="fa fa-file-text-o me-1"/> Thanh / Quyết toán
                  <span class="badge bg-info-subtle text-info-emphasis ms-1">
                    <t t-esc="state.stats.claim_report_count"/>
                  </span>
                </button>

                                <button class="btn btn-sm btn-outline-info" t-on-click="openInvoiceReportsAction">
                  <i class="fa fa-file-text-o me-1"/> Hóa đơn
                  <span class="badge bg-info-subtle text-info-emphasis ms-1">
                    <t t-esc="state.stats.customer_invoice_count"/>
                  </span>
                </button>
              </div>
            </div>

            <!-- Project name -->
            <div class="card mb-3 border-0 shadow-sm">
              <div class="card-body py-3">
                <label class="form-label fw-semibold mb-1">Tên dự án</label>
                <input class="form-control"
                       data-field="name"
                       t-att-value="state.form.name || ''"
                       t-on-input="onInput"
                       placeholder="Tên dự án..."/>
              </div>
            </div>

            <!-- Top layout: 3 blocks -->
            <div class="row g-3 mb-3">

              <!-- 1) Basic info -->
              <div class="col-12 col-lg-6 col-xxl-4">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-header py-2 fw-semibold bg-light">Thông tin cơ bản</div>
                  <div class="card-body">
                    <div class="row g-2">

                      <div class="col-12">
                        <label class="form-label mb-1">Đối tác</label>
                        <select class="form-select"
                                data-field="partner_id"
                                t-on-change="onSelectMany2one"
                                t-att-value="state.form.partner_id ? '' + state.form.partner_id : ''">
                          <option value="" t-att-selected="!state.form.partner_id ? true : undefined">
                            -- Chọn đối tác --
                          </option>
                          <t t-foreach="state.partnerOptions" t-as="p" t-key="p.id">
                            <option t-att-value="p.id"
                                    t-att-selected="state.form.partner_id &amp;&amp; ('' + state.form.partner_id) === ('' + p.id) ? true : undefined">
                              <t t-esc="p.name"/>
                            </option>
                          </t>
                        </select>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Ngày bắt đầu</label>
                        <input type="date"
                               class="form-control"
                               data-field="date_start"
                               t-att-value="state.form.date_start || ''"
                               t-on-input="onInput"/>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Ngày kết thúc</label>
                        <input type="date"
                               class="form-control"
                               data-field="date"
                               t-att-value="state.form.date || ''"
                               t-on-input="onInput"/>
                      </div>

                      <div class="col-12">
                        <label class="form-label mb-1">Trạng thái dự án</label>
                        <select class="form-select"
                                data-field="stage_id"
                                t-on-change="onSelectMany2one"
                                t-att-value="state.form.stage_id ? '' + state.form.stage_id : ''">
                          <option value="" t-att-selected="!state.form.stage_id ? true : undefined">
                            -- Chọn trạng thái --
                          </option>
                          <t t-foreach="state.stageOptions" t-as="s" t-key="s.id">
                            <option t-att-value="s.id"
                                    t-att-selected="state.form.stage_id &amp;&amp; ('' + state.form.stage_id) === ('' + s.id) ? true : undefined">
                              <t t-esc="s.name"/>
                            </option>
                          </t>
                        </select>
                      </div>

                    </div>
                  </div>
                </div>
              </div>

              <!-- 2) Contract info -->
              <div class="col-12 col-lg-6 col-xxl-4">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-header py-2 fw-semibold bg-light">Thông tin hợp đồng</div>
                  <div class="card-body">
                    <div class="row g-2">

                      <div class="col-12">
                        <label class="form-label mb-1">Hợp đồng</label>
                        <select class="form-select"
                                data-field="contract_id"
                                t-on-change="onSelectMany2one"
                                t-att-value="state.form.contract_id ? '' + state.form.contract_id : ''">
                          <option value="" t-att-selected="!state.form.contract_id ? true : undefined">
                            -- Chọn hợp đồng --
                          </option>
                          <t t-foreach="state.contractOptions" t-as="c" t-key="c.id">
                            <option t-att-value="c.id"
                                    t-att-selected="state.form.contract_id &amp;&amp; ('' + state.form.contract_id) === ('' + c.id) ? true : undefined">
                              <t t-esc="c.name"/>
                              <t t-if="c.sale_order_name"> - <t t-esc="c.sale_order_name"/></t>
                            </option>
                          </t>
                        </select>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Ngày ký</label>
                        <input class="form-control" readonly="1"
                               t-att-value="state.display.signature_date || ''"/>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Địa điểm XD</label>
                        <input class="form-control" readonly="1"
                               t-att-value="state.display.location || ''"/>
                      </div>

                      <div class="col-12">
                        <label class="form-label mb-1">Báo giá</label>
                        <input class="form-control" readonly="1"
                               t-att-value="state.display.sale_order_name || ''"/>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Giá trị hợp đồng</label>
                        <input class="form-control text-end" readonly="1"
                               t-att-value="money(state.display.value_contract || 0)"/>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Hạng mục</label>
                        <input class="form-control" readonly="1"
                               t-att-value="state.display.sales_category_text || ''"/>
                      </div>

                    </div>
                  </div>
                </div>
              </div>

              <!-- 3) Progress -->
              <div class="col-12 col-xxl-4">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-header py-2 fw-semibold bg-light">Tiến độ</div>
                  <div class="card-body">

                    <!-- Quick stats -->
                    <div class="row g-2 mb-2">
                      <div class="col-6">
                        <label class="form-label mb-1">Giá trị thực tế</label>
                        <input class="form-control text-end" readonly="1"
                               t-att-value="money(state.display.value_settlement || state.display.value_contract || 0)"/>
                      </div>

                      <div class="col-6">
                        <label class="form-label mb-1">Giá trị phát sinh</label>
                        <input class="form-control text-end" readonly="1"
                               t-att-value="money(state.display.value_arise || 0)"/>
                      </div>

                    </div>

                    <!-- Progress bars -->
                    <div class="pwf-progress-card">

                      <!-- Sản lượng -->
                      <div class="pwf-progress-row">
                        <div class="pwf-progress-label">
                          <span>Sản lượng</span>
                          <b t-esc="Math.round(state.display.progress_percent || 0) + '%'"/>
                        </div>

                        <div class="pwf-progress-meta">
                          <span>
                            Đã thực hiện:
                            <b t-esc="money(state.display.value_completed || 0)"/>
                          </span>
                          <span>
                            Còn lại:
                            <b t-esc="money(state.display.value_remaining || 0)"/>
                          </span>
                        </div>

                        <div class="pwf-progress-track"
                             t-att-title="'Sản lượng: ' + Math.round(state.display.progress_percent || 0) + '%'">
                          <div class="pwf-progress-fill"
                               t-att-class="_progressToneClass(state.display.progress_percent)"
                               t-att-style="'width:' + _clampPercent(state.display.progress_percent) + '%'"/>
                        </div>
                      </div>
                      <!-- Nghiệm thu -->
                      <div class="pwf-progress-row">
                        <div class="pwf-progress-label">
                          <span>Nghiệm thu</span>
                          <b t-esc="Math.round(state.display.acceptance_progress_percent || 0) + '%'"/>
                        </div>

                        <div class="pwf-progress-meta">
                          <span>
                            Đã nghiệm thu:
                            <b t-esc="money(state.display.acceptance_value_done || 0)"/>
                          </span>
                          <span>
                            Còn lại:
                            <b t-esc="money(state.display.acceptance_value_remaining || 0)"/>
                          </span>
                        </div>

                        <div class="pwf-progress-track"
                             t-att-title="'Nghiệm thu: ' + Math.round(state.display.acceptance_progress_percent || 0) + '%'">
                          <div class="pwf-progress-fill"
                               t-att-class="_progressToneClass(state.display.acceptance_progress_percent)"
                               t-att-style="'width:' + _clampPercent(state.display.acceptance_progress_percent) + '%'"/>
                        </div>
                      </div>
                      <!-- Thanh / Quyết toán -->
                      <div class="pwf-progress-row">
                        <div class="pwf-progress-label">
                          <span>Thanh / Quyết toán</span>
                          <b t-esc="Math.round(state.display.claim_progress_percent || 0) + '%'"/>
                        </div>

                        <div class="pwf-progress-meta">
                          <span>
                            Đã quyết toán:
                            <b t-esc="money(state.display.claim_value_done || 0)"/>
                          </span>
                          <span>
                            Còn lại:
                            <b t-esc="money(state.display.claim_value_remaining || 0)"/>
                          </span>
                        </div>

                        <div class="pwf-progress-track"
                             t-att-title="'Quyết toán: ' + Math.round(state.display.claim_progress_percent || 0) + '%'">
                          <div class="pwf-progress-fill"
                               t-att-class="_progressToneClass(state.display.claim_progress_percent)"
                               t-att-style="'width:' + _clampPercent(state.display.claim_progress_percent) + '%'"/>
                        </div>
                      </div>


                      <!-- Hóa đơn -->
                      <div class="pwf-progress-row">
                        <div class="pwf-progress-label">
                          <span>Thu tiền</span>
                          <b t-esc="Math.round(state.display.payment_process_percent || 0) + '%'"/>
                        </div>

                        <div class="pwf-progress-meta">
                            <span>
                            Hóa đơn chưa thuế:
                            <b t-esc="money(state.display.customer_invoice_untaxed_total || 0)"/>
                          </span>
                          <span>
                            Đã thu:
                            <b t-esc="money(state.display.customer_invoice_received_total || 0)"/>
                          </span>
                          <span>
                            Còn lại:
                            <b t-esc="money(state.display.customer_invoice_remaining_total || 0)"/>
                          </span>
                        </div>

                        <div class="pwf-progress-track"
                             t-att-title="'Thu tiền: ' + Math.round(state.display.payment_process_percent || 0) + '%'">
                          <div class="pwf-progress-fill"
                               t-att-class="_progressToneClass(state.display.payment_process_percent)"
                               t-att-style="'width:' + _clampPercent(state.display.payment_process_percent) + '%'"/>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>
              </div>

            </div>

            <!-- Description -->
            <div class="card mb-3 border-0 shadow-sm">
              <div class="card-header py-2 fw-semibold bg-light">Mô tả</div>
              <div class="card-body">
                <div class="form-control"
                      t-out="state.form.description || ''"/>
              </div>
            </div>
<!-- Attachments (preview image + pdf) -->
<div class="card mb-3 border-0 shadow-sm">
  <div class="card-header d-flex align-items-center justify-content-between py-2 bg-light flex-wrap gap-2">
    <span class="fw-semibold">Tệp đính kèm</span>

    <label class="btn btn-sm btn-outline-primary mb-0">
      <i class="fa fa-paperclip me-1"/>
      <t t-if="state.uploadingAttachments">Đang tải lên...</t>
      <t t-else="">Thêm tệp đính kèm</t>
      <input type="file"
             class="d-none"
             multiple="multiple"
             t-on-change="onPickAttachments"
             t-att-disabled="state.uploadingAttachments ? true : undefined"/>
    </label>
  </div>

  <div class="card-body p-0">
    <t t-if="state.attachments.length">
      <div class="list-group list-group-flush">

        <t t-foreach="state.attachments" t-as="att" t-key="att.id">
          <div class="list-group-item pwf-attach-row">
            <!-- Left: info -->
            <div class="pwf-attach-main">
              <div class="d-flex align-items-start gap-2" style="min-width:0;">
                <div class="pwf-attach-icon">
                  <i t-att-class="
                      isImageAttachment(att) ? 'fa fa-file-image-o' :
                      (isPdfAttachment(att) ? 'fa fa-file-pdf-o' : 'fa fa-file-o')
                    "/>
                </div>

                <div class="flex-grow-1" style="min-width:0;">
                  <div class="pwf-attach-name text-truncate" t-att-title="att.name || ''">
                    <a t-att-href="attachmentUrl(att.id, true)"
                       target="_blank"
                       class="text-decoration-none">
                      <t t-esc="att.name || ('Tệp #' + att.id)"/>
                    </a>
                  </div>

                  <div class="small text-muted d-flex flex-wrap gap-2">
                    <span t-if="att.mimetype"><t t-esc="att.mimetype"/></span>
                    <span>•</span>
                    <span><t t-esc="formatFileSize(att.file_size)"/></span>
                    <span t-if="att.create_date">•</span>
                    <span t-if="att.create_date"><t t-esc="formatDateTime(att.create_date)"/></span>
                  </div>
                </div>
              </div>

              <div class="d-flex align-items-center gap-1 mt-2">
                <a class="btn btn-sm btn-outline-secondary"
                   t-att-href="attachmentUrl(att.id, false)"
                   target="_blank"
                   title="Mở xem">
                  <i class="fa fa-eye"/>
                </a>

                <a class="btn btn-sm btn-outline-secondary"
                   t-att-href="attachmentUrl(att.id, true)"
                   target="_blank"
                   title="Tải xuống">
                  <i class="fa fa-download"/>
                </a>

                <button class="btn btn-sm btn-outline-danger"
                        t-att-data-attachment-id="att.id"
                        t-on-click="removeAttachment"
                        title="Xóa tệp">
                  <i class="fa fa-trash"/>
                </button>
              </div>
            </div>

            <!-- Right: preview -->
            <div class="pwf-attach-preview-wrap" t-if="hasInlinePreview(att)">
              <!-- Image thumbnail -->
              <t t-if="isImageAttachment(att)">
                <a t-att-href="attachmentUrl(att.id, false)"
                   target="_blank"
                   class="pwf-attach-preview is-image"
                   t-att-title="'Xem ảnh: ' + (att.name || '')">
                  <img t-att-src="attachmentImageThumbUrl(att.id)"
                       t-att-alt="att.name || 'image preview'"/>
                </a>
              </t>

              <!-- PDF preview -->
              <t t-elif="isPdfAttachment(att)">
                <div class="pwf-attach-preview is-pdf" t-att-title="'Preview PDF: ' + (att.name || '')">
                  <!-- Browser nào hỗ trợ sẽ hiện page đầu; không hỗ trợ sẽ fallback -->
                  <iframe t-att-src="attachmentPreviewUrl(att.id) + '#toolbar=0&amp;navpanes=0&amp;scrollbar=0&amp;page=1'"
                          loading="lazy"
                          title="PDF preview"/>
                  <div class="pwf-attach-preview-overlay">
                    <a t-att-href="attachmentUrl(att.id, false)"
                       target="_blank"
                       class="btn btn-xs btn-light border">
                      <i class="fa fa-eye me-1"/> Mở PDF
                    </a>
                  </div>
                </div>
              </t>
            </div>

          </div>
        </t>

      </div>
    </t>

    <t t-else="">
      <div class="p-4 text-center text-muted">
        <i class="fa fa-paperclip me-1"/> Chưa có tệp đính kèm.
      </div>
    </t>
  </div>
</div>
            <!-- Work items -->
            <div class="card mb-3 border-0 shadow-sm">
              <div class="card-header d-flex align-items-center justify-content-between py-2 bg-light flex-wrap gap-2">
                <span class="fw-semibold">Hạng mục công việc</span>
                <div class="d-flex gap-2">
                  <button class="btn btn-sm btn-outline-primary" t-on-click="syncWorkItemsFromSO">
                    <i class="fa fa-refresh me-1"/> Lấy hạng mục từ Đơn bán
                  </button>
                  <button class="btn btn-sm btn-outline-secondary" t-on-click="openWorkItemsAction">
                    <i class="fa fa-list-ul me-1"/> Mở danh sách đầy đủ
                  </button>
                </div>
              </div>

              <div class="card-body p-0">
                <!-- Batch assign toolbar -->
                <div class="px-3 py-2 border-bottom bg-light-subtle">
                  <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="small text-muted me-1">
                      Đã chọn: <b><t t-esc="selectedWorkItemCount"/></b> hạng mục
                    </div>

                    <select class="form-select form-select-sm"
                            style="width:220px;"
                            data-field="assigned_user_id"
                            t-on-change="onChangeBatchAssignUser"
                            t-att-value="state.batchAssign.assigned_user_id ? '' + state.batchAssign.assigned_user_id : ''">
                      <option value="">Người báo cáo sản lượng (batch)</option>
                      <t t-foreach="state.userOptions" t-as="u" t-key="'b_assigned_' + u.id">
                        <option t-att-value="u.id"><t t-esc="u.name"/></option>
                      </t>
                    </select>

                    <select class="form-select form-select-sm"
                            style="width:240px;"
                            data-field="claim_user_id"
                            t-on-change="onChangeBatchAssignUser"
                            t-att-value="state.batchAssign.claim_user_id ? '' + state.batchAssign.claim_user_id : ''">
                      <option value="">Người báo cáo quyết toán (batch)</option>
                      <t t-foreach="state.userOptions" t-as="u" t-key="'b_claim_' + u.id">
                        <option t-att-value="u.id"><t t-esc="u.name"/></option>
                      </t>
                    </select>

                    <select class="form-select form-select-sm"
                            style="width:240px;"
                            data-field="acceptance_user_id"
                            t-on-change="onChangeBatchAssignUser"
                            t-att-value="state.batchAssign.acceptance_user_id ? '' + state.batchAssign.acceptance_user_id : ''">
                      <option value="">Người báo cáo nghiệm thu (batch)</option>
                      <t t-foreach="state.userOptions" t-as="u" t-key="'b_acceptance_' + u.id">
                        <option t-att-value="u.id"><t t-esc="u.name"/></option>
                      </t>
                    </select>

                    <button class="btn btn-sm btn-primary"
                            t-on-click="applyBatchAssignSelectedWorkItems"
                            t-att-disabled="selectedWorkItemCount ? undefined : true">
                      <i class="fa fa-users me-1"/> Áp dụng
                    </button>

                    <button class="btn btn-sm btn-outline-secondary"
                            t-on-click="clearSelectedWorkItems"
                            t-att-disabled="selectedWorkItemCount ? undefined : true">
                      Bỏ chọn
                    </button>
                  </div>
                </div>

                <div class="table-responsive" style="max-height: 520px;">
                  <table class="table table-sm table-hover table-striped align-middle m-0">
                    <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                      <tr>
                        <th style="width:42px;" class="text-center">
                          <input type="checkbox"
                                 class="form-check-input m-0"
                                 t-att-checked="allWorkItemsSelected ? true : undefined"
                                 t-on-click.stop="noop"
                                 t-on-change="onToggleSelectAllWorkItems"/>
                        </th>
                        <th style="width:60px;">STT</th>
                        <th style="min-width:220px;">Tên hạng mục</th>
                        <th style="min-width:180px;">Sản phẩm</th>
                        <th style="min-width:280px;">Mô tả</th>
                        <th style="min-width:220px;">Người báo cáo sản lượng</th>
                        <th style="min-width:220px;">Người báo cáo quyết toán</th>
                        <th style="min-width:220px;">Người báo cáo nghiệm thu</th>
                        <th class="text-end" style="min-width:140px;">KH theo HĐ</th>
                        <th class="text-end" style="min-width:140px;">Phát sinh</th>
                        <th class="text-end" style="min-width:140px;">Quyết toán/ Thực tế</th>
                        <th class="text-end" style="min-width:120px;">Sản lượng đã thực hiện</th>
                        <th class="text-end" style="min-width:120px;">Khối lượng còn lại</th>
                        <th class="text-end" style="min-width:90px;">%</th>
                      </tr>
                    </thead>

                    <tbody>
                      <t t-if="state.work_items.length">
                        <t t-foreach="state.work_items" t-as="wi" t-key="wi.id">
                          <tr>
                            <td class="text-center" t-on-click.stop="noop">
                              <input type="checkbox"
                                     class="form-check-input m-0"
                                     t-att-data-work-item-id="wi.id"
                                     t-att-checked="isWorkItemSelected(wi.id) ? true : undefined"
                                     t-on-click.stop="noop"
                                     t-on-change="onToggleSelectWorkItem"/>
                            </td>

                            <td class="fw-semibold" t-esc="wi.sequence"/>

                            <td>
                              <div style="white-space: normal; line-height: 1.25;" t-att-title="wi.name || ''">
                                <t t-esc="wi.name || ''"/>
                              </div>
                            </td>

                            <td>
                              <div style="white-space: normal; line-height: 1.25;" t-att-title="wi.product_id ? wi.product_id[1] : ''">
                                <t t-esc="wi.product_id ? wi.product_id[1] : ''"/>
                              </div>
                            </td>

                            <td>
                              <textarea class="form-control form-control-sm"
                                        rows="2"
                                        style="min-width:240px; white-space:pre-wrap; resize:vertical; line-height:1.25;"
                                        t-att-data-work-item-id="wi.id"
                                        data-field="description"
                                        t-on-change="onChangeWorkItemTextField"
                                        placeholder="Nhập mô tả hạng mục..."><t t-esc="wi.description || ''"/></textarea>
                            </td>

                            <td>
                              <select class="form-select form-select-sm"
                                      t-att-data-work-item-id="wi.id"
                                      t-on-change="onChangeWorkItemAssignedUser"
                                      t-att-value="wi.assigned_user_id ? '' + wi.assigned_user_id[0] : ''">
                                <option value="">-- Chọn --</option>
                                <t t-foreach="state.userOptions" t-as="u" t-key="'assigned_' + wi.id + '_' + u.id">
                                  <option t-att-value="u.id"
                                          t-att-selected="wi.assigned_user_id &amp;&amp; ('' + wi.assigned_user_id[0]) === ('' + u.id) ? true : undefined">
                                    <t t-esc="u.name"/>
                                  </option>
                                </t>
                              </select>
                            </td>

                            <td>
                              <select class="form-select form-select-sm"
                                      t-att-data-work-item-id="wi.id"
                                      t-on-change="onChangeWorkItemClaimUser"
                                      t-att-value="wi.claim_user_id ? '' + wi.claim_user_id[0] : ''">
                                <option value="">-- Chọn --</option>
                                <t t-foreach="state.userOptions" t-as="u" t-key="'claim_' + wi.id + '_' + u.id">
                                  <option t-att-value="u.id"
                                          t-att-selected="wi.claim_user_id &amp;&amp; ('' + wi.claim_user_id[0]) === ('' + u.id) ? true : undefined">
                                    <t t-esc="u.name"/>
                                  </option>
                                </t>
                              </select>
                            </td>

                            <td>
                              <select class="form-select form-select-sm"
                                      t-att-data-work-item-id="wi.id"
                                      t-on-change="onChangeWorkItemAcceptanceUser"
                                      t-att-value="wi.acceptance_user_id ? '' + wi.acceptance_user_id[0] : ''">
                                <option value="">-- Chọn --</option>
                                <t t-foreach="state.userOptions" t-as="u" t-key="'acceptance_' + wi.id + '_' + u.id">
                                  <option t-att-value="u.id"
                                          t-att-selected="wi.acceptance_user_id &amp;&amp; ('' + wi.acceptance_user_id[0]) === ('' + u.id) ? true : undefined">
                                    <t t-esc="u.name"/>
                                  </option>
                                </t>
                              </select>
                            </td>

                            <td class="text-end">
                              <input type="number"
                                     step="any"
                                     class="form-control form-control-sm text-end"
                                     style="min-width:120px;"
                                     t-att-data-work-item-id="wi.id"
                                     data-field="qty_plan"
                                     t-att-value="wi.qty_plan || 0"
                                     t-on-change="onChangeWorkItemNumberField"/>
                            </td>

                            <td class="text-end">
                              <input type="number"
                                     step="any"
                                     class="form-control form-control-sm text-end"
                                     style="min-width:120px;"
                                     t-att-data-work-item-id="wi.id"
                                     data-field="qty_arise"
                                     t-att-value="wi.qty_arise || 0"
                                     t-on-change="onChangeWorkItemNumberField"/>
                            </td>

                            <td class="text-end fw-medium" t-esc="wi.qty_settlement || 0"/>
                            <td class="text-end" t-esc="wi.qty_done || 0"/>
                            <td class="text-end" t-esc="wi.qty_remaining || 0"/>
                            <td class="text-end">
                              <span class="badge rounded-pill text-bg-light border">
                                <t t-esc="Math.round(wi.progress_percent || 0) + '%'"/>
                              </span>
                            </td>
                          </tr>
                        </t>
                      </t>

                      <t t-else="">
                        <tr>
                          <td colspan="14" class="text-muted p-4 text-center">Chưa có hạng mục công việc.</td>
                        </tr>
                      </t>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Tasks (optional preview) -->
