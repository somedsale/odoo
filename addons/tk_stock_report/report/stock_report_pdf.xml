<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- (Optional) PAPERFORMAT: nếu thích set riêng cho report tồn kho -->
    <record id="stock_report_a4_portrait" model="report.paperformat">
        <field name="name">Stock Summary Report A4 Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">10</field>
        <field name="dpi">110</field>
    </record>

    <!-- ========== LAYOUT CHUNG (HEADER + FOOTER) ========== -->
    <template id="report_stock_report_layout">
        <t t-call="web.html_container">
            <!-- Đề phòng data = None -->
            <t t-set="wizard" t-value="data or {}"/>

            <!-- HEADER -->
            <div class="header" style="font-family: 'Times New Roman', Arial, sans-serif; font-size: 11px; margin-bottom: 16px;">
                <table style="width:100%; border-collapse:collapse; border:0;">
                    <tr>
                        <!-- Cột trái: logo + tên công ty -->
                        <td style="width:55%; vertical-align:top;">
                            <div style="display:flex; align-items:center; gap:12px;">
                                <t t-if="company and company.logo">
                                    <img t-att-src="'data:image/png;base64,%s' % company.logo.decode('utf-8')" style="max-height:50px;"/>
                                </t>
                                <div>
                                    <div style="font-size:14px; font-weight:700; text-transform:uppercase; color:#111827;">
                                        <t t-esc="company and company.name or ''"/>
                                    </div>
                                    <div t-if="company and company.partner_id" style="font-size:10px; color:#6B7280; margin-top:2px;">
                                        <t t-esc="company.partner_id.contact_address"/>
                                    </div>
                                </div>
                            </div>
                        </td>

                        <!-- Cột phải: tiêu đề + meta -->
                        <td style="width:45%; text-align:right; vertical-align:top;">
                            <div style="font-size:16px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:#111827;">
                                Báo cáo tồn kho tổng hợp
                            </div>
                            <div style="margin-top:6px; font-size:10px; color:#4B5563;">
                                <div>
                                    <span style="font-weight:600; color:#374151;">Kho / Vị trí: </span>
                                    <span t-esc="location and location.display_name or 'Tất cả kho nội bộ'"/>
                                </div>
                                <div style="margin-top:2px;">
                                    <span style="font-weight:600; color:#374151;">Thời gian: </span>

                                    <!-- Khoảng ngày (custom) -->
                                    <t t-if="wizard.get('period_type') == 'custom' or not wizard.get('period_type')">
                                        <span t-esc="wizard.get('start_date') or ''"/>
        &#160;→&#160;
                                        <span t-esc="wizard.get('end_date') or ''"/>
                                    </t>

                                    <!-- Theo năm -->
                                    <t t-elif="wizard.get('period_type') == 'year'">
                                        <span>Năm </span>
                                        <span t-esc="wizard.get('year') or ''"/>
                                    </t>

                                    <!-- Theo tháng -->
                                    <t t-elif="wizard.get('period_type') == 'month'">
                                        <span>Tháng </span>
                                        <span t-esc="wizard.get('month') or ''"/>
                                        <span>/</span>
                                        <span t-esc="wizard.get('year') or ''"/>
                                    </t>

                                    <!-- Theo quý -->
                                    <t t-elif="wizard.get('period_type') == 'quarter'">
                                        <span>Quý </span>
                                        <span t-esc="wizard.get('quarter') or ''"/>
                                        <span>/</span>
                                        <span t-esc="wizard.get('year') or ''"/>
                                    </t>
                                </div>
                                <div style="margin-top:2px;">
                                    <span style="font-weight:600; color:#374151;">Người lập: </span>
                                    <span t-esc="wizard.get('create_uid') and wizard['create_uid'][1] or ''"/>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Thanh gạch nhẹ dưới header -->
                <div style="margin-top:10px; border-bottom:1px solid #E5E7EB;"></div>
            </div>

            <!-- ARTICLE: nội dung report sẽ được chèn vào -->
            <div class="article" style="font-family:'DejaVu Sans', Arial, sans-serif; font-size:11px; line-height:1.5; padding-top:5px;">
                <t t-raw="0"/>
            </div>

            <!-- FOOTER: số trang -->
            <div class="footer" style="text-align:center; padding:4mm 0; font-size:9px; font-family:'DejaVu Sans', Arial, sans-serif; color:#9CA3AF;">
                <span class="page"/>
            </div>
        </t>
    </template>

    <!-- ========== TEMPLATE NỘI DUNG BÁO CÁO ========== -->
    <template id="stock_report_template">
        <!-- Bắt chước cách gọi của report_supplier_invoice_view -->
        <t t-call="tk_stock_report.report_stock_report_layout">
            <div class="page stock-report-page" style="font-family:'DejaVu Sans', Arial, sans-serif; font-size:11px; color:#111827;">

                <!-- STYLE riêng cho bảng tồn kho -->
                <style>
                    .stock-report-page {
                        color: #111827;
                    }

                    .sr-table {
                        width: 100%;
                        border-collapse: collapse;
                        border-spacing: 0;
                        margin-top: 8px;
                        font-size: 10px;
                        border: 1px solid #E5E7EB;
                    }

                    .sr-table thead tr:first-child th {
                        background: #EEF2FF;
                        color: #111827;
                        font-weight: 600;
                        border-bottom: 1px solid #E5E7EB;
                    }

                    .sr-table thead tr:nth-child(2) th {
                        background: #F9FAFB;
                        font-weight: 600;
                        color: #4B5563;
                        border-bottom: 1px solid #E5E7EB;
                    }

                    .sr-table th,
                    .sr-table td {
                        padding: 4px 6px;
                        border-right: 1px solid #E5E7EB;
                        border-bottom: 1px solid #E5E7EB;
                        vertical-align: middle;
                    }

                    .sr-table th:last-child,
                    .sr-table td:last-child {
                        border-right: none;
                    }

                    .sr-table tbody tr:nth-child(even) {
                        background: #F9FAFB;
                    }

                    .sr-table tbody tr:hover {
                        background: #EEF2FF;
                    }

                    .sr-text-center { text-align: center; }
                    .sr-text-right  { text-align: right; }
                    .sr-text-left   { text-align: left; }

                    .sr-total-row {
                        background: #F3F4F6;
                        font-weight: 600;
                    }
                </style>

                <div class="oe_structure">
                    <!-- Nếu không có dữ liệu -->
                    <t t-if="not lines">
                        <p class="sr-text-center" style="margin-top: 24px; color:#9CA3AF;">
                            Không có dữ liệu tồn kho cho điều kiện đã chọn.
                        </p>
                    </t>

                    <!-- Bảng NXT tổng hợp -->
                    <t t-if="lines">
                        <table class="sr-table">
                            <thead>
                                <tr>
                                    <th rowspan="2" class="sr-text-center" style="width: 10%;">Mã hàng</th>
                                    <th rowspan="2" class="sr-text-center" style="width: 25%;">Tên hàng</th>
                                    <th rowspan="2" class="sr-text-center" style="width: 6%;">ĐVT</th>

                                    <th colspan="2" class="sr-text-center" style="width: 14%;">Đầu kỳ</th>
                                    <th colspan="2" class="sr-text-center" style="width: 14%;">Nhập</th>
                                    <th colspan="2" class="sr-text-center" style="width: 14%;">Xuất</th>
                                    <th colspan="2" class="sr-text-center" style="width: 14%;">Cuối kỳ</th>
                                </tr>
                                <tr>
                                    <th class="sr-text-center">SL</th>
                                    <th class="sr-text-center">Giá trị</th>

                                    <th class="sr-text-center">SL</th>
                                    <th class="sr-text-center">Giá trị</th>

                                    <th class="sr-text-center">SL</th>
                                    <th class="sr-text-center">Giá trị</th>

                                    <th class="sr-text-center">SL</th>
                                    <th class="sr-text-center">Giá trị</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="sr-total-row">
                                    <td colspan="3" class="sr-text-center">
                                        TỔNG CỘNG:
                                    </td>

                                    <td class="sr-text-right">

                                    </td>
                                    <td class="sr-text-right">
                                        <t t-esc="'%.0f' % totals.get('opening_val', 0.0)"/>
                                    </td>

                                    <td class="sr-text-right">

                                    </td>
                                    <td class="sr-text-right">
                                        <t t-esc="'%.0f' % totals.get('in_val', 0.0)"/>
                                    </td>

                                    <td class="sr-text-right">

                                    </td>
                                    <td class="sr-text-right">
                                        <t t-esc="'%.0f' % totals.get('out_val', 0.0)"/>
                                    </td>

                                    <td class="sr-text-right">

                                    </td>
                                    <td class="sr-text-right">
                                        <t t-esc="'%.0f' % totals.get('closing_val', 0.0)"/>
                                    </td>
                                </tr>
                                <!-- DÒNG CHI TIẾT -->
                                <t t-foreach="lines" t-as="l">
                                    <tr>
                                        <!-- Thông tin sản phẩm -->
                                        <td class="sr-text-left">
                                            <t t-esc="l['default_code']"/>
                                        </td>
                                        <td class="sr-text-left">
                                            <t t-esc="l['name']"/>
                                        </td>
                                        <td class="sr-text-center">
                                            <t t-esc="l['uom']"/>
                                        </td>

                                        <!-- Đầu kỳ -->
                                        <td class="sr-text-right">
                                            <t t-esc="'%.2f' % l['opening_qty']"/>
                                        </td>
                                        <td class="sr-text-right">
                                            <t t-esc="'%.0f' % l['opening_val']"/>
                                        </td>

                                        <!-- Nhập -->
                                        <td class="sr-text-right">
                                            <t t-esc="'%.2f' % l['in_qty']"/>
                                        </td>
                                        <td class="sr-text-right">
                                            <t t-esc="'%.0f' % l['in_val']"/>
                                        </td>

                                        <!-- Xuất -->
                                        <td class="sr-text-right">
                                            <t t-esc="'%.2f' % l['out_qty']"/>
                                        </td>
                                        <td class="sr-text-right">
                                            <t t-esc="'%.0f' % l['out_val']"/>
                                        </td>

                                        <!-- Cuối kỳ -->
                                        <td class="sr-text-right">
                                            <t t-esc="'%.2f' % l['closing_qty']"/>
                                        </td>
                                        <td class="sr-text-right">
                                            <t t-esc="'%.0f' % l['closing_val']"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ========== ACTIONS ========== -->
    <record id="pdf_stock_report_action" model="ir.actions.report">
        <field name="name">Stock Summary Report</field>
        <field name="model">stock.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tk_stock_report.stock_report_template</field>
        <field name="report_file">tk_stock_report.stock_report_template</field>
        <field name="binding_model_id" ref="model_stock_report_wizard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="tk_stock_report.stock_report_a4_portrait"/>
    </record>

    <record id="pdf_stock_report_action_html" model="ir.actions.report">
        <field name="name">Stock Summary Report (HTML)</field>
        <field name="model">stock.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">tk_stock_report.stock_report_template</field>
        <field name="report_file">tk_stock_report.stock_report_template</field>
        <field name="binding_model_id" ref="model_stock_report_wizard"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="tk_stock_report.stock_report_a4_portrait"/>
    </record>

</odoo>
