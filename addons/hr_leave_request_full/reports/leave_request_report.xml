<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_somed_leave_a4_portrait" model="report.paperformat">
        <field name="name">Somed Leave A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_somed_leave_request" model="ir.actions.report">
        <field name="name">Đơn xin nghỉ phép</field>
        <field name="model">somed.leave.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_leave_request_full.report_somed_leave_request_document</field>
        <field name="report_file">hr_leave_request_full.report_somed_leave_request_document</field>
        <field name="paperformat_id" ref="hr_leave_request_full.paperformat_somed_leave_a4_portrait"/>
        <field name="binding_model_id" ref="model_somed_leave_request"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Don_Nghi_Phep_%s' % (object.name or '')</field>
    </record>

    <template id="report_somed_leave_request_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                    <div class="page somed-leave-report" style="font-family:'DejaVu Sans','Liberation Sans','Arial Unicode MS',Arial,sans-serif; color:#000; font-size:16px; line-height:1.55;">
                    <style>
                        @charset "UTF-8";
                        * {
                            font-family: 'DejaVu Sans','Liberation Sans','Arial Unicode MS',Arial,sans-serif !important;
                            color:#000;
                        }
                        body, .page, .somed-leave-report {
                            font-family: 'DejaVu Sans','Liberation Sans','Arial Unicode MS',Arial,sans-serif !important;
                            -webkit-text-size-adjust: 100%;
                        }
                        table.somed-no-border,
                        table.somed-no-border tr,
                        table.somed-no-border td,
                        table.somed-no-border th,
                        .somed-no-border div {
                            border:0 none transparent !important;
                            border-color:transparent !important;
                            border-style:none !important;
                            outline:0 none transparent !important;
                            box-shadow:none !important;
                        }
                        .line-dots { border-bottom:0 none transparent !important; display:inline-block; min-height:24px; padding-left:6px; }
                    </style>

                    <div style="text-align:center; font-weight:bold; text-transform:uppercase; line-height:1.35;">
                        <div>CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                        <div>Độc lập – Tự do – Hạnh phúc</div>
                        <div>---------------------------</div>
                    </div>

                    <h2 style="text-align:center; margin:16px 0 12px 0; font-size:24px; font-weight:bold;">XÁC NHẬN NGHỈ PHÉP</h2>

                    <div style="margin-bottom:10px;">
                        <strong>Kính gửi:</strong>
                        Ban Giám Đốc Công Ty TNHH Giải Pháp Kỹ Thuật Y Tế Miền Nam
                    </div>
                    <div style="margin-bottom:10px;">
                        Trưởng bộ phận phòng
                        <span style="padding-left:6px;">
                            <span t-esc="o.department_id.name or ''"/>
                        </span>
                    </div>

                    <div style="margin-bottom:10px;">
                        <strong>Họ và tên:</strong>
                        <span style="padding-left:6px;"><span t-esc="o.employee_id.name or ''"/></span>
                    </div>
                    <div style="margin-bottom:10px;">
                        <strong>Vị trí:</strong>
                        <span style="padding-left:6px;"><span t-esc="o.job_id.name or ''"/></span>
                    </div>

                    <table style="width:100%; border-collapse:collapse; font-size:16px; margin-top:16px; table-layout:fixed;" border="1" cellspacing="0" cellpadding="0">
                        <thead>
                            <tr style="text-align:center; font-weight:bold; min-height:40px;">
                                <th style="width:7%; padding:10px 6px; vertical-align:middle; text-align:center;">STT</th>
                                <th style="width:25%; padding:10px 8px; vertical-align:middle; text-align:center;">Nội dung</th>
                                <th style="width:17%; padding:10px 8px; vertical-align:middle; text-align:center;">Từ ngày</th>
                                <th style="width:17%; padding:10px 8px; vertical-align:middle; text-align:center;">Đến ngày</th>
                                <th style="width:17%; padding:10px 8px; vertical-align:middle; text-align:center;">Tổng ngày nghỉ</th>
                                <th style="width:17%; padding:10px 8px; vertical-align:middle; text-align:center;">Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.line_ids" t-as="line" style="min-height:42px;">
                                <td style="text-align:center; vertical-align:middle; padding:11px 6px;"><span t-esc="line_index + 1"/></td>
                                <td style="vertical-align:middle; padding:11px 8px; text-align:left;"><span t-esc="line.leave_type or ''"/></td>
                                <td style="text-align:center; vertical-align:middle; padding:11px 8px;"><span t-if="line.date_from" t-esc="line.date_from.strftime('%d/%m/%Y')"/></td>
                                <td style="text-align:center; vertical-align:middle; padding:11px 8px;"><span t-if="line.date_to" t-esc="line.date_to.strftime('%d/%m/%Y')"/></td>
                                <td style="text-align:center; vertical-align:middle; padding:11px 8px;"><span t-esc="('{:g}'.format(line.total_days or 0))"/></td>
                                <td style="vertical-align:middle; padding:11px 8px; text-align:left;"><span t-esc="line.note or ''"/></td>
                            </tr>
                            <tr t-if="not o.line_ids" style="height:44px;">
                                <td style="text-align:center; vertical-align:middle; padding:11px 6px;">1</td>
                                <td style="padding:11px 8px;"></td>
                                <td style="padding:11px 8px;"></td>
                                <td style="padding:11px 8px;"></td>
                                <td style="padding:11px 8px;"></td>
                                <td style="padding:11px 8px;"></td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="margin-top:12px;">
                        <strong>Lý do:</strong>
                        <span style="padding-left:6px;"><span t-esc="o.reason or ''"/></span>
                    </div>

                    <div style="margin-top:12px;">Người phụ trách công việc trong thời gian tôi nghỉ phép:</div>
                    <ul style="margin-top:4px; margin-bottom:10px;">
                        <li>Họ tên: <span style="padding-left:6px;"><span t-esc="o.handover_employee_id.name or ''"/></span></li>
                        <li>Số điện thoại: <span style="padding-left:6px;"><span t-esc="o.handover_phone or ''"/></span></li>
                    </ul>

                    <p style="text-align:justify; margin-top:10px;">
                        Tôi cam đoan đã sắp xếp công việc, không làm ảnh hưởng đến tiến độ công việc của Công ty trong thời gian tôi nghỉ phép.
                    </p>
                    <p>Rất mong Ban Lãnh Đạo xem xét và chấp thuận.</p>
                    <p>Tôi xin chân thành cảm ơn!</p>

                    <table class="somed-no-border" border="0" cellpadding="0" cellspacing="0" rules="none" frame="void" style="color:#000; width:100%; font-size:15px; line-height:1.65; margin-top:26px; border-color:transparent; border-style:none; outline:none; border-collapse:collapse;">
                        <tr style="border:none; color:#000 !important;">
                            <td style="width:25%; text-align:center; vertical-align:top; border:none; border-color:transparent; padding:0 5px;">
                                <div><span t-if="o.request_date" t-esc="o.request_date.strftime('%d/%m/%Y')"/><span t-if="not o.request_date">.... / .... / ....</span></div>
                                <div style="font-weight:700;">NGƯỜI ĐỀ XUẤT</div>
                                <div style="font-style:italic;">(Ký, họ tên)</div>
                                <div style="margin-top:6px; font-style:italic; font-weight:700;">(Đã Xác Nhận)</div>
                                <div style="margin-top:14px; font-style:italic;"><span t-esc="o.employee_id.name or ''"/></div>
                            </td>
                            <td style="width:25%; text-align:center; vertical-align:top; border:none; border-color:transparent; padding:0 5px;">
                                <div><span t-if="o.manager_approved_date" t-esc="o.manager_approved_date.strftime('%d/%m/%Y')"/><span t-if="not o.manager_approved_date">.... / .... / ....</span></div>
                                <div style="font-weight:700;">TRƯỞNG BỘ PHẬN</div>
                                <div style="font-style:italic;">(Ký, họ tên)</div>
                                <div t-if="o.manager_approved_by" style="margin-top:6px; font-style:italic; font-weight:700;">(Đã Xác Nhận)</div>
                                <div t-if="o.manager_approved_by" style="margin-top:14px; font-style:italic;"><span t-esc="o.manager_approved_by.name or ''"/></div>
                            </td>
                            <td style="width:25%; text-align:center; vertical-align:top; border:none; border-color:transparent; padding:0 5px;">
                                <div><span t-if="o.hr_approved_date" t-esc="o.hr_approved_date.strftime('%d/%m/%Y')"/><span t-if="not o.hr_approved_date">.... / .... / ....</span></div>
                                <div style="font-weight:700;">QUẢN TRỊ VIÊN HR</div>
                                <div style="font-style:italic;">(Ký, họ tên)</div>
                                <div t-if="o.hr_approved_by" style="margin-top:6px; font-style:italic; font-weight:700;">(Đã Xác Nhận)</div>
                                <div t-if="o.hr_approved_by" style="margin-top:14px; font-style:italic;"><span t-esc="o.hr_approved_by.name or ''"/></div>
                            </td>
                            <td style="width:25%; text-align:center; vertical-align:top; border:none; border-color:transparent; padding:0 5px;">
                                <div><span t-if="o.director_approved_date" t-esc="o.director_approved_date.strftime('%d/%m/%Y')"/><span t-if="not o.director_approved_date">.... / .... / ....</span></div>
                                <div style="font-weight:700;">GIÁM ĐỐC</div>
                                <div style="font-style:italic;">(Ký, họ tên)</div>
                                <div t-if="o.director_approved_by" style="margin-top:6px; font-style:italic; font-weight:700;">(Đã Xác Nhận)</div>
                                <div t-if="o.director_approved_by" style="margin-top:14px; font-style:italic;"><span t-esc="o.director_approved_by.name or ''"/></div>
                            </td>
                        </tr>
                    </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
