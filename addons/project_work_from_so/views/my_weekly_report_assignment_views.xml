<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- TREE -->
  <record id="view_my_assignment_report_tree" model="ir.ui.view">
    <field name="name">project.work.assignment.my.report.tree</field>
    <field name="model">project.work.assignment</field>
    <field name="arch" type="xml">
      <tree string="Báo cáo lũy kế theo kỳ" create="0" delete="0">
        <field name="project_id"/>
        <field name="work_item_name"/>
        <field name="product_id"/>
        <field name="qty_plan"/>
        <field name="uom_id"/>
        <field name="date_start"/>
        <field name="current_period_no"/>
      </tree>
    </field>
  </record>

  <!-- FORM -->
  <record id="view_my_assignment_report_form" model="ir.ui.view">
    <field name="name">project.work.assignment.my.report.form</field>
    <field name="model">project.work.assignment</field>
    <field name="arch" type="xml">
      <form string="Báo cáo lũy kế theo kỳ" create="0" delete="0" edit="1">
        <header>
          <!-- Nút sửa dữ liệu cũ (nếu DB có kỳ sau < kỳ trước) -->
          <button name="action_repair_cumulative"
                  type="object"
                  string="Sửa dữ liệu lũy kế"
                  class="btn-secondary"
                  groups="project_work_from_so.group_project_work_manager"/>
        </header>

        <sheet>
          <group>
            <group>
              <field name="project_id" readonly="1"/>
              <field name="work_item_name" readonly="1"/>
              <field name="product_id" readonly="1"/>
            </group>
            <group>
              <field name="qty_plan" readonly="1"/>
              <field name="uom_id" readonly="1"/>
              <field name="date_start" readonly="1"/>
              <field name="current_period_no" readonly="1"/>
              <field name="value_completed" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page string="Nhập kỳ hiện tại">
              <group>
                <group>
                  <field name="current_period_start" readonly="1"/>
                  <field name="current_period_end" readonly="1"/>
                </group>
                <group>
                  <field name="prev_qty_cum" readonly="1"/>
                  <field name="current_qty_cum" readonly="1"/>
                </group>
              </group>

              <group>
                <group>
                  <field name="current_qty_week"
                         readonly="not current_period_start"
                         placeholder="Nhập sản lượng đạt được trong kỳ..."/>
                </group>
                <group>
                  <field name="current_note"
                         readonly="not current_period_start"
                         placeholder="Ghi chú..."/>
                </group>
              </group>

              <div class="text-muted" style="margin-top:8px;">
                Bạn chỉ nhập <b>Sản lượng trong kỳ</b>. Hệ thống tự cộng thành <b>Lũy kế</b> và ghi vào lịch sử.
              </div>
            </page>

            <page string="Lịch sử">
              <field name="progress_ids" nolabel="1">
                <tree create="0" delete="0" edit="0" default_order="period_no desc">
                  <field name="period_no"/>
                  <field name="period_start"/>
                  <field name="period_end"/>
                  <field name="qty_period"/>
                  <field name="qty_cum"/>
                  <field name="note"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_my_assignment_report" model="ir.actions.act_window">
    <field name="name">Báo cáo lũy kế theo kỳ</field>
    <field name="res_model">project.work.assignment</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('user_id','=',uid), ('active','=',True)]</field>
    <field name="view_ids" eval="[
      (5,0,0),
      (0,0, {'sequence': 1, 'view_mode':'tree', 'view_id': ref('view_my_assignment_report_tree')}),
      (0,0, {'sequence': 2, 'view_mode':'form', 'view_id': ref('view_my_assignment_report_form')})
    ]"/>
  </record>

  <!-- MENU -->
  <menuitem id="menu_my_assignment_report"
            name="Báo cáo lũy kế theo kỳ"
            parent="project.menu_main_pm"
            action="action_my_assignment_report"
            sequence="96"/>

</odoo>
