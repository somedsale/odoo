                                                </field>
                                            </page>
                                        </notebook>

                                    </sheet>
                                </form>
                            </field>
                        </page> -->
                        <page string="Nhiệm vụ">
                            <field name="task_ids" context="{'default_project_id': id, 'default_company_id': company_id}">
                                <tree editable="bottom" string="Nhiệm vụ">
                                    <!-- ✅ thêm để tránh lỗi domain validate -->
                                    <!-- <field name="is_internal_project" invisible="1"/> -->

                                    <field name="name"/>
                                    <field name="user_ids" widget="many2many_tags"/>
                                    <field name="date_deadline"/>
                                    <field name="priority"/>

                                    <!-- nếu có hiển thị project_id thì vẫn giữ -->
                                </tree>

                                <form string="Nhiệm vụ">
                                    <sheet>
                                        <!-- ✅ bắt buộc cho domain của project_id -->
                                        <field name="company_id" invisible="1"/>
                                        <!-- <field name="is_internal_project" invisible="1"/> -->
                                        <field name="project_id" invisible="1"/>

                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <!-- Có thể bỏ field project_id khỏi form vì đang tạo trong dự án -->
                                                <!-- <field name="project_id" readonly="1"/> -->
                                                <field name="user_ids" widget="many2many_tags"/>
                                            </group>
                                            <group>
                                                <field name="date_deadline"/>
                                                <field name="priority"/>
                                                <field name="partner_id"/>
                                            </group>
                                        </group>

                                        <group>
                                            <field name="description" placeholder="Mô tả nhiệm vụ..."/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_project_project_form_chatter_only" model="ir.ui.view">
        <field name="name">project.project.form.chatter.only</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="Chatter dự án">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <!-- ===== ACTION RIÊNG ===== -->
    <record id="action_project_project_work_custom" model="ir.actions.act_window">
        <field name="name">Dự án (Theo SO)</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5,0,0),
            (0,0, {'sequence': 1, 'view_mode': 'tree', 'view_id': ref('view_project_project_tree_work_custom')}),
            (0,0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('view_project_project_form_work_custom')})
        ]"/>
    </record>

    <!-- ===== MENU RIÊNG ===== -->
    <!-- <menuitem id="menu_project_work_root" name="Dự án (Theo SO)" parent="project.menu_main_pm" action="action_project_project_work_custom" sequence="95"/> -->

</odoo>
