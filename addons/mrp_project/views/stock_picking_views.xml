<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_picking_form_inherit_reset_to_draft_done" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.reset.to.draft.done</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_reset_to_draft_from_done"
                    type="object"
                    string="Trở lại nháp"
                    class="btn btn-warning"
                    invisible="state != 'done'"
                    confirm="Phiếu đã hoàn tất. Bạn có chắc muốn đưa phiếu trở lại nháp không?"
                />
            </xpath>
        </field>
    </record>

</odoo>