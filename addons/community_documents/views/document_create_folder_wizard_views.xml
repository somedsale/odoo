<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Form view -->
  <record id="view_document_create_folder_wizard_form" model="ir.ui.view">
    <field name="name">document.create.folder.wizard.form</field>
    <field name="model">document.create.folder.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Folder">
        <group>
          <field name="name"/>
          <field name="parent_id" domain="['|', ('owner_id','=', uid),
                  '&amp;', ('access_mode','=','restricted'),
                    ('allowed_user_ids','in', uid)
               ]"/>
          <field name="access_mode" widget="radio"/>
          <field name="allowed_user_ids" widget="many2many_tags" invisible="access_mode == 'private'"/>
        </group>
        <footer>
          <button string="Create" type="object" name="action_create" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ✅ Action (XMLID đúng cái bạn đang gọi) -->
  <record id="action_document_create_folder_wizard" model="ir.actions.act_window">
    <field name="name">Create Folder</field>
    <field name="res_model">document.create.folder.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_document_create_folder_wizard_form"/>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

</odoo>
