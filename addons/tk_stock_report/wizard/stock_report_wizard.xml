<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="stock_report_wizard_view_form" model="ir.ui.view">
            <field name="name">stock.report.wizard.view.form</field>
            <field name="model">stock.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <!-- Kỳ báo cáo (gộp tất cả filter vào 1 chỗ) -->
                    <group string="Kỳ báo cáo">
                        <group>
                            <field name="period_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="year" widget="yearpicker" invisible="period_type == 'custom'"/>
                        </group>

                        <group invisible="period_type != 'month'">
                            <field name="month"/>
                        </group>

                        <group invisible="period_type != 'quarter'">
                            <field name="quarter"/>
                        </group>

                        <group invisible="period_type != 'custom'">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>

                    <group string="Tên Kho">
                        <group>
                            <field name="stock_location_id" string="Kho"/>
                        </group>
                        <!-- <group>
                            <field name="company_id"/>
                        </group> -->
                    </group>

                    <footer>
                        <div style="display: flex; justify-content: center; align-items: center;">
                            <button name="pdf_action_html" string="Xem nhanh" type="object" class="oe_highlight"/>
                            <span style="vertical-align: middle; margin: 0 5px;">or</span>
                            <button name="pdf_action" string="PDF" type="object" class="oe_highlight"/>
                            <span style="vertical-align: middle; margin: 0 5px;">or</span>
                            <button name="btn_excel_action" string="Excel" type="object" class="oe_highlight"/>
                            <span style="margin: 0 5px;">or</span>
                            <button special="cancel" string="Cancel" type="object"/>
                        </div>
                    </footer>
                </form>
            </field>
        </record>

        <record id="stock_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Stock Card Report</field>
            <field name="res_model">stock.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
