<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_document_share_tree" model="ir.ui.view">
        <field name="name">document.share.tree</field>
        <field name="model">document.share</field>
        <field name="arch" type="xml">
            <tree string="Shares">
                <field name="name"/>
                <field name="owner_id"/>
                <field name="expiration_date"/>
                <field name="state"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_document_share_form" model="ir.ui.view">
        <field name="name">document.share.form</field>
        <field name="model">document.share</field>
        <field name="arch" type="xml">
            <form string="Share">
                <header>
                    <button name="action_open_share" type="object" string="Open Share Link" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_id" groups="community_documents.group_documents_manager"/>
                        <field name="expiration_date"/>
                        <field name="active"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="share_url" readonly="1"/>
                    </group>
                    <group>
                        <field name="document_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
