<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Paperformat -->
    <record id="custom_inventory_report_a4_portrait" model="report.paperformat">
        <field name="name">Custom Inventory Report A4 Portrait</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">25</field>
        <field name="dpi">110</field>
    </record>

    <!-- Action PDF -->
    <record id="action_report_inventory_all_in_one" model="ir.actions.report">
        <field name="name">Báo Cáo Tồn Kho</field>
        <field name="model">dynamic.inventory.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inventory_report_generator.inventory_pdf_report</field>
        <field name="report_file">inventory_report_generator.inventory_pdf_report</field>
        <field name="print_report_name">'Báo Cáo Tồn Kho'</field>
        <field name="paperformat_id" ref="inventory_report_generator.custom_inventory_report_a4_portrait"/>
    </record>

    <!-- =======================
         LAYOUT (HEADER/FOOTER)
    ======================== -->
    <template id="report_inventory_layout">
        <t t-call="web.html_container">
            <!-- bạn có thể set font chung ở đây -->
            <t t-set="res_company" t-value="company or env.company"/>

            <div class="header" style="display:flex;justify-content:space-between;font-family:Times New Roman;">
                <table style="width:100%; border-collapse:collapse; border: 1px solid #fff;">
                    <tr>
                        <td style="text-align:left; width:50%;">
                            <t t-if="res_company">
                                <img t-att-src="'/web/image/res.company/%s/logo' % res_company.id" alt="Company Logo" style="max-width: 160px;"/>
                            </t>
                        </td>
                        <td style="text-align:right; width:50%; font-size:11px; line-height:1.4;">
                            <div style="text-transform: uppercase; font-weight:700;">
                                <span t-esc="res_company.name"/>
                            </div>
                            <div t-if="res_company.partner_id and res_company.partner_id.vat">
                                MST: <span t-esc="res_company.partner_id.vat"/>
                            </div>

                            <!-- địa chỉ sạch: không bị ', , ,' -->
                            <t t-if="res_company.partner_id">
                                <t t-set="raw_addr" t-value="res_company.partner_id._display_address(without_company=True) or ''"/>
                                <t t-set="addr_clean" t-value="', '.join([p.strip() for p in raw_addr.replace('\n', ',').split(',') if p.strip()])"/>
                                <div t-if="addr_clean">
                                    Địa chỉ: <span t-esc="addr_clean"/>
                                </div>
                            </t>

                            <!-- <div t-if="res_company.phone">
                                SĐT: <span t-esc="res_company.phone"/>
                            </div>
                            <div t-if="res_company.email">
                                Email: <span t-esc="res_company.email"/>
                            </div> -->
                        </td>
                    </tr>
                </table>
            </div>

            <div class="article" style="font-family: Times New Roman; font-size: 11pt; line-height: 1.5; padding-top: 12px;">
                <t t-raw="0"/>
            </div>

            <div class="footer" style="text-align:center; padding: 5mm; font-size: 10pt; font-family: Times New Roman;">
                <span class="page"/>
            </div>
        </t>
    </template>

    <!-- =======================
         VIEW (CONTENT)
    ======================== -->
    <template id="inventory_pdf_report">
        <t t-call="inventory_report_generator.report_inventory_layout">
            <div class="page">
                <style>
                    .page { font-family: "Times New Roman"; font-size: 12pt; color:#000; }

                    .title { text-align:center; font-weight:700; font-size: 22px; text-transform:uppercase; margin: 0 0 6px 0; }
                    .subtitle { text-align:center; font-style:italic; font-weight:600; margin-bottom: 10px; }

                    .styled-table{
                        border-collapse: collapse;
                        width: 100%;
                        border: 1px solid #000;
                        table-layout: fixed;
                        font-size: 10pt;
                    }
                    .styled-table thead tr{
                        background-color: #C6E0B4;
                        font-weight: bold;
                        text-align: center;
                    }
                    .styled-table th, .styled-table td{
                        border: 1px solid #000;
                        padding: 6px 8px;
                        vertical-align: middle;
                        overflow: hidden;
                        word-wrap: break-word;
                        overflow-wrap: anywhere;
                    }
                    .row-total{
                        background-color: #E2EFDA;
                        font-weight: 700;
                    }
                    .text-center { text-align:center; }
                    .text-right { text-align:right; }
                    .text-left { text-align:left; }
                    .num { white-space: nowrap; }
                </style>

                <div class="title">BÁO CÁO TỒN KHO</div>

                <!-- SUBTITLE -->
                <div class="subtitle">
                    <t t-set="pt" t-value="(Filters or {}).get('period_type')"/>
                    <t t-set="df" t-value="(Filters or {}).get('date_from')"/>
                    <t t-set="dt" t-value="(Filters or {}).get('date_to')"/>
                    <t t-set="loc" t-value="(Filters or {}).get('location')"/>

                    <!-- convert YYYY-MM-DD -> DD/MM/YYYY -->
                    <t t-set="df_fmt" t-value="(df and (df[8:10] + '/' + df[5:7] + '/' + df[0:4])) or ''"/>
                    <t t-set="dt_fmt" t-value="(dt and (dt[8:10] + '/' + dt[5:7] + '/' + dt[0:4])) or ''"/>

                    <t t-if="pt == 'Month' and df">
        Kho: <t t-esc="loc"/>
, Tháng <t t-esc="int(df[5:7])"/>
 năm <t t-esc="int(df[0:4])"/>
            </t>

            <t t-elif="pt == 'Quarter' and df">
                <t t-set="m" t-value="int(df[5:7])"/>
                <t t-set="q" t-value="(m-1)//3 + 1"/>
        Kho: <t t-esc="loc"/>
, Quý <t t-esc="q"/>
 năm <t t-esc="int(df[0:4])"/>
    </t>

    <t t-elif="pt == 'Year' and df">
        Kho: <t t-esc="loc"/>
, Năm <t t-esc="int(df[0:4])"/>
</t>

<t t-else="">
        Kho: <t t-esc="loc"/>
, Từ ngày <t t-esc="df_fmt"/>
 đến ngày <t t-esc="dt_fmt"/>
</t>
</div>

<table class="styled-table">
<colgroup>
<col style="width:12%"/>
<col style="width:28%"/>
<col style="width:8%"/>
<col style="width:10%"/>
<col style="width:10%"/>
<col style="width:10%"/>
<col style="width:10%"/>
<col style="width:10%"/>
<col style="width:10%"/>
<col style="width:10%"/>
<col style="width:10%"/>
</colgroup>

<thead>
<tr>
<th rowspan="2">Mã hàng</th>
<th rowspan="2">Sản phẩm/Hàng hóa</th>
<th rowspan="2">Đơn vị</th>
<th colspan="2">Đầu kỳ</th>
<th colspan="2">Nhập</th>
<th colspan="2">Xuất</th>
<th colspan="2">Cuối kỳ</th>
</tr>
<tr>
<th class="text-right">SL</th>
<th class="text-right">Giá trị</th>
<th class="text-right">SL</th>
<th class="text-right">Giá trị</th>
<th class="text-right">SL</th>
<th class="text-right">Giá trị</th>
<th class="text-right">SL</th>
<th class="text-right">Giá trị</th>
</tr>
</thead>

<tbody>
<!-- TOTAL -->
<tr class="row-total">
<td colspan="3" class="text-center">TỔNG</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('opening_qty') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('opening_val') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('in_qty') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('in_val') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('out_qty') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('out_val') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('closing_qty') or 0"/>
</td>
<td class="text-right num">
    <t t-esc="(Totals or {}).get('closing_val') or 0"/>
</td>
</tr>

<!-- LINES -->
<t t-if="report_main_line_data">
<t t-foreach="report_main_line_data" t-as="l">
    <tr>
        <td class="text-left">
            <t t-esc="l.get('product_code') or ''"/>
        </td>
        <td class="text-left">
            <t t-esc="l.get('product_name') or ''"/>
        </td>
        <td class="text-center">
            <t t-esc="l.get('uom') or ''"/>
        </td>

        <td class="text-right num">
            <t t-esc="l.get('opening_qty') or 0"/>
        </td>
        <td class="text-right num">
            <t t-esc="l.get('opening_val') or 0"/>
        </td>

        <td class="text-right num">
            <t t-esc="l.get('in_qty') or 0"/>
        </td>
        <td class="text-right num">
            <t t-esc="l.get('in_val') or 0"/>
        </td>

        <td class="text-right num">
            <t t-esc="l.get('out_qty') or 0"/>
        </td>
        <td class="text-right num">
            <t t-esc="l.get('out_val') or 0"/>
        </td>

        <td class="text-right num">
            <t t-esc="l.get('closing_qty') or 0"/>
        </td>
        <td class="text-right num">
            <t t-esc="l.get('closing_val') or 0"/>
        </td>
    </tr>
</t>
</t>
<t t-else="">
<tr>
    <td colspan="11" class="text-center">Không có dữ liệu</td>
</tr>
</t>
</tbody>
</table>

</div>
</t>
</template>

</odoo>
