<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_project_project_form_work_custom_inherit_claim_user_assignment" model="ir.ui.view">
      <field name="name">project.project.form.work.custom.inherit.claim.user.assignment</field>
      <field name="model">project.project</field>
      <field name="inherit_id" ref="project_work_from_so.view_project_project_form_work_custom"/>
      <field name="arch" type="xml">

        <!-- Thêm cột claim_user_id vào tree assignment_ids (tab Phân công trong form hạng mục) -->
        <xpath expr="//field[@name='work_item_ids']/tree/field[@name='assigned_user_id']"
               position="after">
          <field name="claim_user_id" string="Người báo cáo quyết toán" widget="many2one_avatar_user"/>
        </xpath>

      </field>
    </record>

  </data>
</odoo>