<odoo>
    <record id="view_proposal_sheet_form_inherit_cost_estimate" model="ir.ui.view">
        <field name="name">proposal.sheet.form.inherit.cost.estimate</field>
        <field name="model">proposal.sheet</field>
        <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_form"/>
        <field name="arch" type="xml">
            <!-- Chèn sau project_id -->
            <xpath expr="//group/group/field[@name='project_id']" position="after">
                <field name="estimate_choice" readonly="state != 'draft'"/>
                <field name="cost_estimate_line_id" invisible="estimate_choice == 'other'" options="{'no_create': True}" domain="[('project_id', '=', project_id)]" string="Hạng mục dự toán" readonly="state != 'draft'"/>
                <field name="other_estimate_item" invisible="estimate_choice != 'other'" required="estimate_choice == 'other'"/>
            </xpath>
        </field>
    </record>
    <record id="view_proposal_sheet_tree_inherit_display_estimate_item" model="ir.ui.view">
        <field name="name">proposal.sheet.tree.inherit.display.estimate.item</field>
        <field name="model">proposal.sheet</field>
        <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_tree"/>
        <!-- ID tree gốc -->
        <field name="arch" type="xml">
            <!-- Thêm cột sau product_id hoặc vị trí bạn muốn -->
            <xpath expr="//tree/field[@name='project_id']" position="after">
                <field name="display_estimate_item" string="Hạng mục"/>
            </xpath>
        </field>
    </record>
</odoo>
