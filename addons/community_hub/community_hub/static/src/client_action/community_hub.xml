<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="community_hub.ClientAction" owl="1">
    <div class="o_community_hub ch-app">
      <div class="ch-layout">

        <!-- LEFT SIDEBAR -->
        <aside class="ch-sidebar">

          <div class="ch-side-block">
            <div class="ch-side-title">
              <span>COMMUNITIES</span>
              <button class="ch-icon-btn" t-on-click="toggleNewCommunity" title="New community">+</button>
            </div>

            <div class="ch-side-list">
              <t t-if="state.communities &amp;&amp; state.communities.length">
                <t t-foreach="state.communities" t-as="c" t-key="c.id">

                  <div t-att-class="(state.selectedCommunity &amp;&amp; state.selectedCommunity.id === c.id) ? 'ch-comm-row is-active' : 'ch-comm-row'">

                    <button type="button"
                            class="btn btn-light w-100 text-start ch-comm-btn"
                            t-att-data-community-id="c.id"
                            t-on-click="selectCommunity">
                      <span t-esc="c.name"/>
                      <span class="ch-mini-tag" t-if="c.my_state"> • <t t-esc="c.my_state"/></span>

                      <t t-if="state.ui.badges &amp;&amp; state.ui.badges[c.id]">
                        <span class="ch-badge-count" t-esc="state.ui.badges[c.id]"/>
                      </t>
                    </button>

                    <t t-if="c.my_state === 'invited'">
                      <button class="btn btn-primary btn-sm"
                              t-att-data-community-id="c.id"
                              t-on-click="joinCommunity">
                        Tham gia
                      </button>
                    </t>

                  </div>

                </t>
              </t>
              <t t-else="">
                <div class="ch-empty">Bạn chưa có community nào</div>
              </t>
            </div>
          </div>

          <div class="ch-side-block">
            <div class="ch-side-title">
              <span>KÊNH</span>
              <button class="ch-icon-btn"
                      t-on-click="toggleNewChannel"
                      t-att-disabled="!canManage || !state.selectedCommunity"
                      title="New channel">+</button>
            </div>

            <div class="ch-side-list">
              <t t-if="!state.selectedCommunity">
                <div class="ch-empty">Chọn community để xem kênh</div>
              </t>
              <t t-elif="state.selectedCommunity.my_state !== 'joined'">
  <div class="ch-empty">
    Bạn được mời vào community. Bấm <b>Tham gia</b> để xem kênh &amp; bài viết.
  </div>
</t>
              <t t-elif="state.channels &amp;&amp; state.channels.length">
                <t t-foreach="state.channels" t-as="ch" t-key="ch.id">
                  <button type="button"
                          class="btn btn-light w-100 text-start"
                          t-att-class="(state.selectedChannelId === ch.id) ? 'btn btn-light w-100 text-start is-active' : 'btn btn-light w-100 text-start'"
                          t-att-data-channel-id="ch.id"
                          t-on-click="selectChannel">
                    <t t-esc="ch.name"/>
                  </button>
                </t>
              </t>
              <t t-else="">
                <div class="ch-empty">Chưa có kênh</div>
              </t>
            </div>
          </div>

          <!-- New community modal -->
          <t t-if="state.ui.showNewCommunity">
            <div class="ch-modal-backdrop" t-on-click="toggleNewCommunity"/>
            <div class="ch-modal">
              <div class="ch-modal-title">Create community</div>
              <input class="ch-input"
                     placeholder="Community name"
                     t-model="state.ui.newCommunityName"
                     t-on-keydown="onNewCommunityKeydown"/>
              <div class="ch-row">
                <label class="ch-check">
                  <input type="checkbox" t-model="state.ui.newCommunityPublic"/>
                  <span>Public</span>
                </label>
                <select class="ch-input" t-model="state.ui.newCommunityPolicy">
                  <option value="invite">invite</option>
                  <option value="open">open</option>
                </select>
              </div>
              <div class="ch-modal-actions">
                <button class="btn btn-secondary" t-on-click="toggleNewCommunity">Cancel</button>
                <button class="btn btn-primary" t-on-click="submitNewCommunity">Create</button>
              </div>
            </div>
          </t>

          <!-- New channel modal -->
          <t t-if="state.ui.showNewChannel">
            <div class="ch-modal-backdrop" t-on-click="toggleNewChannel"/>
            <div class="ch-modal">
              <div class="ch-modal-title">Create channel</div>
              <input class="ch-input"
                     placeholder="Channel name"
                     t-model="state.ui.newChannelName"
                     t-on-keydown="onNewChannelKeydown"/>
              <div class="ch-modal-actions">
                <button class="btn btn-secondary" t-on-click="toggleNewChannel">Cancel</button>
                <button class="btn btn-primary"
                        t-att-disabled="!canManage || !state.selectedCommunity"
                        t-on-click="submitNewChannel">Create</button>
              </div>
            </div>
          </t>
        </aside>

        <!-- MAIN -->
        <main class="ch-main">

          <!-- Header -->
          <header class="ch-team-header">
            <div class="ch-team-title">
              <div class="ch-team-name" t-out="(state.selectedCommunity &amp;&amp; state.selectedCommunity.name) || 'Community Hub'"/>
              <div class="ch-team-sub">
                <t t-if="selectedChannel">
                  Channel: <span class="ch-pill" t-out="selectedChannel.name"/>
                </t>
                <t t-else="">
                  <span class="text-muted">No channel</span>
                </t>
              </div>
            </div>

            <nav class="ch-tabs">
              <button class="ch-tab"
                      data-tab="posts"
                      t-att-class="state.ui.activeTab==='posts'?'ch-tab is-active':'ch-tab'"
                      t-on-click="onTabClick">Posts</button>

              <button class="ch-tab"
                      data-tab="files"
                      t-att-class="state.ui.activeTab==='files'?'ch-tab is-active':'ch-tab'"
                      t-on-click="onTabClick">Tập tin</button>

              <button class="ch-tab"
                      data-tab="photos"
                      t-att-class="state.ui.activeTab==='photos'?'ch-tab is-active':'ch-tab'"
                      t-on-click="onTabClick">Photos</button>
            </nav>

            <div class="ch-header-actions">
              <button class="btn btn-secondary" t-on-click="toggleSettings"
        t-att-disabled="!state.selectedCommunity || state.selectedCommunity.my_state !== 'joined'">

                Manage
              </button>
            </div>
          </header>

          <!-- POSTS -->
          <t t-if="state.ui.activeTab==='posts'">
            <section class="ch-compose" t-if="state.selectedCommunity &amp;&amp; state.selectedChannelId">
              <div class="ch-compose-card">
                <!-- hidden inputs for uploads (post + comment) -->
                <input type="file" multiple="multiple" style="display:none" t-ref="postFileInput" t-on-change="onPostFilesChange"/>
                <input type="file" multiple="multiple" accept="image/*" style="display:none" t-ref="postImageInput" t-on-change="onPostImagesChange"/>
                <input type="file" multiple="multiple" style="display:none" t-ref="commentFileInput" t-on-change="onCommentFilesChange"/>
                <input type="file" multiple="multiple" accept="image/*" style="display:none" t-ref="commentImageInput" t-on-change="onCommentImagesChange"/>

                <div class="ch-compose-top">
                  <div class="ch-compose-label">Post in channel</div>
                  <div class="ch-compose-modes">

                    <button class="ch-pill-btn"
                            data-mode="post"
                            t-att-class="state.ui.composerMode==='post'?'ch-pill-btn is-active':'ch-pill-btn'"
                            t-on-click="onComposerModeClick">Post</button>

                    <button class="ch-pill-btn"
                            data-mode="announcement"
                            t-att-class="state.ui.composerMode==='announcement'?'ch-pill-btn is-active':'ch-pill-btn'"
                            t-on-click="onComposerModeClick">Announcement</button>

                  </div>
                </div>

                <t t-if="state.ui.composerMode==='announcement'">
                  <input class="ch-input ch-announce-title" placeholder="Announcement title"
                         t-model="state.ui.announcementTitle"/>
                </t>

                <!-- toolbar like Teams: emoji / image / attachment -->
                <div class="ch-compose-toolbar">
                  <button class="ch-tool-btn" title="Emoji" t-on-click="togglePostEmoji">🙂</button>
                  <button class="ch-tool-btn" title="Image" t-on-click="openPostImagePicker">🖼</button>
                  <button class="ch-tool-btn" title="Attach file" t-on-click="openPostFilePicker">📎</button>
                </div>

                <t t-if="state.ui.showPostEmoji">
                  <div class="ch-emoji-pop">
                    <t t-foreach="state.ui.emojiList" t-as="e" t-key="e">
                      <button class="ch-emoji-btn" t-att-data-emoji="e" t-on-click="onPostEmojiPick"><t t-out="e"/></button>
                    </t>
                  </div>
                </t>

                <textarea class="ch-textarea" placeholder="Write a post..." t-model="state.ui.postDraft"/>

                <t t-if="state.ui.postAttachments &amp;&amp; state.ui.postAttachments.length">
                  <div class="ch-attach-preview">
                    <t t-foreach="state.ui.postAttachments" t-as="a" t-key="a.id">
                      <div class="ch-attach-chip">
                        <span class="ch-attach-chip-name" t-out="a.name"/>
                        <button class="ch-x" title="Remove" t-att-data-att-id="a.id" t-on-click="removePostAttachment">✕</button>
                      </div>
                    </t>
                  </div>
                </t>

                <div class="ch-compose-actions">
                  <div class="ch-hint">Tip: Enter để xuống dòng.</div>
                  <button class="btn btn-primary" t-on-click="submitPost">Post</button>
                </div>
              </div>
            </section>

            <section class="ch-feed">
              <t t-if="!state.feed.length">
                <div class="ch-empty">Chưa có bài viết</div>
              </t>

              <t t-foreach="state.feed" t-as="p" t-key="p.id">
                <article class="ch-post">
                  <div class="ch-post-avatar" t-out="p.avatarText"/>
                  <div class="ch-post-body">

                    <div class="ch-post-head">
                      <div class="ch-post-author">
                        <span class="ch-post-name" t-out="p.author_name"/>
                        <t t-if="p.is_owner"><span class="ch-badge">Chủ sở hữu</span></t>
                        <span class="ch-post-date" t-out="p.dateText"/>
                      </div>

                      <div class="ch-post-actions">
                        <button class="ch-react-btn" t-att-data-post-id="p.id" data-emoji="👍" t-on-click="onReactClick">👍</button>
                        <button class="ch-react-btn" t-att-data-post-id="p.id" data-emoji="❤️" t-on-click="onReactClick">❤️</button>
                        <button class="ch-react-btn" t-att-data-post-id="p.id" data-emoji="😂" t-on-click="onReactClick">😂</button>
                        <button class="ch-react-btn" t-att-data-post-id="p.id" data-emoji="😮" t-on-click="onReactClick">😮</button>
                        <button class="ch-more-btn" title="More">⋯</button>
                      </div>
                    </div>

                    <div class="ch-post-content">
                      <div t-out="p.body"/>
                    </div>

                    <t t-if="p.attachments &amp;&amp; p.attachments.length">
                      <div class="ch-attach-grid">
                        <t t-foreach="p.attachments" t-as="a" t-key="a.id">
                          <a class="ch-attach-card" t-att-href="a.url" target="_blank">
                            <div class="ch-attach-ico">
                              <t t-if="(a.mimetype || '').includes('spreadsheet')">X</t>
                              <t t-elif="(a.mimetype || '').includes('word')">W</t>
                              <t t-elif="(a.mimetype || '').startsWith('image/')">🖼</t>
                              <t t-else="">F</t>
                            </div>
                            <div class="ch-attach-name" t-out="a.name"/>
                          </a>
                        </t>
                      </div>
                    </t>

                    <div class="ch-post-footer">
                      <button class="ch-link" t-att-data-post-id="p.id" t-on-click="onToggleCommentsClick">
                        <span class="fa fa-comment-o me-1"/> View conversation
                      </button>
                    </div>

                    <t t-if="state.openComments[p.id]?.loaded">
                      <div class="ch-thread">
                        <t t-foreach="state.openComments[p.id].items" t-as="c" t-key="c.id">
                          <div class="ch-comment">
                            <div class="ch-comment-avatar" t-out="c.avatarText"/>
                            <div class="ch-comment-body">
                              <div class="ch-comment-meta">
                                <span class="ch-comment-name" t-out="c.author_name"/>
                                <span class="ch-comment-date" t-out="c.dateText"/>
                              </div>
                              <div class="ch-comment-content" t-out="c.body"/>
                            </div>
                          </div>
                        </t>

                        <div class="ch-reply">
                          <div class="ch-reply-toolbar">
                            <button class="ch-tool-btn" title="Emoji" t-att-data-post-id="p.id" t-on-click="toggleCommentEmoji">🙂</button>
                            <button class="ch-tool-btn" title="Image" t-att-data-post-id="p.id" t-on-click="openCommentImagePicker">🖼</button>
                            <button class="ch-tool-btn" title="Attach file" t-att-data-post-id="p.id" t-on-click="openCommentFilePicker">📎</button>
                          </div>

                          <t t-if="state.ui.commentEmojiForPostId === p.id">
                            <div class="ch-emoji-pop">
                              <t t-foreach="state.ui.emojiList" t-as="e" t-key="e">
                                <button class="ch-emoji-btn" t-att-data-post-id="p.id" t-att-data-emoji="e" t-on-click="onCommentEmojiPick"><t t-out="e"/></button>
                              </t>
                            </div>
                          </t>

                          <textarea class="ch-textarea ch-reply-box"
                                    placeholder="Reply..."
                                    t-att-data-post-id="p.id"
                                    t-att-value="state.ui.commentDraft[p.id] || ''"
                                    t-on-input="onCommentDraftInputEv"/>

                          <t t-set="cAtts" t-value="state.ui.commentAttachments &amp;&amp; state.ui.commentAttachments[p.id]"/>
                          <t t-if="cAtts &amp;&amp; cAtts.length">
                            <div class="ch-attach-preview">
                              <t t-foreach="cAtts" t-as="a" t-key="a.id">
                                <div class="ch-attach-chip">
                                  <span class="ch-attach-chip-name" t-out="a.name"/>
                                  <button class="ch-x" title="Remove" t-att-data-post-id="p.id" t-att-data-att-id="a.id" t-on-click="removeCommentAttachment">✕</button>
                                </div>
                              </t>
                            </div>
                          </t>
                          <div class="ch-reply-actions">
                            <button class="btn btn-secondary"
                                    t-att-data-post-id="p.id"
                                    t-on-click="onSubmitCommentClick">Reply</button>
                          </div>
                        </div>
                      </div>
                    </t>

                  </div>
                </article>
              </t>

              <t t-if="state.feedHasMore">
                <div class="ch-loadmore">
                  <button class="btn btn-secondary" t-on-click="loadMore">Load more</button>
                </div>
              </t>
            </section>
          </t>

          <!-- FILES -->
          <t t-elif="state.ui.activeTab==='files'">
            <section class="ch-files">
              <t t-if="!flattenFiles.length">
                <div class="ch-empty">Chưa có file</div>
              </t>
              <div class="ch-file-list">
                <t t-foreach="flattenFiles" t-as="f" t-key="f.key">
                  <a class="ch-file-row" t-att-href="f.url" target="_blank">
                    <div class="ch-file-name" t-out="f.name"/>
                    <div class="ch-file-meta" t-out="f.from"/>
                  </a>
                </t>
              </div>
            </section>
          </t>

          <!-- PHOTOS -->
          <t t-else="">
            <section class="ch-photos">
              <t t-if="!flattenPhotos.length">
                <div class="ch-empty">Chưa có ảnh</div>
              </t>
              <div class="ch-photo-grid">
                <t t-foreach="flattenPhotos" t-as="ph" t-key="ph.key">
                  <a class="ch-photo" t-att-href="ph.url" target="_blank">
                    <img t-att-src="ph.url"/>
                  </a>
                </t>
              </div>
            </section>
          </t>

          <!-- SETTINGS DRAWER (FULL) -->
          <t t-if="state.ui.settingsOpen">
            <div class="ch-drawer-backdrop" t-on-click="toggleSettings"/>
            <div class="ch-drawer">

              <div class="ch-drawer-head">
                <div style="flex:1; min-width:0;">
                  <div class="ch-drawer-title" t-out="(state.selectedCommunity &amp;&amp; state.selectedCommunity.name) || ''"/>
                  <div class="ch-drawer-sub">
                    Role: <b t-out="state.ui.myRole || '-'"/>
                    <t t-if="!canManage">
                      <span class="text-muted"> • (read-only)</span>
                    </t>
                  </div>
                </div>
                <button class="ch-icon-btn" t-on-click="toggleSettings" title="Close">✕</button>
              </div>

              <div class="ch-drawer-tabs">
                <button class="ch-tab2" data-tab="members"
                        t-att-class="state.ui.settingsTab==='members'?'ch-tab2 is-active':'ch-tab2'"
                        t-on-click="onSettingsTabClick">Members</button>

                <button class="ch-tab2" data-tab="community"
                        t-att-class="state.ui.settingsTab==='community'?'ch-tab2 is-active':'ch-tab2'"
                        t-on-click="onSettingsTabClick">Community</button>

                <button class="ch-tab2" data-tab="channel"
                        t-att-class="state.ui.settingsTab==='channel'?'ch-tab2 is-active':'ch-tab2'"
                        t-on-click="onSettingsTabClick">Kênh</button>
              </div>

              <div class="ch-drawer-body">

                <!-- MEMBERS TAB -->
                <t t-if="state.ui.settingsTab==='members'">

                  <div class="mb-2">
                    <div class="fw-bold mb-1">Danh sách thành viên</div>
                    <div class="text-muted" style="font-size:12px;">
                      Invite/Kick realtime + thông báo vào Inbox Discuss.
                    </div>
                  </div>

                  <t t-if="canManage">
                    <div class="mb-2">
                      <input class="ch-input"
                             placeholder="Tìm user để mời (name/login)..."
                             t-model="state.ui.memberQuery"
                             t-on-input="onMemberSearchInput"/>
                    </div>

                    <t t-if="state.ui.memberResults &amp;&amp; state.ui.memberResults.length">
                      <div class="mb-3">
                        <div class="fw-bold mb-1" style="font-size:13px;">Kết quả tìm kiếm</div>
                        <t t-foreach="state.ui.memberResults" t-as="u" t-key="u.id">
                          <div class="ch-user-row">
                            <div style="min-width:0;">
                              <div class="fw-bold" t-out="u.name"/>
                              <div class="ch-user-login" t-out="u.login"/>
                            </div>
                            <button class="btn btn-primary btn-sm"
                                    t-att-data-user-id="u.id"
                                    t-on-click="onInviteClick">
                              Mời
                            </button>
                          </div>
                        </t>
                      </div>
                    </t>
                  </t>

                  <div>
                    <div class="fw-bold mb-1" style="font-size:13px;">Members</div>

                    <t t-if="!state.ui.members || !state.ui.members.length">
                      <div class="ch-empty">Chưa load members</div>
                    </t>

                    <t t-foreach="state.ui.members" t-as="m" t-key="m.user_id">
                      <div class="ch-member-row">
                        <div style="min-width:0;">
                          <div class="fw-bold" t-out="m.name"/>
                          <div class="ch-user-meta">
                            <span t-out="m.login"/> • <span t-out="m.state"/> • <span t-out="m.role"/>
                            <t t-if="state.user &amp;&amp; m.user_id === state.user.id">
                              <span class="ch-badge ms-2">You</span>
                            </t>
                            <t t-if="m.role === 'owner'">
                              <span class="ch-badge ms-2">Owner</span>
                            </t>
                          </div>
                        </div>

                        <div style="display:flex; gap:8px; align-items:center;">
                          <!-- đổi role: chỉ Owner mới đổi được (backend cũng yêu cầu owner) -->
                          <select class="ch-role form-select form-select-sm"
                                  t-att-data-user-id="m.user_id"
                                  t-att-disabled="!(state.ui.myRole === 'owner') || m.role === 'owner'"
                                  t-on-change="onRoleChange">
                            <option value="member" t-att-selected="m.role === 'member'">member</option>
                            <option value="admin"  t-att-selected="m.role === 'admin'">admin</option>
                            <option value="owner"  t-att-selected="m.role === 'owner'">owner</option>
                          </select>

                          <!-- kick: admin/owner được kick (nhưng không kick owner, không kick chính mình) -->
                          <t t-if="canManage &amp;&amp; state.user &amp;&amp; m.user_id !== state.user.id &amp;&amp; m.role !== 'owner'">
                            <button class="btn btn-outline-danger btn-sm"
                                    t-att-data-user-id="m.user_id"
                                    t-on-click="onKickClick">
                              Kick
                            </button>
                          </t>
                        </div>
                      </div>
                    </t>
                  </div>

                </t>

                <!-- COMMUNITY TAB -->
                <t t-elif="state.ui.settingsTab==='community'">

                  <div class="mb-2">
                    <div class="fw-bold mb-1">Cấu hình Community</div>
                    <div class="text-muted" style="font-size:12px;">
                      Chỉ Admin/Owner mới sửa được.
                    </div>
                  </div>

                  <div class="mb-2">
                    <label class="form-label fw-bold">Tên community</label>
                    <input class="ch-input" t-model="state.ui.communityForm.name" t-att-disabled="!canManage"/>
                  </div>

                  <div class="mb-2">
                    <label class="form-label fw-bold">Join policy</label>
                    <select class="ch-input" t-model="state.ui.communityForm.join_policy" t-att-disabled="!canManage">
                      <option value="invite">invite</option>
                      <option value="open">open</option>
                    </select>
                  </div>

                  <div class="mb-2">
                    <label class="ch-check">
                      <input type="checkbox" t-model="state.ui.communityForm.is_public" t-att-disabled="!canManage"/>
                      <span class="fw-bold">Public</span>
                    </label>
                  </div>

                  <div class="mb-2">
                    <label class="form-label fw-bold">Description (HTML)</label>
                    <textarea class="ch-textarea" style="min-height:140px;"
                              t-model="state.ui.communityForm.description_html"
                              t-att-disabled="!canManage"/>
                  </div>

                  <div class="ch-drawer-actions">
                    <button class="btn btn-primary" t-on-click="saveCommunitySettings" t-att-disabled="!canManage">
                      Save
                    </button>
                    <button class="btn btn-secondary" t-on-click="loadManageData">
                      Reload
                    </button>
                  </div>

                </t>

                <!-- CHANNEL TAB -->
                <t t-else="">

                  <div class="mb-2">
                    <div class="fw-bold mb-1">Cấu hình Kênh</div>
                    <div class="text-muted" style="font-size:12px;">
                      Sửa kênh đang chọn ở sidebar.
                    </div>
                  </div>

                  <t t-if="!selectedChannel">
                    <div class="ch-empty">Chưa chọn kênh</div>
                  </t>

                  <t t-else="">
                    <div class="mb-2">
                      <label class="form-label fw-bold">Tên kênh</label>
                      <input class="ch-input" t-model="state.ui.channelForm.name" t-att-disabled="!canManage"/>
                    </div>

                    <div class="mb-2">
                      <label class="form-label fw-bold">Sequence</label>
                      <input class="ch-input" type="number" t-model="state.ui.channelForm.sequence" t-att-disabled="!canManage"/>
                    </div>

                    <div class="ch-drawer-actions">
                      <button class="btn btn-primary" t-on-click="saveChannelSettings" t-att-disabled="!canManage">
                        Save
                      </button>

                      <button class="btn btn-outline-danger" t-on-click="deleteSelectedChannel" t-att-disabled="!canManage">
                        Delete channel
                      </button>

                      <button class="btn btn-secondary" t-on-click="loadManageData">
                        Reload
                      </button>
                    </div>

                    <div class="mt-2 text-muted" style="font-size:12px;">
                      Lưu ý: Delete sẽ xoá kênh và phát realtime update trong community.
                    </div>
                  </t>

                </t>

              </div>
            </div>
          </t>

        </main>
      </div>
    </div>
  </t>

</templates>
