<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="project_expense_custom_tree_view" model="ir.ui.view">
        <field name="name">project.expense.custom.tree</field>
        <field name="model">project.expense.custom</field>
        <field name="arch" type="xml">
            <tree string="Chi phí dự án" default_order="create_date desc" decoration-bf="1">
                <field name="project_id"/>
                <field name="partner_id" string="Khách hàng"/>
                <field name="contract_number" string="Hợp đồng"/>
                <field name="signature_date" string="Ngày ký hợp đồng"/>
                <field name="date_start" string="Ngày bắt đầu"/>
                <field name="date_end" string="Ngày kết thúc"/>
                <!-- Đã chi theo phân loại (xanh khi > 0) -->
                <field name="total_spent_material" string="Đã chi NVL" sum="Đã chi NVL" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-success="total_spent_material &gt; 0" decoration-bf="total_spent_material &gt; 0" decoration-muted="total_spent_material == 0"/>

                <field name="total_spent_labor" string="Đã chi NC" sum="Đã chi NC" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-success="total_spent_labor &gt; 0" decoration-bf="total_spent_labor &gt; 0" decoration-muted="total_spent_labor == 0"/>

                <field name="total_spent_manufacturing" string="Đã chi SXC" sum="Đã chi SXC" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-success="total_spent_manufacturing &gt; 0" decoration-bf="total_spent_manufacturing &gt; 0" decoration-muted="total_spent_manufacturing == 0"/>

                <field name="total_spent" string="Đã chi" sum="Tổng đã chi" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-success="total_spent &gt; 0" decoration-bf="total_spent &gt; 0" decoration-muted="total_spent == 0"/>

                <!-- Chưa chi theo phân loại (đỏ/cam khi > 0) -->
                <field name="total_not_spent_material" string="Chưa chi NVL" sum="Chưa chi NVL" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-danger="total_not_spent_material &gt; 0" decoration-bf="total_not_spent_material &gt; 0" decoration-muted="total_not_spent_material == 0"/>

                <field name="total_not_spent_labor" string="Chưa chi NC" sum="Chưa chi NC" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-danger="total_not_spent_labor &gt; 0" decoration-bf="total_not_spent_labor &gt; 0" decoration-muted="total_not_spent_labor == 0"/>

                <field name="total_not_spent_manufacturing" string="Chưa chi SXC" sum="Chưa chi SXC" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-danger="total_not_spent_manufacturing &gt; 0" decoration-bf="total_not_spent_manufacturing &gt; 0" decoration-muted="total_not_spent_manufacturing == 0"/>

                <field name="total_not_spent" string="Chưa chi" sum="Tổng chưa chi" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-danger="total_not_spent &gt; 0" decoration-bf="total_not_spent &gt; 0" decoration-muted="total_not_spent == 0"/>

                <!-- Tổng theo phân loại (optional) -->
                <field name="total_material" string="Tổng NVL" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" decoration-info="total_material &gt; 0" decoration-bf="total_material &gt; 0" decoration-muted="total_material == 0"/>

                <field name="total_labor" string="Tổng NC" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" decoration-info="total_labor &gt; 0" decoration-bf="total_labor &gt; 0" decoration-muted="total_labor == 0"/>

                <field name="total_manufacturing" string="Tổng SXC" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide" decoration-info="total_manufacturing &gt; 0" decoration-bf="total_manufacturing &gt; 0" decoration-muted="total_manufacturing == 0"/>

                <field name="total_cost" string="Tổng theo dõi" sum="Tổng theo dõi" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-primary="total_cost &gt; 0" decoration-bf="total_cost &gt; 0" decoration-muted="total_cost == 0"/>

                <field name="currency_id" invisible="1" optional="hide"/>
            </tree>
        </field>
    </record>
<!-- Search View -->
<record id="project_expense_custom_search_view" model="ir.ui.view">
    <field name="name">project.expense.custom.search</field>
    <field name="model">project.expense.custom</field>
    <field name="arch" type="xml">
        <search string="Tìm kiếm chi phí dự án">
            <!-- Search chính -->
            <field name="project_id" string="Dự án"/>
            <field name="partner_id" string="Khách hàng"/>
            <field name="contract_number" string="Hợp đồng"/>

            <!-- Search mở rộng -->
            <filter string="Có đã chi"
                    name="has_spent"
                    domain="[('total_spent', '>', 0)]"/>

            <filter string="Còn chưa chi"
                    name="has_not_spent"
                    domain="[('total_not_spent', '>', 0)]"/>

            <filter string="Có NVL"
                    name="has_material"
                    domain="[('total_material', '>', 0)]"/>

            <filter string="Có Nhân công"
                    name="has_labor"
                    domain="[('total_labor', '>', 0)]"/>

            <filter string="Có SXC"
                    name="has_manufacturing"
                    domain="[('total_manufacturing', '>', 0)]"/>

            <separator/>

            <!-- Nhóm -->
            <group expand="0" string="Nhóm theo">
                <filter string="Dự án"
                        name="group_by_project"
                        context="{'group_by': 'project_id'}"/>

                <filter string="Khách hàng"
                        name="group_by_partner"
                        context="{'group_by': 'partner_id'}"/>

                <filter string="Ngày ký HĐ"
                        name="group_by_signature_date"
                        context="{'group_by': 'signature_date'}"/>

                <filter string="Ngày bắt đầu"
                        name="group_by_date_start"
                        context="{'group_by': 'date_start'}"/>

                <filter string="Ngày kết thúc"
                        name="group_by_date_end"
                        context="{'group_by': 'date_end'}"/>
            </group>
        </search>
    </field>
</record>
    <!-- Form View -->
    <record id="project_expense_custom_form_view" model="ir.ui.view">
        <field name="name">project.expense.custom.form</field>
        <field name="model">project.expense.custom</field>
        <field name="arch" type="xml">
            <form string="Chi phí dự án">
                <sheet>
                    <group>
                        <group string="Thông tin">
                            <field name="project_id" options="{'no_create': True}" readonly="1"/>
                            <field name="contract_number"/>
                            <field name="currency_id" invisible="1"/>
                        </group>

                        <group string="Tổng quan chi phí">
                            <field name="total_cost" string="Tổng theo dõi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_spent" string="Tổng đã chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_not_spent" string="Tổng chưa chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <separator string="Theo phân loại chi phí"/>

                    <!-- Hiển thị gọn: mỗi nhóm 1 cột -->
                    <group col="3">
                        <group string="Nguyên vật liệu (NVL)">
                            <field name="total_material" string="Tổng" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_spent_material" string="Đã chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_not_spent_material" string="Chưa chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>

                        <group string="Nhân công">
                            <field name="total_labor" string="Tổng" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_spent_labor" string="Đã chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_not_spent_labor" string="Chưa chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>

                        <group string="Sản xuất chung (SXC)">
                            <field name="total_manufacturing" string="Tổng" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_spent_manufacturing" string="Đã chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_not_spent_manufacturing" string="Chưa chi" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                    </group>

                    <separator string="Danh sách yêu cầu chi (chỉ theo dõi Xác nhận / Hoàn tất)"/>

                    <!-- Chỉ hiển thị confirmed + done -->
                    <field name="payment_request_ids" readonly="context.get('readonly_by_ctx', False)" domain="[('state', 'in', ['confirmed', 'done'])]">
                        <tree create="false" edit="false" delete="false" default_order="date_payment desc, expense_type asc">
                            <field name="name"/>
                            <field name="note" string="Nội dung"/>
                            <field name="date_payment"/>
                            <field name="expense_type"/>
                            <field name="total" widget="monetary" sum="Tổng cộng"/>
                            <field name="state" string="Trạng thái" widget="badge" decoration-warning="state == 'confirmed'" decoration-success="state == 'done'"/>
                            <field name="proposal_sheet_id" optional="hide"/>
                            <field name="date" optional="hide"/>
                            <field name="currency_id" optional="hide"/>

                            <!-- Nếu vẫn muốn xem file thì để optional, tránh tree bị rối -->
                            <!-- <field name="attachment_ids" string="Tệp đính kèm" widget="many2many_binary" optional="hide"/> -->
                        </tree>
                    </field>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_project_expense" model="ir.actions.act_window">
        <field name="name">Chi phí dự án</field>
        <field name="res_model">project.expense.custom</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="project_expense_custom_search_view"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Nhấn vào đây để tạo mới một bản ghi chi phí dự án.
            </p>
        </field>
    </record>
    <record id="action_project_expense_readonly" model="ir.actions.act_window">
        <field name="name">Chi phí dự án</field>
        <field name="res_model">project.expense.custom</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="project_expense_custom_search_view"/>
        <!-- Context ép readonly -->
        <field name="context">{'readonly_by_ctx': True}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_project_expense" name="Chi phí dự án" parent="custom_account_menu.menu_accounting_project" action="action_project_expense" sequence="10"/>
    <menuitem id="menu_project_expense_in_project" name="Chi phí dự án" parent="project.menu_main_pm" action="action_project_expense_readonly" sequence="50" />
    <!-- <menuitem id="menu_project_expense_in_project_user" name="Chi phí dự án" parent="custom_project_role.menu_main_pm_user" action="action_project_expense_readonly" sequence="50" /> -->
</odoo>