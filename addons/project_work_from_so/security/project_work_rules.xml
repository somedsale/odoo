<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Assignment: user chỉ thấy assignment của mình -->
  <record id="rule_project_work_assignment_user_own" model="ir.rule">
    <field name="name">Assignment: user own</field>
    <field name="model_id" ref="model_project_work_assignment"/>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="domain_force">[('user_id','=',user.id)]</field>
  </record>

  <!-- Progress: user chỉ thấy progress thuộc assignment của mình -->
  <record id="rule_project_work_weekly_progress_user_own" model="ir.rule">
    <field name="name">Progress: user own</field>
    <field name="model_id" ref="model_project_work_weekly_progress"/>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    <field name="domain_force">[('assignment_id.user_id','=',user.id)]</field>
  </record>

  <!-- Manager: xem tất cả -->
  <record id="rule_project_work_assignment_manager_all" model="ir.rule">
    <field name="name">Assignment: manager all</field>
    <field name="model_id" ref="model_project_work_assignment"/>
    <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

  <record id="rule_project_work_weekly_progress_manager_all" model="ir.rule">
    <field name="name">Progress: manager all</field>
    <field name="model_id" ref="model_project_work_weekly_progress"/>
    <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

</odoo>
