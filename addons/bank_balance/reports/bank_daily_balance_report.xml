<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_bank_daily_balance_html" model="ir.actions.report">
        <field name="name">Bank Daily Balance Report (HTML)</field>
        <field name="model">bank.balance.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">bank_balance.bank_daily_balance_report_template</field>
        <field name="print_report_name">'Bank Daily Balance'</field>
    </record>

    <template id="bank_daily_balance_report_template">
        <t t-call="web.basic_layout">
            <div class="page" style="font-family:'Times New Roman'; font-size:13px; color:#111;">

                <!-- HEADER -->
                <div style="text-align:center; margin-bottom:10px;">
                    <div style="font-size:16px; font-weight:700; letter-spacing:.3px;">
                        BÁO CÁO TỒN NGÂN HÀNG
                    </div>
                    <div style="margin-top:2px;">
                        Ngày: <span style="font-weight:700;">
                        <t t-esc="date_label or ''"/>
                    </span>
                </div>
            </div>

            <!-- COMPANY -->
            <div style="display:flex; justify-content:space-between; margin:6px 0 10px 0;">
                <div>
                    <span style="color:#444;">Công ty:</span>
                    <span style="font-weight:700;">
                        <t t-esc="(res_company and res_company.name) or ''"/>
                    </span>
                </div>
            </div>

            <!-- TABLE -->
            <table style="width:100%; border-collapse:collapse; border:1px solid #222;">
                <thead>
                    <tr style="background:#f2f2f2;">
                        <th style="border:1px solid #222; padding:7px 8px; text-align:left;">Ngân hàng</th>
                        <th style="border:1px solid #222; padding:7px 8px; text-align:right; width:16%;">Tồn đầu</th>
                        <th style="border:1px solid #222; padding:7px 8px; text-align:right; width:16%;">PS thu</th>
                        <th style="border:1px solid #222; padding:7px 8px; text-align:right; width:16%;">PS chi</th>
                        <th style="border:1px solid #222; padding:7px 8px; text-align:right; width:16%;">Tồn cuối</th>
                    </tr>
                </thead>

                <tbody>
                    <!-- zebra counter -->
                    <t t-set="row" t-value="0"/>

                    <t t-foreach="lines or []" t-as="l" t-key="l.get('bank_id') or l.get('bank_name')">
                        <t t-set="row" t-value="row + 1"/>
                        <tr t-att-style="'background:#fcfcfc;' if (row % 2 == 0) else ''">

                            <td style="border:1px solid #222; padding:7px 8px;">
                                <t t-esc="l.get('bank_name') or ''"/>
                            </td>

                            <!-- OPEN -->
                            <td style="border:1px solid #222; padding:7px 8px; text-align:right;">
                                <t t-set="v" t-value="l.get('opening_balance', 0.0)"/>
                                <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                            </td>

                            <!-- RECEIPT -->
                            <td style="border:1px solid #222; padding:7px 8px; text-align:right;">
                                <t t-set="v" t-value="l.get('receipt_amount', 0.0)"/>
                                <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                            </td>

                            <!-- PAYMENT -->
                            <td style="border:1px solid #222; padding:7px 8px; text-align:right;">
                                <t t-set="v" t-value="l.get('payment_amount', 0.0)"/>
                                <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                            </td>

                            <!-- CLOSE -->
                            <td style="border:1px solid #222; padding:7px 8px; text-align:right; font-weight:700;">
                                <t t-set="v" t-value="l.get('closing_balance', 0.0)"/>
                                <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                            </td>

                        </tr>
                    </t>

                    <!-- TOTAL -->
                    <tr style="background:#e9ecef; font-weight:700;">
                        <td style="border:1px solid #222; padding:8px; text-align:center;">TỔNG</td>

                        <td style="border:1px solid #222; padding:8px; text-align:right;">
                            <t t-set="v" t-value="total_open or 0.0"/>
                            <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                        </td>

                        <td style="border:1px solid #222; padding:8px; text-align:right;">
                            <t t-set="v" t-value="total_r or 0.0"/>
                            <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                        </td>

                        <td style="border:1px solid #222; padding:8px; text-align:right;">
                            <t t-set="v" t-value="total_p or 0.0"/>
                            <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                        </td>

                        <td style="border:1px solid #222; padding:8px; text-align:right;">
                            <t t-set="v" t-value="total_close or 0.0"/>
                            <span t-out="v" t-options="{'widget':'monetary','display_currency': currency_id}"/>
                        </td>
                    </tr>

                </tbody>
            </table>

            <div style="margin-top:10px; font-size:12px; color:#444;">
                    Ghi chú: Tồn cuối ngày = Tồn đầu ngày sau.
            </div>

        </div>
    </t>
</template>

</odoo>
