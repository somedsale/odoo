<odoo>
    <record id="view_supplier_contract_tree" model="ir.ui.view">
        <field name="name">supplier.contract.tree</field>
        <field name="model">supplier.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="number_contract"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="interpretation"/>
                <field name="contract_date"/>
                <field name="amount"/>
                <field name="total_invoices"/>
                <field name="paid_amount"/>
                <field name="old_debt"/>
                <field name="residual_amount"/>
                <field name="due_date"/>
                <field name="currency_id" optional="hide" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_supplier_contract_form" model="ir.ui.view">
        <field name="name">supplier.contract.form</field>
        <field name="model">supplier.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" title="Xem tất cả hóa đơn thuộc hợp đồng này">
                            <field name="total_invoices" widget="statinfo" string="Hóa đơn"/>
                        </button>

                        <button name="action_open_payment_requests" type="object" class="oe_stat_button" icon="fa-credit-card" title="Xem các phiếu chi liên quan hợp đồng này">
                            <field name="paid_amount" widget="statinfo" string="Đã chi"/>
                        </button>

                        <button name="action_open_settlements" type="object" class="oe_stat_button" icon="fa-check-square-o" title="Xem hồ sơ quyết toán của hợp đồng này">
                            <field name="total_settlements" widget="statinfo" string="Quyết toán"/>
                        </button>

                        <button name="action_open_residual" type="object" class="oe_stat_button" icon="fa-exclamation-circle" title="Xem chi tiết công nợ còn lại của hợp đồng này">
                            <field name="residual_amount" widget="statinfo" string="Còn nợ"/>
                        </button>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="name"/>
                            <field name="number_contract"/>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="interpretation"/>
                            <field name="contract_date"/>
                            <field name="due_date"/>
                        </group>
                        <group string="Chi tiết">
                            <field name="amount"/>
                            <field name="total_invoices" readonly="1"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="old_debt"/>
                            <field name="residual_amount" readonly="1"/>
                            <field name="currency_id" invisible="1" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hóa đơn">
                            <field name="invoice_ids">
                                <tree editable="bottom">
                                    <field name="invoice_number" width="150" required="1"/>
                                    <field name="date" width="100"/>
                                    <field name="due_date" width="100"/>
                                    <field name="amount_untaxed" widget="monetary" class="o_list_number" width="120"/>
                                    <field name="account_tax_id" />
                                    <field name="amount_tax" widget="monetary" class="o_list_number" width="120" readonly="1"/>
                                    <field name="amount" widget="monetary" class="o_list_number" width="120" readonly="1"/>
                                    <field name="note" width="250"/>
                                    <field name="currency_id" invisible="1" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Phiếu chi">
                            <field name="account_payment_request_ids">
                                <tree>
                                    <field name="name" width="150"/>
                                    <field name="date" width="100"/>
                                    <field name="total" widget="monetary" class="o_list_number" width="120"/>
                                    <field name="state" width="100" string="Trạng thái"/>
                                    <field name="currency_id" invisible="1" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hồ sơ quyết toán">
                            <field name="settlement_ids">
                                <tree editable="bottom">
                                    <field name="name" width="150"/>
                                    <field name="date" width="100"/>
                                    <field name="description" width="300"/>
                                    <field name="amount" widget="monetary" class="o_list_number" width="120"/>
                                    <field name="currency_id" invisible="1" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_supplier_contract_search" model="ir.ui.view">
        <field name="name">supplier.contract.search</field>
        <field name="model">supplier.contract</field>
        <field name="arch" type="xml">
            <search string="Tìm hợp đồng mua">
                <!-- Search fields -->
                <field name="name" string="Tên hợp đồng"/>
                <field name="number_contract" string="Số hợp đồng"/>
                <field name="partner_id" string="Nhà cung cấp"/>
                <field name="project_id" string="Dự án"/>
                <field name="interpretation" string="Diễn giải"/>

                <!-- Quick filters -->
                <filter string="Hợp đồng còn nợ" name="has_residual" domain="[('residual_amount','&gt;',0)]" help="Lọc các hợp đồng còn nợ"/>

                <filter string="Có công nợ cũ" name="has_old_debt" domain="[('old_debt','&gt;',0)]" help="Lọc các hợp đồng có công nợ cũ"/>

                <filter string="Đã thanh toán hết" name="paid_full" domain="[('residual_amount','&lt;=',0)]" help="Lọc các hợp đồng đã thanh toán hết"/>

                <filter string="Có tạm ứng / đã chi" name="has_paid" domain="[('paid_amount','&gt;',0)]" help="Lọc các hợp đồng đã có thanh toán"/>

                <filter string="Có hóa đơn" name="has_invoice" domain="[('total_invoices','&gt;',0)]" help="Lọc các hợp đồng đã có hóa đơn"/>

                <separator/>

                <!-- Date filters -->
                <filter string="Đến hạn" name="due_today" domain="[('due_date','=',context_today())]"/>

                <filter string="Quá hạn" name="overdue" domain="[('due_date','&lt;',context_today()), ('residual_amount','&gt;',0)]"/>

                <filter string="Sắp đến hạn 7 ngày" name="due_7_days" domain="[('due_date','&gt;=',context_today()), ('due_date','&lt;=', (context_today() + relativedelta(days=7)).strftime('%%Y-%%m-%%d')), ('residual_amount','&gt;',0)]"/>

                <separator/>

                <!-- Group by -->
                <filter string="Nhóm theo Nhà cung cấp" name="group_partner" context="{'group_by':'partner_id'}"/>

                <filter string="Nhóm theo Dự án" name="group_project" context="{'group_by':'project_id'}"/>

                <filter string="Nhóm theo Ngày hợp đồng" name="group_contract_date" context="{'group_by':'contract_date'}"/>

                <filter string="Nhóm theo Hạn thanh toán" name="group_due_date" context="{'group_by':'due_date'}"/>

                <searchpanel>
                    <field name="partner_id" string="Nhà cung cấp" icon="fa-user" select="multi" enable_counters="1"/>

                    <field name="project_id" string="Dự án" icon="fa-folder" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_supplier_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng mua</field>
        <field name="res_model">supplier.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_supplier_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nhấn vào nút Tạo để tạo hợp đồng mới.
            </p>
        </field>
    </record>
    <menuitem id="menu_supplier_contract_root" name="Công nợ NCC" sequence="10" parent="custom_account_menu.menu_accounting_custom_root"/>
    <menuitem id="menu_supplier_contract" name="Danh sách hợp đồng mua" parent="menu_supplier_contract_root" action="action_supplier_contract" sequence="10"/>
</odoo>
