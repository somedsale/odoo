<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TREE VIEW COST ESTIMATE -->
    <record id="view_cost_estimate_tree" model="ir.ui.view">
        <field name="name">cost.estimate.tree</field>
        <field name="model">cost.estimate</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <tree>
                <field name="name" column_invisible="1"/>
                <field name="project_id"/>
                <field name="sale_order_partner"/>
                <field name="contract_id"/>
                <field name="signature_date"/>
                <field name="date_start"/>
                <field name="date_end"/>

                <field name="estimate_material_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estimate_labor_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estimate_manufacturing_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estimate_total_breakdown" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="estimate_material_total_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estimate_labor_total_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estimate_manufacturing_total_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estimate_total_breakdown_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="total_final_non_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="total_final_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                <field name="state"
                       widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-primary="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state in ['rejected', 'cancel']"/>

                <field name="currency_id" optional="hide"/>
                <field name="activity_ids" widget="list_activity" string="Hoạt động" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW COST ESTIMATE -->
    <record id="view_cost_estimate_form" model="ir.ui.view">
        <field name="name">cost.estimate.form</field>
        <field name="model">cost.estimate</field>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <form string="Dự toán chi phí Dự án">

                <field name="show_button_submit" invisible="1"/>
                <field name="show_button_approve" invisible="1"/>
                <field name="show_button_cancel" invisible="1"/>
                <field name="show_button_draft" invisible="1"/>

                <header>
                    <button name="action_submit"
                            type="object"
                            string="Gửi duyệt"
                            invisible="show_button_submit == False"
                            class="oe_highlight"/>

                    <button name="action_approve"
                            type="object"
                            string="Duyệt"
                            invisible="show_button_approve == False"
                            class="oe_highlight"/>

                    <button name="action_cancel"
                            type="object"
                            string="Hủy"
                            invisible="show_button_cancel == False"
                            class="oe_highlight"
                            confirm="Bạn có chắc muốn hủy không?"/>

                    <button name="action_draft"
                            type="object"
                            string="Đưa về nháp"
                            invisible="show_button_draft == False"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,cancel"/>
                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_requests_without_item"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exclamation-circle">
                            <field name="payment_requests_without_item_count"
                                   widget="statinfo"
                                   string="Phiếu chi chưa gán hạng mục"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state != 'draft'"/>
                        </h1>
                    </div>

                    <!-- THÔNG TIN TỔNG QUAN -->
                    <group string="Thông tin tổng quan" col="2">

                        <group string="Thông tin chính">
                            <field name="code" readonly="1"/>
                            <field name="project_id" readonly="1"/>

                            <separator string="Tổng hợp chi phí"/>

                            <field name="total_cost" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_cost_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                            <field name="amount_additional_expense" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_additional_expense_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                            <field name="total_final_non_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_final_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>

                            <field name="currency_id" invisible="1"/>
                        </group>

                        <group string="Thông tin đơn hàng / hợp đồng">
                            <field name="create_date" string="Ngày tạo" readonly="1"/>

                            <label for="sale_order_id"/>
                            <div class="popup-wrapper">
                                <field name="sale_order_id" readonly="1" nolabel="1" class="popup-trigger"/>

                                <div class="popup-detail">
                                    <p>
                                        <b>Khách hàng: </b>
                                        <field name="sale_order_partner" readonly="1"/>
                                    </p>
                                    <p>
                                        <b>Ngày đơn hàng: </b>
                                        <field name="sale_order_date" readonly="1"/>
                                    </p>
                                    <p>
                                        <b>Tổng tiền: </b>
                                        <field name="sale_order_amount_total"
                                               readonly="1"
                                               widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </p>
                                </div>
                            </div>

                            <field name="contract_id" readonly="1"/>
                            <field name="contract_value"
                                   string="Giá trị hợp đồng"
                                   readonly="1"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>

                            <field name="signature_date" readonly="1"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                        </group>

                    </group>

                    <!-- TỔNG HỢP DỰ TOÁN THEO PHÂN LOẠI -->
                    <group string="Tổng hợp thành phần dự toán" col="3">

                        <group string="Dự toán trước thuế">
                            <field name="estimate_material_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_labor_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_manufacturing_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_total_breakdown" string="Tổng" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>

                        <group string="Thuế dự toán">
                            <field name="estimate_material_tax_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_labor_tax_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_manufacturing_tax_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_tax_total_breakdown" string="Tổng" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>

                        <group string="Dự toán sau thuế">
                            <field name="estimate_material_total_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_labor_total_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_manufacturing_total_with_tax" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="estimate_total_breakdown_with_tax" string="Tổng" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>

                    </group>

                    <notebook>

                        <!-- CHI TIẾT DỰ TOÁN SẢN PHẨM -->
                        <page string="Chi tiết dự toán sản phẩm">
                            <field name="line_ids"
                                   widget="section_and_note_one2many"
                                   context="{'default_cost_estimate_id': active_id}"
                                   readonly="state == 'approved'">

                                <!-- FORM DÒNG DỰ TOÁN -->
                                <form string="Chi tiết dòng dự toán">

                                    <header>
                                        <button name="action_open_copy_cost_wizard"
                                                type="object"
                                                string="Sao chép chi phí"
                                                class="oe_highlight"
                                                icon="fa-copy"
                                                invisible="display_type"/>
                                    </header>

                                    <sheet>
                                        <field name="display_type" invisible="1"/>
                                        <field name="sequence" invisible="1"/>
                                        <field name="is_from_sale_order" invisible="1"/>
                                        <field name="product_type" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>

                                        <group invisible="not display_type">
                                            <field name="name"/>
                                        </group>

                                        <group invisible="display_type" col="2">

                                            <group string="Thông tin dự toán" col="2">
                                                <field name="name" string="Tên hạng mục" colspan="2"/>

                                                <field name="product_id"
                                                       string="Sản phẩm"
                                                       context="{'no_default_code': True}"
                                                       readonly="is_from_sale_order"
                                                       required="not display_type"
                                                       force_save="1"
                                                       colspan="2"/>

                                                <field name="quantity"
                                                       readonly="is_from_sale_order"
                                                       required="not display_type"/>

                                                <field name="unit"
                                                       readonly="is_from_sale_order"
                                                       required="not display_type"
                                                       force_save="1"/>

                                                <field name="tax_id" string="Thuế áp dụng"/>

                                                <field name="price_unit"
                                                       string="Giá thành trên 1 sản phẩm"
                                                       readonly="1"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"/>

                                                <field name="price_subtotal"
                                                       string="Thành tiền dự toán chưa thuế"
                                                       readonly="1"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"
                                                       colspan="2"/>
                                            </group>

                                            <group string="Phân loại chi phí" col="2">
                                                <field name="material_total_cost"
                                                       string="Tổng chi phí vật tư"
                                                       readonly="1"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"
                                                       colspan="2"/>

                                                <field name="labor_total_cost"
                                                       string="Tổng chi phí nhân công"
                                                       readonly="1"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"
                                                       colspan="2"/>

                                                <field name="other_total_cost"
                                                       string="Tổng chi phí khác"
                                                       readonly="1"
                                                       widget="monetary"
                                                       options="{'currency_field': 'currency_id'}"
                                                       colspan="2"/>
                                            </group>

                                        </group>

                                        <notebook invisible="display_type">

                                            <page string="Chi phí nguyên vật liệu (VT)">
                                                <field name="material_line_ids"
                                                       context="{'default_estimate_line_id': active_id}"
                                                       mode="tree,form">
                                                    <tree editable="bottom">
                                                        <field name="material_id" required="1"/>
                                                        <field name="factor" string="Hệ số"/>
                                                        <field name="quantity" required="1"/>
                                                        <field name="unit" widget="selection" options="{'no_create': True}" required="1"/>
                                                        <field name="price_unit" required="1"/>
                                                        <field name="price_total" readonly="1" sum="Tổng"/>
                                                        <field name="vendor_id" placeholder="Nhà cung cấp"/>
                                                    </tree>
                                                    <form>
                                                        <group col="2">
                                                            <field name="material_id" required="1"/>
                                                            <field name="vendor_id"/>
                                                            <field name="factor" string="Hệ số"/>
                                                            <field name="quantity" required="1"/>
                                                            <field name="unit" required="1"/>
                                                            <field name="price_unit" required="1"/>
                                                            <field name="price_total" readonly="1"/>
                                                        </group>
                                                    </form>
                                                </field>
                                            </page>

                                            <page string="Chi phí nhân công">
                                                <field name="labor_expense_line_ids"
                                                       context="{'default_estimate_line_id': active_id, 'default_type': 'labor'}"
                                                       mode="tree,form">
                                                    <tree editable="bottom">
                                                        <field name="expense_id"
                                                               context="{'default_type': 'labor'}"
                                                               string="Chi phí nhân công"
                                                               domain="[('type', '=', 'labor')]"/>
                                                        <field name="factor" string="Hệ số"/>
                                                        <field name="quantity"/>
                                                        <field name="unit"/>
                                                        <field name="price_unit"/>
                                                        <field name="price_total" readonly="1" sum="Tổng"/>
                                                    </tree>
                                                    <form>
                                                        <group col="2">
                                                            <field name="expense_id"
                                                                   context="{'default_type': 'labor'}"
                                                                   string="Chi phí nhân công"
                                                                   domain="[('type', '=', 'labor')]"/>
                                                            <field name="factor" string="Hệ số"/>
                                                            <field name="quantity"/>
                                                            <field name="unit"/>
                                                            <field name="price_unit"/>
                                                            <field name="price_total" readonly="1"/>
                                                        </group>
                                                    </form>
                                                </field>
                                            </page>

                                            <page string="Chi phí khác (SXC)">
                                                <field name="expense_line_ids"
                                                       context="{'default_estimate_line_id': active_id, 'default_type': 'other'}"
                                                       mode="tree,form">
                                                    <tree editable="bottom">
                                                        <field name="expense_id"
                                                               context="{'default_type': 'other'}"
                                                               domain="[('type', '=', 'other')]"
                                                               string="Chi phí sản xuất chung"/>
                                                        <field name="factor" string="Hệ số"/>
                                                        <field name="quantity"/>
                                                        <field name="unit"/>
                                                        <field name="price_unit"/>
                                                        <field name="price_total" readonly="1" sum="Tổng"/>
                                                    </tree>
                                                    <form>
                                                        <group col="2">
                                                            <field name="expense_id"
                                                                   context="{'default_type': 'other'}"
                                                                   domain="[('type', '=', 'other')]"
                                                                   string="Chi phí sản xuất chung"/>
                                                            <field name="factor" string="Hệ số"/>
                                                            <field name="quantity"/>
                                                            <field name="unit"/>
                                                            <field name="price_unit"/>
                                                            <field name="price_total" readonly="1"/>
                                                        </group>
                                                    </form>
                                                </field>
                                            </page>

                                        </notebook>
                                    </sheet>
                                </form>

                                <!-- TREE DÒNG DỰ TOÁN -->
                                <tree string="Chi tiết dự toán">

                                    <control>
                                        <create name="add_product_control" string="Thêm hạng mục"/>
                                        <create name="add_section_control"
                                                string="Thêm nhóm"
                                                context="{'default_display_type': 'line_section'}"/>
                                    </control>

                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>

                                    <field name="name"
                                           string="Tên hạng mục"
                                           widget="section_and_note_text"
                                           optional="show"/>

                                    <field name="product_id"
                                           context="{'no_default_code': True}"
                                           required="not display_type"
                                           invisible="display_type"/>

                                    <field name="so_name" optional="show" invisible="display_type"/>
                                    <field name="so_thongso" optional="hide" invisible="display_type"/>
                                    <field name="so_xuatxu" optional="hide" invisible="display_type"/>

                                    <field name="quantity" required="not display_type" invisible="display_type"/>
                                    <field name="unit" required="not display_type" invisible="display_type"/>

                                    <field name="price_unit"
                                           readonly="1"
                                           optional="show"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="tax_id"
                                           string="Thuế áp dụng"
                                           invisible="display_type"/>

                                    <field name="price_subtotal"
                                           readonly="1"
                                           optional="show"
                                           sum="Tổng"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="price_tax"
                                           readonly="1"
                                           string="Tiền thuế"
                                           optional="hide"
                                           sum="Tổng"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="price_total"
                                           readonly="1"
                                           optional="show"
                                           sum="Tổng"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="actual_material_cost"
                                           string="Chi phí thực tế NVL"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="actual_labor_cost"
                                           string="Chi phí thực tế nhân công"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="actual_manufacturing_cost"
                                           string="Chi phí thực tế sản xuất chung"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="actual_cost"
                                           string="Chi phí thực tế"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="difference_cost"
                                           string="Chênh lệch"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="sale_order_price_unit"
                                           sum="Tổng"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="display_type"/>

                                    <field name="sale_order_price_subtotal"
                                           sum="Tổng"
                                           invisible="display_type"/>

                                    <field name="sale_order_price_total"
                                           sum="Tổng"
                                           invisible="display_type"/>

                                    <field name="currency_id" column_invisible="True"/>

                                </tree>

                            </field>
                        </page>

                        <!-- CHI TIẾT DỰ TOÁN CHI PHÍ GIÁN TIẾP -->
                        <page string="Chi tiết dự toán chi phí phát sinh">
                            <field name="additional_expense_line_ids"
                                   context="{'default_cost_estimate_id': active_id}"
                                   readonly="state == 'approved'">
                                <tree editable="bottom">
                                    <field name="expense_id" string="Tên chi phí"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" string="Đơn vị"/>
                                    <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price_subtotal" sum="Tổng 1" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="tax_id"/>
                                    <field name="price_tax" sum="Tổng 2" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price_total" sum="Tổng 3" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" string="Tiền tệ" optional="hide"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION CŨ: GIỮ NGUYÊN LIST/FORM MẶC ĐỊNH -->
    <record id="action_cost_estimate" model="ir.actions.act_window">
        <field name="name">Dự toán chi phí Dự án</field>
        <field name="res_model">cost.estimate</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ACTION MỚI: OWL CLIENT ACTION -->
    <record id="action_cost_estimate_owl" model="ir.actions.client">
        <field name="name">Dự toán chi phí Dự án</field>
        <field name="tag">cost_estimate_owl_list</field>
    </record>

    <!-- SERVER ACTION -->
    <record id="action_cost_estimate_sync_line_names_server" model="ir.actions.server">
        <field name="name">Đồng bộ tên hạng mục theo sản phẩm</field>
        <field name="model_id" ref="model_cost_estimate"/>
        <field name="binding_model_id" ref="model_cost_estimate"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
if records:
    action = records.action_sync_estimate_line_names_from_products()
    if action:
        result = action
]]></field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <!-- MENU -->
    <menuitem id="menu_cost_estimate_root"
              name="Dự toán chi phí"
              parent="project.menu_main_pm"/>

    <menuitem id="menu_cost_estimate_main"
              name="Quản lý dự toán"
              parent="menu_cost_estimate_root"
              action="action_cost_estimate_owl"/>

</odoo>