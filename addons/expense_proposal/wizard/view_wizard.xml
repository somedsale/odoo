<odoo>
    <record id="view_expense_proposal_reject_wizard" model="ir.ui.view">
        <field name="name">expense.proposal.reject.wizard.form</field>
        <field name="model">expense.proposal.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Từ chối Đề xuất">
                <group>
                    <field name="reason" placeholder="Nhập lý do từ chối..."/>
                </group>
                <footer>
                    <button string="Xác nhận" type="object" name="action_confirm_reject" class="btn-primary"/>
                    <button string="Hủy" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_expense_proposal_reject_wizard" model="ir.actions.act_window">
        <field name="name">Từ chối Đề xuất</field>
        <field name="res_model">expense.proposal.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
