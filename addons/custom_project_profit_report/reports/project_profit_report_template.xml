<odoo>
    <record id="custom_profit_report_a4_landscape" model="report.paperformat">
        <field name="name">Custom Profit Report A4 Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>        <!-- Điều chỉnh từ 40mm xuống 30mm -->
        <field name="margin_bottom">30</field>        <!-- Tăng từ 23mm lên 30mm -->
        <field name="margin_left">5</field>        <!-- Tăng từ 7mm lên 10mm -->
        <field name="margin_right">5</field>        <!-- Tăng từ 7mm lên 10mm -->
        <field name="header_spacing">25</field>        <!-- Giảm từ 35mm xuống 25mm -->
        <field name="dpi">110</field>
    </record>
    <template id="custom_project_profit_layout">
        <t t-call="web.html_container">
            <t t-set="o" t-value="o or doc"/>
            <div class="header" style="display: flex; justify-content: space-between; font-family: Times New Roman;">
                <table style="width:100%; border-collapse: collapse; border: 1px solid #fff;">
                    <tr>
                        <!-- Cột logo bên trái -->
                        <td style="text-align: left; vertical-align: middle; border-collapse: collapse; border: 1px solid #fff; width: 50%;">
                            <img t-att-src="'/web/image/res.company/%s/logo' % res_company.id" alt="Company Logo" style="max-width: 160px;"/>
                        </td>

                        <!-- Cột thông tin công ty bên phải -->
                        <td style="text-align: right; vertical-align: middle; border-collapse: collapse; border: 1px solid #fff; font-size: 11px; text-transform: capitalize; width: 50%;">
                            <span t-esc="res_company.name" style="text-transform: uppercase;"/>
                            <br/>
                            MST: <span t-esc="res_company.partner_id.vat"/>
                        <br/>
                            Địa chỉ: <span t-esc="res_company.partner_id.street"/>
                    <br/>
                            SĐT: <span t-esc="res_company.phone_accounting"/>
                <br/>
                            Email: <span style="text-transform: lowercase;" t-esc="res_company.account_email"/>
            </td>
        </tr>
    </table>
</div>
<div class="article" style="font-family: Times New Roman; font-size: 11pt; line-height: 1.5;">
    <t t-raw="0"/>
    <!-- Nội dung chính của báo cáo -->
</div>
<div class="footer" style="text-align: center; padding: 5mm; font-size: 10pt;">
    <p>
        <span class="page"/>
    </p>
</div>
</t>
</template>
<template id="custom_project_profit_report.project_profit_template">
<t t-call="custom_project_profit_report.custom_project_profit_layout">
<style>
* {
    font-family: "Times New Roman";
    color: #000;
}

h1 {
    text-align: center;
    margin-bottom: 10px;
    font-size: 18pt;
    text-transform: uppercase;
}

table.report-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;        /* 🔥 QUAN TRỌNG */
    font-size: 11px;            /* 🔽 GIẢM */
}

table.report-table th,
table.report-table td {
    border: 1px solid #000;
    padding: 3px 4px;           /* 🔽 GIẢM */
    text-align: center;
    vertical-align: middle;
    word-wrap: break-word;      /* 🔥 */
    white-space: normal;        /* 🔥 */
}

table.report-table th {
    background-color: #C6E0B4;
    font-weight: bold;
}

.money {
    text-align: right !important;
}

.table-item {
    text-transform: uppercase;
    background-color: #E2EFDA;
    font-weight: bold;
}
.col-stt        { width: 3%;  }
.col-project    { width: 18%; text-align: left; }
.col-contract-no{ width: 5%;  }
.col-contract-v { width: 8%;  }

.col-money      { width: 7%;  }
.col-profit     { width: 7%;  }
</style>

<h1 style="text-align:center; margin-bottom:20px;padding-top: 10px;">BÁO CÁO TỔNG HỢP LÃI LỖ CÁC CÔNG TRÌNH</h1>
<!-- Table Report -->
<table class="report-table">
    <thead>
        <tr>
            <th rowspan="2" class="table-item col-stt">STT</th>
            <th rowspan="2" class="table-item col-project">Dự án</th>
            <th colspan="2" class="table-item">Hợp đồng</th>
            <th rowspan="2" class="table-item col-money">Giá trị quyết toán</th>
            <th rowspan="2" class="table-item col-money">Số tiền hóa đơn</th>
            <th rowspan="2" class="table-item col-money">Đã thanh toán</th>
            <th rowspan="2" class="table-item col-money">Nợ phải thu</th>
            <th colspan="4" class="table-item">Chi phí</th>
            <th rowspan="2" class="table-item col-profit">Lãi / Lỗ</th>
        </tr>
        <tr>
            <th class="table-item col-contract-no">Số HĐ</th>
            <th class="table-item col-contract-v">Giá trị HĐ</th>
            <th class="table-item col-money">Nguyên vật liệu</th>
            <th class="table-item col-money">Nhân công</th>
            <th class="table-item col-money">Sản xuất chung</th>
            <th class="table-item col-money">Tổng chi phí</th>
        </tr>
    </thead>
    <tbody>
        <tr style="font-weight:bold;">
            <td colspan="3" style="text-align:center;">Tổng cộng</td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['contract_value'] for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['settlement_value'] for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['invoice_amount'] for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['revenue'] for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['receivable_amount'] for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['material_cost'] or 0 for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['labor_cost'] or 0 for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['other_cost'] or 0 for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['expense'] for d in docs)).replace(',', '.')"/>
            </td>
            <td class="money">
                <t t-esc="'{:,.0f}'.format(sum(d['profit'] for d in docs)).replace(',', '.')"/>
            </td>
        </tr>
        <t t-set="counter" t-value="1"/>
        <t t-foreach="docs" t-as="doc">
            <tr>
                <td class="stt">
                    <t t-esc="counter"/>
                    <t t-set="counter" t-value="counter + 1"/>
                </td>
                <td class="text-start">
                    <t t-esc="doc['project_id'].name"/>
                </td>
                <td class="text-start">
                    <t t-esc="doc['num_contract']"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['contract_value']).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['settlement_value']).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['invoice_amount']).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['revenue']).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['receivable_amount']).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['material_cost'] or 0).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['labor_cost'] or 0).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['other_cost'] or 0).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['expense']).replace(',', '.')"/>
                </td>
                <td class="money">
                    <t t-esc="'{:,.0f}'.format(doc['profit']).replace(',', '.')"/>
                </td>
            </tr>
        </t>
    </tbody>
</table>
</t>
</template>
</odoo>
