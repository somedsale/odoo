<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TREE: của tôi -->
    <!-- TREE: của tôi -->
<record id="view_my_acceptance_project_tree" model="ir.ui.view">
    <field name="name">project.project.my.acceptance.tree</field>
    <field name="model">project.project</field>
    <field name="arch" type="xml">
        <tree string="Dự án cần nghiệm thu"
              create="0"
              delete="0"
              js_class="my_acceptance_project_list"
              default_order="create_date desc, id desc">
            <field name="name" string="Dự án"/>
            <field name="partner_id" string="Khách hàng"/>
            <field name="contract_id" string="Hợp đồng"/>
            <field name="date_start" string="Ngày bắt đầu"/>
            <field name="date" string="Ngày kết thúc"/>
            <field name="value_settlement" string="Giá trị hợp đồng / thực tế" sum="Tổng"/>
            <field name="value_accepted" string="Giá trị đã nghiệm thu" sum="Tổng"/>
            <field name="value_acceptance_remaining" string="Giá trị còn lại" sum="Tổng"/>
            <field name="acceptance_percent" string="% nghiệm thu"/>
            <field name="stage_id" string="Giai đoạn"/>
        </tree>
    </field>
</record>

    <record id="view_my_acceptance_project_search" model="ir.ui.view">
        <field name="name">project.project.my.acceptance.search</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="Tìm dự án cần nghiệm thu">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="user_id"/>
                <field name="acceptance_user_id"/>
                <field name="stage_id"/>

                <separator/>

                <filter name="my_acceptance_project"
                        string="Dự án của tôi"
                        domain="[('is_my_acceptance_project', '=', True)]"/>

                <filter name="has_remaining_acceptance"
                        string="Còn khối lượng nghiệm thu"
                        domain="[('value_acceptance_remaining', '&gt;', 0)]"/>

                            <filter string="Đang thực hiện"
                    name="in_progress"
                    domain="[('stage_id.name', '=', 'Đang thực hiện')]"/>

            <filter string="Hoàn tất"
                    name="done"
                    domain="[('stage_id.name', '=', 'Hoàn tất')]"/>

            <filter string="Dự án cũ"
                    name="old_project"
                    domain="[('stage_id.name', '=', 'Dự án cũ')]"/>

            <filter string="Đã hủy"
                    name="cancelled"
                    domain="[('stage_id.name', '=', 'Đã hủy')]"/>

            <filter string="Tạm ngừng"
                    name="paused"
                    domain="[('stage_id.name', '=', 'Đang tạm ngừng')]"/>

                <separator/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner"
                            string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_contract"
                            string="Hợp đồng"
                            context="{'group_by': 'contract_id'}"/>
                    <filter name="group_acceptance_user"
                            string="Người báo cáo nghiệm thu"
                            context="{'group_by': 'acceptance_user_id'}"/>
                    <filter name="group_stage"
                            string="Giai đoạn"
                            context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- TREE: quản lý -->
<record id="view_manager_acceptance_project_tree" model="ir.ui.view">
    <field name="name">project.project.manager.acceptance.tree</field>
    <field name="model">project.project</field>
    <field name="arch" type="xml">
        <tree string="Dự án nghiệm thu quản lý"
              create="0"
              delete="0"
              js_class="manager_acceptance_project_list"
              default_order="create_date desc, id desc">
                          <header>
                <button name="%(action_project_acceptance_assign_multi_wizard)d"
                        string="Phân công người báo cáo nghiệm thu"
                        type="action"
                        class="btn btn-primary"/>
            </header>
            
            <field name="name" string="Dự án"/>
            <field name="partner_id" string="Khách hàng"/>
            <field name="contract_id" string="Hợp đồng"/>
            <field name="acceptance_user_id" string="Người báo cáo nghiệm thu"/>
            <field name="signature_date" string="Ngày ký hợp đồng"/>
            <field name="date_start" string="Ngày bắt đầu"/>
            <field name="date" string="Ngày kết thúc"/>
            <field name="value_settlement" string="Giá trị hợp đồng / thực tế" sum="Tổng"/>
            <field name="value_accepted" string="Giá trị đã nghiệm thu" sum="Tổng"/>
            <field name="value_acceptance_remaining" string="Giá trị còn lại" sum="Tổng"/>
            <field name="acceptance_percent" string="% nghiệm thu"/>
            <field name="stage_id" string="Giai đoạn"/>
        </tree>
    </field>
</record>

    <record id="view_manager_acceptance_project_search" model="ir.ui.view">
        <field name="name">project.project.manager.acceptance.search</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="Tìm dự án nghiệm thu quản lý">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <field name="user_id"/>
                <field name="acceptance_user_id"/>
                <field name="stage_id"/>

                <separator/>

                <filter name="has_acceptance_user"
                        string="Đã phân người nghiệm thu"
                        domain="[('acceptance_user_id', '!=', False)]"/>

                <filter name="no_acceptance_user"
                        string="Chưa phân người nghiệm thu"
                        domain="[('acceptance_user_id', '=', False)]"/>

                <filter name="has_remaining_acceptance_manager"
                        string="Còn khối lượng nghiệm thu"
                        domain="[('value_acceptance_remaining', '&gt;', 0)]"/>

            <filter string="Đang thực hiện"
                    name="in_progress"
                    domain="[('stage_id.name', '=', 'Đang thực hiện')]"/>

            <filter string="Hoàn tất"
                    name="done"
                    domain="[('stage_id.name', '=', 'Hoàn tất')]"/>

            <filter string="Dự án cũ"
                    name="old_project"
                    domain="[('stage_id.name', '=', 'Dự án cũ')]"/>

            <filter string="Đã hủy"
                    name="cancelled"
                    domain="[('stage_id.name', '=', 'Đã hủy')]"/>

            <filter string="Tạm ngừng"
                    name="paused"
                    domain="[('stage_id.name', '=', 'Đang tạm ngừng')]"/>

                <separator/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_partner_manager"
                            string="Khách hàng"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_contract_manager"
                            string="Hợp đồng"
                            context="{'group_by': 'contract_id'}"/>
                    <filter name="group_manager_manager"
                            string="Quản lý dự án"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_acceptance_user_manager"
                            string="Người phụ trách nghiệm thu"
                            context="{'group_by': 'acceptance_user_id'}"/>
                    <filter name="group_stage_manager"
                            string="Giai đoạn"
                            context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACT WINDOW -->
<record id="action_my_acceptance_project_report" model="ir.actions.act_window">
    <field name="name">Báo cáo nghiệm thu của tôi</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_my_acceptance_project_tree"/>
    <field name="search_view_id" ref="view_my_acceptance_project_search"/>
    <field name="domain">[('is_my_acceptance_project', '=', True)]</field>
    <field name="context">{'manager_mode': False}</field>
</record>

<record id="action_manager_acceptance_project_report" model="ir.actions.act_window">
    <field name="name">Báo cáo nghiệm thu quản lý</field>
    <field name="res_model">project.project</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_manager_acceptance_project_tree"/>
    <field name="search_view_id" ref="view_manager_acceptance_project_search"/>
    <field name="context">{'manager_mode': True}</field>
</record>

<record id="action_open_my_acceptance_report_client" model="ir.actions.client">
    <field name="name">Báo cáo nghiệm thu của tôi</field>
    <field name="tag">project_work_acceptance_report.AcceptanceReport</field>
    <field name="target">current</field>
    <field name="context">{'manager_mode': False}</field>
</record>

<record id="action_open_manager_acceptance_report_client" model="ir.actions.client">
    <field name="name">Báo cáo nghiệm thu quản lý</field>
    <field name="tag">project_work_acceptance_report.AcceptanceReport</field>
    <field name="target">current</field>
    <field name="context">{'manager_mode': True}</field>
</record>

</odoo>