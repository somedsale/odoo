<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_document_move_copy_wizard_form" model="ir.ui.view">
    <field name="name">document.move.copy.wizard.form</field>
    <field name="model">document.move.copy.wizard</field>
    <field name="arch" type="xml">
      <form string="Move/Copy">
        <group>
          <field name="operation"/>
          <field name="folder_id" options="{'no_create_edit': True}"/>
          <field name="document_ids" widget="many2many_tags" readonly="1"/>
        </group>

        <footer>
          <button string="Apply" type="object" name="action_apply" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_document_move_copy_wizard" model="ir.actions.act_window">
    <field name="name">Move/Copy</field>
    <field name="res_model">document.move.copy.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
