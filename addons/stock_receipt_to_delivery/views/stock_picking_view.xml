<odoo>
  <record id="view_picking_form_inherit_export_from_receipt" model="ir.ui.view">
    <field name="name">stock.picking.form.export.from.receipt</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="priority" eval="99"/>
    <field name="arch" type="xml">

      <!-- Đưa field compute vào header để client “thấy” và evaluate được invisible -->
      <xpath expr="//header" position="inside">
        <field name="is_incoming_done" invisible="1"/>
        <field name="is_delivery" invisible="1"/>
      </xpath>

      <!-- Chèn ngay sau nút Validate để chắc chắn match -->
      <xpath expr="//header/button[@name='button_validate']" position="after">
        <button name="action_create_delivery_from_receipt"
                type="object"
                string="Xuất hàng"
                class="oe_highlight"
                invisible="is_incoming_done == False or is_delivery == True"
                />
      </xpath>

    </field>
  </record>
</odoo>
