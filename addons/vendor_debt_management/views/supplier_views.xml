<odoo>
    <record id="view_supplier_summary_tree" model="ir.ui.view">
        <field name="name">supplier.summary.tree</field>
        <field name="model">supplier.summary</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="partner_id"/>
                <field name="total_contracts"/>
                <field name="total_invoices"/>
                <field name="paid_amount" sum="Tổng"/>
                <field name="residual_amount" sum="Tổng"/>
                <field name="advance_amount" sum="Tổng"/>
                <field name="due_days" column_invisible="1"/>
                <field name="due_days_html" widget="html" readonly="1"/>
                <field name="currency_id" optional="hide" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="view_supplier_summary_form" model="ir.ui.view">
        <field name="name">supplier.summary.form</field>
        <field name="model">supplier.summary</field>
        <field name="arch" type="xml">
            <form create="false" edit="true" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="due_date"/>
                            <field name="due_days" invisible="1"/>
                            <field name="due_days_html" widget="html" readonly="1"/>
                            <field name="interpretation"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="total_contracts"/>
                            <field name="total_invoices"/>
                            <field name="paid_amount"/>
                            <field name="residual_amount"/>
                            <field name="advance_amount"/>
                            <field name="currency_id" optional="hide" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hợp đồng">
                            <field name="contract_ids" context="{'default_partner_id': partner_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="contract_date"/>
                                    <field name="amount"/>
                                    <field name="total_invoices"/>
                                    <field name="paid_amount"/>
                                    <field name="residual_amount"/>
                                    <field name="currency_id" optional="hide" invisible="1"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_supplier_summary" model="ir.actions.act_window">
        <field name="name">Tổng hợp công nợ nhà cung cấp</field>
        <field name="res_model">supplier.summary</field>
        <field name="view_mode">tree,form</field>
        <field name="limit">80</field>
        <field name="context">{}</field>
    </record>
    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res_partner_view_search</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='customer']" position="replace">
                <filter string="Khách hàng" name="customer" domain="[('customer_rank','>', 0)]"/>
            </xpath>
            <xpath expr="//filter[@name='supplier']" position="replace">
                <filter string="Nhà cung cấp" name="supplier" domain="[('supplier_rank','>', 0)]"/>
            </xpath>
        </field>
    </record>
    <menuitem id="menu_supplier_summary" name="Tổng hợp công nợ" parent="menu_supplier_contract_root" action="action_supplier_summary" sequence="20"/>
    <menuitem id="menu_supplier_ids" name="Nhà cung cấp" parent="menu_supplier_contract_root" action="account.res_partner_action_supplier" sequence="10"/>

</odoo>