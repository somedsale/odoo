<odoo>
    <record id="product_template_form_inherit_bundle" model="ir.ui.view">
        <field name="name">product.template.form.bundle</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Bundle">
                    <field name="product_variant_ids">
                        <tree>
                            <field name="name"/>
                        </tree>
                    </field>

                    <group>
                        <field name="bom_ids"/>
                    </group>
                    
                </page>
            </xpath>

        </field>
    </record>
</odoo>
