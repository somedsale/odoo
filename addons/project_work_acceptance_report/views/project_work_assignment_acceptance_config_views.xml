<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <record id="view_project_work_assignment_acceptance_config_search" model="ir.ui.view">
      <field name="name">project.work.assignment.acceptance.config.search</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <search string="Phân công người nghiệm thu">
          <field name="project_id"/>
          <field name="work_item_id"/>
          <field name="user_id"/>
          <field name="acceptance_user_id"/>

          <filter string="Chưa phân công nghiệm thu" name="no_acceptance_user" domain="[('acceptance_user_id','=',False)]"/>
          <filter string="Đang hoạt động" name="active_true" domain="[('active','=',True)]"/>

          <group expand="0" string="Nhóm theo">
            <filter string="Dự án" name="group_project" context="{'group_by':'project_id'}"/>
            <filter string="Hạng mục" name="group_work_item" context="{'group_by':'work_item_id'}"/>
            <filter string="Người thi công" name="group_exec" context="{'group_by':'user_id'}"/>
            <filter string="Người nghiệm thu" name="group_acc_user" context="{'group_by':'acceptance_user_id'}"/>
          </group>

          <!-- chỉ dùng project_id để tránh lỗi searchpanel với res.users / field non-stored -->
          <searchpanel>
            <field name="project_id" string="Dự án" enable_counters="1"/>
          </searchpanel>
        </search>
      </field>
    </record>

    <record id="view_project_work_assignment_acceptance_config_tree" model="ir.ui.view">
      <field name="name">project.work.assignment.acceptance.config.tree</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <tree string="Phân công người nghiệm thu" editable="bottom" create="0" delete="0" default_order="project_id, id">
          <field name="project_id"/>
          <field name="work_item_id" string="Hạng mục"/>
          <field name="executor_user_id" string="Người thi công" widget="many2one_avatar_user" readonly="1"/>
          <field name="acceptance_user_id" string="Người nghiệm thu" widget="many2one_avatar_user"/>
          <field name="date_start"/>
          <field name="active"/>
        </tree>
      </field>
    </record>

    <record id="view_project_work_assignment_acceptance_config_form" model="ir.ui.view">
      <field name="name">project.work.assignment.acceptance.config.form</field>
      <field name="model">project.work.assignment</field>
      <field name="arch" type="xml">
        <form string="Phân công người nghiệm thu" create="0" delete="0">
          <sheet>
            <group>
              <group>
                <field name="project_id" readonly="1"/>
                <field name="work_item_id" readonly="1"/>
                <field name="executor_user_id" string="Người thi công" widget="many2one_avatar_user" readonly="1"/>
              </group>
              <group>
                <field name="acceptance_user_id" string="Người nghiệm thu" widget="many2one_avatar_user"/>
                <field name="date_start"/>
                <field name="active"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_project_work_assignment_acceptance_config" model="ir.actions.act_window">
      <field name="name">Phân công người nghiệm thu</field>
      <field name="res_model">project.work.assignment</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="project_work_acceptance_report.view_project_work_assignment_acceptance_config_search"/>
      <field name="view_ids" eval="[
        (5,0,0),
        (0,0, {'sequence':1, 'view_mode':'tree', 'view_id': ref('project_work_acceptance_report.view_project_work_assignment_acceptance_config_tree')}),
        (0,0, {'sequence':2, 'view_mode':'form', 'view_id': ref('project_work_acceptance_report.view_project_work_assignment_acceptance_config_form')})
      ]"/>
      <field name="domain">[('active','=',True)]</field>
    </record>

    <menuitem id="menu_project_work_acceptance_root"
              name="Báo cáo nghiệm thu"
              parent="project.menu_main_pm"
              sequence="62"/>

    <!-- <menuitem id="menu_project_work_assignment_acceptance_config"
              name="Phân công người nghiệm thu"
              parent="menu_project_work_acceptance_root"
              action="action_project_work_assignment_acceptance_config"
              sequence="1"
              groups="project.group_project_manager"/> -->

  </data>
</odoo>