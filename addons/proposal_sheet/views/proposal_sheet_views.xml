<odoo>
    <!-- FORM VIEW -->
    <record id="view_proposal_sheet_form" model="ir.ui.view">
        <field name="name">proposal.sheet.form</field>
        <field name="model">proposal.sheet</field>
        <field name="arch" type="xml">
            <form string="Phiếu Đề Xuất">
                <field name="show_button_submit" invisible="1"/>
                <field name="show_button_manager_approve" invisible="1"/>
                <field name="show_button_boss_approve" invisible="1"/>
                <field name="show_button_reject" invisible="1"/>
                <field name="show_button_waiting_accounting_paid" invisible="1"/>
                <field name="show_button_accounting_approve" invisible="1"/>
                <field name="show_button_cancel" invisible="1"/>
                <field name="show_button_done" invisible="1"/>
                <field name="show_button_reset_draft" invisible="1"/>
                <field name="is_type_readonly" invisible="1"/>
                <field name="is_new_proposal" invisible="1"/>
                <header>
                    <button name="action_submit" type="object" string="Gửi Duyệt" class="btn-primary" invisible="show_button_submit == False"/>
                    <button name="action_manager_approve" type="object" string="Quản Lý Duyệt" class="btn-success" invisible="show_button_manager_approve == False"/>
                    <button name="action_boss_approve" type="object" string="Sếp Duyệt" class="btn-success" invisible="show_button_boss_approve == False"/>
                    <button name="action_waiting_accounting_paid" type="object" string="Chi Tiền" class="btn-info" invisible="show_button_waiting_accounting_paid == False"/>
                    <button name="action_treasurer_comfirm" type="object" string="Thủ quỹ xác nhận" class="btn-info" invisible="state != 'reviewed_accounting' or treasurer_confirmed" groups="account.group_account_manager"/>
                    <button name="action_accounting_approve" type="object" string="Kế Toán Duyệt" class="btn-info" invisible="not show_button_accounting_approve"/>
                    <button name="action_done" type="object" string="Hoàn Tất" class="btn-success" invisible="show_button_done == False" confirm= "Bạn có chắn chắn xác nhận không?"/>
                    <button name="%(action_proposal_reject_wizard)d" type="action" string="Từ Chối" class="btn-danger" invisible="show_button_reject == False"/>
                    <button name="action_cancel" type="object" string="Hủy Phiếu" class="btn-warning" invisible="show_button_cancel == False"/>
                    <button name="action_reset_to_draft" type="object" string="Reset về Nháp" class="btn-secondary" invisible="show_button_reset_draft == False"/>
                    <button name="action_load_from_estimate" type="object" string="Lấy từ Dự toán" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="reviewed_manager,reviewed_accounting,approved,waiting_accounting_paid,done" invisible="state in (&apos;rejected&apos;, &apos;canceled&apos;)"/>
                    <field name="state" widget="statusbar" statusbar_visible="reviewed_manager,reviewed_accounting,approved,rejected" invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="reviewed_manager,reviewed_accounting,approved,canceled" invisible="state != 'canceled'"/>

                </header>
                <sheet>
                    <!-- boolean gốc ẩn đi -->
                    <field name="treasurer_confirmed" invisible="1"/>
                    <field name= "state" invisible="1"/>
                    <!-- Dòng thông báo ở cột value (không nhãn) -->
                    <widget name="web_ribbon" title="Đã xác nhận" bg_color="bg-success" invisible="not treasurer_confirmed"/>
                    <widget name="web_ribbon" title="Đã hoàn tất" bg_color="bg-success" invisible="state != 'done'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True,'no_open':True}" readonly="context.get('from_task', False) or state !='draft' " force_save="context.get('from_task', False)"/>
                            <field name="cost_additional_expense_line_id" string="Hạng mục dự toán chi phí gián tiếp" domain="[('project_id', '=', project_id)]"/>
                            <field name="task_id" options="{'no_create': True,'no_open':True}" readonly="context.get('from_task', False) or state !='draft'" force_save="context.get('from_task', False)" domain="[('project_id', '=', project_id)]" invisible="type=='expense'"/>
                            <field name="requested_by" widget="many2one_avatar_user" readonly="1" options="{'no_open':True}"/>
                            <field name="take_note" placeholder="Ghi chú về phiếu đề xuất" readonly="state != 'draft'"/>
                            <field name="amount_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_total_taxes" string="Tổng (sau thuế)" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="department_id" options="{'no_create': True,'no_open':True}" readonly="state !='draft'"/>
                            <field name="manager_id" widget="many2one_avatar_user" options="{'no_create': True,'no_open':True}" readonly="1"/>
                            <field name="type" widget="selection" readonly="is_type_readonly"/>
                            <field name="create_date" string="Ngày Tạo" readonly="1"/>
                            <field name="date_proposal" />

                        </group>
                    </group>
                    <notebook>
                        <page string="Chi Tiết Vật Tư" invisible="type != 'material'">
                            <field name="material_line_ids" context="{'default_type': 'material'}" readonly="state !='draft'">
                                <tree editable="bottom">
                                    <field name="product_id" column_invisible="parent.is_new_proposal == False" context="{
                                        'default_categ_id': %(project_material.product_category_vattu)d,
                                        'default_detailed_type': 'product',
                                        'default_purchase_ok': True,
                                        'default_sale_ok': False,
                                        'search_default_vattu_only': 1
                                    }"/>
                                    <field name="material_id" column_invisible="parent.is_new_proposal == True"/>
                                    <field name="quantity" required="1"/>
                                    <field name="unit" />
                                    <field name="estimate_price_unit" string="Giá dự toán" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" optional="hide"/>
                                    <field name="estimate_price_total" string="Tổng giá dự toán" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng" optional="hide"/>
                                    <field name="price_unit" string="Giá đề xuất" required="1" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                    <field name="price_total" string="Tổng giá đề xuất" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="tax_id" />
                                    <field name="price_unit_taxed" string="Giá đề xuất (sau thuế)" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" />
                                    <field name="price_total_taxed" string="Thành tiền (sau thuế)" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" optional="show" sum="Tổng"/>
                                    <field name="vendor_id" placeholder="Nhà cung cấp đề xuất" required="1"/>
                                    <field name="description"/>
                                    <field name="currency_id" invisible="1" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chi Tiết Chi Phí Công Trình" invisible="type != 'expense'">
                            <field name="expense_line_ids" context="{'default_type': 'expense'}" readonly="state !='draft'">
                                <tree editable="bottom">
                                    <field name="expense_id" required="1" />
                                    <field name="quantity" required="1"/>
                                    <field name="unit" />
                                    <field name="type_expense"/>
                                    <field name="estimate_price_unit" string="Giá dự toán" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="price_unit" string="Giá đề xuất" required="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="estimate_price_total" string="Tổng giá dự toán" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="price_total" string="Tổng giá đề xuất" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="description"/>
                                    <field name="currency_id" invisible="1" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Chi phí khác" invisible="type != 'other'">
                            <field name="expense_noproject_line_ids" context="{'default_type': 'other'}" readonly="state !='draft'">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="date"/>
                                    <field name="content" string="Nội dung đề xuất"/>
                                    <field name="unit"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" string="Đơn giá" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                                    <field name="object"/>
                                    <field name="cost_classification"/>
                                    <field name="note"/>
                                    <field name="currency_id" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_proposal_sheet_tree" model="ir.ui.view">
        <field name="name">proposal.sheet.tree</field>
        <field name="model">proposal.sheet</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <!-- <field name="task_id"/> -->
                <field name ="project_id"/>
                <field name="create_date" string="Ngày Tạo"/>
                <field name="requested_by"/>
                <field name="type"/>
                <field name="amount_total" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                <field name="amount_total_taxes" string="Tổng (sau thuế)" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                <field name="treasurer_confirmed" string="Thủ quỹ duyệt" readonly="1" groups="account.group_account_manager"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-info="state in ['reviewed_manager', 'reviewed_accounting']" decoration-warning="state == 'waiting_accounting_paid'" decoration-primary="state == 'approved'" decoration-success="state == 'done'" decoration-danger="state in ['rejected', 'canceled']"/>
                <field name="currency_id" string="Tiền tệ" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_proposal_sheet_search" model="ir.ui.view">
        <field name="name">proposal.sheet.search</field>
        <field name="model">proposal.sheet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="task_id"/>
                <field name="requested_by"/>
                <filter string="Nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Chờ Duyệt (Sếp)" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Chờ chi tiền (KT)" name="waiting_accounting_paid" domain="[('state', '=', 'waiting_accounting_paid')]"/>
                <filter string="Chờ Duyệt (QL)" name="reviewed_manager" domain="[('state', '=', 'reviewed_manager')]"/>
                <filter string="Chờ Duyệt (KT)" name="reviewed_accounting" domain="[('state', '=', 'reviewed_accounting')]"/>
                <filter string="Hoàn Tất" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Nhóm Theo">
                    <filter string="Trạng Thái" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Loại Đề Xuất" name="group_by_type" context="{'group_by': 'type'}"/>
                    <filter string="Công trình" name="group_by_project" context="{'group_by': 'project_id'}"/>
                </group>
                <searchpanel>
                    <!-- Nếu proposal.sheet có field project_id -->
                    <field name="project_id" string="Dự án" icon="fa-building" enable_counters="1"/>
                    <field name="state" string="Trạng thái" icon="fa-clipboard-list" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <!-- MENU project manager -->
    <record id="action_proposal_sheet" model="ir.actions.act_window">
        <field name="name">Phiếu Đề Xuất</field>
        <field name="res_model">proposal.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_proposal_sheet_search"/>
        <field name="context">{'search_default_reviewed_manager': 1}</field>
        <field name="domain">[('state', 'in', ['draft', 'reviewed_manager','reviewed_accounting', 'approved', 'waiting_accounting_paid', 'done','rejected'])]</field>
    </record>
    <!-- MENU proposal sheet user -->
    <record id="action_proposal_sheet_user" model="ir.actions.act_window">
        <field name="name">Phiếu Đề Xuất</field>
        <field name="res_model">proposal.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_proposal_sheet_search"/>
        <field name="domain">[('requested_by', '=', uid), ('state', 'in', ['draft', 'reviewed_manager','reviewed_accounting', 'approved', 'waiting_accounting_paid', 'done','rejected','canceled'])]</field>

    </record>
    <!-- MENU Kế Toán -->
    <record id="action_proposal_for_accounting" model="ir.actions.act_window">
        <field name="name">Phiếu Đề Xuất (Kế Toán)</field>
        <field name="res_model">proposal.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_proposal_sheet_search"/>
        <field name="context">{'search_default_reviewed_accounting': 1,
            'search_default_waiting_accounting_paid': 1}</field>
        <field name="domain">[('state', 'in', ['draft','reviewed_manager','reviewed_accounting', 'approved', 'waiting_accounting_paid', 'done','rejected'])]</field>
    </record>
    <record id="action_proposal_sheet_create_form" model="ir.actions.act_window">
        <field name="name">Tạo Phiếu Đề Xuất</field>
        <field name="res_model">proposal.sheet</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_proposal_sheet_form"/>
        <field name="target">current</field>
    </record>
    <record id="action_proposal_for_sale" model="ir.actions.act_window">
        <field name="name">Phiếu Đề Xuất (Bán Hàng)</field>
        <field name="res_model">proposal.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_proposal_sheet_search"/>
        <field name="domain">[('state', 'in', ['draft','reviewed_manager','reviewed_accounting', 'approved', 'waiting_accounting_paid', 'done','rejected'])]</field>
    </record>
    <!-- MENU -->
    <menuitem id="menu_proposal_sheet_root" name="Phiếu Đề Xuất" parent="project.menu_main_pm" sequence="10"/>
    <menuitem id="menu_proposal_sheet" name="Quản Lý Phiếu Đề Xuất" parent="menu_proposal_sheet_root" action="action_proposal_sheet" sequence="10"/>
</odoo>