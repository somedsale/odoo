                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:18%">Tiêu đề</th>
                                <th style="width:27%">Nội dung</th>
                                <th style="width:15%">Người giao</th>
                                <th style="width:15%">Người nhận</th>
                                <th style="width:10%">Hạn</th>
                                <th style="width:10%">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="overdue_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.summary || line.display_name || ''"/>
                                </td>
                                <td>
                                    <t t-raw="line.note_html || ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.create_uid ? line.create_uid[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.user_id ? line.user_id[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="fmtDate(line.date_deadline)"/>
                                </td>

                                <td>
                                    <button class="btn-pill click-origin-view" t-att-data-model="line.res_model" t-att-data-resid="line.res_id" t-att-data-activity-id="line.id" t-on-click="click_origin">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- NODEADLINE -->
        <div id="tab-nodeadline" class="tab-panel table_activity table_nodeadline_activity">
            <div class="table_title">Công việc không hạn</div>

            <t t-if="!nodeadline_activity || nodeadline_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-clock-o"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="nodeadline_activity &amp;&amp; nodeadline_activity.length">
                <div class="table-responsive-somed">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:18%">Tiêu đề</th>
                                <th style="width:27%">Nội dung</th>
                                <th style="width:15%">Người giao</th>
                                <th style="width:15%">Người nhận</th>
                                <th style="width:10%">Hạn</th>
                                <th style="width:10%">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="nodeadline_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.summary || line.display_name || ''"/>
                                </td>
                                <td>
                                    <t t-raw="line.note_html || ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.create_uid ? line.create_uid[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.user_id ? line.user_id[1] : ''"/>
                                </td>
                                <td></td>

                                <td>
                                    <button class="btn-pill click-origin-view" t-att-data-model="line.res_model" t-att-data-resid="line.res_id" t-att-data-activity-id="line.id" t-on-click="click_origin">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- DONE -->
        <div id="tab-done" class="tab-panel table_activity table_done_activity">
            <div class="table_title">Công việc hoàn thành</div>

            <t t-if="!done_activity || done_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-flag-checkered"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="done_activity &amp;&amp; done_activity.length">
                <div class="table-responsive-somed">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:18%">Tiêu đề</th>
                                <th style="width:27%">Nội dung</th>
                                <th style="width:15%">Người giao</th>
                                <th style="width:15%">Người nhận</th>
                                <th style="width:10%">Ngày xong</th>
                                <th style="width:10%">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="done_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.summary || line.display_name || ''"/>
                                </td>
                                <td>
                                    <t t-raw="line.note_html || ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.create_uid ? line.create_uid[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.user_id ? line.user_id[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="fmtDate(line.date_done)"/>
                                </td>

                                <td>
                                    <button class="btn-pill click-origin-view" t-att-data-model="line.res_model" t-att-data-resid="line.res_id" t-att-data-activity-id="line.id" t-on-click="click_origin">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

    </t>
</templates>
