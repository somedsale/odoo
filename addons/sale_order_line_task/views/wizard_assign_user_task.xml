<odoo>
    <record id="view_assign_user_wizard_form" model="ir.ui.view">
        <field name="name">assign.user.wizard.form</field>
        <field name="model">assign.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Phân công User">
                <group>
                    <field name="user_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Xác nhận" type="object" name="action_assign" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_assign_user_wizard" model="ir.actions.act_window">
        <field name="name">Phân công Người Phụ Trách</field>
        <field name="res_model">assign.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
