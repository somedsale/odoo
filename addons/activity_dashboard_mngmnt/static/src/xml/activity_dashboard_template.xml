<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ======================= DASHBOARD ======================= -->
    <t t-name="ActivityDashboard">
        <div class="somed-activity-dashboard">
            <!-- Header -->
            <div class="somed-header">
                <h1 class="head">Tổng hợp việc cần làm</h1>
                <div class="somed-subhead">Tổng quan các công việc và hoạt động theo trạng thái</div>
            </div>

            <!-- ===== Layout: Tabs dọc + Nội dung ===== -->
            <div class="layout-two-cols">
                <!-- Radios (ẩn) -->
                <input type="radio" name="activityTabs" id="tabbtn-planned" class="tab-radio" checked="checked"/>
                <input type="radio" name="activityTabs" id="tabbtn-today" class="tab-radio"/>
                <input type="radio" name="activityTabs" id="tabbtn-overdue" class="tab-radio"/>
                <input type="radio" name="activityTabs" id="tabbtn-nodeadline" class="tab-radio"/>
                <input type="radio" name="activityTabs" id="tabbtn-done" class="tab-radio"/>

                <!-- Sidebar -->
                <aside class="side-tabs" role="tablist" aria-label="Bộ lọc trạng thái công việc">
                    <label for="tabbtn-planned" class="tab-pill">
                        Sắp tới
                        <span class="tab-badge">
                            <t t-esc="len_planned"/>
                        </span>
                    </label>

                    <label for="tabbtn-today" class="tab-pill">
                        Hôm nay
                        <span class="tab-badge">
                            <t t-esc="len_today"/>
                        </span>
                    </label>

                    <label for="tabbtn-overdue" class="tab-pill">
                        Quá hạn
                        <span class="tab-badge">
                            <t t-esc="len_overdue"/>
                        </span>
                    </label>
                    <label for="tabbtn-done" class="tab-pill">
                        Hoàn thành
                        <span class="tab-badge">
                            <t t-esc="len_done"/>
                        </span>
                    </label>
                </aside>

                <!-- Nội dung -->
                <section class="tab-content">
                    <t t-call="ManageActivity"/>
                </section>
            </div>
        </div>
    </t>

    <!-- ======================= LISTS ======================= -->
    <t t-name="ManageActivity">

        <!-- helper: render cell safe -->
        <t t-set="fmtDate" t-value="(d) =&gt; d ? (new Date(d)).toLocaleDateString('vi-VN') : ''"/>

        <!-- PLANNED -->
        <div id="tab-planned" class="tab-panel table_activity table_planned_activity">
            <div class="table_title">Công việc sắp tới</div>

            <t t-if="!planned_activity || planned_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-check-circle"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="planned_activity &amp;&amp; planned_activity.length">
                <div class="table-responsive-somed">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:18%">Tiêu đề</th>
                                <th style="width:27%">Nội dung</th>
                                <th style="width:15%">Người giao</th>
                                <th style="width:15%">Người nhận</th>
                                <th style="width:10%">Hạn</th>
                                <th style="width:10%">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="planned_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.summary || line.display_name || ''"/>
                                </td>

                                <td>
                                    <t t-raw="line.note_html || ''"/>
                                </td>

                                <td>
                                    <t t-esc="line.create_uid ? line.create_uid[1] : ''"/>
                                </td>

                                <td>
                                    <t t-esc="line.user_id ? line.user_id[1] : ''"/>
                                </td>

                                <td>
                                    <t t-esc="fmtDate(line.date_deadline)"/>
                                </td>

                                <td>
                                    <button class="btn-pill click-origin-view" t-att-data-model="line.res_model" t-att-data-resid="line.res_id" t-att-data-activity-id="line.id" t-on-click="click_origin">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- TODAY -->
        <div id="tab-today" class="tab-panel table_activity table_today_activity">
            <div class="table_title">Công việc hôm nay</div>

            <t t-if="!today_activity || today_activity.length === 0">
                <div class="empty_state">
                    <i class="fa fa-calendar-o"/>
                    <div>Không có dữ liệu</div>
                </div>
            </t>

            <t t-if="today_activity &amp;&amp; today_activity.length">
                <div class="table-responsive-somed">
                    <table class="table table-modern" width="100%">
                        <thead>
                            <tr class="table_head">
                                <th class="text-center" style="width:5%">STT</th>
                                <th style="width:18%">Tiêu đề</th>
                                <th style="width:27%">Nội dung</th>
                                <th style="width:15%">Người giao</th>
                                <th style="width:15%">Người nhận</th>
                                <th style="width:10%">Hạn</th>
                                <th style="width:10%">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="today_activity" t-as="line" t-key="line.id">
                                <td class="text-center">
                                    <t t-esc="line_index + 1"/>
                                </td>

                                <td>
                                    <t t-esc="line.summary || line.display_name || ''"/>
                                </td>
                                <td>
                                    <t t-raw="line.note_html || ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.create_uid ? line.create_uid[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="line.user_id ? line.user_id[1] : ''"/>
                                </td>
                                <td>
                                    <t t-esc="fmtDate(line.date_deadline)"/>
                                </td>

                                <td>
                                    <button class="btn-pill click-origin-view" t-att-data-model="line.res_model" t-att-data-resid="line.res_id" t-att-data-activity-id="line.id" t-on-click="click_origin">Xem</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </div>

        <!-- OVERDUE -->
        <div id="tab-overdue" class="tab-panel table_activity table_overdue_activity">
            <div class="table_title">Công việc quá hạn</div>

            <t t-if="!overdue_activity || overdue_activity.length === 0">
