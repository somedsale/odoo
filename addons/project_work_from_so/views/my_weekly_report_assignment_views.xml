<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- SEARCH -->
  <record id="view_my_assignment_report_search" model="ir.ui.view">
    <field name="name">project.work.assignment.my.report.search</field>
    <field name="model">project.work.assignment</field>
    <field name="arch" type="xml">
      <search string="Tìm báo cáo sản lượng">
        <!-- search fields -->
        <field name="project_id"/>
        <field name="work_item_name" string="Hạng mục"/>
        <field name="product_id"/>
        <field name="user_id"/>

        <separator/>

        <!-- filters -->
        <filter string="Đang hoạt động"
                name="active_true"
                domain="[('active','=',True)]"/>

        <filter string="Có ngày bắt đầu"
                name="has_date_start"
                domain="[('date_start','!=',False)]"/>
        <filter string="Chưa hoàn thành"
                name="not_done"
                domain="[('progress_percent','&lt;',100)]"/>
        <filter string="Hoàn thành ≥ 100%"
                name="done_100"
                domain="[('progress_percent','&gt;=',100)]"/>
        <separator/>

        <!-- group by -->
        <group expand="0" string="Nhóm theo">
          <filter string="Dự án"
                  name="group_project"
                  context="{'group_by':'project_id'}"/>
          <filter string="Hạng mục"
                  name="group_work_item"
                  context="{'group_by':'work_item_name'}"/>
          <filter string="Sản phẩm"
                  name="group_product"
                  context="{'group_by':'product_id'}"/>
          <filter string="Ngày bắt đầu"
                  name="group_date_start"
                  context="{'group_by':'date_start'}"/>
        </group>

        <!-- Search Panel -->
        <searchpanel>
          <field name="project_id" string="Dự án" enable_counters="1"/>
        </searchpanel>
      </search>
    </field>
  </record>

  <!-- TREE -->
  <record id="view_my_assignment_report_tree" model="ir.ui.view">
    <field name="name">project.work.assignment.my.report.tree</field>
    <field name="model">project.work.assignment</field>
    <field name="arch" type="xml">
      <tree string="Báo cáo lũy kế theo kỳ" create="0" delete="0">
        <field name="project_id"/>
        <field name="work_item_name"/>
        <field name="product_id"/>
        <field name="date_start"/>
        <field name="uom_id"/>
        <field name="qty_settlement"/>
        <field name="qty_done" string="Sản lượng đã hoàn thành"/>
        <field name="qty_remaining" string="Sản lượng còn lại"/>
        <field name="progress_percent" widget="progressbar" string="Tiến độ"/>
        <field name="current_period_no"/>
      </tree>
    </field>
  </record>

  <!-- FORM -->
  <record id="view_my_assignment_report_form" model="ir.ui.view">
    <field name="name">project.work.assignment.my.report.form</field>
    <field name="model">project.work.assignment</field>
    <field name="arch" type="xml">
      <form string="Báo cáo lũy kế theo kỳ" create="0" delete="0" edit="1">
        <header>
          <button name="action_repair_cumulative"
                  type="object"
                  string="Sửa dữ liệu lũy kế"
                  class="btn-secondary"
                  groups="project_work_from_so.group_project_work_manager"/>
        </header>

        <sheet>
          <group>
            <group>
              <field name="project_id" readonly="1"/>
              <field name="work_item_name" readonly="1"/>
              <field name="product_id" readonly="1"/>
              <field name="date_start" readonly="1"/>
              <field name="current_period_no" readonly="1"/>
              <field name="description" readonly="1"/>
              <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
            </group>
            <group>
              <field name="uom_id" readonly="1"/>
              <field name="qty_settlement" readonly="1" string="Khối lượng Hợp đồng/ Thực tế"/>
              <field name="progress_percent" readonly="1" widget="progressbar"/>
              <field name="value_completed" readonly="1" string="Giá trị sản lượng đã thực hiện"/>
            </group>
          </group>

          <notebook>
            <page string="Nhập kỳ hiện tại">
              <group>
                <group>
                  <field name="current_period_start" readonly="1"/>
                  <field name="current_period_end" readonly="1"/>
                </group>
                <group>
                  <field name="prev_qty_cum" readonly="1"/>
                  <field name="current_qty_cum" readonly="1" string="Tổng sản lượng đã đạt được"/>
                </group>
              </group>

              <group>
                <group>
                  <field name="current_qty_week"
                         readonly="not current_period_start"
                         placeholder="Nhập sản lượng đạt được trong kỳ..."/>
                </group>
                <group>
                  <field name="current_note"
                         readonly="not current_period_start"
                         placeholder="Ghi chú..."/>
                </group>
              </group>

              <div class="text-muted" style="margin-top:8px;">
                Bạn chỉ nhập <b>Sản lượng trong kỳ</b>. Hệ thống tự cộng thành <b>Lũy kế</b> và ghi vào lịch sử.
              </div>
            </page>

            <page string="Lịch sử">
              <field name="progress_ids" nolabel="1">
                <tree create="0" delete="0" edit="0">
                  <field name="period_no"/>
                  <field name="period_start"/>
                  <field name="period_end"/>
                  <field name="qty_period" sum="Tổng"/>
                  <field name="uom_id" readonly="1"/>
                  <field name="note"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_my_assignment_report" model="ir.actions.act_window">
    <field name="name">Báo cáo lũy kế theo kỳ</field>
    <field name="res_model">project.work.assignment</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_my_assignment_report_search"/>
    <field name="domain">[('user_id','=',uid), ('active','=',True)]</field>
    <!-- mặc định nhóm theo dự án -->
    <field name="context">{}</field>
    <field name="view_ids" eval="[
      (5,0,0),
      (0,0, {'sequence': 1, 'view_mode':'tree', 'view_id': ref('view_my_assignment_report_tree')}),
      (0,0, {'sequence': 2, 'view_mode':'form', 'view_id': ref('view_my_assignment_report_form')})
    ]"/>
  </record>

  <!-- MENU -->
  <menuitem id="menu_assignment_report"
            name="Báo cáo sản lượng"
            parent="project.menu_main_pm"
            action="action_my_assignment_report"
            sequence="5"/>

  <menuitem id="menu_my_assignment_report"
            name="Báo cáo sản lượng của tôi"
            parent="menu_assignment_report"
            action="action_my_assignment_report"
            sequence="1"/>
</odoo>
