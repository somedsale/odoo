<odoo>
    <record id="view_proposal_sheet_form_inherit_payment" model="ir.ui.view">
        <field name="name">proposal.sheet.form.inherit.payment</field>
        <field name="model">proposal.sheet</field>
        <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Phiếu Chi" groups="account.group_account_user,account.group_account_manager">
                    <field name="payment_line_ids" readonly="1">
                        <tree>
                            <field name="payment_name" string="Phiếu chi"/>
                            <field name="payment_create_date" string="Ngày tạo chi"/>
                            <field name="payment_date" string="Ngày chi"/>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Tổng"/>
                            <field name="currency_id" optional="hide"/>
                            <field name="note"/>
                            <field name="payment_state" string="Trạng thái" widget="badge"
                                   decoration-muted="payment_state == 'draft'"
                                   decoration-primary="payment_state == 'confirmed'"
                                   decoration-info="payment_state == 'post'"
                                   decoration-success="payment_state == 'done'"
                                   decoration-danger="payment_state == 'cancelled'"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <xpath expr="//sheet/group/group/field[@name='amount_total_taxes']" position="after">
                <field name="payment_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_proposal_sheet_tree_inherit_payment" model="ir.ui.view">
        <field name="name">proposal.sheet.tree.inherit.payment</field>
        <field name="model">proposal.sheet</field>
        <field name="inherit_id" ref="proposal_sheet.view_proposal_sheet_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='amount_total_taxes']" position="after">
                <field name="payment_total" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="1"/>
            </xpath>
        </field>
    </record>
</odoo>