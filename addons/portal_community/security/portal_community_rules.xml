    <!-- Nội bộ: full access channels -->
    <record id="portal_community_rule_channel_internal_full" model="ir.rule">
        <field name="name">Internal: Full access channels</field>
        <field name="model_id" ref="portal_community.model_portal_community_channel"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- =========================
         Posts
         ========================= -->

    <!-- Portal: đọc tất cả post trong community/channel -->
    <record id="portal_community_rule_post_portal_read" model="ir.rule">
        <field name="name">Portal: Read posts</field>
        <field name="model_id" ref="portal_community.model_portal_community_post"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal: tạo / sửa / xoá post của chính mình -->
    <record id="portal_community_rule_post_portal_own" model="ir.rule">
        <field name="name">Portal: Own posts</field>
        <field name="model_id" ref="portal_community.model_portal_community_post"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('author_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
