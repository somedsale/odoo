<odoo>
    <record id="view_account_payment_request_form_inherit_bucket" model="ir.ui.view">
        <field name="name">account.payment.request.form.inherit.bucket</field>
        <field name="model">account.payment.request</field>
        <field name="inherit_id" ref="custom_account_payment_request.view_account_payment_request_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='expense_category_id']" position="after">
                <field name="expense_bucket"/>
            </xpath>
        </field>
    </record>
</odoo>
